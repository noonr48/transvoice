  buildHistory,
  // 2026-07-26 v4 baseline honesty (exported for tests + reuse).
  BASELINE_RECALIBRATED_NOTE,
  isBaselineCalibrationComparable,
  buildTakeQuality,
  primaryIssueToFocus,
  recommendDrillForFocus,
  // Exported for the direction-survival guard test: every cue this produces is
  // spoken to a learner whose direction it cannot see, so each must survive the
  // cross-direction stripper in BOTH directions.
  buildCoachMove,
  resolveCoachingDirection,
  deriveDirectionHintFromTarget,
  emitCoachWitness,
  buildAvoidCues,
  buildSuccessCriteria,
  buildDoNotSay,
  // 2026-07-19 zero-friction wave (exported for tests + reuse).
  resolveTakeKind,
  normalizeTakeKindToken,
  // 2026-07-26 field repair: the engine's own structured prescription surface.
  resolveEngineRecommendedTakeKind,
  buildKindMetrics,
  resolveSessionScope,
  resolveRingTierForDaypart,
  resolveSessionsRing,
  daypartOf,
  KIND_SUPPRESSED_ISSUES,
  TAKE_KIND_DO_NOT_SAY,
  COACH_ENTRY_POLICY,
  FOCUS_AXES,
