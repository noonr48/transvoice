// 2026-07-30: the tutor's measured travel across the pitch / mouth-shape field
// for the line being spoken. Rides the response that DELIVERS the audio, which
// is the only payload that already accompanies a spoken line and reaches the
// player at the moment the dot should start moving.
const TUTOR_METRIC_TRACK_HEADER = 'X-Tutor-Metric-Track';

// VoxCPM streams raw mono PCM16 at this rate (MEASURED 2026-07-30 against the
// live service: `X-Audio-Sample-Rate: 48000`, `X-Audio-Channels: 1`,
// `X-Audio-Format: pcm_s16le`). Only a FALLBACK — the pre-synthesis path reads
// the response's own header first, so a service that changes rate re-labels its
// audio rather than silently shifting every tutor reading by an octave.
const VOXCPM_STREAM_SAMPLE_RATE = 48000;

const VOXCPM_AUDIO_RESPONSE_HEADERS = Object.freeze([
  'X-Audio-Format',
  'X-Audio-Sample-Rate',
  'X-Audio-Channels',
  'X-Speaking-Rate-Applied',
  'X-TTS-Generation-Mode',
  'X-Reference-Audio-Role',
]);
const VOICE_SPEECH_BROWSER_EXPOSED_RESPONSE_HEADERS = Object.freeze([
  'X-Audio-Format',
  'X-Audio-Sample-Rate',
  'X-Audio-Channels',
  'X-Voice-Speech-Stream-Id',
  // Honesty contract: cross-origin clients (Electron / remote connection
  // profiles) must be able to read the stand-in-voice signal.
  'X-Reference-Resolved',
  'X-Voice-Cloned',
  'X-Speaking-Rate-Applied',
  'X-TTS-Generation-Mode',
  'X-Reference-Audio-Role',
  // 2026-07-30 call-and-response graph: the tutor's own pitch/resonance travel
  // for this exact line. Must be exposed or a cross-origin client (Electron,
  // remote connection profiles) gets the audio and silently never sees the
  // shape — the "wired but nothing flows" failure this list exists to prevent.
  TUTOR_METRIC_TRACK_HEADER,
]);

const DEFAULT_TUTOR_SPEAKING_RATE = 0.76;
const MIN_TUTOR_SPEAKING_RATE = 0.65;
const MAX_TUTOR_SPEAKING_RATE = 1.25;
// A real reply is fire-and-forget, but it must survive a low-priority template
// already owning VoxCPM's single worker. Five attempts, four retry witnesses;
// the existing terminal tts_presynth line keeps one incident at five lines max.
const COACH_PRESYNTH_BUSY_DELAYS_MS = Object.freeze([0, 500, 1000, 2000, 4000]);

function waitForAbortableDelay(delayMs, signal) {
  if (!(delayMs > 0) || signal?.aborted) return Promise.resolve();
  return new Promise((resolve) => {
    let timer = null;
    const finish = () => {
      if (timer) clearTimeout(timer);
      signal.removeEventListener('abort', finish);
      resolve();
    };
    signal.addEventListener('abort', finish, { once: true });
    timer = setTimeout(finish, delayMs);
  });
}

// The loudness at or below which a take carries NO SIGNAL, as distinct from a
// signal too quiet for the voicing detector. BORROWED, not chosen: it is the
// analyzer's own `peak_loudness_db` default when there are no frames at all
// (services/voice-trainer/src/services/audio_analysis.py:2893, default=-90.0).
// MEASURED separation on a clean 200 Hz hum: real-but-quiet -38.64 dB, digital
// silence -100.0 dB, all-zero buffer -180.0 dB — so this sits ~51 dB below the
// quietest genuine hum observed and still catches true silence. Raising it
// toward the analyzer's `quiet_input` bar (-33 dB) would start silencing real
// learners, which is the failure the wordless ruling exists to prevent.
const NO_SIGNAL_LOUDNESS_DB = -90;
// A requested sound should never wait on an ASR that is expected to produce no
// words. A requested phrase/sentence is different: its lexical evidence is part
// of the same lesson turn, and field measurements put healthy Parakeet around
// 542 ms. Give lexical work a still-bounded window that includes that healthy
// result instead of discarding it after 120 ms.
const NONLEXICAL_ASR_MERGE_GRACE_MS = 120;
const LEXICAL_ASR_MERGE_GRACE_MS = 900;
const NONLEXICAL_SPEECH_OVERRIDE_CONFIDENCE = 0.72;
const NONLEXICAL_ASR_ARTIFACT_TOKENS = new Set([
  'a', 'ah', 'e', 'ee', 'eh', 'er', 'erm', 'hm', 'hmm', 'hum', 'huh', 'i',
  'mhmm', 'mm', 'mmm', 'o', 'oh', 'ooh', 'u', 'uh', 'um',
]);
const NONLEXICAL_ASR_ARTIFACT_TOKEN_PATTERN = /^(?:m+(?:h+m*)?|h+m+|u+(?:h+|m+))$/;
const NONLEXICAL_SPEECH_INTERRUPT_TOKENS = new Set([
  'again', 'cannot', 'cant', 'could', 'help', 'how', 'no', 'please', 'repeat',
  'stop', 'wait', 'what', 'why',
]);
// A completed capture may cross the browser once before the tutor consumes it.
// Keep the joined transcript + take snapshot transient, short-lived, and
// one-shot so a later take can never be substituted for the one the words came
// from. Nothing in this registry is persisted by the session store.
const LISTENING_TURN_TTL_MS = 30_000;

function isRecord(value) {
  return Boolean(value) && typeof value === 'object' && !Array.isArray(value);
}

function normalizeText(value, maxLength = 400) {
  const normalized = typeof value === 'string' ? value.trim() : '';
  return normalized ? normalized.slice(0, maxLength) : '';
}

function settleWithin(promise, timeoutMs) {
  return new Promise((resolve) => {
    const timer = setTimeout(() => resolve(null), timeoutMs);
    promise.then((value) => {
      clearTimeout(timer);
      resolve(value);
    });
  });
}

function normalizeTutorSpeakingRate(value) {
  const numeric = Number(value);
  if (!Number.isFinite(numeric)) return DEFAULT_TUTOR_SPEAKING_RATE;
  return Math.max(MIN_TUTOR_SPEAKING_RATE, Math.min(MAX_TUTOR_SPEAKING_RATE, numeric));
}

const VOICE_TARGET_SOURCE_CATEGORIES = new Set([
  'built-in',
  'preset',
  'reference',
  'custom',
  'custom-handmade',
  'custom-reference',
]);

function normalizeVoiceTargetSourceCategory(value) {
  const normalized = normalizeText(value, 40).toLowerCase();
  return VOICE_TARGET_SOURCE_CATEGORIES.has(normalized) ? normalized : 'unknown';
}

function isReferenceTargetSource(value) {
  return value === 'reference' || value === 'custom-reference';
}

function isRejectedReferenceAnalysis(value) {
  if (!isRecord(value)) return false;
  const advanced = isRecord(value.metrics?.advanced)
    ? value.metrics.advanced
    : (isRecord(value.advanced) ? value.advanced : {});
  const reasons = []
    .concat(Array.isArray(advanced.measurementRejectionReasons) ? advanced.measurementRejectionReasons : [])
    .concat(Array.isArray(advanced.rejectionReasons) ? advanced.rejectionReasons : [])
    .concat(Array.isArray(advanced.reliabilityFlags) ? advanced.reliabilityFlags : [])
    .map((reason) => normalizeText(reason, 80).toLowerCase())
    .filter(Boolean);
  return normalizeText(value.quality?.verdict, 20).toLowerCase() === 'reject'
    || advanced.measurementAvailable === false
    || reasons.includes('no_voiced_frames');
}

function hasTrustworthyReferenceMeasurement(value) {
  if (!isRecord(value) || isRejectedReferenceAnalysis(value)) return false;
  const advanced = isRecord(value.metrics?.advanced)
    ? value.metrics.advanced
    : (isRecord(value.advanced) ? value.advanced : {});
  if (advanced.measurementAvailable === true) return true;
  return Array.isArray(value.timeline) && value.timeline.some((frame) => (
    isRecord(frame)
    && frame.voiced === true
    && Number.isFinite(Number(frame.pitchHz))
    && Number(frame.pitchHz) > 0
  ));
}

function toFiniteOrNull(value) {
  if (value == null || value === '') return null;
  const n = Number(value);
  return Number.isFinite(n) ? n : null;
}

// ── Flow-session backbone (B-SESS 2026-07-19) ────────────────────────────────
// sessionScope: what shape this session takes. tier 'full' = normal voiced
// practice, 'quiet' = humming/soft-onset only, 'silent' = listening/planning
// only (no speaking aloud). eyesFree = the learner cannot read the screen.
// Persisted on the session record; echoed on every session payload (extras key
// `sessionScope`); threaded into the lesson planner as MODE constraints.
const SESSION_SCOPE_TIERS = Object.freeze(['full', 'quiet', 'silent']);

function normalizeSessionScope(value) {
  const source = isRecord(value) ? value : {};
  return {
    tier: SESSION_SCOPE_TIERS.includes(source.tier) ? source.tier : 'full',
    eyesFree: source.eyesFree === true,
  };
}

// Staleness cutoff for the internal cut-short sweep: a session untouched this
// long while its lesson is still live is presumed interrupted. Server-internal
// time plumbing ONLY — the coach surface never sees durations or timers.
const SESSION_STALE_CUTOFF_MS = 20 * 60 * 1000;

// How long the ENGINE's one-shot take-kind prescription stays live (2026-07-26).
// Deliberately the SAME window as the session-staleness cutoff above rather than
// a second number: both answer "has this session gone quiet long enough that
// what was happening before no longer describes what is happening now?" — and a
// prescription is an instruction for the learner's NEXT take, not a standing
// order that should outlive a break. Full lifecycle: stampEngineRecommendedTakeKind.
const PENDING_TAKE_KIND_MAX_AGE_MS = SESSION_STALE_CUTOFF_MS;
// How long a live spoken turn may wait for its analyzer session to be bound
// (2026-07-27). Once per coach session, and deliberately far below the 8s
// fetch budget `startVoiceSession` may spend: an additive evidence channel is
// never worth a visible stall in front of the learner. See
// waitForCoachAnalyzerBind.
const COACH_ANALYZER_BIND_WAIT_MS = 2000;
// After a bind fails or blows its deadline, how long before this session may
// try again. Long enough that a wedged analyzer costs the learner ONE degraded
// turn instead of every turn; short enough that an analyzer restarted
// mid-lesson is picked up without the learner starting over.
const COACH_ANALYZER_BIND_COOLDOWN_MS = 30000;

function createHttpError(status, message, extras = {}) {
  const error = new Error(message);
  error.status = status;
  error.statusCode = status;
  error.payload = {
    success: false,
    error: message,
    ...extras,
  };
  return error;
}

// 2026-07-27 MTF-ONLY — the ONE built-in-target enum check, shared by every
// gateway write sink that can put a `targetPreset` into the session store.
// Membership is tested against the imported PRESET_PROFILES registry, never a
// re-listed literal, so the gate cannot drift from what the cue sheet scores.
//
// `hasOwnProperty.call` (not `in`, not `PRESET_PROFILES[x]`) is deliberate: it
// is what makes '__proto__' and 'constructor' fail the check instead of
// resolving off Object.prototype.
//
// An EMPTY value is allowed through: it means "no explicit target", and the
// callers resolve it to the live 'cute-feminine' default. Rejecting it would
// change behaviour for every caller that omits the field.
function assertLiveBuiltInTargetPreset(targetPreset) {
  if (!targetPreset) return '';
  if (!Object.prototype.hasOwnProperty.call(PRESET_PROFILES, targetPreset)) {
    throw createHttpError(
      400,
      `Unknown target preset "${targetPreset}". Expected one of: ${Object.keys(PRESET_PROFILES).sort().join(', ')}`,
    );
  }
  return targetPreset;
}

async function readResponsePayload(response) {
  const text = await response.text();
  if (!text) {
    return null;
  }
  try {
    return JSON.parse(text);
  } catch {
    return { text };
  }
}

async function fetchJson(url, options = {}) {
  const {
    apiKey = '',
    body,
    fetchImpl = global.fetch,
    headers = {},
    method = body === undefined ? 'GET' : 'POST',
    timeoutMs = 8000,
  } = options;
  const requestHeaders = { ...headers };
  if (body !== undefined && !requestHeaders['Content-Type']) {
    requestHeaders['Content-Type'] = 'application/json';
  }
  if (apiKey && !requestHeaders.Authorization) {
    requestHeaders.Authorization = `Bearer ${apiKey}`;
  }
  const response = await fetchImpl(url, {
    method,
    headers: Object.keys(requestHeaders).length ? requestHeaders : undefined,
    body: body === undefined ? undefined : JSON.stringify(body),
    signal: AbortSignal.timeout(timeoutMs),
  });
  const payload = await readResponsePayload(response);
  if (!response.ok) {
    const detail = payload?.error || payload?.detail || payload?.message || `HTTP ${response.status}`;
    throw createHttpError(response.status, Array.isArray(detail) ? JSON.stringify(detail) : String(detail), {
      upstream: payload,
    });
  }
  return payload;
}

function buildSinePcm16Frame({ frequencyHz = 220, sampleRate = 16000, samples = 1024 } = {}) {
  const buffer = Buffer.alloc(samples * 2);
  for (let index = 0; index < samples; index += 1) {
    const sample = Math.round(Math.sin((2 * Math.PI * frequencyHz * index) / sampleRate) * 0.25 * 32767);
    buffer.writeInt16LE(sample, index * 2);
  }
  return buffer;
}

// ---------------------------------------------------------------------------
// Wordless practice acknowledgment (2026-07-26)
//
// A vocalise drill asks for sound with no WORDS in it — a hum, a straw/SOVT
// buzz, a siren, a sustained note. The ASR correctly returns no-speech, and the
// input turn returns before any coach turn is built, so the learner used to get
// silence back and the loop just repeated "record again".
//
// These lines are deterministic and code-owned, in the same register as the
// drills' own cues (voice-drills.js VOCALISE_DIRECTIONS): they acknowledge that
// the sound was HEARD and hand the turn back. They make no claim about quality
// — there is no measurement here to make one from.
// ---------------------------------------------------------------------------
const WORDLESS_PRACTICE_LINES = Object.freeze({
  hum_sovt: 'I could not get a usable voice reading. Try the hum again, easy and unforced.',
  siren: 'I could not get a usable voice reading. Try the slide again, smooth and unforced.',
  sustained: 'I could not get a usable voice reading. Try the held note again, steady and unpushed.',
  resonance_play: 'I could not get a usable voice reading. Try that sound again, small and forward.',
  trill: 'I could not get a usable voice reading. Try the trill again, loose and easy.',
});

// 2026-07-26 (analyzer take leg): the lines above were written for a hum nobody
// could MEASURE — they say "heard", and stop there, because the ASR's no-speech
// was the only evidence in the building. Now the same segment also becomes a
// real analyzer take, so on a turn where that take succeeded the honest
// acknowledgment is stronger: the sound was heard AND read.
//
// Still deterministic, still code-owned, still no LLM: and deliberately no
// NUMBERS and no quality verdict, because a spoken line is the wrong place to
// recite a measurement. These claim only that a usable reading exists — which
// is exactly what `has_metrics` on the take witness asserts. When the take
// timed out or failed, WORDLESS_PRACTICE_LINES above is the fallback, unchanged.
const WORDLESS_ANALYZED_LINES = Object.freeze([
  'Heard that, and I got a clean read on it. Take another when you\'re ready.',
  'That came through with plenty for me to work from. Go again whenever you like.',
  'Got it — heard and measured. Whenever you\'re ready, take it again.',
]);

// 2026-07-26 (field repair — "hums go silent"): the two tables above are keyed
// by a take KIND, which means they can only be reached when the session's drill
// state already knows a vocalise is running. The field failure was exactly the
// other case: the tutor prescribed an "mhmm" out loud, the machine's state
// stayed take_kind 'phrase' / source 'default' for the whole session, the
// learner hummed three times, and every hum fell into the silent re-arm.
//
// These lines are the KIND-NEUTRAL acknowledgment for that case. They are
// reached only when the analyzer supplies positive voiced evidence for THIS
// turn's take (hasVoicedPracticeEvidence), so "heard that" is a fact, not an
// assumption — but they name no technique, because the state does not know
// which one was practised and inventing one would be a fabricated instruction.
// Register matches the tables above; no numbers, no quality verdict.
// These lines are the accepted measured-turn response. They deliberately do
// not ask for another take: positive analyzer evidence means the learner's
// voice-quality turn landed even when ASR missed the words.
const VOICED_PRACTICE_LINES = Object.freeze([
  'Got it — I have a usable voice reading.',
  'That came through clearly enough to use.',
  'I heard that, and the voice reading is ready.',
]);

function voicedPracticeLineWithSentence(seed, _voiceState) {
  return pickLineForSeed(VOICED_PRACTICE_LINES, seed);
}

/**
 * Pick a line deterministically from a seed (the take's own artifact id).
 *
 * Deterministic on purpose: the same take always yields the same line (so it is
 * testable and reproducible from a log), while different takes vary, so a
 * learner humming five times does not hear one sentence five times.
 */
function pickLineForSeed(lines, seed) {
  const text = String(seed || '');
  let hash = 0;
  for (let index = 0; index < text.length; index += 1) {
    hash = (hash * 31 + text.charCodeAt(index)) % 1000003;
  }
  return lines[hash % lines.length];
}

function pickWordlessAnalyzedLine(seed) {
  return pickLineForSeed(WORDLESS_ANALYZED_LINES, seed);
}

function pickVoicedPracticeLine(seed) {
  return pickLineForSeed(VOICED_PRACTICE_LINES, seed);
}

/**
 * Resolve the acknowledgment for a no-speech turn IF the session's active drill
 * is a vocalise kind. Returns null for phrase drills and for sessions with no
 * active drill, which leaves the existing no-speech behavior exactly as it was.
 */
/**
 * The take-evidence view a coach turn must derive its rep context from — the
 * SAME gate buildSignal applies internally (2026-07-26, Defect 3 follow-up).
 *
 * Without this the two disagreed: buildSignal stripped the stale take, but the
 * caller had already read `repContext` off that same stale artifact and passed
 * it in as an argument, where it WINS over the gated state. A day-old hum could
 * therefore still set takeKind 'hum_sovt' — and with it the vocalise-lenient
 * strain warn bar — on a turn with no fresh take.
 *
 * NOTE: the ungated `voiceState` is still what gets passed to buildSignal, so
 * its own gate fires and the `coach_take_freshness` witness still reports.
 */
function resolveCoachRepContext(voiceState) {
  const freshness = resolveTakeEvidenceFreshness(voiceState);
  const evidence = freshness.fresh ? voiceState : withTakeEvidenceAbsent(voiceState);
  return evidence?.repContext
    || evidence?.lastAttemptArtifact?.repContext
    || evidence?.lastAttemptArtifact?.summary?.repContext
    // The selected drill is live session state, not take evidence, so it
    // survives the gate and remains the honest kind signal for a fresh turn.
    || (voiceState?.lessonId ? { drillId: voiceState.lessonId } : null);
}

/**
 * The rep context for what the learner is practising RIGHT NOW.
 *
 * The ACTIVE drill wins here, unlike the coach-turn path: this answers "what is
 * happening in this moment?", while `voiceState.repContext` is the LAST
 * FINALIZED TAKE's context. Preferring the sticky one would keep treating a
 * phrase as a hum after the learner had already moved on.
 *
 * ONE resolver, deliberately: the analyzer take's `takeKind` and the wordless
 * acknowledgment's `takeKind` describe the SAME sound, so they must not be able
 * to drift apart — the trainer must never record a take as a siren while the
 * spoken line acknowledges a hum.
 */
function resolveActiveDrillRepContext(voiceState) {
  if (!voiceState) return null;
  const targetPreset = voiceState.targetPreset || 'cute-feminine';
  const drillId = voiceState.lessonId || null;
  const drill = drillId ? getVoiceDrillById(targetPreset, drillId) : null;
  return (drill ? { drill: { id: drill.id, kind: drill.kind, tags: drill.tags } } : null)
    || (drillId ? { drillId } : null)
    || voiceState.repContext
    || null;
}

/**
 * WHAT MADE THIS TURN A TURN — the first-class trigger (2026-07-27).
 *
 * THE ARCHITECTURAL POINT, in the owner's words: "why are we using an asr? the
 * tutor asks for 'say the words the little cake on the table' and the asr shows
 * the user said exactly those words... but what did that tell the coach? the
 * only thing that the coach got from that was that the user was able to speak
 * english, and never if it spoke correctly in the targetted voice quality".
 *
 * He is right, and the code disagreed with him structurally. An ASR yields
 * WORDS; voice QUALITY comes only from the DSP analyzer. Yet the ASR GATED the
 * turn: `if (noSpeech || !transcript) return` sat across the top of the reply
 * path, so a wordless practice sound produced no turn at all, and the analyzer's
 * verdict was reachable only from inside the no-speech branch of the WORD path
 * — a special case bolted onto a failure handler.
 *
 * So the trigger is named here instead, as its own decision, with two PEER
 * evidence sources and two honest negative states:
 *
 *   'transcript'      the learner used words. (Take evidence, when present,
 *                     rides along — it is what actually answers the owner's
 *                     question about HOW the words were voiced.)
 *   'voiced_evidence' no words, but the analyzer CONFIRMED phonation. A real
 *                     turn. This is the case the ASR used to eat.
 *   'unresolved'      no words and insufficient acoustic evidence either way.
 *   'silent'          the analyzer corroborated no voiced frames with its
 *                     no-signal loudness floor.
 *
 * Two rules this encodes, both load-bearing:
 *
 *   1. Only the ANALYZER may confirm a sound. `hasVoicedPracticeEvidence` is
 *      positive proof of phonation, not the absence of a rejection — so an
 *      engine prescription can propose a take kind but can never manufacture a
 *      turn out of digital silence. (An earlier review caught exactly that
 *      fabrication: a spoken "Heard the hum" produced from a silent capture.)
 *   2. Absence of evidence is not evidence. A take that timed out, errored, or
 *      never dispatched yields 'unresolved', because "we did not measure" must
 *      never read as "nothing was there".
 */
const VOICE_TURN_TRIGGERS = Object.freeze({
  TRANSCRIPT: 'transcript',
  VOICED_EVIDENCE: 'voiced_evidence',
  UNRESOLVED: 'unresolved',
  SILENT: 'silent',
});

function resolveVoiceTurnTrigger({
  transcript = '',
  transcriptConfidence = null,
  takeOutcome = null,
  expectedTakeKind = null,
} = {}) {
  const words = typeof transcript === 'string' ? transcript.trim() : '';
  const lexicalTokens = words
    .toLowerCase()
    .replace(/[^\p{L}\p{N}'’]+/gu, ' ')
    .split(/\s+/)
    .filter(Boolean);
  const wordCount = lexicalTokens.length;
  const likelyNonlexicalArtifact = wordCount > 0
    && lexicalTokens.every((token) => (
      NONLEXICAL_ASR_ARTIFACT_TOKENS.has(token)
      || NONLEXICAL_ASR_ARTIFACT_TOKEN_PATTERN.test(token)
    ));
  const explicitSpeechInterruption = words.endsWith('?')
    || lexicalTokens.some((token) => (
      NONLEXICAL_SPEECH_INTERRUPT_TOKENS.has(token.replace(/[’']/g, ''))
    ));
  const numericConfidence = Number(transcriptConfidence);
  const hasReportedConfidence = transcriptConfidence !== null
    && transcriptConfidence !== undefined
    && Number.isFinite(numericConfidence);
  // Parakeet's deployed simple response has no confidence field. In that live
  // path, a real sentence must still be able to interrupt a requested hum.
  // When confidence IS present and low, do not let multiword hallucinations
  // relabel the sound. Clear learner controls/questions always escape.
  const confidentSpeechInterruption = !likelyNonlexicalArtifact
    && (
      explicitSpeechInterruption
      || (hasReportedConfidence && numericConfidence >= NONLEXICAL_SPEECH_OVERRIDE_CONFIDENCE)
      // The deployed Parakeet contract has no confidence. With no numerical
      // discriminator, the honest boundary is lexical shape: suppress only a
      // transcript made wholly of sound-like artifacts; preserve every other
      // word/phrase so controls such as "Next" and "Done" are never swallowed.
      || (!hasReportedConfidence && wordCount > 0)
    );
  // The analyzer's verdict is computed the SAME way on both branches, so a
  // spoken turn and a wordless one agree about whether phonation was confirmed.
  const analyzed = takeOutcome?.outcome === 'analyzed';
  const voicedEvidence = analyzed
    && hasVoicedPracticeEvidence(takeOutcome.attemptArtifact || takeOutcome.summary);
  if (
    words
    && (
      !isWordlessPracticeKind(expectedTakeKind)
      || confidentSpeechInterruption
    )
  ) {
    return {
      trigger: VOICE_TURN_TRIGGERS.TRANSCRIPT,
      transcript: words,
      voicedEvidence,
      takeAnalyzed: analyzed,
    };
  }
  if (voicedEvidence) {
    return {
      trigger: VOICE_TURN_TRIGGERS.VOICED_EVIDENCE,
      transcript: '',
      voicedEvidence: true,
      takeAnalyzed: analyzed,
    };
  }
  return {
    trigger: didAnalyzerProveSilence(takeOutcome)
      ? VOICE_TURN_TRIGGERS.SILENT
      : VOICE_TURN_TRIGGERS.UNRESOLVED,
    transcript: '',
    voicedEvidence: false,
    takeAnalyzed: analyzed,
  };
}

function didAnalyzerProveSilence(takeOutcome) {
  const source = takeOutcome?.outcome === 'analyzed'
    ? (takeOutcome.attemptArtifact || takeOutcome.summary)
    : null;
  if (!source) return false;
  const probe = resolveVoiceMeasurementUsability(source);
  const advanced = source?.metrics?.advanced || source?.advanced || source;
  const peakDb = Number(advanced?.peakLoudnessDb);
  const meanDb = Number(advanced?.meanLoudnessDb);
  const loudnessAtFloor = (Number.isFinite(peakDb) && peakDb <= NO_SIGNAL_LOUDNESS_DB)
    || (!Number.isFinite(peakDb)
      && Number.isFinite(meanDb)
      && meanDb <= NO_SIGNAL_LOUDNESS_DB);
  return probe.reliabilityFlags.includes('no_voiced_frames') && loudnessAtFloor;
}

function buildVoiceTurnEvidence({
  asrSettled = null,
  asrResult = null,
  turnTrigger = null,
  takeOutcome = null,
  expectedTakeKind = null,
} = {}) {
  const semantic = isWordlessPracticeKind(expectedTakeKind)
    && turnTrigger?.trigger !== VOICE_TURN_TRIGGERS.TRANSCRIPT
    ? 'not_applicable'
    : asrSettled?.bypassed === true
    ? 'bypassed'
    : asrSettled?.ok === false || asrResult?.success === false
    ? 'failed'
    : turnTrigger?.trigger === VOICE_TURN_TRIGGERS.TRANSCRIPT
      ? 'final'
      : 'no_words';
  const acoustic = takeOutcome?.outcome === 'analyzed' && takeOutcome?.hasMetrics === true
    ? 'usable'
    : didAnalyzerProveSilence(takeOutcome)
      ? 'silence'
    : turnTrigger?.trigger === VOICE_TURN_TRIGGERS.VOICED_EVIDENCE
      ? 'voiced_unscorable'
      : takeOutcome?.outcome === 'analyzed'
        ? 'unusable'
      : takeOutcome?.outcome === 'timeout' || takeOutcome?.outcome === 'error'
        ? 'failed'
        : 'absent';
  const resolution = turnTrigger?.trigger === VOICE_TURN_TRIGGERS.TRANSCRIPT
    ? (acoustic === 'usable' ? 'semantic_measured' : 'semantic_only')
    : acoustic === 'usable'
      ? 'measured_only'
      : acoustic === 'silence'
        ? 'silent'
        : 'unresolved';
  return {
    semantic,
    acoustic,
    resolution,
    measurementUsable: acoustic === 'usable',
  };
}

function isWordlessPracticeKind(value) {
  const kind = normalizeTakeKindToken(value);
  return isVocaliseTakeKind(kind) || kind === 'resonance_play' || kind === 'trill';
}

function resolveAsrMergeGraceMs(takeOutcome = null, expectedTakeKind = null) {
  return isWordlessPracticeKind(takeOutcome?.takeKind || expectedTakeKind)
    ? NONLEXICAL_ASR_MERGE_GRACE_MS
    : LEXICAL_ASR_MERGE_GRACE_MS;
}

function resolveLexicalRetryLine(session, evidence = {}) {
  const voiceState = session?.voiceState || {};
  const progression = voiceState.practiceProgression;
  const expectedUnit = progression?.expectedUnit === 'phrase' ? 'phrase' : 'sentence';
  const sentence = normalizeText(
    (expectedUnit === 'phrase' ? progression?.bridgeText : progression?.returnText)
      || resolveActiveVoicePhrase(voiceState),
    240,
  );
  const heardVoice = evidence.acoustic === 'usable'
    || evidence.acoustic === 'voiced_unscorable';
  const opening = heardVoice
    ? 'I heard your voice, but I missed the words.'
    : "I didn't catch that take.";
  return sentence
    ? `${opening} Say the ${expectedUnit} again: "${sentence}"`
    : `${opening} Say the ${expectedUnit} again.`;
}

function resolveWordlessPracticeAcknowledgement(session, takeOutcome = null, turnTrigger = null) {
  const voiceState = session?.voiceState;
  if (!voiceState) return null;
  const repContext = resolveActiveDrillRepContext(voiceState);
  const drillId = repContext?.drill?.id || repContext?.drillId || voiceState.lessonId || null;
  // The kind for THIS turn. `takeOutcome.takeKind` is the kind the analyzer was
  // actually TOLD to record, so preferring it is what keeps the one-resolver
  // invariant intact (the trainer must never file a take as a siren while the
  // spoken line acknowledges a hum) — and it is also how the engine's one-shot
  // prescription reaches this line for free: it was consumed at dispatch, well
  // before the take landed, so re-reading session state here would miss it.
  const kind = normalizeTakeKindToken(takeOutcome?.takeKind)
    || resolveTakeKind(repContext, voiceState.practiceMode).kind;
  // Metrics-aware only when this turn's analyzer take genuinely landed WITH
  // metrics. A take that timed out, errored, or came back empty falls straight
  // back to the heard-only lines — the line must never claim a reading that
  // does not exist.
  const analyzed = takeOutcome?.outcome === 'analyzed' && takeOutcome?.hasMetrics === true;

  // Is this kind a wordless one at all? Vocalise per the safety gate's own
  // definition, widened to the two other wordless kinds the drill pack ships
  // (resonance_play, trill) — both are equally speechless to an ASR.
  const wordlessKind = isWordlessPracticeKind(kind);
  // ...and WHO said so. A kind the learner's own selected drill declares is its
  // own warrant: they chose a hum drill, so a no-speech turn on it is wordless
  // practice by construction, measured or not. A kind the ENGINE merely
  // PRESCRIBED is a different thing — nobody has confirmed the learner acted on
  // it — so it may not, by itself, license a spoken claim about what was heard.
  const prescribed = takeOutcome?.takeKindSource === 'engine-recommendation';

  // The turn's first-class trigger, resolved once for both bases below.
  const trigger = turnTrigger || resolveVoiceTurnTrigger({ transcript: '', takeOutcome });

  // OWNER RULING 2026-07-27 ("close the gap") — RESOLVED, with the earlier
  // decision PRESERVED rather than overridden. The distinction is the whole
  // point, so do not collapse it:
  //
  //   TOO QUIET TO MEASURE  != NO SOUND AT ALL.
  //
  // The prior decision — a learner who CHOSE a hum drill and made a sound too
  // faint to score should still be ANSWERED, not met with silence — is
  // correct, and blanket suppression would reintroduce the exact "the tutor
  // stops responding" failure this whole repair line exists to end. So a take
  // that merely falls under the evidence bar (lowVoicedEvidence: some voicing,
  // just not enough to score) STILL earns the heard-only line. The committed
  // test 'an UNMEASURABLE take never earns the "heard and measured" line'
  // stands untouched — that test is about the ANALYZED line, not this one.
  //
  // What was a fabrication is narrower: the analyzer proving there was NO SIGNAL
  // AT ALL while the coach says "Heard the hum". Only the ANALYZER may confirm a
  // sound — but equally, only real silence may withhold the answer.
  //
  // *** `no_voiced_frames` IS NOT SILENCE. Do not gate on it alone. ***
  // It means "no frame cleared the VOICING DETECTOR", not "no sound arrived".
  // audio_analysis.py:2173 requires pitch_strength >= 0.45 AND energy_confidence
  // >= 0.05 (rms >= ~0.012, about -38.4 dBFS) before a frame counts as voiced;
  // audio_analysis.py:2748 then sets the flag whenever voiced_frame_pct <= 0.
  // MEASURED on a clean 200 Hz hum: -37.8 dBFS -> voicedPct 1.0, no flag;
  // -38.6 dBFS -> voicedPct 0.0 and a flag list BYTE-IDENTICAL to digital
  // silence. A 0.8 dB drop, and a perfectly real hum looks exactly like nothing.
  // Gating on the flag alone therefore silenced quiet hums in the field — the
  // precise failure this ruling exists to prevent. That shipped; this is the
  // repair.
  //
  // THE SEPARATING EVIDENCE IS LOUDNESS, and the threshold is the DSP's own:
  // audio_analysis.py:2893 uses -90.0 dB as `peak_loudness_db`'s default when
  // there are NO FRAMES AT ALL — the analyzer's own "nothing here" value.
  // MEASURED: real quiet hum -38.64 dB; digital silence -100.0; an all-zero
  // buffer -180.0. So `<= -90` catches true silence with ~51 dB of margin below
  // the quietest real hum observed, and the number is borrowed, not invented.
  // If loudness is ABSENT we do NOT suppress: an unreported field is not proof.
  //
  // Flags come through resolveVoiceMeasurementUsability (imported :146) because
  // they are nested — readAdvancedMetrics (voice-measurement-validity.js:38-47)
  // resolves `metrics.advanced` then `advanced` then the object itself. An
  // earlier version read `summary.reliabilityFlags` directly, a path that does
  // not exist on VoiceAttemptSummary, so the guard was inert while its own test
  // passed on a fixture written to the same wrong assumption.
  const analyzerProvedSilence = didAnalyzerProveSilence(takeOutcome);
  //
  // BASIS 1 — the learner's own drill says this is wordless practice.
  // Their own drill choice is the warrant, EXCEPT where the analyzer has
  // positively proven there was nothing to hear (see the ruling above).
  if (wordlessKind && !prescribed && !analyzerProvedSilence) {
    return {
      takeKind: kind,
      drillId,
      analyzed,
      ackBasis: 'drill_kind',
      line: analyzed
        ? pickWordlessAnalyzedLine(takeOutcome.attemptArtifactId || kind)
        : (WORDLESS_PRACTICE_LINES[kind] || WORDLESS_PRACTICE_LINES.hum_sovt),
    };
  }

  // BASIS 2 — the drill state did not declare this (it says 'phrase', or the
  // kind came only from the engine's prescription), but the learner VOICED
  // something anyway (2026-07-26 field repair). This is the case that produced
  // "the tutor stops responding": the tutor prescribed an "mhmm" in speech,
  // coach_gates stayed take_kind 'phrase' / source 'default' all session, and
  // three real hums each fell into the plain silent re-arm because the
  // acknowledgment was gated on drill kind alone.
  //
  // The gate here is EVIDENCE, not state: this turn's analyzer take must have
  // been analyzed AND carry positive proof of phonation. A genuinely silent
  // no-speech turn fails hasVoicedPracticeEvidence (the analyzer reports
  // no_voiced_frames) and keeps today's behavior exactly — silent re-arm plus
  // the frontend's own counter and calm-noise hint. This is also what stops a
  // prescription from manufacturing a "Heard the hum" out of silence: the
  // engine can propose a kind, but only the analyzer can confirm a sound.
  //
  // 2026-07-27: this basis now READS the turn's first-class trigger instead of
  // re-deriving it. Same predicate, same thresholds, same answer — but the
  // decision "was this a turn at all?" is made once, by name, above, so the
  // acknowledgment can never disagree with the branch that routed the turn to
  // it. (The fallback derivation keeps every existing caller working.)
  if (trigger.trigger !== VOICE_TURN_TRIGGERS.VOICED_EVIDENCE) return null;
  return {
    takeKind: kind,
    drillId,
    analyzed,
    ackBasis: 'voiced_evidence',
    // A prescribed vocalise kind DOES name the sound once the analyzer has
    // confirmed there was one, so the kind-named line is honest here. With no
    // wordless kind at all, the line names no technique — the state does not
    // know which one was practised, and inventing it would be the one
    // fabrication this basis exists to avoid.
    line: wordlessKind
      ? (analyzed
        ? pickWordlessAnalyzedLine(takeOutcome.attemptArtifactId || kind)
        : (WORDLESS_PRACTICE_LINES[kind] || WORDLESS_PRACTICE_LINES.hum_sovt))
      : voicedPracticeLineWithSentence(takeOutcome.attemptArtifactId || kind, voiceState),
  };
}

function normalizeReadinessProbeStatus(value) {
  return ['online', 'degraded', 'offline'].includes(value) ? value : 'online';
}

async function runReadinessProbe(id, label, fn) {
  const startedAt = Date.now();
  try {
    const result = await fn();
    return {
      id,
      label,
      status: normalizeReadinessProbeStatus(result?.status),
      detail: normalizeText(result?.detail, 1000) || 'Probe completed.',
      durationMs: Date.now() - startedAt,
      ...(result?.metadata && isRecord(result.metadata) ? { metadata: result.metadata } : {}),
    };
  } catch (error) {
    return {
      id,
      label,
      status: 'offline',
      detail: error.message || String(error),
      durationMs: Date.now() - startedAt,
    };
  }
}

function copyProxyHeaders(headers = {}) {
  const output = {};
  const connectionTokens = String(headers.connection || '')
    .split(',')
    .map((value) => value.trim().toLowerCase())
    .filter(Boolean);
  for (const [key, value] of Object.entries(headers)) {
    const normalizedKey = key.toLowerCase();
    if (connectionTokens.includes(normalizedKey)
      || ['connection', 'host', 'keep-alive', 'proxy-authenticate', 'proxy-authorization', 'te', 'trailer', 'transfer-encoding', 'upgrade'].includes(normalizedKey)) {
      continue;
    }
    output[key] = value;
  }
  return output;
}

function proxyHttpRequest(req, res, targetUrl, options = {}) {
  const target = new URL(targetUrl);
  const client = target.protocol === 'https:'
    ? (options.httpsClient || https)
    : (options.httpClient || http);
  const hasParsedBody = Object.prototype.hasOwnProperty.call(req, 'body') && req.body !== undefined;
  const body = hasParsedBody ? Buffer.from(JSON.stringify(req.body)) : null;
  const headers = {
    ...copyProxyHeaders(req.headers || {}),
    ...(options.headers || {}),
    host: target.host,
  };
  if (body) {
    delete headers['content-encoding'];
    headers['content-type'] = 'application/json';
    headers['content-length'] = String(body.length);
    delete headers['transfer-encoding'];
  }
  const timeoutMs = Number.isFinite(Number(options.timeoutMs))
    ? Math.max(1, Number(options.timeoutMs))
    : 30000;
  let settled = false;
  let upstreamResponse = null;
  let upstreamEnded = false;
  let destroyed = false;
  function destroyUpstream() {
    if (destroyed) return;
    destroyed = true;
    upstreamResponse?.destroy?.();
    upstreamRequest.destroy?.();
  }
  function cleanup() {
    req.removeListener?.('aborted', onDownstreamClosed);
    res.removeListener?.('close', onDownstreamClosed);
    res.removeListener?.('finish', finish);
    upstreamRequest.removeListener?.('error', onRequestError);
    upstreamResponse?.removeListener?.('end', onUpstreamEnd);
    upstreamResponse?.removeListener?.('aborted', onUpstreamAborted);
    upstreamResponse?.removeListener?.('close', onUpstreamClose);
    upstreamResponse?.removeListener?.('error', onResponseError);
    upstreamRequest.setTimeout?.(0);
  }
  function finish() {
    if (settled) return;
    settled = true;
    cleanup();
  }
  function cancelPiping() {
    req.unpipe?.(upstreamRequest);
    upstreamResponse?.unpipe?.(res);
  }
  function failProxy() {
    if (settled) return;
    settled = true;
    cleanup();
    cancelPiping();
    destroyUpstream();
    if (!res.headersSent && !res.writableEnded) res.status(502).json({ success: false, error: 'VoiceTrainer proxy failed.' });
    else if (!res.writableEnded) res.end();
  }
  function onDownstreamClosed() {
    if (settled || res.writableEnded) return;
    settled = true;
    cleanup();
    destroyUpstream();
  }
  function onRequestError() { failProxy(); }
  function onResponseError() { failProxy(); }
  function destroyDownstream() {
    cancelPiping();
    if (!req.destroyed) req.destroy?.();
    if (!res.destroyed && !res.writableEnded) res.destroy?.();
  }
  function onUpstreamEnd() {
    upstreamEnded = true;
    finish();
  }
  function onUpstreamAborted() {
    if (settled) return;
    settled = true;
    cleanup();
    destroyUpstream();
    destroyDownstream();
  }
  function onUpstreamClose() {
    if (!upstreamEnded) onUpstreamAborted();
  }
  const upstreamRequest = client.request({
    protocol: target.protocol,
    hostname: target.hostname,
    port: target.port || (target.protocol === 'https:' ? 443 : 80),
    method: req.method,
    path: `${target.pathname}${target.search}`,
    headers,
  }, (response) => {
    if (settled) { response.destroy?.(); return; }
    upstreamResponse = response;
    res.statusCode = response.statusCode || 502;
    for (const [key, value] of Object.entries(copyProxyHeaders(response.headers || {}))) {
      if (value !== undefined) {
        res.setHeader(key, value);
      }
    }
    response.once('end', onUpstreamEnd);
    response.once('aborted', onUpstreamAborted);
    response.once('close', onUpstreamClose);
    response.once('error', onResponseError);
    response.pipe(res);
  });
  req.once?.('aborted', onDownstreamClosed);
  res.once?.('close', onDownstreamClosed);
  res.once?.('finish', finish);
  upstreamRequest.once('error', onRequestError);
  upstreamRequest.setTimeout?.(timeoutMs, () => {
    if (settled) return;
    settled = true;
    cleanup();
    destroyUpstream();
    if (!res.headersSent && !res.writableEnded) res.status(504).json({ success: false, error: 'VoiceTrainer proxy timed out.' });
    else if (!res.writableEnded) res.end();
  });

  if (body) {
    upstreamRequest.end(body);
  } else if (req.readable && !req.readableEnded) {
    req.pipe(upstreamRequest);
  } else {
    upstreamRequest.end();
  }
}

function createId(prefix) {
  if (typeof crypto.randomUUID === 'function') {
    return `${prefix}-${crypto.randomUUID()}`;
  }
  return `${prefix}-${Date.now().toString(36)}-${Math.random().toString(16).slice(2)}`;
}

function appendVoiceCoachThreadMessage(voiceState, role, content, kind = 'note') {
  const text = normalizeText(content, 2000);
  if (!text) {
    return Array.isArray(voiceState?.coachThread) ? voiceState.coachThread : [];
  }
  const currentThread = Array.isArray(voiceState?.coachThread) ? voiceState.coachThread : [];
  return [
    ...currentThread,
    {
      id: createId('voice-msg'),
      role: role === 'user' ? 'user' : 'coach',
      channel: kind.startsWith('runtime-') ? 'runtime' : 'coach',
      kind,
      content: text,
      createdAt: Date.now(),
    },
  ].slice(-40);
}

function resolveReferenceAudioUrl(voiceTrainerUrl, clipId) {
  return `${voiceTrainerUrl}/api/v1/voice/reference/${encodeURIComponent(clipId)}/audio`;
}

function resolveAttemptAudioUrl(voiceTrainerUrl, attemptId) {
  return `${voiceTrainerUrl}/api/v1/voice/attempts/${encodeURIComponent(attemptId)}/audio`;
}

// V1.5 time-lapse mirror: DSP milestone endpoints (list/audio/delete proxied;
// pin is POST-with-body so it goes via callVoiceTrainer, not the stream proxy).
function resolveMilestonesUrl(voiceTrainerUrl) {
  return `${voiceTrainerUrl}/api/v1/voice/milestones`;
}

function resolveMilestoneAudioUrl(voiceTrainerUrl, milestoneId) {
  return `${voiceTrainerUrl}/api/v1/voice/milestones/${encodeURIComponent(milestoneId)}/audio`;
}

function resolveMilestoneUrl(voiceTrainerUrl, milestoneId) {
  return `${voiceTrainerUrl}/api/v1/voice/milestones/${encodeURIComponent(milestoneId)}`;
}

function createStandaloneLine(session, drill = null, action = 'ensure') {
  const voiceState = session.voiceState || {};
  const targetPreset = voiceState.targetPreset || drill?.targetPreset || 'cute-feminine';
  const displayText = normalizeText(
    drill?.phrase
      || voiceState.activeLine?.displayText
      || voiceState.forecastPhrase
      || 'yeah, no worries, i can do that',
    220,
  );
  const cueSheet = buildVoiceCueSheet({
    phrase: displayText,
    targetPreset,
    teachingFocus: drill?.tags || drill?.focus ? [drill.focus, ...(drill.tags || [])].filter(Boolean) : [],
  });
  return {
    id: createId(`voice-line-${action}`),
    displayText,
    // 2026-07-27 (round 4): the per-lane neutral/feminine SPLIT that used to
    // live here is REMOVED. It was kept last round on the claim that it serves
    // live `androgynous`/`gender-neutral` learners; that justification was
    // wrong, because the branch is unreachable. Measured, not assumed:
    //   - all 60 drills across the 7 live packs carry a non-empty `description`,
    //     so `drill?.description` always short-circuits;
    //   - both call sites pass a pack drill — :6586 is guarded by `drill ?`, and
    //     :6627 indexes a pack that is never empty;
    //   - no test asserted either fallback string, and instrumenting the branch
    //     across the whole backend suite showed it never firing.
    // What remains is a single direction-BLIND fallback, kept only for shape
    // safety so this field degrades like its `intent`/`difficulty` neighbours
    // rather than becoming undefined. It states no lane, so it cannot push any
    // learner — feminizing or neutral — in a direction they did not choose.
    performanceText: drill?.description
      || `Say "${displayText}" in your own comfortable, steady delivery.`,
    intent: drill?.focus || 'Conversation practice',
    difficulty: action === 'harder' ? 'hard' : action === 'easier' ? 'easy' : 'medium',
    targetPreset,
    teachingFocus: Array.from(new Set([drill?.focus, ...(drill?.tags || [])].filter(Boolean))).slice(0, 6),
    source: drill?.id ? 'selected-drill' : 'standalone-fallback',
    referenceMode: voiceState.referenceClipId ? 'reference-supported' : null,
    cueSheet,
    pinned: action === 'pin-toggle' ? !voiceState.activeLine?.pinned : Boolean(voiceState.activeLine?.pinned),
  };
}

function createStandaloneRuntimeModelEntry(config) {
  return {
    id: config.voiceTutorGgufModel,
    name: 'Voice Tutor Gemma 4 GGUF',
    provider: 'voice-tutor-gguf',
    vendor: 'local',
    source: 'voice-standalone',
    context: 120000,
    contextDetails: {
      maxContextWindowTokens: 120000,
      maxPromptTokens: 118000,
      maxOutputTokens: 1024,
    },
    billing: {
      includedOnPaid: true,
      usageRateLabel: 'self-hosted',
    },
    supportsReasoningEffort: false,
    supportsToolCalls: false,
    selectable: true,
    available: true,
    pickerEnabled: true,
    visibleInCatalog: true,
    pickerSurfaceSupport: {
      primary: { enabled: true, disabledReason: null },
      toolLoop: { enabled: false, disabledReason: 'Voice Tutor standalone runtime is realtime-coach only.' },
      critic: { enabled: false, disabledReason: 'Voice Tutor standalone runtime is realtime-coach only.' },
    },
  };
}

function cloneJsonValue(value) {
  return JSON.parse(JSON.stringify(value));
}

const DURABLE_SESSION_FORBIDDEN_KEYS = new Set([
  'coachthread',
  'conversationhistory',
  'lastcoachmessage',
  'lastusermessage',
  'messages',
  'transcript',
  'transcriptpreview',
  'lasttranscript',
  'lastpartialtranscript',
  'partialtranscript',
  'transcriptsource',
  'audiobase64',
  'audiobuffer',
  'audiobytes',
  'pcmbytes',
  'rawaudio',
]);

function scrubDurableSessionValue(value) {
  if (Array.isArray(value)) {
    return value.map(scrubDurableSessionValue);
  }
  if (!isRecord(value)) {
    return value;
  }
  const output = {};
  for (const [key, child] of Object.entries(value)) {
    const normalizedKey = key.toLowerCase().replace(/[^a-z0-9]/g, '');
    if (
      DURABLE_SESSION_FORBIDDEN_KEYS.has(normalizedKey)
      || normalizedKey.includes('transcript')
    ) {
      continue;
    }
    output[key] = scrubDurableSessionValue(child);
  }
  return output;
}

function normalizePersistedSessionRecord(value) {
  if (!isRecord(value)) {
    return null;
  }
  const id = normalizeText(value.id, 160);
  if (!id) {
    return null;
  }
  const sanitized = scrubDurableSessionValue({
    ...value,
    id,
  });
  delete sanitized.mainTask;
  delete sanitized.notepad;
  delete sanitized.summary;
  delete sanitized.deeptutorVoiceState;
  return cloneJsonValue(sanitized);
}

function createVoiceStandaloneSessionStore(options = {}) {
  const storePath = normalizeText(options.storePath, 2000)
    ? path.resolve(options.storePath)
    : null;
  const fsImpl = options.fsImpl || fs;
  const logger = options.logger === false ? null : (options.logger || console);
  const schemaVersion = 'voice-standalone-sessions-v2';
  const compatibleSchemaVersions = new Set([schemaVersion, 'voice-standalone-sessions-v1']);
  const maxSessions = Number.isInteger(options.maxSessions) && options.maxSessions >= 0
    ? options.maxSessions
    : 250;
  const retentionDays = Number.isInteger(options.retentionDays) && options.retentionDays >= 0
    ? options.retentionDays
    : 0;
  const now = typeof options.now === 'function' ? options.now : () => Date.now();
  let writeBlockedReason = null;
  const storeHealth = {
    status: 'healthy',
    lastSuccessAt: null,
    lastError: null,
    lastQuarantinePath: null,
    recoveries: 0,
    failures: 0,
  };

  function getWriteBlockKind() {
    if (!writeBlockedReason) return null;
    if (writeBlockedReason.startsWith(
      'Session store is corrupt and no valid previous generation is available:',
    )) {
      return 'unrecoverable-corruption';
    }
    if (writeBlockedReason.startsWith('Unsupported Voice Tutor session store schema:')) {
      return 'unsupported-schema';
    }
    return 'unknown';
  }

  function extractSessionRecords(payload) {
    if (Array.isArray(payload)) {
      return payload;
    }
    if (payload?.schemaVersion && !compatibleSchemaVersions.has(payload.schemaVersion)) {
      writeBlockedReason = `Unsupported Voice Tutor session store schema: ${payload.schemaVersion}`;
      storeHealth.status = 'failed';
      storeHealth.lastError = writeBlockedReason;
      logger?.warn?.(`[VoiceStandalone] ${writeBlockedReason}`);
      return [];
    }
    if (Array.isArray(payload?.sessions)) {
      return payload.sessions;
    }
    if (isRecord(payload?.sessions)) {
      return Object.values(payload.sessions);
    }
    return [];
  }

  function getSessionRecordTimestamp(record) {
    const updatedAt = Number(record?.updatedAt);
    if (Number.isFinite(updatedAt) && updatedAt > 0) {
      return Math.round(updatedAt);
    }
    const createdAt = Number(record?.createdAt);
    return Number.isFinite(createdAt) && createdAt > 0 ? Math.round(createdAt) : 0;
  }

  function pruneSessionRecords(records) {
    const validRecords = records
      .map((session) => normalizePersistedSessionRecord(session))
      .filter(Boolean);
    const before = validRecords.length;
    const cutoff = retentionDays > 0
      ? now() - (retentionDays * 24 * 60 * 60 * 1000)
      : null;
    const retentionFiltered = cutoff
      ? validRecords.filter((session) => getSessionRecordTimestamp(session) >= cutoff)
      : validRecords;
    const sortedByRecency = retentionFiltered
      .slice()
      .sort((left, right) => getSessionRecordTimestamp(right) - getSessionRecordTimestamp(left));
    const bounded = maxSessions > 0 ? sortedByRecency.slice(0, maxSessions) : sortedByRecency;
    const sortedForStorage = bounded
      .slice()
      .sort((left, right) => String(left.createdAt || '').localeCompare(String(right.createdAt || '')));
    return {
      records: sortedForStorage,
      pruned: before - bounded.length,
      before,
      maxSessions,
      retentionDays,
    };
  }

  function buildSessionMap(records) {
    const sessions = new Map();
    for (const session of records) {
      sessions.set(session.id, session);
    }
    return sessions;
  }

  function loadSessions() {
    const sessions = new Map();
    if (!storePath) {
      return sessions;
    }
    let parsed = null;
    const backupPath = `${storePath}.bak`;
    try {
      const parentPath = path.dirname(storePath);
      fsImpl.mkdirSync(parentPath, { recursive: true, mode: 0o700 });
      fsImpl.chmodSync?.(parentPath, 0o700);
      fsImpl.chmodSync?.(storePath, 0o600);
      parsed = JSON.parse(fsImpl.readFileSync(storePath, 'utf8'));
    } catch (error) {
      if (error.code === 'ENOENT') return sessions;
      storeHealth.failures += 1;
      storeHealth.status = 'failed';
      storeHealth.lastError = `session store corruption: ${error.message}`;
      const quarantinePath = `${storePath}.corrupt.${now()}`;
      try {
        fsImpl.renameSync?.(storePath, quarantinePath);
        storeHealth.lastQuarantinePath = quarantinePath;
      } catch {
        // The write block below is the safety boundary if quarantine is unavailable.
      }
      try {
        parsed = JSON.parse(fsImpl.readFileSync(backupPath, 'utf8'));
        if (!isRecord(parsed) && !Array.isArray(parsed)) throw new Error('backup root is invalid');
        fsImpl.writeFileSync(storePath, `${JSON.stringify(parsed, null, 2)}\n`, { encoding: 'utf8', mode: 0o600 });
        fsImpl.chmodSync?.(storePath, 0o600);
        storeHealth.status = 'recovered';
        storeHealth.recoveries += 1;
        storeHealth.lastSuccessAt = now();
        storeHealth.lastError = null;
        writeBlockedReason = null;
        logger?.warn?.('[VoiceStandalone] Recovered the session store from its previous valid generation.');
      } catch (backupError) {
        writeBlockedReason = `Session store is corrupt and no valid previous generation is available: ${backupError.message}`;
        storeHealth.lastError = writeBlockedReason;
        logger?.warn?.(`[VoiceStandalone] ${writeBlockedReason}`);
        return sessions;
      }
    }
    const pruned = pruneSessionRecords(extractSessionRecords(parsed));
    for (const [sessionId, session] of buildSessionMap(pruned.records).entries()) {
      sessions.set(sessionId, session);
    }
    if (pruned.pruned > 0 && options.pruneOnLoad !== false && !writeBlockedReason) {
      saveSessions(sessions);
    }
    storeHealth.lastSuccessAt = now();
    return sessions;
  }

  function saveSessions(sessions) {
    if (!storePath) {
      return { saved: false, count: 0 };
    }
    if (writeBlockedReason && options.allowOverwriteUnsupportedSchema !== true) {
      logger?.warn?.(`[VoiceStandalone] Session store write blocked: ${writeBlockedReason}`);
      return { saved: false, blocked: true, reason: writeBlockedReason, count: 0 };
    }
    const pruned = pruneSessionRecords(Array.from(sessions?.values?.() || []));
    const payload = {
      schemaVersion,
      updatedAt: Date.now(),
      maxSessions,
      retentionDays,
      sessions: pruned.records,
    };
    const parentPath = path.dirname(storePath);
    fsImpl.mkdirSync(parentPath, { recursive: true, mode: 0o700 });
    fsImpl.chmodSync?.(parentPath, 0o700);
    const tempPath = `${storePath}.${process.pid}.${Date.now()}.tmp`;
    try {
      if (fsImpl.existsSync?.(storePath)) {
        const currentRaw = fsImpl.readFileSync(storePath, 'utf8');
        const current = JSON.parse(currentRaw);
        if (!isRecord(current) && !Array.isArray(current)) {
          throw new Error('Existing session store root is invalid.');
        }
        const backupTempPath = `${storePath}.bak.${process.pid}.${Date.now()}.tmp`;
        try {
          fsImpl.writeFileSync(backupTempPath, currentRaw, { encoding: 'utf8', mode: 0o600 });
          fsImpl.chmodSync?.(backupTempPath, 0o600);
          fsImpl.renameSync(backupTempPath, `${storePath}.bak`);
          fsImpl.chmodSync?.(`${storePath}.bak`, 0o600);
        } catch (backupError) {
          try { fsImpl.unlinkSync?.(backupTempPath); } catch { /* best-effort cleanup */ }
          throw backupError;
        }
      }
      fsImpl.writeFileSync(tempPath, `${JSON.stringify(payload, null, 2)}\n`, { encoding: 'utf8', mode: 0o600 });
      fsImpl.chmodSync?.(tempPath, 0o600);
      fsImpl.renameSync(tempPath, storePath);
      fsImpl.chmodSync?.(storePath, 0o600);
      storeHealth.status = storeHealth.recoveries > 0 ? 'recovered' : 'healthy';
      storeHealth.lastSuccessAt = now();
      storeHealth.lastError = null;
    } catch (error) {
      try { fsImpl.unlinkSync?.(tempPath); } catch { /* best-effort cleanup */ }
      throw error;
    }
    return { saved: true, count: pruned.records.length, pruned: pruned.pruned };
  }

  function listSessionStoreArtifacts() {
    if (!storePath || typeof fsImpl.readdirSync !== 'function') return [];
    const parentPath = path.dirname(storePath);
    const baseName = path.basename(storePath);
    let names = [];
    try {
      names = fsImpl.readdirSync(parentPath);
    } catch (error) {
      if (error?.code === 'ENOENT') return [];
      throw error;
    }
    const escapedBaseName = baseName.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    const artifactPattern = new RegExp(
      `^${escapedBaseName}(?:$|\\.bak$|\\.corrupt\\.\\d+$|(?:\\.bak)?\\.\\d+\\.\\d+\\.tmp$)`,
    );
    return names
      .filter((name) => artifactPattern.test(name))
      .map((name) => path.join(parentPath, name));
  }

  function inspectArtifactPayload(payload) {
    if (Array.isArray(payload)) {
      return { known: true, records: payload };
    }
    if (!isRecord(payload)) {
      return { known: false, records: [] };
    }
    if (Array.isArray(payload.sessions)) {
      return { known: true, records: payload.sessions };
    }
    if (isRecord(payload.sessions)) {
      return { known: true, records: Object.values(payload.sessions) };
    }
    return { known: false, records: [] };
  }

  function writeScrubbedArtifact(artifactPath, records) {
    const payload = {
      schemaVersion,
      updatedAt: Date.now(),
      maxSessions,
      retentionDays,
      sessions: records.map((record) => cloneJsonValue(record)),
    };
    const tempPath = `${artifactPath}.${process.pid}.${Date.now()}.delete.tmp`;
    try {
      fsImpl.writeFileSync(
        tempPath,
        `${JSON.stringify(payload, null, 2)}\n`,
        { encoding: 'utf8', mode: 0o600 },
      );
      fsImpl.chmodSync?.(tempPath, 0o600);
      fsImpl.renameSync(tempPath, artifactPath);
      fsImpl.chmodSync?.(artifactPath, 0o600);
    } catch (error) {
      try { fsImpl.unlinkSync?.(tempPath); } catch { /* best-effort cleanup */ }
      throw error;
    }
  }

  /**
   * Scrub the learner from every recoverable session-store generation.
   *
   * `.corrupt.*` and interrupted-write artifacts are deliberately included:
   * Delete All must cover files that the normal primary/backup writer never
   * touches. Unreadable generations are removed because they cannot be proved
   * unrelated to the learner.
   */
  function scrubLearnerArtifacts(studentId, scrubOptions = {}) {
    const normalizedStudentId = normalizeText(studentId, 160);
    if (!normalizedStudentId || !storePath) {
      return {
        success: Boolean(normalizedStudentId),
        inspectedArtifacts: 0,
        rewrittenArtifacts: 0,
        removedUnreadableArtifacts: 0,
        removedRecords: 0,
        remainingTargetRecords: 0,
      };
    }
    const writeBlockKind = getWriteBlockKind();
    if (writeBlockKind && writeBlockKind !== 'unrecoverable-corruption') {
      throw new Error('A write-blocked session schema cannot be safely scrubbed.');
    }
    const fallbackStudentId = normalizeText(scrubOptions.defaultStudentId, 160);
    let inspectedArtifacts = 0;
    let rewrittenArtifacts = 0;
    let removedUnreadableArtifacts = 0;
    let removedRecords = 0;

    for (const artifactPath of listSessionStoreArtifacts()) {
      inspectedArtifacts += 1;
      let payload;
      try {
        payload = JSON.parse(fsImpl.readFileSync(artifactPath, 'utf8'));
      } catch {
        fsImpl.unlinkSync(artifactPath);
        removedUnreadableArtifacts += 1;
        continue;
      }
      const inspected = inspectArtifactPayload(payload);
      if (!inspected.known) {
        fsImpl.unlinkSync(artifactPath);
        removedUnreadableArtifacts += 1;
        continue;
      }
      const kept = inspected.records.filter((record) => {
        const recordStudentId = normalizeText(record?.studentId, 160) || fallbackStudentId;
        return recordStudentId !== normalizedStudentId;
      });
      const removed = inspected.records.length - kept.length;
      if (removed > 0) {
        writeScrubbedArtifact(artifactPath, kept);
        rewrittenArtifacts += 1;
        removedRecords += removed;
      }
    }

    let remainingTargetRecords = 0;
    for (const artifactPath of listSessionStoreArtifacts()) {
      let payload;
      try {
        payload = JSON.parse(fsImpl.readFileSync(artifactPath, 'utf8'));
      } catch {
        throw new Error('A session-store generation remained unreadable after learner deletion.');
      }
      const inspected = inspectArtifactPayload(payload);
      if (!inspected.known) {
        throw new Error('An unverifiable session-store generation remained after learner deletion.');
      }
      remainingTargetRecords += inspected.records.filter((record) => {
        const recordStudentId = normalizeText(record?.studentId, 160) || fallbackStudentId;
        return recordStudentId === normalizedStudentId;
      }).length;
    }
    if (remainingTargetRecords > 0) {
      throw new Error('Session-store learner deletion verification failed.');
    }
    return {
      success: true,
      inspectedArtifacts,
      rewrittenArtifacts,
      removedUnreadableArtifacts,
      removedRecords,
      remainingTargetRecords,
    };
  }

  /**
   * Re-enable writes only after Delete All has independently proved that every
   * owned generation is readable and contains no record for this learner.
   *
   * This recovery is deliberately limited to unrecoverable JSON corruption.
   * An unsupported schema remains blocked because silently overwriting it could
   * destroy records that this runtime does not understand.
   */
  function recoverWritesAfterVerifiedLearnerScrub(studentId, scrubOptions = {}) {
    const normalizedStudentId = normalizeText(studentId, 160);
    if (!normalizedStudentId || !storePath) {
      throw new Error('A learner and session-store path are required for recovery.');
    }
    if (!writeBlockedReason) {
      return {
        recovered: false,
        blocked: false,
        inspectedArtifacts: 0,
        remainingTargetRecords: 0,
      };
    }
    if (getWriteBlockKind() !== 'unrecoverable-corruption') {
      return {
        recovered: false,
        blocked: true,
        reason: writeBlockedReason,
        inspectedArtifacts: 0,
        remainingTargetRecords: null,
      };
    }

    const fallbackStudentId = normalizeText(scrubOptions.defaultStudentId, 160);
    let inspectedArtifacts = 0;
    let remainingTargetRecords = 0;
    for (const artifactPath of listSessionStoreArtifacts()) {
      inspectedArtifacts += 1;
      let payload;
      try {
        payload = JSON.parse(fsImpl.readFileSync(artifactPath, 'utf8'));
      } catch {
        throw new Error('A session-store generation became unreadable during deletion recovery.');
      }
      const inspected = inspectArtifactPayload(payload);
      if (!inspected.known) {
        throw new Error('An unverifiable session-store generation remained during deletion recovery.');
      }
      remainingTargetRecords += inspected.records.filter((record) => {
        const recordStudentId = normalizeText(record?.studentId, 160) || fallbackStudentId;
        return recordStudentId === normalizedStudentId;
      }).length;
    }
    if (remainingTargetRecords > 0) {
      throw new Error('The learner remained in a session-store generation during deletion recovery.');
    }

    writeBlockedReason = null;
    storeHealth.status = 'recovered';
    storeHealth.lastError = null;
    storeHealth.lastSuccessAt = now();
    storeHealth.recoveries += 1;
    return {
      recovered: true,
      blocked: false,
      inspectedArtifacts,
      remainingTargetRecords,
    };
  }

  function pruneSessions(sessions) {
    const pruned = pruneSessionRecords(Array.from(sessions?.values?.() || []));
    const keptIds = new Set(pruned.records.map((session) => session.id));
    for (const sessionId of Array.from(sessions?.keys?.() || [])) {
      if (!keptIds.has(sessionId)) {
        sessions.delete(sessionId);
      }
    }
    const saveResult = saveSessions(sessions);
    return {
      ...pruned,
      saved: saveResult.saved,
      blocked: saveResult.blocked || false,
      reason: saveResult.reason || null,
    };
  }

  function getStoreInfo() {
    return {
      schemaVersion,
      storePath,
      maxSessions,
      retentionDays,
      writeBlocked: Boolean(writeBlockedReason),
      writeBlockKind: getWriteBlockKind(),
      writeBlockedReason,
      health: { ...storeHealth },
    };
  }

  return {
    getStoreInfo,
    loadSessions,
    pruneSessions,
    recoverWritesAfterVerifiedLearnerScrub,
    saveSessions,
    scrubLearnerArtifacts,
    schemaVersion,
    storePath,
  };
}

function createVoiceStandaloneRuntime(options = {}) {
  const config = resolveVoiceStandaloneConfig(options);
  const fetchImpl = options.fetchImpl || global.fetch;
  const logger = options.logger === false ? null : (options.logger || console);
  const isolatedEvaluation = options.isolatedEvaluation === true;
  const exposeRawEvalPayload = isolatedEvaluation && options.evalExposeRaw === true;
  const captureEvalText = isolatedEvaluation && options.evalCaptureText === true;
  let debugBus = options.debugBus || null;
  function pushRuntimeWitness(level, category, message, metadata = {}) {
    try {
      debugBus?.push?.(level, category, message, metadata);
    } catch {
      // Telemetry must never affect a voice turn or target transition.
    }
    // Successful live-input witnesses used to exist only in the in-memory debug
    // ring, so a service restart erased the evidence needed to explain a slow
    // spoken turn. Persist only fixed, content-free stage/timing fields to the
    // service journal; never audio, transcript, learner text, or identifiers.
    //
    // 2026-07-27: warn/error live-input lines reach the journal too. They used
    // to exist ONLY in the in-memory ring + the persistent sink, so the journal
    // — the surface the owner actually reads — showed a turn ending at
    // `asr-completed` and simply stopping, with the failure invisible. A turn
    // that dies must say so where the death is being looked for.
    if (category === 'voice-input-live' && (level === 'info' || level === 'warn' || level === 'error')) {
      logger?.log?.({
        event: 'voice_input_live_stage',
        level,
        stage: typeof metadata.outcome === 'string' ? metadata.outcome : null,
        boundary: typeof metadata.boundary === 'string' ? metadata.boundary : null,
        // Failure fields — present only on a failing line, so a healthy run
        // still emits exactly the stage/timing shape it always did.
        ...(metadata.error_class ? {
          error_class: metadata.error_class,
          error_name: metadata.error_name || null,
          error_status: Number.isFinite(metadata.error_status) ? metadata.error_status : null,
          error_message: metadata.error_message || null,
          discarded: metadata.discarded === true,
          segment_id: metadata.segment_id || null,
        } : {}),
        open_to_first_pcm_ms: Number.isFinite(metadata.open_to_first_pcm_ms)
          ? metadata.open_to_first_pcm_ms : null,
        open_to_speech_ms: Number.isFinite(metadata.open_to_speech_ms)
          ? metadata.open_to_speech_ms : null,
        open_to_asr_ms: Number.isFinite(metadata.open_to_asr_ms)
          ? metadata.open_to_asr_ms : null,
        speech_to_asr_ms: Number.isFinite(metadata.speech_to_asr_ms)
          ? metadata.speech_to_asr_ms : null,
        asr_ms: Number.isFinite(metadata.asr_ms) ? metadata.asr_ms : null,
        open_to_final_ms: Number.isFinite(metadata.open_to_final_ms)
          ? metadata.open_to_final_ms : null,
        silence_ms: Number.isFinite(metadata.silence_ms) ? metadata.silence_ms : null,
        voiced_ms: Number.isFinite(metadata.voiced_ms) ? metadata.voiced_ms : null,
        // Segment trim (Defect 2): how much of the listening window was silence.
        audio_ms_raw: Number.isFinite(metadata.audio_ms_raw) ? metadata.audio_ms_raw : null,
        audio_ms_trimmed: Number.isFinite(metadata.audio_ms_trimmed)
          ? metadata.audio_ms_trimmed : null,
        // Mid-turn speech buffering (Defect 1): only present on the seed line.
        buffered_frames: Number.isFinite(metadata.buffered_frames) ? metadata.buffered_frames : null,
        buffered_ms: Number.isFinite(metadata.buffered_ms) ? metadata.buffered_ms : null,
        dropped_overflow: Number.isFinite(metadata.dropped_overflow)
          ? metadata.dropped_overflow : null,
        min_speech_ms: Number.isFinite(metadata.min_speech_ms) ? metadata.min_speech_ms : null,
        rms_threshold: Number.isFinite(metadata.rms_threshold) ? metadata.rms_threshold : null,
        first_pcm_timeout_ms: Number.isFinite(metadata.first_pcm_timeout_ms)
          ? metadata.first_pcm_timeout_ms : null,
      });
    }
  }
  const sessions = options.sessions || new Map();
  const tasks = options.tasks || new Map();
  const listeningTurns = new Map();
  const listeningTurnResults = new Map();

  function cloneListeningTurnValue(value) {
    if (value == null) return value;
    if (typeof structuredClone === 'function') return structuredClone(value);
    return JSON.parse(JSON.stringify(value));
  }

  function pruneListeningTurns(now = Date.now()) {
    for (const [id, packet] of listeningTurns.entries()) {
      if (!packet || packet.expiresAt <= now) {
        if (packet?.expiryTimer) clearTimeout(packet.expiryTimer);
        listeningTurns.delete(id);
      }
    }
    for (const [id, result] of listeningTurnResults.entries()) {
      if (!result || result.expiresAt <= now) {
        if (result?.expiryTimer) clearTimeout(result.expiryTimer);
        listeningTurnResults.delete(id);
      }
    }
  }

  function registerListeningTurn(session, {
    transcript,
    confidence = null,
    evidence = null,
    takeKind = null,
    capturedAt = Date.now(),
  } = {}) {
    const words = normalizeText(transcript, 1200);
    if (!words) return null;
    const createdAt = Date.now();
    pruneListeningTurns(createdAt);
    const id = createId('listening-turn');
    const voiceState = cloneListeningTurnValue(session.voiceState || {});
    voiceState.voiceInputRuntime = {
      ...(voiceState.voiceInputRuntime || {}),
      lastTurnEvidence: cloneListeningTurnValue(evidence),
    };
    const packet = {
      id,
      sessionId: session.id,
      transcript: words,
      confidence: Number.isFinite(Number(confidence)) ? Number(confidence) : null,
      evidence: cloneListeningTurnValue(evidence),
      takeKind: normalizeTakeKindToken(takeKind) || null,
      capturedAt: Number.isFinite(Number(capturedAt)) ? Math.round(Number(capturedAt)) : createdAt,
      createdAt,
      expiresAt: createdAt + LISTENING_TURN_TTL_MS,
      voiceState,
      expiryTimer: null,
    };
    packet.expiryTimer = setTimeout(() => {
      if (listeningTurns.get(id) === packet) listeningTurns.delete(id);
    }, LISTENING_TURN_TTL_MS);
    packet.expiryTimer.unref?.();
    listeningTurns.set(id, packet);
    return id;
  }

  function consumeListeningTurn(session, listeningTurnId) {
    const id = normalizeText(listeningTurnId, 200);
    if (!id) return null;
    const now = Date.now();
    pruneListeningTurns(now);
    const packet = listeningTurns.get(id);
    if (!packet) {
      throw createHttpError(409, 'Listening turn already used or expired.');
    }
    if (packet.sessionId !== session.id) {
      throw createHttpError(409, 'Listening turn belongs to a different session.');
    }
    if (packet.expiryTimer) clearTimeout(packet.expiryTimer);
    listeningTurns.delete(id);
    return packet;
  }

  function restoreListeningTurn(packet) {
    if (!packet || packet.expiresAt <= Date.now()) return;
    const remainingMs = Math.max(1, packet.expiresAt - Date.now());
    packet.expiryTimer = setTimeout(() => {
      if (listeningTurns.get(packet.id) === packet) listeningTurns.delete(packet.id);
    }, remainingMs);
    packet.expiryTimer.unref?.();
    listeningTurns.set(packet.id, packet);
  }

  function processListeningTurnCoach(session, listeningTurnId, generate) {
    const id = normalizeText(listeningTurnId, 200);
    pruneListeningTurns();
    const existing = listeningTurnResults.get(id);
    if (existing) {
      if (existing.sessionId !== session.id) {
        throw createHttpError(409, 'Listening turn belongs to a different session.');
      }
      return existing.promise;
    }
    const packet = consumeListeningTurn(session, id);
    const entry = {
      sessionId: session.id,
      expiresAt: packet.expiresAt,
      promise: null,
      expiryTimer: null,
    };
    entry.expiryTimer = setTimeout(() => {
      if (listeningTurnResults.get(id) === entry) listeningTurnResults.delete(id);
    }, Math.max(1, packet.expiresAt - Date.now()));
    entry.expiryTimer.unref?.();
    entry.promise = Promise.resolve()
      .then(() => generate(packet))
      .catch((error) => {
        if (listeningTurnResults.get(id) === entry) {
          if (entry.expiryTimer) clearTimeout(entry.expiryTimer);
          listeningTurnResults.delete(id);
          restoreListeningTurn(packet);
        }
        throw error;
      });
    listeningTurnResults.set(id, entry);
    return entry.promise;
  }

  function resolveListeningTurnVoiceState(session, listeningTurn = null) {
    if (!listeningTurn?.voiceState) {
      return voiceStateRuntime.normalizeVoiceState(session.voiceState);
    }
    const captured = voiceStateRuntime.normalizeVoiceState(
      cloneListeningTurnValue(listeningTurn.voiceState),
    );
    // A failed/absent analyzer lane must not inherit an older usable take merely
    // because the session's "latest" fields are sticky.
    return listeningTurn.evidence?.acoustic === 'usable'
      ? captured
      : withTakeEvidenceAbsent(captured);
  }
  // Per-session practice-card state (the lesson "strip of words"). In-memory like
  // LessonState; cards are authored by the tutor (card_ops) or the deterministic
  // fallback. See lessons/practice-cards.js + coaching/card-ops.js.
  const practiceCards = options.practiceCards || new PracticeCardStore();
  const learnerContextService = options.learnerContextService || createLearnerContextService({
    storageRoot: config.learnerContextRoot,
  });
  const voiceInputAsrBridge = options.voiceInputAsrBridge || new VoiceInputAsrBridge({
    enabled: config.voiceAsrEnabled,
    baseUrl: config.voiceAsrUrl,
    apiStyle: config.voiceAsrApiStyle,
    language: config.voiceAsrLanguage,
    timeoutMs: config.voiceAsrTimeoutMs,
    liveMode: config.voiceAsrLiveMode,
    fetchImpl,
  });
  const voiceTurnDetector = options.voiceTurnDetector || createVoiceTurnDetector({
    enabled: config.smartTurnEnabled,
    pythonPath: config.smartTurnPythonPath,
    workerPath: config.smartTurnWorkerPath,
    modelPath: config.smartTurnModelPath,
    timeoutMs: config.smartTurnTimeoutMs,
    onWitness: pushRuntimeWitness,
  });
  let voiceInputLiveService = options.voiceInputLiveService || null;
  // V1.5 strain guardian: one accumulator per voice session (keyed by sessionId),
  // fed at take-finalize. In-memory like the card store; never persisted.
  const strainGuardians = options.strainGuardians || new Map();
  // V1.5 time-lapse mirror: per-session pin-suggestion + best-take tracking so a
  // pinSuggestion is offered at most ONCE per session and only for the session's
  // best take. Keyed by sessionId: { suggested: bool, bestHeldRatio, bestConfidence }.
  const sessionMirrorState = options.sessionMirrorState || new Map();
  // V1.5 time-lapse mirror: tiny per-student cache of the most-recent milestone
  // pin time, refreshed by the milestones proxy (list/pin), so the pin-suggestion
  // 7-day gate doesn't issue a blocking network call on every take.
  const recentMilestoneCache = options.recentMilestoneCache || new Map();
  // v4 tutor-memory: per-session focus-axis tally (keyed by sessionId) so the
  // sessions-ring entry written at session end can record the DOMINANT focus axis.
  // In-memory like the guardian/mirror state; never persisted. Each coach turn
  // increments the bucket for that turn's coachingDecision focus axis.
  const sessionFocusCounts = options.sessionFocusCounts || new Map();
  function recordSessionFocus(sessionId, signal) {
    try {
      const key = String(sessionId || '');
      if (!key) return;
      const focus = signal?.coachingDecision?.primaryFocus;
      const axis = focusToAxis(focus);
      if (!axis) return;
      let counts = sessionFocusCounts.get(key);
      if (!counts) {
        counts = {};
        sessionFocusCounts.set(key, counts);
      }
      counts[axis] = (counts[axis] || 0) + 1;
    } catch {
      // fail-soft: focus accounting must never affect a coach turn
    }
  }
  // Dominant axis for a session = the most-tallied axis (ties broken by the
  // FOCUS_AXES declaration order for determinism). Returns null when no axis was
  // ever recorded for the session.
  function dominantSessionFocus(sessionId) {
    const counts = sessionFocusCounts.get(String(sessionId || ''));
    if (!counts) return null;
    let best = null;
    let bestN = 0;
    for (const axis of SESSION_FOCUS_AXES) {
      const n = counts[axis] || 0;
      if (n > bestN) {
        bestN = n;
        best = axis;
      }
    }
    return bestN > 0 ? best : null;
  }
  // v4 tutor-memory (gap 2): build + persist the sessions-ring entry for a session
  // that's ending, and set voice.lastSessionAt. Active minutes + take count come
  // from the strain guardian's per-session accumulator (the same source the
  // strainWatch field uses); the dominant focus axis comes from the per-session
  // tally. oneLine is the deterministic 'N takes on <axis>'. Best-effort: every
  // step is guarded so session end never fails on a memory write.
  //
  // B-SESS flow-session upgrade: the entry now also carries
  //   sessionId  — dedupe key (the service keeps ONE ring entry per session),
  //   at         — ms epoch of this end signal,
  //   endReason  — 'completed' (clean close) | 'learner-stopped' (explicit,
  //                resumable End) | 'cut-short' (pagehide / staleness sweep),
  //   tier       — the session's sessionScope tier at close time.
  // Idempotence is two-layered: (1) a cheap in-place skip — when nothing changed
  // since the last ring write for this session AND the reason is the same, the
  // write is skipped entirely (repeated pagehide beacons / 5-min sweep passes
  // don't churn the profile); (2) the service's sessionId dedupe — a re-write
  // REPLACES the session's entry (cut-short can upgrade to completed with fresh
  // stats; completed never downgrades). Returns true when an entry was written.
  function writeSessionRingEntry(session, endedAt, options = {}) {
    try {
      const endReason = ['completed', 'learner-stopped', 'cut-short'].includes(options.endReason)
        ? options.endReason
        : 'completed';
      const studentId = session?.studentId || config.defaultStudentId;
      const sessionId = String(session?.id || '');
      const at = Number(endedAt) || Date.now();
      const lastLogged = isRecord(session?.ringLogged) ? session.ringLogged : null;
      const endReasonRank = {
        'cut-short': 1,
        'learner-stopped': 2,
        completed: 3,
      };
      if (
        lastLogged
        && Number(lastLogged.at) >= (Number(session?.updatedAt) || 0)
        && (
          lastLogged.endReason === endReason
          || (endReasonRank[lastLogged.endReason] || 0) > (endReasonRank[endReason] || 0)
        )
      ) {
        // Already recorded at this authority (or higher) since the session's
        // last activity. A fresh Start/take advances updatedAt and permits the
        // next truthful segment boundary.
        return false;
      }
      const startedAt = Number(session?.createdAt) || at;
      const guardian = strainGuardians.get(sessionId) || null;
      const watch = guardian && typeof guardian.strainWatch === 'function' ? guardian.strainWatch() : null;
      const takes = watch && Number.isFinite(Number(watch.takeCount)) ? Math.max(0, Math.round(watch.takeCount)) : 0;
      // Prefer the guardian's active minutes; fall back to wall-clock since start.
      const minutes = watch && Number.isFinite(Number(watch.sessionMinutes))
        ? Math.max(0, Number(watch.sessionMinutes))
        : Math.max(0, (at - startedAt) / 60000);
      const focusAxis = dominantSessionFocus(sessionId);
      // Deterministic one-line summary: 'N takes on <axis>'. No axis -> 'N takes'.
      const takeWord = takes === 1 ? 'take' : 'takes';
      const oneLine = focusAxis ? `${takes} ${takeWord} on ${focusAxis}` : `${takes} ${takeWord}`;

      if (typeof learnerContextService.addSession === 'function') {
        learnerContextService.addSession(studentId, {
          sessionId,
          startedAt,
          endedAt: at,
          minutes: Number(minutes.toFixed(2)),
          takes,
          focusAxis,
          oneLine,
          endReason,
          tier: normalizeSessionScope(session?.sessionScope).tier,
        });
      }
      if (endReason === 'completed') {
        // The session is truly over — drop its in-memory focus tally so a future
        // session reusing the same id starts clean. A cut-short write keeps the
        // tally: the session stays resumable and a later clean close should still
        // know its dominant focus.
        sessionFocusCounts.delete(sessionId);
      }
      if (session) {
        session.ringLogged = { endReason, at };
        if (options.persist !== false) {
          persistSessionsSafely();
        }
      }
      return true;
    } catch (error) {
      logger?.warn?.(`[Voice] session-ring write failed: ${error?.message || error}`);
      return false;
    }
  }

  function purgeWorkingConversationState(session) {
    if (!session) return;
    const scrubbedVoiceState = scrubDurableSessionValue(session.voiceState || {});
    session.voiceState = voiceStateRuntime.normalizeVoiceState({
      ...scrubbedVoiceState,
      coachThread: [],
      lastCoachMessage: null,
      lastCoachGeneratedAt: null,
      voiceInputRuntime: {
        ...(isRecord(scrubbedVoiceState.voiceInputRuntime)
          ? scrubbedVoiceState.voiceInputRuntime
          : {}),
        status: 'idle',
        lastPartialTranscript: null,
        lastPartialTranscriptAt: null,
        lastTranscript: null,
        transcriptSource: null,
      },
    });
    session.deeptutorVoiceState = normalizeDeepTutorVoiceState(null);
  }

  // ── B-SESS staleness sweep (server-internal plumbing, never user-facing) ──
  // Ring-writes sessions that look interrupted: not ended, lesson still live
  // (active/practice), and no activity for SESSION_STALE_CUTOFF_MS. Runs once at
  // runtime init (catches sessions restored from disk after a crash/shutdown)
  // and piggybacks on the existing 5-minute telemetry-eviction interval — no new
  // user-visible surface. Idempotent via ringLogged: a session already recorded
  // since its last activity is skipped, so the periodic pass doesn't churn.
  function isLessonActive(session) {
    const status = session?.lessonState?.status;
    return status === 'active' || status === 'practice';
  }

  function sweepStaleCutShortSessions(nowMs = Date.now()) {
    let swept = 0;
    try {
      for (const session of sessions.values()) {
        if (!session || session.voiceState?.status === 'ended') continue;
        if (!isLessonActive(session)) continue;
        const updatedAt = Number(session.updatedAt) || 0;
        if (nowMs - updatedAt < SESSION_STALE_CUTOFF_MS) continue;
        const lastLogged = isRecord(session.ringLogged) ? session.ringLogged : null;
        if (lastLogged && Number(lastLogged.at) >= updatedAt) continue;
        if (writeSessionRingEntry(session, nowMs, { endReason: 'cut-short', persist: false })) {
          swept += 1;
        }
      }
      if (swept > 0) {
        persistSessionsSafely();
        logger?.log?.({ event: 'session_sweep_cut_short', count: swept });
      }
    } catch (error) {
      logger?.warn?.(`[Voice] session sweep failed: ${error?.message || error}`);
    }
    return swept;
  }
  function resolveStrainGuardian(session) {
    const key = String(session?.id || '');
    let guardian = strainGuardians.get(key);
    if (!guardian) {
      guardian = createStrainGuardian({
        sessionStartedAt: session?.createdAt || Date.now(),
      });
      strainGuardians.set(key, guardian);
    }
    return guardian;
  }
  const sessionPersistenceDisabled = options.disableSessionPersistence
    || (options.sessions && !options.sessionStore && !options.sessionStorePath);
  const sessionStore = sessionPersistenceDisabled
    ? null
    : (options.sessionStore || createVoiceStandaloneSessionStore({
        storePath: config.sessionStorePath,
        maxSessions: config.sessionStoreMaxSessions,
        retentionDays: config.sessionStoreRetentionDays,
        logger,
      }));
  const voiceStateRuntime = createVoiceSessionStateRuntime({
    appendVoiceCoachThreadMessage,
    buildVoiceCueSheet,
    buildVoiceStudentModelEvaluations,
    getCachedDefaultModelId: () => config.voiceTutorGgufModel,
    getRenderableVoicePhraseComparison,
    getVoiceDrillById,
    normalizeDeepTutorVoiceState,
    normalizeDifficultyPreference,
    normalizeRequestedModel: (value) => normalizeText(value, 160),
    normalizeVoiceCoachInputConfidence: (value) => (
      // null/undefined = "no measurement" -> stay null. Number(null)===0 is finite,
      // so without this guard an unset lastTranscriptConfidence became a real 0,
      // which collectAnalyzerSafetyReasons flagged as low-confidence capture
      // (0% < 0.4) -> capture_only -> breather on every no-audio turn.
      value === null || value === undefined || !Number.isFinite(Number(value))
        ? null
        : Math.max(0, Math.min(1, Number(value)))
    ),
    normalizeVoiceCoachInputProvider: (value) => (value === 'backend' ? 'backend' : 'browser'),
    resolveActiveVoicePhrase,
    resolveValidatedSessionModel: async () => ({
      model: config.voiceTutorGgufModel,
      modelConfig: {
        provider: 'voice-tutor-gguf',
        baseUrl: config.voiceTutorGgufBaseUrl,
      },
    }),
  });

  function callVoiceTrainer(endpoint, requestOptions = {}) {
    return fetchJson(`${config.voiceTrainerUrl}${endpoint}`, {
      fetchImpl,
      apiKey: config.voiceTrainerAuthToken,
      ...requestOptions,
    });
  }

  function normalizeSessionId(value) {
    return normalizeText(value, 160);
  }

  function normalizeSessionTimestamp(value, fallback = Date.now()) {
    const numeric = Number(value);
    return Number.isFinite(numeric) && numeric > 0 ? Math.round(numeric) : fallback;
  }

  function normalizeStoredStandaloneSession(value, fallbackId = '') {
    if (!isRecord(value)) {
      return null;
    }
    const sessionId = normalizeSessionId(value.id) || normalizeSessionId(fallbackId);
    if (!sessionId) {
      return null;
    }
    const createdAt = normalizeSessionTimestamp(value.createdAt);
    const voiceState = voiceStateRuntime.normalizeVoiceState(value.voiceState);
    const restoredVoiceState = {
      ...voiceState,
      status: voiceState.status === 'ended' ? 'ended' : 'idle',
      voiceSessionId: null,
      streamUrl: null,
      serviceStatus: 'unknown',
      // 2026-07-26 phase C: an isolation loop NEVER survives a restart. The loop
      // state is persisted with the session, but the fragment card that gives it
      // meaning lives only in the in-memory PracticeCardStore — so a restored loop
      // would resume mid-teardown with the whole sentence on screen and the coach
      // drilling words the learner cannot see. That is exactly the half-performed
      // isolation the entry guard refuses to create; refusing to RESTORE one is the
      // same rule applied to the same failure. The next confidently-weak take opens
      // a fresh loop, with its card.
      sectionLoop: null,
      sectionLoopLastTakeKey: null,
    };
    const session = {
      ...value,
      id: sessionId,
      agentId: normalizeText(value.agentId, 120) || 'voice-tutor-standalone',
      studentId: normalizeText(value.studentId, 160) || config.defaultStudentId,
      createdAt,
      updatedAt: normalizeSessionTimestamp(value.updatedAt, createdAt),
      mode: 'voice',
      model: normalizeText(value.model, 200) || config.voiceTutorGgufModel,
      voiceState: restoredVoiceState,
      deeptutorVoiceState: normalizeDeepTutorVoiceState(value.deeptutorVoiceState),
      // B-SESS: session shape survives restarts (defaults full / not eyes-free).
      sessionScope: normalizeSessionScope(value.sessionScope),
      mainTask: normalizeText(value.mainTask, 2000) || null,
      notepad: isRecord(value.notepad) ? value.notepad : createDefaultNotepadState(),
      summary: isRecord(value.summary) ? value.summary : null,
      // Live microphone authority is process-local. A restored session can be
      // resumed, but it must earn a fresh Start lease before accepting PCM.
      coachLiveInputState: 'stopped',
      coachLiveInputGeneration: Math.max(0, Math.round(Number(value.coachLiveInputGeneration) || 0)),
      coachLiveInputLeaseId: null,
    };
    ensureSessionNotepad(session);
    return session;
  }

  function persistSessionsSafely(options = {}) {
    if (!sessionStore) {
      return { saved: false, disabled: true };
    }
    try {
      const result = sessionStore.saveSessions(sessions);
      if (options.required === true && result?.saved !== true) {
        throw new Error(result?.reason || 'Session store did not confirm a write.');
      }
      return result;
    } catch (error) {
      logger?.warn?.(`[VoiceStandalone] Failed to persist session store: ${error.message}`);
      if (options.required === true) {
        throw createHttpError(503, 'Session memory could not be saved safely.');
      }
      return { saved: false, error: error.message };
    }
  }

  function touchSession(session, options = {}) {
    if (!session) {
      return null;
    }
    session.updatedAt = Date.now();
    persistSessionsSafely({ required: options.required === true });
    return session;
  }

  function loadPersistedSessions() {
    if (options.sessions) {
      for (const [sessionId, session] of Array.from(sessions.entries())) {
        const normalized = normalizeStoredStandaloneSession(session, sessionId);
        if (normalized) {
          sessions.set(normalized.id, normalized);
        } else {
          sessions.delete(sessionId);
        }
      }
      return;
    }
    const persistedSessions = sessionStore?.loadSessions?.() || new Map();
    for (const [sessionId, session] of persistedSessions.entries()) {
      const normalized = normalizeStoredStandaloneSession(session, sessionId);
      if (normalized) {
        sessions.set(normalized.id, normalized);
      }
    }
  }

  function buildStandaloneSessionSummary(session) {
    const voiceState = voiceStateRuntime.normalizeVoiceState(session?.voiceState);
    return {
      id: session.id,
      sessionId: session.id,
      agentId: session.agentId || 'voice-tutor-standalone',
      studentId: session.studentId || config.defaultStudentId,
      createdAt: session.createdAt || null,
      updatedAt: session.updatedAt || null,
      status: voiceState.status || 'idle',
      targetPreset: voiceState.targetPreset || 'cute-feminine',
      targetSource: voiceState.targetSource || 'built-in',
      lessonId: voiceState.lessonId || null,
      referenceClipId: voiceState.referenceClipId || null,
      referenceClipName: voiceState.referenceClipName || null,
      hasActiveVoiceTrainerSession: Boolean(voiceState.voiceSessionId),
      hasNotepad: Boolean(session.notepad?.content),
      hasSummary: Boolean(session.summary || voiceState.lastSummary),
      lastCoachMessage: normalizeText(voiceState.lastCoachMessage, 240) || null,
      lastCoachGeneratedAt: voiceState.lastCoachGeneratedAt || null,
      endedAt: voiceState.endedAt || null,
    };
  }

  function listStandaloneSessions(query = {}) {
    const limit = Number.isFinite(Number(query.limit))
      ? Math.max(1, Math.min(200, Math.round(Number(query.limit))))
      : 50;
    const studentId = normalizeText(query.studentId, 160);
    const summaries = Array.from(sessions.values())
      .map(buildStandaloneSessionSummary)
      .filter((summary) => !studentId || summary.studentId === studentId)
      .sort((left, right) => Number(right.updatedAt || 0) - Number(left.updatedAt || 0))
      .slice(0, limit);
    return {
      success: true,
      source: 'voice-standalone',
      count: summaries.length,
      sessionStore: sessionStore?.getStoreInfo?.() || null,
      sessions: summaries,
    };
  }

  function exportStandaloneSession(sessionId) {
    const session = requireSession(sessionId);
    return {
      success: true,
      source: 'voice-standalone',
      exportedAt: Date.now(),
      summary: buildStandaloneSessionSummary(session),
      session: normalizePersistedSessionRecord(session),
    };
  }

  function clearPerSessionRuntimeState(sessionId) {
    const normalizedSessionId = normalizeSessionId(sessionId);
    if (!normalizedSessionId) return;
    try { practiceCards.clear(normalizedSessionId); } catch { /* best-effort */ }
    strainGuardians.delete(normalizedSessionId);
    sessionMirrorState.delete(normalizedSessionId);
    sessionFocusCounts.delete(normalizedSessionId);
    evalTurnCounters.delete(normalizedSessionId);
    sessionTelemetryHistory.delete(normalizedSessionId);
    for (const [taskId, task] of tasks.entries()) {
      if (task?.sessionId === normalizedSessionId) tasks.delete(taskId);
    }
    for (const [turnId, telemetry] of turnTelemetryStore.entries()) {
      if (telemetry?.sessionId !== normalizedSessionId) continue;
      turnTelemetryStore.delete(turnId);
      turnTelemetryCorrelationStore.delete(deriveTelemetryCorrelationId(turnId));
      turnTelemetryTimestamps.delete(turnId);
    }
  }

  function deleteStandaloneSession(sessionId) {
    const normalizedSessionId = normalizeSessionId(sessionId);
    if (!normalizedSessionId) {
      throw createHttpError(400, 'sessionId is required and must be a string');
    }
    const session = sessions.get(normalizedSessionId) || null;
    if (session) {
      stopLiveInputSession(session, 'session-deleted');
      abortTtsStreamsForSession(normalizedSessionId, 'session-deleted');
    }
    const deleted = sessions.delete(normalizedSessionId);
    let checkpointCleared = false;
    if (deleted) {
      clearPerSessionRuntimeState(normalizedSessionId);
      const studentId = session?.studentId || config.defaultStudentId;
      const checkpoint = readCoachCheckpoint(studentId);
      if (
        checkpoint?.sessionId === normalizedSessionId
        && typeof learnerContextService.updateCoachCheckpoint === 'function'
      ) {
        try {
          learnerContextService.updateCoachCheckpoint(
            studentId,
            null,
            { reason: 'session-deleted' },
          );
          checkpointCleared = true;
        } catch {
          pushRuntimeWitness('warn', 'coach-continuity', 'Deleted session checkpoint could not be cleared.', {
            outcome: 'checkpoint_clear_failed',
          });
        }
      }
      persistSessionsSafely();
    }
    return {
      success: true,
      source: 'voice-standalone',
      deleted,
      checkpointCleared,
      sessionId: normalizedSessionId,
    };
  }

  function pruneStandaloneSessions() {
    const result = sessionStore?.pruneSessions?.(sessions) || {
      before: sessions.size,
      pruned: 0,
      records: Array.from(sessions.values()),
      saved: false,
      blocked: false,
      reason: null,
      maxSessions: 0,
      retentionDays: 0,
    };
    return {
      success: true,
      source: 'voice-standalone',
      count: sessions.size,
      pruned: result.pruned || 0,
      saved: Boolean(result.saved),
      blocked: Boolean(result.blocked),
      reason: result.reason || null,
      sessionStore: sessionStore?.getStoreInfo?.() || null,
    };
  }

  function createSession(input = {}) {
    // 2026-07-27 MTF-ONLY (round 5) — THE CREATE CHOKE POINT.
    //
    // Every session row in the store is born here, and the row is written
    // (sessions.set + persistSessionsSafely, below) BEFORE any analyzer call
    // that could reject the target. So this — not the analyzer — is where an
    // invalid target has to die. Enumerated callers, all covered by this one
    // check: voiceOperationRouteHandlers.startVoiceSession (via
    // getOrCreateSession), appCompatibilityRouteHandlers.startSession (POST
    // /session/start, which passes body.targetPreset straight through), and
    // recoverCoachSessionFromCheckpoint (restores voiceState from a checkpoint
    // file — out-of-band data, so it fails closed here rather than reinstating a
    // corrupt row).
    //
    // BOTH doors into the field are checked, because createSession takes the
    // preset from either `input.targetPreset` OR a whole `input.voiceState`
    // object, and buildDefaultVoiceState spreads `...overrides` with no enum
    // check of its own (voice-session-state.js).
    assertLiveBuiltInTargetPreset(normalizeText(input.targetPreset, 80));
    if (isRecord(input.voiceState)) {
      assertLiveBuiltInTargetPreset(normalizeText(input.voiceState.targetPreset, 80));
    }
    const sessionId = normalizeSessionId(input.sessionId) || createId('voice-session');
    const studentId = normalizeText(input.studentId, 160) || config.defaultStudentId;
    const session = {
      id: sessionId,
      agentId: 'voice-tutor-standalone',
      studentId,
      createdAt: Date.now(),
      updatedAt: Date.now(),
      mode: 'voice',
      model: config.voiceTutorGgufModel,
      voiceState: voiceStateRuntime.normalizeVoiceState(
        isRecord(input.voiceState)
          ? input.voiceState
          : voiceStateRuntime.buildDefaultVoiceState({
            targetPreset: normalizeText(input.targetPreset, 80) || 'cute-feminine',
          }),
      ),
      deeptutorVoiceState: normalizeDeepTutorVoiceState(null),
      lessonState: isRecord(input.lessonState) ? cloneJsonValue(input.lessonState) : null,
      // B-SESS: session shape (tier full|quiet|silent + eyesFree), defaults
      // full/false; updated via POST /voice/session/:sessionId/scope.
      sessionScope: normalizeSessionScope(input.sessionScope),
      mainTask: null,
      notepad: createDefaultNotepadState(),
      summary: null,
      coachLiveInputState: 'stopped',
      coachLiveInputGeneration: 0,
      coachLiveInputLeaseId: null,
    };
    sessions.set(sessionId, session);
    if (input.persist !== false) persistSessionsSafely();
    return session;
  }

  function getOrCreateSession(input = {}) {
    const sessionId = normalizeSessionId(input.sessionId);
    if (sessionId && sessions.has(sessionId)) {
      return sessions.get(sessionId);
    }
    return createSession(input);
  }

  function requireSession(sessionId) {
    const normalizedSessionId = normalizeSessionId(sessionId);
    if (!normalizedSessionId) {
      throw createHttpError(400, 'sessionId is required and must be a string');
    }
    const session = sessions.get(normalizedSessionId);
    if (!session) {
      throw createHttpError(404, 'Session not found');
    }
    return session;
  }

  function normalizeLiveInputLeaseId(value) {
    return normalizeText(value, 160);
  }

  function liveInputLeaseMatches(session, value) {
    const expected = normalizeLiveInputLeaseId(session?.coachLiveInputLeaseId);
    const supplied = normalizeLiveInputLeaseId(value);
    return expected ? supplied === expected : !supplied;
  }

  function beginLiveInputPreparation(session, leaseId) {
    const normalizedLeaseId = normalizeLiveInputLeaseId(leaseId);
    if (!normalizedLeaseId) {
      throw createHttpError(400, 'liveInputLeaseId is required to prepare live input.');
    }
    voiceInputLiveService?.closeSession?.(session.id, 'session-reprepared');
    session.coachLiveInputGeneration = Math.max(
      0,
      Math.round(Number(session.coachLiveInputGeneration) || 0),
    ) + 1;
    session.coachLiveInputState = 'starting';
    session.coachLiveInputLeaseId = normalizedLeaseId;
    // Start is the learner's explicit retry boundary. Transient capture/ASR
    // streaks belong to the previous run and must not immediately re-trigger
    // legacy hands-free recovery after the new microphone socket opens.
    session.voiceState = voiceStateRuntime.updateSessionVoiceState(session, {
      voiceInputRuntime: {
        ...(session.voiceState?.voiceInputRuntime || {}),
        status: 'idle',
        lastOutcome: 'idle',
        consecutiveErrorTurns: 0,
        consecutiveNoSpeechTurns: 0,
        lastError: null,
        lastTranscript: null,
        lastTranscriptConfidence: null,
        lastPartialTranscript: null,
        lastPartialTranscriptAt: null,
      },
    });
  }

  function activateLiveInputSession(session, leaseId) {
    const normalizedLeaseId = normalizeLiveInputLeaseId(leaseId);
    if (session.coachLiveInputState === 'starting') {
      if (!liveInputLeaseMatches(session, normalizedLeaseId)) {
        throw createHttpError(409, 'The live input start lease is no longer current.');
      }
    } else {
      // Compatibility callers may still activate a session without the
      // two-phase phone lease. They receive a fresh generation and may only
      // open a lease-less socket while that generation remains active.
      voiceInputLiveService?.closeSession?.(session.id, 'session-reactivated');
      session.coachLiveInputGeneration = Math.max(
        0,
        Math.round(Number(session.coachLiveInputGeneration) || 0),
      ) + 1;
      session.coachLiveInputLeaseId = normalizedLeaseId || null;
    }
    session.coachLiveInputState = 'active';
  }

  function stopLiveInputSession(session, reason = 'session-stopped') {
    session.coachLiveInputState = 'stopped';
    session.coachLiveInputGeneration = Math.max(
      0,
      Math.round(Number(session.coachLiveInputGeneration) || 0),
    ) + 1;
    session.coachLiveInputLeaseId = null;
    return voiceInputLiveService?.closeSession?.(session.id, reason) || 0;
  }

  function buildRuntimeTargetBinding(voiceStateInput) {
    const voiceState = voiceStateRuntime.normalizeVoiceState(voiceStateInput);
    const targetProfile = isRecord(voiceState.targetVoiceProfile) ? voiceState.targetVoiceProfile : {};
    const contract = resolveMetricContract(voiceState, {
      targetPreset: voiceState.targetPreset,
      analysisVersion: targetProfile.analysisVersion || null,
      referenceClipId: voiceState.referenceClipId || targetProfile.clipId || null,
      target: {
        source: voiceState.targetSource,
        targetPreset: voiceState.targetPreset,
        targetProfileId: targetProfile.profileId || null,
        direction: targetProfile.direction || targetDirectionFromPreset(voiceState.targetPreset),
        pitchFloorHz: targetProfile.pitchFloorHz,
        pitchCeilingHz: targetProfile.pitchCeilingHz,
        resonanceFloor: targetProfile.resonanceFloor,
        resonanceCeiling: targetProfile.resonanceCeiling,
        weightFloor: targetProfile.weightFloor,
        weightCeiling: targetProfile.weightCeiling,
      },
      metrics: { advanced: { measurementAvailable: true } },
    });
    if (!contract.target?.targetKey) return null;
    const binding = {
      presetId: normalizeText(voiceState.selectedCustomPresetId, 160) || null,
      presetName: normalizeText(voiceState.selectedCustomPresetName || voiceState.referenceClipName, 160) || null,
      referenceClipId: normalizeText(voiceState.referenceClipId || targetProfile.clipId, 160) || null,
      targetPreset: contract.target.targetPreset,
      targetSource: contract.target.source,
      targetKey: contract.target.targetKey,
      targetProfileId: contract.target.targetProfileId || null,
      analysisVersion: contract.target.analysisVersion || null,
      direction: contract.target.direction || null,
      pitchFloorHz: contract.target.pitchFloorHz,
      pitchCeilingHz: contract.target.pitchCeilingHz,
      resonanceFloor: contract.target.resonanceFloor,
      resonanceCeiling: contract.target.resonanceCeiling,
      weightFloor: contract.target.weightFloor,
      weightCeiling: contract.target.weightCeiling,
      updatedAt: Date.now(),
    };
    if (
      binding.targetSource !== 'built-in'
      && !binding.presetId
    ) {
      return null;
    }
    if (
      binding.targetSource.includes('reference')
      && !binding.referenceClipId
    ) {
      return null;
    }
    return binding;
  }

  function bindLearnerVoiceTarget(session, nextVoiceState, reason = 'target-bound') {
    const binding = buildRuntimeTargetBinding(nextVoiceState);
    if (!binding) {
      throw createHttpError(409, 'The selected voice preset could not be bound to an exact target identity.');
    }
    if (typeof learnerContextService.setActiveVoiceTarget === 'function') {
      try {
        learnerContextService.setActiveVoiceTarget(
          session?.studentId || config.defaultStudentId,
          binding,
        );
      } catch (error) {
        pushRuntimeWitness('error', 'target-binding', 'Exact target binding could not be persisted.', {
          outcome: 'binding_persist_failed',
          reason: normalizeText(reason, 80) || 'unknown',
          target_source: binding.targetSource,
        });
        throw createHttpError(503, 'The selected tutor voice could not be saved safely, so it was not activated.');
      }
    }
    pushRuntimeWitness('info', 'target-binding', 'Exact target binding verified.', {
      outcome: 'bound',
      reason: normalizeText(reason, 80) || 'unknown',
      target_source: binding.targetSource,
      preset_present: Boolean(binding.presetId),
      reference_present: Boolean(binding.referenceClipId),
    });
    return binding;
  }

  function requireExactSessionTargetBinding(session) {
    const voiceState = voiceStateRuntime.normalizeVoiceState(session?.voiceState);
    const expected = buildRuntimeTargetBinding(voiceState);
    const stored = isRecord(voiceState.targetBinding) ? voiceState.targetBinding : null;
    if (!expected || !stored) {
      throw createHttpError(
        409,
        'The selected tutor voice is not bound to an exact uploaded preset.',
      );
    }
    const identityFields = [
      'targetKey',
      'presetId',
      'referenceClipId',
      'targetSource',
      'targetPreset',
      'targetProfileId',
    ];
    const mismatch = identityFields.some((field) => (
      (normalizeText(stored[field], 200) || null)
      !== (normalizeText(expected[field], 200) || null)
    ));
    if (mismatch) {
      pushRuntimeWitness('error', 'target-binding', 'Tutor speech target binding diverged.', {
        outcome: 'binding_mismatch',
        target_source: expected.targetSource,
      });
      throw createHttpError(
        409,
        'The selected tutor voice changed unexpectedly. Start the lesson again to rebind it.',
      );
    }
    return expected;
  }

  function buildSessionSpeechTargetFingerprint(session) {
    const voiceState = voiceStateRuntime.normalizeVoiceState(session?.voiceState);
    const hasExactBinding = (
      normalizeText(voiceState.selectedCustomPresetId, 160)
      || isRecord(voiceState.targetBinding)
    );
    if (hasExactBinding) {
      const binding = requireExactSessionTargetBinding(session);
      return JSON.stringify([
        binding.targetKey || null,
        binding.presetId || null,
        binding.referenceClipId || null,
        binding.targetSource || null,
        binding.targetPreset || null,
        binding.targetProfileId || null,
        binding.analysisVersion || null,
      ]);
    }
    return JSON.stringify([
      'compatibility-reference',
      voiceState.referenceClipId || null,
      voiceState.targetSource || null,
      voiceState.targetPreset || null,
      voiceState.targetVoiceProfile?.profileId || null,
    ]);
  }

  function readCoachCheckpoint(studentId, options = {}) {
    if (typeof learnerContextService.readProfile !== 'function') return null;
    try {
      return learnerContextService.readProfile(studentId || config.defaultStudentId)?.voice?.coachCheckpoint || null;
    } catch (error) {
      pushRuntimeWitness('warn', 'coach-continuity', 'Coach checkpoint read failed.', {
        outcome: 'checkpoint_read_failed',
      });
      if (options.requiredReadable === true) {
        throw createHttpError(
          503,
          'Learner memory is unavailable, so the continuing tutor voice cannot be verified.',
        );
      }
      return null;
    }
  }

  function buildCoachCheckpointPatch(session, lifecyclePatch = {}) {
    const voiceState = voiceStateRuntime.normalizeVoiceState(session?.voiceState);
    const lesson = isRecord(session?.lessonState) ? session.lessonState : {};
    const activeLine = isRecord(voiceState.activeLine) ? voiceState.activeLine : {};
    const activeCueSheet = isRecord(activeLine.cueSheet) ? activeLine.cueSheet : {};
    const activeCard = practiceCards.getActiveCard?.(session.id) || null;
    const exerciseIndex = lesson.currentExerciseIndex
      ?? lesson.exerciseIndex
      ?? lesson.currentIndex
      ?? 0;
    return {
      sessionId: session.id,
      startedAt: Number(session.createdAt) || null,
      lastActivityAt: Date.now(),
      lesson: {
        status: lesson.status || voiceState.status || null,
        stage: lesson.stage || lesson.phase || null,
        focus: lesson.focus || activeCard?.focus?.axis || activeLine.teachingFocus?.[0] || null,
        lessonId: lesson.id || voiceState.lessonId || null,
        exerciseId: lesson.currentExerciseId || lesson.exerciseId || voiceState.lessonId || null,
        exerciseIndex,
      },
      practice: {
        lineId: activeLine.id || null,
        text: activeCard?.phrase || activeLine.displayText || null,
        pronunciation: activeLine.pronunciation
          || activeCueSheet.styledCueLine
          || activeCueSheet.cueLine
          || null,
        cardId: activeCard?.id || null,
      },
      preset: {
        id: voiceState.selectedCustomPresetId || null,
        name: voiceState.selectedCustomPresetName || voiceState.referenceClipName || null,
        referenceClipId: voiceState.referenceClipId || null,
        targetPreset: voiceState.targetPreset || null,
        targetSource: voiceState.targetSource || null,
        targetProfileId: voiceState.targetVoiceProfile?.profileId || voiceState.targetProfileId || null,
      },
      targetBinding: buildRuntimeTargetBinding(voiceState),
      ...lifecyclePatch,
    };
  }

  function checkpointCoachSession(
    session,
    lifecyclePatch = {},
    reason = 'checkpoint-updated',
    options = {},
  ) {
    if (!session) return null;
    if (typeof learnerContextService.updateCoachCheckpoint !== 'function') {
      if (options.required === true) {
        throw createHttpError(
          503,
          'The continuing lesson store is unavailable, so Coach was not started.',
        );
      }
      return null;
    }
    try {
      return learnerContextService.updateCoachCheckpoint(
        session.studentId || config.defaultStudentId,
        buildCoachCheckpointPatch(session, lifecyclePatch),
        { reason },
      );
    } catch (error) {
      pushRuntimeWitness('warn', 'coach-continuity', 'Coach checkpoint write failed.', {
        outcome: 'checkpoint_write_failed',
        reason: normalizeText(reason, 80) || 'unknown',
      });
      if (options.required === true) {
        throw createHttpError(
          503,
          'The continuing lesson could not be saved safely, so Coach was not started.',
        );
      }
      return null;
    }
  }

  function buildSessionMutationPayload(
    session,
    extras = {},
    voiceStatePatch = null,
    options = {},
  ) {
    if (options.persist !== false) {
      touchSession(session, { required: options.requiredPersistence === true });
    }
    return createVoiceBackendPayload({
      voiceState: isRecord(voiceStatePatch) ? voiceStatePatch : null,
    }, {
      success: true,
      sessionId: session.id,
      agentId: session.agentId,
      sessionScope: normalizeSessionScope(session.sessionScope),
      ...extras,
    });
  }

  // 2026-07-29 L2 (TTS latency): SLIM THE HOT PAYLOAD. The measured
  // /voice/session response was ~721 KB — 544 KB of it 12 full
  // attemptArtifacts (timeline + advanced metric bulk). The wire copy keeps
  // EVERY row (the Review panel's take count, per-take hit/sim rows and the
  // Listen replay read exactly this subset — verified against
  // frontend/src/voice/view-model.ts getVoiceReviewListItems and
  // lesson/controller.ts attempt-audio lookups) but drops the fields nothing
  // client-side reads. lastAttemptArtifact stays FULL-fidelity: the coach
  // views read repContext/selfReport/summary from it. Server state is
  // untouched (the coach + section scorer keep the full artifacts).
  const WIRE_ATTEMPT_METRIC_KEYS = [
    'targetHitPct',
    'similarityScore',
    'durationMs',
    'meanPitchHz',
  ];
  // Exactly the fields isVoiceAttemptMeasurementUsable reads (the frontend
  // mirror of voice-measurement-validity) — nothing more.
  const WIRE_ATTEMPT_ADVANCED_KEYS = [
    'measurementAvailable',
    'measurementRejectionReasons',
    'reliabilityFlags',
    'scoreConfidence',
    'voicedFramePct',
    'confidentFramePct',
    'captureReliability',
    'snrDb',
    'clippingPct',
    'pitchValidFrameCount',
  ];
  const WIRE_ATTEMPT_TOP_LEVEL_KEYS = [
    'attemptArtifactId',
    'attemptId',
    'clientAttemptId',
    'status',
    'reason',
    'targetPreset',
    'referenceClipId',
    'lessonId',
    'createdAt',
    'endedAt',
    'finalizedAt',
  ];

  function slimAttemptMetricsForWire(metrics) {
    if (!isRecord(metrics)) return null;
    const slim = {};
    for (const key of WIRE_ATTEMPT_METRIC_KEYS) {
      if (metrics[key] !== undefined) slim[key] = metrics[key];
    }
    if (isRecord(metrics.advanced)) {
      const advanced = {};
      for (const key of WIRE_ATTEMPT_ADVANCED_KEYS) {
        if (metrics.advanced[key] !== undefined) advanced[key] = metrics.advanced[key];
      }
      if (Object.keys(advanced).length > 0) slim.advanced = advanced;
    }
    return Object.keys(slim).length > 0 ? slim : null;
  }

  function slimAttemptArtifactForWire(artifact) {
    if (!isRecord(artifact)) return null;
    const slim = {};
    for (const key of WIRE_ATTEMPT_TOP_LEVEL_KEYS) {
      if (artifact[key] !== undefined && artifact[key] !== null) slim[key] = artifact[key];
    }
    const metrics = slimAttemptMetricsForWire(artifact.metrics);
    if (metrics) slim.metrics = metrics;
    const summaryMetrics = slimAttemptMetricsForWire(artifact.summary?.metrics);
    if (summaryMetrics) slim.summary = { metrics: summaryMetrics };
    return Object.keys(slim).length > 0 ? slim : null;
  }

  function slimVoiceStateForWire(voiceState) {
    const artifacts = Array.isArray(voiceState?.attemptArtifacts) ? voiceState.attemptArtifacts : null;
    if (!artifacts || artifacts.length === 0) return voiceState;
    const slimmed = artifacts
      .map((artifact) => slimAttemptArtifactForWire(artifact))
      .filter(Boolean);
    const beforeBytes = Buffer.byteLength(JSON.stringify(artifacts));
    const afterBytes = Buffer.byteLength(JSON.stringify(slimmed));
    logger?.log?.({
      event: 'session_payload_slimmed',
      attempt_artifacts: artifacts.length,
      bytes_before: beforeBytes,
      bytes_after: afterBytes,
    });
    return { ...voiceState, attemptArtifacts: slimmed };
  }

  async function buildSessionPayload(session, extras = {}, options = {}) {
    touchSession(session);
    const hasStudentModel = Object.prototype.hasOwnProperty.call(options, 'studentModel');
    const studentModel = hasStudentModel
      ? options.studentModel
      : await learnerContextService.getVoiceStudentModelSnapshot(
        session.studentId || config.defaultStudentId,
        typeof options.query === 'string' ? options.query : '',
      );
    return createVoiceBackendPayload({
      voiceState: slimVoiceStateForWire(session.voiceState),
      studentModel,
      learnerContext: studentModel?.learnerContext || null,
      deeptutorVoiceState: session.deeptutorVoiceState || null,
    }, {
      success: true,
      sessionId: session.id,
      agentId: session.agentId,
      // B-SESS: the session's shape rides every session payload (additive extras,
      // like fallbackReply) so the frontend can read it without a separate fetch.
      sessionScope: normalizeSessionScope(session.sessionScope),
      ...extras,
    });
  }

  loadPersistedSessions();
  // B-SESS: catch sessions that died with the process (restored from disk with a
  // live lesson + stale updatedAt) — record them as cut-short right away.
  sweepStaleCutShortSessions();

  async function buildAppSessionPayload(session, extras = {}) {
    return buildSessionPayload(session, {
      name: 'Voice Tutor',
      agentId: 'voice',
      agentName: 'Voice Tutor',
      model: config.voiceTutorGgufModel,
      studentId: session.studentId || config.defaultStudentId,
      knowledgeSelection: [],
      requiredKnowledgeIds: [],
      knowledgeDatasets: [],
      hasWebAccess: false,
      subjectContext: null,
      contextInjected: false,
      contextLength: 0,
      memoryProject: null,
      privilegeMode: 'constrained',
      reviewEnabled: false,
      subjectReview: null,
      subAgentSlots: [],
      xnaSettings: null,
      notepadPolicy: null,
      composition: null,
      composition_manifest: null,
      ...extras,
    });
  }

  // ── V1.5 take-finalize side-channels (deterministic, advisory, protective) ──
  //
  // Run AFTER recordVoiceAttempt. Produces the additive payload fields:
  //   guardian: { level }              — strain-guardian decision for this take
  //   strainWatch: { recentFlags, sessionMinutes, ... }
  //   pinSuggestion: { attemptId }|null — time-lapse mirror "keep this marker"
  //   realSentenceReadiness: {...}|null — readiness for an active real_sentence card
  // and, when the guardian speaks, inserts its template line into the coach thread
  // exactly like a coach message. Best-effort: any failure degrades to {} so the
  // take still returns its payload.
  function applyTakeFinalizeSideChannels(session, { summary, attemptArtifact, studentId }) {
    const extras = {};
    try {
      const sessionKey = String(session.id || '');
      const measurementValidity = resolveVoiceMeasurementUsability(attemptArtifact || summary);

      // 1) Strain guardian — feed this take's strain evidence; get the decision.
      const guardian = resolveStrainGuardian(session);
      const takeRepContext = attemptArtifact?.repContext
        || attemptArtifact?.summary?.repContext
        || session.voiceState?.repContext
        || session.voiceState?.lastAttemptArtifact?.repContext
        || session.voiceState?.lastAttemptArtifact?.summary?.repContext
        || null;
      const resolvedTakeKind = resolveTakeKind(
        takeRepContext,
        session.voiceState?.practiceMode,
      );
      const decision = guardian.recordTake(attemptArtifact || summary || {}, {
        qualityBands: session.voiceState?.targetVoiceProfile?.advancedBands?.quality || {},
        takeKind: resolvedTakeKind.kind,
      });
      extras.guardian = {
        level: decision.level,
        ignored: decision.ignored === true,
        takeKind: resolvedTakeKind.kind,
        takeKindSource: resolvedTakeKind.source,
        takeKindContextPresent: Boolean(takeRepContext),
        thresholds: decision.evidence?.thresholds || null,
      };
      extras.strainWatch = decision.strainWatch;
      // Mirror strainWatch onto the voiceState so the live coaching signal (built
      // on the next coach turn) can reference it naturally via signal-builder.
      session.voiceState = voiceStateRuntime.updateSessionVoiceState(session, {
        strainWatch: decision.strainWatch,
        guardianLevel: decision.level,
      });
      // When the guardian speaks, insert its line into the coach thread like a
      // coach message (deterministic template; never nags — `spoke` gates this).
      if (decision.spoke && decision.line) {
        const coachGeneratedAt = Date.now();
        const nextThread = appendVoiceCoachThreadMessage(
          session.voiceState,
          'coach',
          decision.line,
          'runtime-guardian',
        );
        session.voiceState = voiceStateRuntime.updateSessionVoiceState(session, {
          coachThread: nextThread,
          lastCoachMessage: decision.line,
          lastCoachGeneratedAt: coachGeneratedAt,
        });
        checkpointCoachSession(session, {
          state: 'active',
          lastActivityAt: coachGeneratedAt,
        }, 'coach-safety-cue-generated');
        extras.guardianMessage = decision.line;
      }

      // Rejected/degraded captures remain auditable takes, but none of the
      // downstream achievement side channels may treat them as practice
      // evidence. Guardian state is preserved above with ignored=true; best-pin
      // and real-sentence readiness are explicitly suppressed here.
      if (!measurementValidity.usableForScoring) {
        extras.pinSuggestion = null;
        extras.realSentenceReadiness = null;
        const witness = {
          outcome: 'measurement_rejected',
          reasons: measurementValidity.reasons.slice(0, 8),
          guardian_ignored: decision.ignored === true,
          pin_suppressed: true,
          readiness_suppressed: true,
        };
        logger?.log?.({ event: 'take_finalize_gate', ...witness });
        pushRuntimeWitness(
          'warn',
          'take-finalize-gate',
          'Unusable voice measurement was excluded from achievement side channels.',
          witness,
        );
        return extras;
      }

      // 2) Pin suggestion — time-lapse mirror. Offer at most once per session, and
      //    only for the session's best take (held-ratio, then confidence tiebreak)
      //    AND only when there's been no milestone in the last 7 days. The 7-day
      //    check reads the persisted milestone list lazily (best-effort).
      const attemptId = attemptArtifact?.attemptArtifactId
        || attemptArtifact?.attemptId
        || summary?.attemptId
        || null;
      const heldRatio = evaluateReadiness({
        takesToday: 1,
        take: { phraseComparison: session.voiceState?.phraseComparison, attemptArtifact, summary },
      }).heldRatio;
      const confidence = toFiniteOrNull(
        attemptArtifact?.metrics?.advanced?.scoreConfidence
          ?? summary?.metrics?.advanced?.scoreConfidence,
      );
      let mirror = sessionMirrorState.get(sessionKey);
      if (!mirror) {
        mirror = { suggested: false, bestHeldRatio: -1, bestConfidence: -1 };
        sessionMirrorState.set(sessionKey, mirror);
      }
      // Update the session's best-take watermark (held-ratio, then confidence).
      const hr = heldRatio == null ? -1 : heldRatio;
      const cf = confidence == null ? -1 : confidence;
      const isNewBest = hr > mirror.bestHeldRatio
        || (hr === mirror.bestHeldRatio && cf > mirror.bestConfidence);
      if (isNewBest) {
        mirror.bestHeldRatio = hr;
        mirror.bestConfidence = cf;
      }
      extras.pinSuggestion = null;
      if (!mirror.suggested && attemptId && isNewBest && !hasRecentMilestone(studentId)) {
        mirror.suggested = true;
        extras.pinSuggestion = { attemptId };
      }

      // 3) Real-sentence readiness — only when the active card is a real_sentence.
      //    Advisory ONLY: never gates. Sets the matching entry's status to 'ready'
      //    when >=2 takes today on it AND latest held-ratio >= 0.7.
      const activeCard = practiceCards.getActiveCard(sessionKey);
      if (activeCard && activeCard.kind === 'real_sentence') {
        const today = localDateString();
        if (!mirror.realSentenceDay || mirror.realSentenceDay !== today) {
          mirror.realSentenceDay = today;
          mirror.realSentenceTakesToday = 0;
        }
        mirror.realSentenceTakesToday = (mirror.realSentenceTakesToday || 0) + 1;
        const readiness = evaluateReadiness({
          takesToday: mirror.realSentenceTakesToday,
          take: { phraseComparison: session.voiceState?.phraseComparison, attemptArtifact, summary },
        });
        extras.realSentenceReadiness = {
          ready: readiness.ready,
          takesToday: readiness.takesToday,
          heldRatio: readiness.heldRatio,
          phrase: activeCard.phrase,
        };
        if (readiness.ready) {
          // Promote the matching today's entry to 'ready' (advisory). Match by the
          // card phrase against today's real-sentence entry.
          try {
            const state = learnerContextService.getRealSentenceState(studentId);
            const todays = state.today;
            if (todays && todays.text === activeCard.phrase && todays.status === 'picked') {
              learnerContextService.updateRealSentence(studentId, todays.id, { status: 'ready' });
            }
          } catch {
            // fail-soft: readiness promotion must never break the take
          }
        }
      }
    } catch {
      // fail-soft: the entire side-channel block is advisory
    }
    return extras;
  }

  // ─────────────────────────────────────────────────────────────────────────
  // Take landing (2026-07-26)
  //
  // ONE path stamps a finalized take onto a session. Both doors use it:
  //   - finalizeVoiceTake      — the learner's own practice take (solo transport)
  //   - the coach loop's per-turn analyzer take (below)
  // The freshness gate must not be able to tell them apart: a coach take is a
  // REAL take, so it stamps lastTakeFinalizedAt through this function rather
  // than reaching past it. Bypassing this would be exactly the substitution the
  // gate exists to catch.
  // ─────────────────────────────────────────────────────────────────────────
  function landFinalizedTake(session, {
    summary,
    attemptArtifact,
    status,
    streamUrl,
    repContext,
    checkpointReason,
  }) {
    session.summary = summary;
    session.voiceState = voiceStateRuntime.updateSessionVoiceState(session, {
      status: status || 'ready',
      streamUrl: streamUrl || session.voiceState?.streamUrl || null,
      lastSummary: summary,
      lastAttemptArtifact: attemptArtifact,
      // 2026-07-26 (Defect 3): a local receipt of WHEN this take was
      // finalized. The DSP artifact's own finalizedAt/endedAt is optional and
      // service-clock-based; this one always exists and is on OUR clock, so
      // the coach's turn-window freshness test can never be defeated by an
      // artifact that simply forgot to timestamp itself.
      lastTakeFinalizedAt: Date.now(),
      repContext,
      lastError: null,
    });
    const studentId = session.studentId || config.defaultStudentId;
    if (summary) {
      const evaluations = voiceStateRuntime.buildVoiceStudentModelEvaluations(summary, session.voiceState);
      learnerContextService.recordVoiceAttempt(studentId, {
        sessionId: session.id,
        summary,
        voiceState: session.voiceState,
        attemptArtifact,
        evaluations,
      });
    }
    checkpointCoachSession(session, {
      state: 'active',
      lastActivityAt: Date.now(),
    }, checkpointReason || 'practice-take-finalized');

    // ── V1.5 take-finalize side-channels (ALL deterministic, advisory, after
    //    the learner-context recording above). Each is best-effort and never
    //    throws out of finalize.
    return applyTakeFinalizeSideChannels(session, {
      summary,
      attemptArtifact,
      studentId,
    });
  }

  // ─────────────────────────────────────────────────────────────────────────
  // Coach take leg (2026-07-26)
  //
  // The coach surface used to have NO analyzer leg at all. Two capture seams
  // existed and never joined: the live input socket produced a trimmed 16 kHz
  // segment for the ASR, and the analyzer session sat open with nothing ever
  // reaching it. So every coach turn carried null metrics, a hum could not be
  // scored, and the take-freshness gate — correctly — treated all evidence as
  // absent.
  //
  // The product law this closes: feedback grounds only in the learner's CURRENT
  // take. So every finalized coach segment ALSO becomes an analyzer take, via
  // the trainer's one-shot endpoint, which runs the same internals a streamed
  // take runs.
  //
  // Fail-open, always. This is an ADDITIVE evidence channel on a live spoken
  // lesson; nothing about it may block, slow, or break a turn. A timeout, an
  // HTTP error, a busy analyzer, or a provenance mismatch all resolve to "no
  // take evidence this turn" — which the freshness gate already handles as its
  // normal absent case.
  // ─────────────────────────────────────────────────────────────────────────

  // Guard 1 of 3 against double-submitting one take. Keyed by analyzer session
  // id: two coach segments that somehow overlap for the same analyzer session
  // must not both contribute. (Guard 2 is source-scoping — only the live-input
  // path carries PCM into submitVoiceInputTurn at all. Guard 3, the race-free
  // one, is the trainer's single-stream slot, which answers 409 while the solo
  // practice transport owns the session.)
  const coachTakeInFlight = new Set();

  function logCoachTakeWitness({ outcome, ms, takeKind, takeKindSource, hasMetrics, reason }) {
    // ONE compact structured line per take — this is a per-take witness, not a
    // failure witness, so a healthy run emits exactly one line per spoken turn.
    logger?.log?.({
      event: 'coach_take',
      outcome,
      ms: Number.isFinite(ms) ? Math.max(0, Math.round(ms)) : null,
      take_kind: takeKind || null,
      // WHERE the kind came from. The field session that produced this repair
      // logged take_kind 'phrase' / source 'default' for its whole run while the
      // tutor was verbally prescribing a hum; a run showing
      // 'engine-recommendation' here is the state successfully following the
      // engine, and one showing 'default' throughout is the defect recurring.
      take_kind_source: takeKindSource || null,
      has_metrics: hasMetrics === true,
      ...(reason ? { reason } : {}),
    });
    if (outcome !== 'analyzed') {
      pushRuntimeWitness('warn', 'coach-take', 'Coach turn proceeded without analyzer take evidence.', {
        outcome,
        ms: Number.isFinite(ms) ? Math.max(0, Math.round(ms)) : null,
        take_kind: takeKind || null,
        ...(reason ? { reason } : {}),
      });
    }
  }

  /**
   * The coach-turn REQUEST witness (2026-07-27 field repair).
   *
   * The incident: a live turn reached `asr-completed` with a real transcript
   * and then produced nothing at all — no coach_gates, no turn_telemetry, no
   * TTS, no error. Nothing in any log could distinguish "the client never asked
   * for a reply" from "the coach turn threw on the way to its first witness",
   * because POST /voice/coach/stream had no witness of any kind: its 400/404
   * guards answered silently and its catch-all turned a throw into a bare 500.
   *
   * `accepted` is a per-turn line, deliberately — the same justification as
   * logCoachTakeWitness. It carries no transcript, only a length, because its
   * whole job is to answer "did the request arrive" without recording what was
   * said. Everything else is a failure line and also goes to the persistent
   * sink, so it survives a restart.
   */
  function logCoachTurnRequest(outcome, extras = {}) {
    logger?.log?.({ event: 'coach_turn_request', outcome, ...extras });
    if (outcome !== 'accepted') {
      pushRuntimeWitness('error', 'coach-turn', 'Coach turn request did not produce a reply.', {
        outcome,
        ...extras,
      });
    }
  }

  // -------------------------------------------------------------------------
  // pendingTakeKind — the engine's one-shot prescription (2026-07-26)
  //
  // LIFECYCLE, in full:
  //   STAMPED   after buildSignal, on BOTH coach paths (streaming + buffered),
  //             when resolveEngineRecommendedTakeKind finds a VOCALISE kind in
  //             coachingDecision.recommendedDrill. Re-stamping overwrites.
  //   READ      by resolveCoachTakeKind, and ONLY when the session's own drill
  //             state resolved to source 'default' — i.e. nothing in the
  //             session has said anything about a kind. A drill that DECLARES
  //             one always wins (a siren drill resolves 'drill-kind'), because
  //             the take kind steers the analyzer's per-kind metric contract
  //             and the vocalise-lenient strain bar: re-filing a siren as a hum
  //             would hand it the wrong metrics and the wrong safety threshold.
  //             MEASURED: a plain phrase drill declares NO kind and resolves to
  //             'default' too, so it is filled in like an empty session — which
  //             is intended. The engine only ever prescribes a vocalise, and a
  //             phrase drill makes no claim the prescription could contradict.
  //   CONSUMED  exactly once, at the single real dispatch site in
  //             beginCoachTakeAnalysis — cleared the moment a take actually
  //             goes out under it. The early-return guards there (oversize,
  //             already-in-flight) dispatch nothing and so consume nothing.
  //   EXPIRED   three ways, because a take is not guaranteed to arrive:
  //             (a) the drill changes — selectVoiceDrill clears it outright,
  //                 and the read below re-checks the lessonId it was stamped
  //                 against, so a drill change through any other route cannot
  //                 leave a prescription pointing at the wrong lesson;
  //             (b) a later coach turn recommends something that is NOT a
  //                 vocalise — the engine's latest word wins ('superseded');
  //             (c) age — a prescription older than PENDING_TAKE_KIND_MAX_AGE_MS
  //                 is not a live instruction ('expired'), because a coach turn
  //                 that dispatches no take cannot spend the one-shot, so
  //                 without this a hum prescribed before a long break would
  //                 still be steering the first take after it.
  //             And it is never trusted ALONE: a prescribed kind still needs
  //             analyzer voiced evidence before anything is SAID about it
  //             (resolveWordlessPracticeAcknowledgement).
  // -------------------------------------------------------------------------
  const CONCRETE_SCAFFOLD_CUES = Object.freeze({
    hum_sovt: {
      family: 'loose_jaw_closed_lips',
      text: 'Keep your lips gently together and your jaw loose',
    },
    sustained: {
      family: 'steady_air',
      text: 'Keep your jaw loose and let the air move steadily',
    },
    siren: {
      family: 'easy_slide',
      text: 'Keep your jaw loose and slide without pushing',
    },
    resonance_play: {
      family: 'tongue_rest',
      text: 'Let your tongue rest behind your lower front teeth and keep your jaw loose',
    },
    trill: {
      family: 'loose_lips',
      text: 'Let your lips stay loose and keep the air steady',
    },
  });

  function beginPracticeProgressionForScaffold(session, takeKind) {
    if (!session?.voiceState || session.voiceState.practiceProgression) {
      return session?.voiceState?.practiceProgression || null;
    }
    const cue = CONCRETE_SCAFFOLD_CUES[takeKind];
    if (!cue) return null;

    const activeLine = session.voiceState.activeLine;
    const selectedKind = resolveTakeKind(
      resolveActiveDrillRepContext(session.voiceState),
      session.voiceState.practiceMode,
    );
    // An explicit learner-selected vocalise is already the exercise. An engine
    // recommendation may not reinterpret its sound text as a return sentence.
    if (activeLine?.source === 'selected-drill' || selectedKind.source === 'drill-kind') {
      return null;
    }
    const returnText = normalizeText(activeLine?.displayText, 240);
    const returnLineId = normalizeText(activeLine?.id, 120);
    // A scaffold may only start when it has a real phrase/sentence to return
    // to. Never fabricate a target from the sound exercise itself.
    if (!returnLineId || returnText.split(/\s+/).filter(Boolean).length < 3) return null;

    const progression = beginSentenceProgression({
      returnLineId,
      returnText,
      cueFamilyId: cue.family,
      cueText: cue.text,
      startedAt: Date.now(),
    });
    if (!progression) return null;
    session.voiceState = voiceStateRuntime.updateSessionVoiceState(session, {
      practiceProgression: progression,
    });
    logger?.log?.({
      event: 'sentence_progression_started',
      return_line_id: progression.returnLineId,
      take_kind: takeKind,
    });
    return progression;
  }

  function applyPracticeProgressionTurn(
    session,
    takeKind,
    turnEvidence,
    takeOutcome,
    transcript = '',
  ) {
    if (!session?.voiceState) return null;
    const progression = session.voiceState.practiceProgression;
    if (!progression) return null;

    const safety = takeOutcome?.extras?.guardian?.level === 'stop'
      || session.voiceState.guardianLevel === 'stop'
      ? 'stop'
      : 'safe';
    // 2026-07-29 sound-rung verification. The ladder can now hold on a take that
    // contradicts the sound it asked for, but only if it is actually handed the
    // per-kind numbers — with no metrics every check returns 'unknown' and
    // passes, so a wiring miss degrades to exactly the old behaviour rather than
    // failing closed on the learner. Everything below is null-tolerant.
    const progressionSummary = takeOutcome?.summary || takeOutcome?.attemptArtifact?.summary || null;
    const progressionMetrics = progressionSummary?.metrics || {};
    const progressionAdvanced = progressionMetrics.advanced || {};
    const targetProfile = session.voiceState?.targetVoiceProfile || {};
    let kindMetrics = null;
    try {
      kindMetrics = buildKindMetrics(takeKind, {
        metrics: progressionMetrics,
        advanced: progressionAdvanced,
        quality: progressionAdvanced.quality || {},
        formantLite: progressionAdvanced.formantLite || {},
        targetProfile,
      });
    } catch (error) {
      // A metric-shaping failure must never break the lesson; fall through to
      // 'unknown' and let the take advance as it did before this check existed.
      logger?.log?.({ event: 'sound_landed_metrics_error', message: error?.message || String(error) });
      kindMetrics = null;
    }

    const transition = resolveSentenceProgressionTurn({
      progression,
      takeKind,
      evidence: {
        ...turnEvidence,
        safety,
        transcript,
        kindMetrics,
        bands: targetProfile.advancedBands || {},
        // minPitchRangeSt lives on the per-take ATTEMPT TARGET, not on the
        // profile's advancedBands — passing only the latter left the siren
        // check permanently dead.
        target: progressionSummary?.target || {},
      },
    });
    session.voiceState = voiceStateRuntime.updateSessionVoiceState(session, {
      practiceProgression: transition.progression,
    });
    logger?.log?.({
      event: 'sentence_progression_transition',
      transition: transition.transition,
      phase: transition.progression?.phase || 'complete',
      expected_unit: transition.progression?.expectedUnit || null,
      eligible_attempt_count: transition.progression?.eligibleAttemptCount
        ?? progression.eligibleAttemptCount,
      lexical_accuracy: transition.lexicalAccuracy,
    });
    return transition;
  }

  function stampEngineRecommendedTakeKind(session, signal) {
    if (!session?.voiceState) return null;
    const recommended = resolveEngineRecommendedTakeKind(signal);
    if (!recommended) {
      // The engine's LATEST word is the prescription. A turn that recommends
      // something other than a vocalise has changed its mind, so a standing
      // prescription must not survive it — otherwise a hum prescribed three
      // text-only turns ago would still be waiting to re-file an ordinary
      // phrase take as a hum, with the vocalise-lenient strain bar attached.
      // (A coach turn that dispatches no take cannot spend the one-shot, so
      // without this the prescription really does span turns indefinitely.)
      //
      // NOTE this also fires on a turn whose signal came back empty — a model
      // fallback, an errored turn — which wipes a prescription that was still
      // perfectly valid. That is the deliberate direction to fail in: losing it
      // returns the session to today's behavior, and the acknowledgment's
      // voiced-evidence basis still catches the learner's hum either way. The
      // opposite failure, a stale prescription steering the analyzer's metric
      // contract and strain bar, has no such backstop.
      clearPendingTakeKind(session, 'superseded');
      return null;
    }
    const pendingTakeKind = {
      prescriptionId: createId('take-prescription'),
      kind: recommended.kind,
      drillId: recommended.drillId || null,
      // The lesson this prescription was made under; a different lesson later
      // means the learner moved on and the prescription is stale.
      lessonId: session.voiceState.lessonId || null,
      stampedAt: Date.now(),
    };
    session.voiceState = voiceStateRuntime.updateSessionVoiceState(session, { pendingTakeKind });
    beginPracticeProgressionForScaffold(session, pendingTakeKind.kind);
    logger?.log?.({
      event: 'coach_take_kind_prescribed',
      take_kind: pendingTakeKind.kind,
      drill_id: pendingTakeKind.drillId,
      lesson_id: pendingTakeKind.lessonId,
    });
    return pendingTakeKind;
  }

  // -------------------------------------------------------------------------
  // lastCueGiven — the cue carried ONE turn forward (2026-07-30).
  //
  // WHY IT EXISTS. recommendDrillForFocus already returns a stable cue identity
  // ({ id, instruction, successCriteria }) and it was discarded at the end of
  // every turn, so nothing downstream could ever say WHICH cue was in play when
  // a take landed. The win line therefore picked from four fixed sentences by
  // FRESHNESS — a pitch win and a resonance win got the same words. Persisting
  // the identity for exactly one turn is the whole enabling change.
  //
  // LIFECYCLE:
  //   STAMPED  at the end of BOTH coach paths (streaming + buffered), where the
  //            reply is finalised onto the voice state, from the signal's own
  //            structured recommendedDrill — never from the model's words.
  //   READ     by buildSignal on the NEXT turn, as `signal.previousCue`. It is
  //            read before this function runs again, so the two can never be
  //            the same turn's drill.
  //   CLEARED  by a coach turn that recommends NO cue (focus 'none', an unmapped
  //            axis, an errored/empty signal). Same "the engine's latest word
  //            wins" rule as pendingTakeKind, and the same safe failure
  //            direction: losing the record costs one named win line and falls
  //            back to the stock sentence, while KEEPING a stale one would have
  //            the tutor tell her she was doing something she was last asked to
  //            do several turns ago.
  //
  // HONESTY BOUND: this records the cue the turn ISSUED, which on the LLM path
  // is what the model was instructed to say rather than a transcript of what it
  // said. Downstream wording must therefore stay co-occurrence ("you were doing
  // X"), never causal ("X did it") — see composeAcknowledgeWin.
  // -------------------------------------------------------------------------
  function stampLastCueGiven(session, signal) {
    if (!session?.voiceState) return null;
    const drill = signal?.coachingDecision?.recommendedDrill;
    const id = normalizeText(drill?.id, 120);
    const instruction = normalizeText(drill?.instruction, 240);
    if (!id || !instruction) {
      if (session.voiceState.lastCueGiven) {
        session.voiceState = voiceStateRuntime.updateSessionVoiceState(session, { lastCueGiven: null });
        logger?.log?.({ event: 'coach_cue_carry_cleared', reason: 'no_cue_this_turn' });
      }
      return null;
    }
    const lastCueGiven = {
      id,
      axis: normalizeText(signal?.coachingDecision?.primaryFocus, 60) || null,
      instruction,
    };
    session.voiceState = voiceStateRuntime.updateSessionVoiceState(session, { lastCueGiven });
    logger?.log?.({
      event: 'coach_cue_carried',
      cue_id: lastCueGiven.id,
      axis: lastCueGiven.axis,
    });
    return lastCueGiven;
  }

  function clearPendingTakeKind(session, reason) {
    if (!session?.voiceState?.pendingTakeKind) return;
    const cleared = session.voiceState.pendingTakeKind;
    session.voiceState = voiceStateRuntime.updateSessionVoiceState(session, { pendingTakeKind: null });
    logger?.log?.({
      event: 'coach_take_kind_cleared',
      take_kind: cleared.kind || null,
      reason: reason || 'consumed',
    });
  }

  function readPendingTakeKind(session) {
    const pending = session?.voiceState?.pendingTakeKind;
    if (!pending || typeof pending !== 'object') return null;
    if (!normalizeText(pending.prescriptionId, 160)) {
      clearPendingTakeKind(session, 'invalid_legacy_prescription');
      return null;
    }
    const kind = normalizeTakeKindToken(pending.kind);
    if (!kind) return null;
    if ((pending.lessonId || null) !== (session.voiceState.lessonId || null)) {
      clearPendingTakeKind(session, 'drill_changed');
      return null;
    }
    // A prescription is "do this on your NEXT take", not a standing order. If
    // the learner walks away mid-session and comes back, the next take is a
    // fresh start, not the answer to a cue they no longer remember hearing —
    // and filing it as a hum would hand it the wrong per-kind metrics and the
    // vocalise-lenient strain bar. Same window the session-staleness sweep
    // already treats as "this session went quiet".
    if (Number.isFinite(Number(pending.stampedAt))
      && Date.now() - Number(pending.stampedAt) > PENDING_TAKE_KIND_MAX_AGE_MS) {
      clearPendingTakeKind(session, 'expired');
      return null;
    }
    return { ...pending, kind };
  }

  /**
   * The take kind for THIS turn — the SAME resolver the wordless
   * acknowledgment uses, so the kind the analyzer records and the kind the
   * spoken line acknowledges can never disagree about one sound.
   *
   * This never SPENDS the prescription — consumption is a separate, single act
   * at the dispatch site, because this is called several times per turn
   * (including from guards that dispatch nothing). It can still RETIRE one: a
   * prescription whose lessonId no longer matches is stale, and readPendingTakeKind
   * clears it on sight rather than handing back something it has just judged invalid.
   */
  function resolveCoachTakeKind(session) {
    const voiceState = session?.voiceState;
    if (!voiceState) return { kind: 'phrase', source: 'default' };
    if (voiceState.practiceProgression?.requiredTakeKind === 'phrase') {
      return { kind: 'phrase', source: 'sentence-progression' };
    }
    const resolved = resolveTakeKind(resolveActiveDrillRepContext(voiceState), voiceState.practiceMode);
    // 'default' is the ONE state that means "nothing here knows the kind" —
    // exactly what the field session logged for its whole run while the tutor
    // was verbally prescribing a hum. A 'mode' source is the learner's own
    // chosen practice mode and is left alone.
    if (resolved.source !== 'default') return resolved;
    const pending = readPendingTakeKind(session);
    if (!pending) return resolved;
    return { kind: pending.kind, source: 'engine-recommendation' };
  }

  // In-flight analyzer-session binds, keyed by coach session id. A coach turn
  // is not the only thing that can arrive at once (the client re-arms fast, and
  // a buffered segment can land while another is settling), and binding twice
  // would leave one orphaned analyzer session per extra caller.
  const coachAnalyzerSessionBinds = new Map();
  // Sessions whose bind recently failed or blew its deadline. Without this the
  // "once per session" cost is a lie: a wedged analyzer leaves voiceSessionId
  // null forever, so EVERY turn re-entered the wait and paid the full budget
  // again (MEASURED, 300ms budget, hung analyzer: per-turn 306/302/301/302),
  // and a fast-failing analyzer was re-attempted once per turn (4 turns, 4
  // starts). Both break the fail-open contract this leg is supposed to honor.
  const coachAnalyzerBindCooldownUntil = new Map();

  /**
   * Make sure this coach session HAS an analyzer session, so the take leg can
   * actually run. Returns the analyzer session id, or null.
   *
   * WHY THIS EXISTS (2026-07-27 field repair). The take leg was written to be
   * additive on a session that already had an analyzer bound — which is true of
   * the solo practice flow and of the legacy coach page (coach-app.js calls
   * POST /voice/session/start). It is NOT true of the live coach client, which
   * starts through POST /session/start and never binds one. So the leg was dead
   * in coach mode from the day it shipped, silently.
   *
   * FAIL-OPEN, and that is the whole contract. This runs on a live spoken
   * lesson; if the analyzer is down, busy, or rejects the target, the turn must
   * proceed EXACTLY as it does today — with no take evidence — never fail.
   * A throw here would turn an additive evidence channel into a new way for a
   * coach turn to die, which is the opposite of the repair.
   *
   * It delegates to `startVoiceSession` rather than calling the trainer itself,
   * deliberately: that handler owns target binding, the acknowledgement gate,
   * and the single stale-calibration rebind. A second, simpler bind path here
   * would drift from it and hand the analyzer takes under a target the session
   * is not actually bound to — which the take's own provenance check would then
   * discard anyway, silently, for a different reason.
   */
  async function ensureCoachAnalyzerSession(session, internal = {}) {
    const canCommit = () => {
      try {
        return typeof internal.shouldCommit !== 'function' || internal.shouldCommit() === true;
      } catch {
        return false;
      }
    };
    if (!canCommit()) return null;
    const existing = normalizeText(session?.voiceState?.voiceSessionId, 200);
    if (existing) return existing;
    const sessionId = normalizeText(session?.id, 160);
    if (!sessionId) return null;
    // Already tried and it did not work. Trying again on the very next segment
    // buys nothing (the analyzer does not recover in the gap between two
    // utterances) and costs the learner either a stall or a doomed round-trip
    // on every turn for the rest of the session.
    const cooldownUntil = coachAnalyzerBindCooldownUntil.get(sessionId) || 0;
    if (Date.now() < cooldownUntil) return null;
    if (coachAnalyzerSessionBinds.has(sessionId)) {
      return waitForCoachAnalyzerBind(sessionId, coachAnalyzerSessionBinds.get(sessionId));
    }
    const bind = (async () => {
      const startedAt = Date.now();
      try {
        await voiceOperationRouteHandlers.startVoiceSession(
          { sessionId },
          { shouldCommit: canCommit },
        );
        const bound = normalizeText(session?.voiceState?.voiceSessionId, 200) || null;
        logger?.log?.({
          event: 'coach_analyzer_session_bind',
          outcome: bound ? 'bound' : 'no_session_id',
          ms: Date.now() - startedAt,
        });
        if (!bound) {
          coachAnalyzerBindCooldownUntil.set(sessionId, Date.now() + COACH_ANALYZER_BIND_COOLDOWN_MS);
          pushRuntimeWitness('warn', 'coach-take', 'Coach analyzer session bind returned no analyzer session.', {
            outcome: 'analyzer_bind_empty',
            ms: Date.now() - startedAt,
          });
        } else {
          coachAnalyzerBindCooldownUntil.delete(sessionId);
        }
        return bound;
      } catch (error) {
        const status = Number(error?.status ?? error?.statusCode);
        if (status === 409) return null;
        coachAnalyzerBindCooldownUntil.set(sessionId, Date.now() + COACH_ANALYZER_BIND_COOLDOWN_MS);
        const witness = {
          outcome: 'analyzer_bind_failed',
          ms: Date.now() - startedAt,
          error_status: Number.isFinite(status) ? status : null,
          error_message: normalizeText(error?.message, 200) || 'unknown error',
        };
        logger?.log?.({ event: 'coach_analyzer_session_bind', ...witness });
        // WARN, not error: the turn is unharmed. This names a lost evidence
        // channel, which is exactly the thing that was invisible before.
        pushRuntimeWitness('warn', 'coach-take', 'Coach analyzer session could not be bound; this turn has no take evidence.', witness);
        return null;
      } finally {
        coachAnalyzerSessionBinds.delete(sessionId);
      }
    })();
    coachAnalyzerSessionBinds.set(sessionId, bind);
    return waitForCoachAnalyzerBind(sessionId, bind);
  }

  /**
   * Wait for a bind, but never for long. The bind sits on the critical path of
   * a live spoken turn, and `startVoiceSession` can legitimately take a while:
   * `fetchJson` alone allows 8s, and a stale-calibration rebind adds a second
   * analyzer round-trip plus an in-place reference re-analysis. Sixteen-plus
   * seconds of silence in front of the learner's first turn, to acquire an
   * ADDITIVE evidence channel, is a worse failure than not having the channel.
   *
   * So this stops WAITING at the deadline without cancelling the bind — the
   * same rule the take deadline follows. The bind keeps running, still writes
   * `voiceSessionId` onto the session when it lands, and the NEXT turn simply
   * finds it already there. Only this one turn goes without take evidence.
   */
  function waitForCoachAnalyzerBind(sessionId, bind) {
    if (!bind || typeof bind.then !== 'function') return Promise.resolve(bind || null);
    let timeoutHandle = null;
    // A SENTINEL, not null. A bind that FAILED also resolves null, and the two
    // are different facts: the bind already witnessed its own failure, so
    // logging a timeout for it would double-count and mislabel it. Only the
    // deadline branch may claim a timeout.
    const timedOut = Symbol('coach-analyzer-bind-timeout');
    const waitMs = Number.isFinite(Number(config.voiceCoachAnalyzerBindWaitMs))
      ? Math.max(1, Math.round(Number(config.voiceCoachAnalyzerBindWaitMs)))
      : COACH_ANALYZER_BIND_WAIT_MS;
    const deadline = new Promise((resolve) => {
      timeoutHandle = setTimeout(() => resolve(timedOut), waitMs);
      timeoutHandle?.unref?.();
    });
    return Promise.race([bind, deadline]).then((bound) => {
      if (timeoutHandle) clearTimeout(timeoutHandle);
      if (bound === timedOut) {
        // The bind is still running and may yet land for a later turn, but this
        // session has now demonstrated it is slow. Stop paying the deadline on
        // every subsequent turn.
        coachAnalyzerBindCooldownUntil.set(sessionId, Date.now() + COACH_ANALYZER_BIND_COOLDOWN_MS);
        logger?.log?.({
          event: 'coach_analyzer_session_bind',
          outcome: 'wait_timeout',
          ms: waitMs,
        });
        return null;
      }
      return bound || null;
    }, () => null)
      // Belt AND braces: `.then(onOk, onErr)` does NOT catch a throw from its
      // own success handler, and that handler calls the injected logger. A
      // throw there would reject the promise the turn awaits, turning the one
      // thing that must never break a turn into the thing that breaks it.
      .catch(() => null);
  }

  /**
   * Dispatch this segment's analyzer take and return a promise that ALWAYS
   * resolves — never rejects — within the configured deadline.
   *
   * Non-rejecting is load-bearing, not defensive style: the caller dispatches
   * this BEFORE awaiting the ASR, so if the ASR throws first this promise is
   * never awaited. A rejection with no handler takes the whole process down on
   * Node >= 15. Every failure path therefore resolves to an outcome object.
   *
   * The deadline is absolute from DISPATCH, so the concurrency actually buys
   * something: by the time the ASR returns, the take has usually already
   * landed and the extra wait is zero.
   *
   * Returns null when there is nothing to submit (no analyzer session bound, no
   * audio, or a guard fired) — the caller then simply has no take this turn.
   */
  function beginCoachTakeAnalysis(session, pcmBuffer) {
    const voiceSessionId = normalizeText(session?.voiceState?.voiceSessionId, 200);
    // ── 2026-07-27 FIELD ROOT CAUSE ────────────────────────────────────────
    // These two guards used to `return null` SILENTLY, and that silence is why
    // two consecutive repairs of "the tutor ignores my hums" did not hold.
    //
    // MEASURED on the live gateway (journal, whole uptime): `coach_take` x0
    // while `voice_input_live_stage` x37 and `coach_gates` x2 — i.e. the take
    // leg emitted NOTHING on every turn, including the two spoken turns that
    // did produce coach replies. The cause was this first guard: the live coach
    // client starts its session through POST /session/start
    // (appCompatibilityRouteHandlers.startSession), which binds a target but
    // never starts an ANALYZER session, so `voiceSessionId` stayed null for the
    // whole session and no take was ever dispatched in coach mode at all.
    // Everything downstream — the drill_kind ack, the voiced-evidence ack —
    // reads a take that never existed, so both were unreachable by
    // construction while looking perfectly correct in review.
    //
    // A guard that declines to do work must SAY SO. The skip witnesses below
    // are the difference between "the analyzer disagreed" and "the analyzer was
    // never asked" — two conclusions that a reviewer reading only the code
    // cannot tell apart, and that the field log must never again conflate.
    if (!voiceSessionId) {
      const skippedKind = resolveCoachTakeKind(session);
      logCoachTakeWitness({
        outcome: 'skipped',
        ms: 0,
        takeKind: skippedKind.kind,
        takeKindSource: skippedKind.source,
        hasMetrics: false,
        reason: 'no_analyzer_session',
      });
      return null;
    }
    if (!Buffer.isBuffer(pcmBuffer) || pcmBuffer.length < 2 || pcmBuffer.length % 2) {
      const skippedKind = resolveCoachTakeKind(session);
      logCoachTakeWitness({
        outcome: 'skipped',
        ms: 0,
        takeKind: skippedKind.kind,
        takeKindSource: skippedKind.source,
        hasMetrics: false,
        reason: 'no_pcm_segment',
      });
      return null;
    }
    // The trainer's one-shot endpoint caps audio at 60s of 16kHz PCM16
    // (1,920,000 bytes) with a 413; the live segmenter's own cap is larger.
    // Skip the doomed HTTP round-trip and witness the skip instead.
    if (pcmBuffer.length > 1920000) {
      const skippedKind = resolveCoachTakeKind(session);
      logCoachTakeWitness({
        outcome: 'skipped',
        ms: 0,
        takeKind: skippedKind.kind,
        takeKindSource: skippedKind.source,
        hasMetrics: false,
        reason: 'oversize_segment',
      });
      return null;
    }
    if (coachTakeInFlight.has(voiceSessionId)) {
      const skippedKind = resolveCoachTakeKind(session);
      logCoachTakeWitness({
        outcome: 'skipped',
        ms: 0,
        takeKind: skippedKind.kind,
        takeKindSource: skippedKind.source,
        hasMetrics: false,
        reason: 'take_already_in_flight',
      });
      return null;
    }

    const { kind: takeKind, source: takeKindSource } = resolveCoachTakeKind(session);
    const pendingTakeAtDispatch = takeKindSource === 'engine-recommendation'
      ? readPendingTakeKind(session)
      : null;
    const timeoutMs = Number.isFinite(Number(config.voiceCoachTakeTimeoutMs))
      ? Math.max(1, Math.round(Number(config.voiceCoachTakeTimeoutMs)))
      : 2500;
    const startedAt = Date.now();
    coachTakeInFlight.add(voiceSessionId);

    let request;
    try {
      request = callVoiceTrainer(
        `/api/v1/voice/sessions/${encodeURIComponent(voiceSessionId)}/take-oneshot`,
        {
          method: 'POST',
          timeoutMs,
          body: {
            pcm16Base64: pcmBuffer.toString('base64'),
            takeKind,
            reason: 'coach turn take',
            sloaneSessionId: session.id,
            referenceClipId: session.voiceState?.referenceClipId || null,
          },
        },
      ).then(
        (result) => ({ ok: true, result }),
        (error) => ({ ok: false, error }),
      );
    } catch (error) {
      // Encoding or URL construction threw before a promise ever existed. Even
      // this must not reach the caller as an exception: the turn is the thing
      // being protected.
      coachTakeInFlight.delete(voiceSessionId);
      return Promise.resolve({
        outcome: 'error',
        ms: 0,
        takeKind,
        takeKindSource,
        hasMetrics: false,
        reason: normalizeText(error?.message, 80) || 'dispatch_failed',
      });
    }

    let timeoutHandle = null;
    const deadline = new Promise((resolve) => {
      timeoutHandle = setTimeout(() => resolve({ timedOut: true }), timeoutMs);
      timeoutHandle?.unref?.();
    });
    // Release the in-flight claim when we STOP WAITING, not when the request
    // eventually settles. A request that never settles (a wedged socket, an
    // exotic fetch impl that ignores its abort signal) would otherwise block
    // every later take on this session for the rest of its life — a silent,
    // permanent loss of take evidence. Overlap after the deadline is still
    // caught, by the trainer's own single-stream slot, which is the only
    // race-free guard anyway.
    const releaseClaim = () => {
      if (timeoutHandle) clearTimeout(timeoutHandle);
      timeoutHandle = null;
      coachTakeInFlight.delete(voiceSessionId);
    };

    return Promise.race([request, deadline]).then((settled) => {
      releaseClaim();
      const ms = Date.now() - startedAt;
      if (settled?.timedOut === true) {
        // Do NOT abort the request. The trainer is most likely mid-DSP and its
        // take is real; it should still land and be retained. We simply stop
        // waiting for it, and this turn coaches without it.
        return { outcome: 'timeout', ms, takeKind, takeKindSource, hasMetrics: false };
      }
      if (settled.ok !== true) {
        const status = Number(settled.error?.status);
        return {
          outcome: 'error',
          ms,
          takeKind,
          takeKindSource,
          hasMetrics: false,
          reason: Number.isFinite(status) ? `http_${status}` : 'request_failed',
        };
      }
      const result = settled.result || {};
      const summary = result.summary || result.attemptArtifact?.summary || null;
      const attemptArtifact = result.attemptArtifact || null;
      if (!summary && !attemptArtifact) {
        return { outcome: 'error', ms, takeKind, takeKindSource, hasMetrics: false, reason: 'empty_take' };
      }
      // Same target-provenance check the solo take path runs — but NOT its
      // quarantine. The solo path is allowed to retire the analyzer session on
      // a mismatch because the learner asked for that take; this leg is an
      // additive channel on a live lesson, and the learner owns the session
      // lifetime. So a mismatch here discards the EVIDENCE (never substitute)
      // and leaves the session alone; the solo path still quarantines if the
      // learner takes a real take against the same mis-bound session.
      const provenanceFailures = collectVoiceTakeProvenanceFailures({
        session,
        voiceSessionId,
        summary,
        attemptArtifact,
      });
      if (provenanceFailures.length > 0) {
        return {
          outcome: 'error',
          ms,
          takeKind,
          takeKindSource,
          hasMetrics: false,
          reason: `provenance:${provenanceFailures.slice(0, 3).join(',')}`,
        };
      }
      // `hasMetrics` must mean the analyzer got a USABLE reading — not that the
      // response had numbers in it. MEASURED against the real analyzer
      // (2026-07-26): a take with zero voiced frames still returns all six core
      // fields finite (meanPitchHz 201.5, resonanceMean 0.5, similarityScore
      // 0.436 …) alongside measurementAvailable=false and
      // measurementRejectionReasons=['no_voiced_frames']. Those are FALLBACKS,
      // not readings. Testing finiteness — or truthiness of the metrics object
      // — would let a silent or too-quiet hum earn the "heard and measured"
      // line, which is a fabricated claim of evidence.
      //
      // So defer to the codebase's own predicate, the same one the take-finalize
      // side channels use to decide whether a take counts as practice evidence.
      // The take still LANDS (it is a real, auditable take, and the side
      // channels already suppress the achievement paths for it) — it simply
      // cannot claim a reading it does not have.
      // Both halves are needed. `usableForScoring` alone is not enough: it
      // deliberately treats an ABSENT measurement as usable (absent is not the
      // same as rejected — a stale take must not be able to accuse the mic of a
      // fault), so an empty metrics block would sail through it. Claiming a
      // reading requires the measurement to be PRESENT *and* not degraded.
      const measurementValidity = resolveVoiceMeasurementUsability(attemptArtifact || summary);
      const hasMetrics = measurementValidity.measurementAvailable === true
        && measurementValidity.usableForScoring === true;
      // `false` means the analyzer looked and reported no usable measurement;
      // `null` means it reported nothing at all. Different faults, so the
      // witness names them differently.
      const noReadingReason = measurementValidity.measurementAvailable == null
        ? `measurement_absent:${measurementValidity.reasons[0] || 'not_reported'}`
        : `measurement_unusable:${measurementValidity.reasons[0] || 'unknown'}`;
      return {
        outcome: 'analyzed',
        ms,
        takeKind,
        takeKindSource,
        hasMetrics,
        ...(hasMetrics ? {} : { reason: noReadingReason }),
        summary,
        attemptArtifact,
        status: result.status || null,
        streamUrl: result.streamUrl || null,
        attemptArtifactId: attemptArtifact?.attemptArtifactId || null,
      };
    }).catch((error) => {
      // `.catch` after `.then`, NOT `.then(onOk, onErr)`: the two-argument form
      // does not catch a throw from its own success handler, and that handler
      // runs collectVoiceTakeProvenanceFailures -> resolveMetricContract, which
      // is a lot of unguarded surface. This promise is dispatched before the ASR
      // is awaited, so any escape would be an UNHANDLED rejection whenever the
      // ASR throws first — process-fatal on Node >= 15.
      releaseClaim();
      return {
        outcome: 'error',
        ms: Date.now() - startedAt,
        takeKind,
        takeKindSource,
        hasMetrics: false,
        reason: normalizeText(error?.message, 80) || 'race_failed',
      };
    }).then((outcome) => (
      pendingTakeAtDispatch
        ? { ...outcome, pendingTakePrescriptionId: pendingTakeAtDispatch.prescriptionId }
        : outcome
    ));
  }

  function consumeCommittedPendingTakeKind(session, takeOutcome) {
    if (takeOutcome?.takeKindSource !== 'engine-recommendation') return;
    const pending = readPendingTakeKind(session);
    if (!pending) return;
    if (pending.kind !== takeOutcome.takeKind) return;
    if (!pending.prescriptionId
      || pending.prescriptionId !== takeOutcome.pendingTakePrescriptionId) return;
    clearPendingTakeKind(session, 'take_dispatched');
  }

  /**
   * Land an analyzed coach take on the session, then witness the take exactly
   * once. Returns the take outcome so the caller can shape its reply from it —
   * including `extras`, the take-finalize side channels, which the caller MUST
   * pass through. They are not decoration: applyTakeFinalizeSideChannels can
   * append a strain-guardian line into the coach thread, so dropping the extras
   * would leave a coach line the learner never heard sitting in the history the
   * model reads on the next turn.
   */
  function settleCoachTakeAnalysis(session, takeOutcome) {
    if (!takeOutcome) return null;
    if (takeOutcome.outcome === 'analyzed') {
      try {
        const extras = landFinalizedTake(session, {
          summary: takeOutcome.summary,
          attemptArtifact: takeOutcome.attemptArtifact,
          status: takeOutcome.status,
          streamUrl: takeOutcome.streamUrl,
          repContext: takeOutcome.attemptArtifact?.repContext || null,
          checkpointReason: 'coach-take-finalized',
        });
        logCoachTakeWitness(takeOutcome);
        return { ...takeOutcome, extras: extras && typeof extras === 'object' ? extras : {} };
      } catch (error) {
        // Landing is bookkeeping. It must never break a spoken turn.
        const failed = {
          ...takeOutcome,
          outcome: 'error',
          hasMetrics: false,
          reason: normalizeText(error?.message, 80) || 'land_failed',
        };
        logCoachTakeWitness(failed);
        return failed;
      }
    }
    logCoachTakeWitness(takeOutcome);
    return takeOutcome;
  }

  // Best-effort "has the student pinned a milestone in the last 7 days?" — reads
  // the DSP milestone list via the proxy upstream. Returns false on any error so a
  // suggestion can still be offered (the contract: an offer, ignoring it is free).
  // NOTE: this is a synchronous gate; we keep a tiny in-process cache to avoid a
  // blocking network call on every take. The cache is refreshed opportunistically
  // by the milestones proxy + on a miss it simply returns false (no suggestion
  // suppression on unknown — we err toward NOT nagging only when we KNOW there is
  // a recent milestone).
  function hasRecentMilestone(studentId) {
    const entry = recentMilestoneCache.get(String(studentId || ''));
    if (!entry) return false;
    const sevenDaysMs = 7 * 24 * 60 * 60 * 1000;
    return Number.isFinite(entry.lastPinnedAt) && (Date.now() - entry.lastPinnedAt) < sevenDaysMs;
  }

  /**
   * 2026-07-26 anti-collapse decoding parameters for the fine-tuned coach model.
   *
   * WHY: a measurement of the live coach found 86.5% of replies carrying the
   * same cue. The model is mode-collapsed from its fine-tune, and both request
   * bodies sent temperature ALONE — no nucleus cutoff and no repetition
   * penalties — so at the production temperature (0.2 on the coaching path) the
   * sampler was near-deterministic and simply re-emitted the collapsed cue.
   *
   * top_p trims the improbable tail without loosening the head; the frequency
   * penalty taxes tokens by how often they have already appeared, and the
   * presence penalty taxes them once for appearing at all. llama.cpp's
   * OpenAI-compatible /v1/chat/completions accepts all three.
   *
   * Resolution order: per-call generationOptions -> config (env-overridable via
   * VOICE_TUTOR_TOP_P / VOICE_TUTOR_FREQUENCY_PENALTY / VOICE_TUTOR_PRESENCE_PENALTY)
   * -> these constants. The constants are the fallback for callers that build a
   * runtime with a partial config object.
   */
  function buildVoiceTutorDecodingParams(generationOptions = {}) {
    const pick = (callValue, configValue, fallback) => {
      const candidate = callValue ?? configValue;
      const numeric = Number(candidate);
      return Number.isFinite(numeric) ? numeric : fallback;
    };
    return {
      top_p: pick(
        generationOptions.topP ?? generationOptions.top_p,
        config.voiceTutorTopP,
        DEFAULT_VOICE_TUTOR_TOP_P,
      ),
      frequency_penalty: pick(
        generationOptions.frequencyPenalty ?? generationOptions.frequency_penalty,
        config.voiceTutorFrequencyPenalty,
        DEFAULT_VOICE_TUTOR_FREQUENCY_PENALTY,
      ),
      presence_penalty: pick(
        generationOptions.presencePenalty ?? generationOptions.presence_penalty,
        config.voiceTutorPresencePenalty,
        DEFAULT_VOICE_TUTOR_PRESENCE_PENALTY,
      ),
    };
  }

  async function callVoiceTutorModel(messages, generationOptions = {}) {
    // Eval determinism (env-gated; unset in production -> live coach unchanged):
    // a side-car eval instance sets VOICE_TUTOR_EVAL_SEED so quant/model comparisons
    // reflect the model, not sampling noise; VOICE_TUTOR_EVAL_TEMP pins temperature
    // (0 for greedy ranking, 0.35 for prod-temp certification).
    const evalSeed = process.env.VOICE_TUTOR_EVAL_SEED;
    const evalTemp = process.env.VOICE_TUTOR_EVAL_TEMP;
    const reqBody = {
      model: config.voiceTutorGgufModel,
      messages,
      stream: false,
      temperature: (evalTemp != null && evalTemp !== '')
        ? Number(evalTemp)
        : (generationOptions.temperature ?? 0.35),
      max_tokens: generationOptions.maxTokens || generationOptions.max_tokens || 1024,
      // 2026-07-26 anti-collapse decoding (see voice-standalone-config.js).
      // The body previously carried temperature ALONE, so nothing discouraged
      // the fine-tune's collapsed cue; at temp 0.2 the coach was effectively
      // deterministic. These three are additive and leave the eval
      // VOICE_TUTOR_EVAL_SEED / VOICE_TUTOR_EVAL_TEMP overrides above intact.
      ...buildVoiceTutorDecodingParams(generationOptions),
    };
    if (evalSeed != null && evalSeed !== '') reqBody.seed = Number(evalSeed);
    const payload = await fetchJson(`${config.voiceTutorGgufBaseUrl}/chat/completions`, {
      fetchImpl,
      apiKey: config.voiceTutorGgufApiKey,
      timeoutMs: generationOptions.timeoutMs || 45000,
      body: reqBody,
    });
    return normalizeText(payload?.choices?.[0]?.message?.content || payload?.content || payload?.text, 4000);
  }

  async function* streamVoiceTutorModel(messages, generationOptions = {}) {
    const headers = { 'Content-Type': 'application/json' };
    if (config.voiceTutorGgufApiKey) {
      headers.Authorization = `Bearer ${config.voiceTutorGgufApiKey}`;
    }
    const response = await fetchImpl(`${config.voiceTutorGgufBaseUrl}/chat/completions`, {
      method: 'POST',
      headers,
      body: JSON.stringify({
        model: config.voiceTutorGgufModel,
        messages,
        stream: true,
        temperature: generationOptions.temperature ?? 0.35,
        max_tokens: generationOptions.maxTokens || generationOptions.max_tokens || 1024,
        // Same anti-collapse decoding as the buffered path — the streaming
        // coach turn must not be more repetitive than the buffered one.
        ...buildVoiceTutorDecodingParams(generationOptions),
      }),
      signal: AbortSignal.timeout(generationOptions.timeoutMs || 45000),
    });
    if (!response.ok) {
      const text = await response.text().catch(() => '');
      throw new Error(`GGUF model returned HTTP ${response.status}: ${text.slice(0, 200)}`);
    }
    const reader = response.body.getReader();
    const decoder = new TextDecoder();
    let buffer = '';
    try {
      while (true) {
        const { done, value } = await reader.read();
        if (done) break;
        buffer += decoder.decode(value, { stream: true });
        const lines = buffer.split('\n');
        buffer = lines.pop();
        for (const line of lines) {
          const trimmed = line.trim();
          if (!trimmed || !trimmed.startsWith('data: ')) continue;
          const payload = trimmed.slice(6);
          if (payload === '[DONE]') return;
          try {
            const chunk = JSON.parse(payload);
            const delta = chunk.choices?.[0]?.delta?.content || '';
            if (delta) yield delta;
          } catch { /* non-critical: skip malformed SSE chunk */ }
        }
      }
    } finally {
      reader.releaseLock();
    }
  }

  function resolveVoiceTrainerReadinessStreamUrl(streamUrl) {
    const baseUrl = config.voiceTrainerUrl.endsWith('/') ? config.voiceTrainerUrl : `${config.voiceTrainerUrl}/`;
    const url = new URL(streamUrl, baseUrl);
    url.protocol = url.protocol === 'https:' ? 'wss:' : 'ws:';
    return url.toString();
  }

  function probeVoiceTrainerStream(streamUrl) {
    const wsUrl = resolveVoiceTrainerReadinessStreamUrl(streamUrl);
    return new Promise((resolve, reject) => {
      const ws = new WebSocket(wsUrl, {
        headers: config.voiceTrainerAuthToken
          ? { authorization: `Bearer ${config.voiceTrainerAuthToken}` }
          : undefined,
      });
      let settled = false;
      const timeout = setTimeout(() => {
        if (settled) {
          return;
        }
        settled = true;
        try {
          ws.close();
        } catch { /* cleanup: ws.close on timeout */ }
        reject(new Error('Timed out waiting for VoiceTrainer stream frame'));
      }, 6000);
      const finish = (callback) => {
        if (settled) {
          return;
        }
        settled = true;
        clearTimeout(timeout);
        callback();
      };
      ws.once('open', () => {
        ws.send(buildSinePcm16Frame());
      });
      ws.once('message', (data) => {
        finish(() => {
          try {
            const text = Array.isArray(data)
              ? Buffer.concat(data).toString('utf8')
              : Buffer.isBuffer(data)
                ? data.toString('utf8')
                : Buffer.from(data).toString('utf8');
            resolve({ wsUrl, frame: text ? JSON.parse(text) : null });
          } catch (error) {
            reject(error);
          } finally {
            try {
              ws.close();
            } catch { /* cleanup: ws.close after message */ }
          }
        });
      });
      ws.once('error', (error) => {
        finish(() => reject(error));
      });
      ws.once('close', () => {
        finish(() => reject(new Error('VoiceTrainer stream closed before returning a frame')));
      });
    });
  }

  async function cleanupVoiceTrainerReadinessSession(trainerSessionPayload) {
    const voiceSessionId = normalizeText(trainerSessionPayload?.voiceSessionId, 200);
    if (!voiceSessionId) {
      return {
        status: 'degraded',
        detail: 'No VoiceTrainer readiness session was available to clean up.',
      };
    }
    const result = await callVoiceTrainer(`/api/v1/voice/sessions/${encodeURIComponent(voiceSessionId)}/end`, {
      method: 'POST',
      timeoutMs: 10000,
      body: {
        reason: 'standalone readiness cleanup',
        sloaneSessionId: trainerSessionPayload?.sloaneSessionId || `readiness-${voiceSessionId}`,
        referenceClipId: null,
        clientAttemptId: null,
        repContext: null,
        selfReport: null,
      },
    });
    return {
      status: result?.status === 'ended' ? 'online' : 'degraded',
      detail: result?.status === 'ended'
        ? `Ended VoiceTrainer readiness session ${voiceSessionId}.`
        : `VoiceTrainer cleanup returned status ${result?.status || 'unknown'}.`,
      metadata: { voiceSessionId },
    };
  }

  async function probeVoxCpmHealth(timeoutMs = 1000) {
    if (!config.voxcpmEnabled) {
      return { status: 'disabled', available: false, detail: 'VoxCPM is disabled.' };
    }
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), timeoutMs);
    try {
      const response = await fetchImpl(`${config.voxcpmUrl}/health`, { signal: controller.signal });
      const payload = response.ok ? await response.json() : null;
      const available = response.ok && payload?.ok === true && payload?.model_loaded === true;
      return {
        status: available ? 'online' : 'offline',
        available,
        detail: available ? 'VoxCPM model is loaded.' : `VoxCPM health was not ready (${response.status}).`,
      };
    } catch (error) {
      return {
        status: 'offline',
        available: false,
        detail: error?.name === 'AbortError' ? 'VoxCPM health timed out.' : 'VoxCPM health was unreachable.',
      };
    } finally {
      clearTimeout(timeout);
    }
  }

  function getMemoryStorageHealthSummary() {
    const learner = typeof learnerContextService.getStorageHealth === 'function'
      ? learnerContextService.getStorageHealth()
      : null;
    const sessionInfo = sessionStore?.getStoreInfo?.() || null;
    const sessionHealth = sessionInfo?.health || null;
    return {
      learner: learner ? {
        status: learner.writeBlocked ? 'failed' : (learner.status || 'unknown'),
        writeBlocked: learner.writeBlocked === true,
        writeBlockedLearners: Number(learner.writeBlockedLearners) || 0,
        recoveries: Number(learner.recoveries) || 0,
        failures: Number(learner.failures) || 0,
        structuredMemoryEnabled: learner.structuredMemoryEnabled === true,
        eventMaxBytes: Number(learner.eventMaxBytes) || null,
      } : {
        status: 'unavailable',
        writeBlocked: false,
      },
      sessions: sessionInfo ? {
        status: sessionInfo.writeBlocked
          ? 'failed'
          : (sessionHealth?.status || 'unknown'),
        writeBlocked: sessionInfo.writeBlocked === true,
        recoveries: Number(sessionHealth?.recoveries) || 0,
        failures: Number(sessionHealth?.failures) || 0,
        schemaVersion: sessionInfo.schemaVersion || null,
      } : {
        status: 'disabled',
        writeBlocked: false,
      },
    };
  }

  async function runStandaloneReadinessProbes() {
    const startedAt = Date.now();
    let trainerSessionPayload = null;
    const probes = [];
    probes.push(await runReadinessProbe('learnerMemoryStore', 'Learner memory store', async () => {
      const health = getMemoryStorageHealthSummary().learner;
      return {
        status: health.writeBlocked ? 'offline' : 'online',
        detail: health.writeBlocked
          ? 'Learner memory writes are blocked pending recovery or deletion.'
          : `Learner memory store is ${health.status}.`,
        metadata: {
          status: health.status,
          recoveries: health.recoveries || 0,
          failures: health.failures || 0,
        },
      };
    }));
    probes.push(await runReadinessProbe('sessionStoreWrite', 'Session store write', async () => {
      if (!sessionStore) {
        return {
          status: 'degraded',
          detail: 'Session persistence is disabled for this runtime.',
        };
      }
      const info = sessionStore.getStoreInfo();
      if (info?.writeBlocked) {
        return {
          status: 'degraded',
          detail: info.writeBlockedReason || 'Session store writes are blocked.',
          metadata: { storePath: info.storePath || null },
        };
      }
      const result = sessionStore.saveSessions(sessions);
      if (result?.blocked) {
        return {
          status: 'degraded',
          detail: result.reason || 'Session store write was blocked.',
          metadata: { storePath: info?.storePath || null },
        };
      }
      return {
        status: result?.saved ? 'online' : 'degraded',
        detail: result?.saved ? `Saved ${result.count || 0} session record(s).` : 'Session store did not save.',
        metadata: { storePath: info?.storePath || null },
      };
    }));

    probes.push(await runReadinessProbe('voiceTrainerSession', 'VoiceTrainer session start', async () => {
      trainerSessionPayload = await callVoiceTrainer('/api/v1/voice/sessions/start', {
        method: 'POST',
        timeoutMs: 10000,
        body: {
          sloaneSessionId: `readiness-${crypto.randomUUID()}`,
          targetPreset: 'australian-bright-feminine',
          lessonId: 'standalone-readiness',
          referenceClipId: null,
          memoryEnabled: false,
        },
      });
      if (!normalizeText(trainerSessionPayload?.voiceSessionId, 200)) {
        return {
          status: 'degraded',
          detail: 'VoiceTrainer responded without a voiceSessionId.',
          metadata: { status: trainerSessionPayload?.status || null },
        };
      }
      return {
        status: 'online',
        detail: `Started VoiceTrainer session ${trainerSessionPayload.voiceSessionId}.`,
        metadata: {
          voiceSessionId: trainerSessionPayload.voiceSessionId,
          streamUrl: trainerSessionPayload.streamUrl || null,
        },
      };
    }));

    probes.push(await runReadinessProbe('voiceTrainerStream', 'VoiceTrainer stream frame', async () => {
      const streamUrl = normalizeText(trainerSessionPayload?.streamUrl, 1000);
      if (!streamUrl) {
        return {
          status: 'degraded',
          detail: 'VoiceTrainer session did not return a stream URL.',
        };
      }
      const result = await probeVoiceTrainerStream(streamUrl);
      return {
        status: result?.frame ? 'online' : 'degraded',
        detail: result?.frame ? 'Received an analyzable stream frame.' : 'Stream opened but returned no frame payload.',
        metadata: {
          voiced: result?.frame?.voiced ?? null,
          meanPitchHz: result?.frame?.metrics?.meanPitchHz ?? null,
        },
      };
    }));

    probes.push(await runReadinessProbe('voiceTrainerCleanup', 'VoiceTrainer cleanup', async () => (
      cleanupVoiceTrainerReadinessSession(trainerSessionPayload)
    )));

    probes.push(await runReadinessProbe('voiceTutorGgufChat', 'GGUF chat completion', async () => {
      const reply = await callVoiceTutorModel([
        {
          role: 'system',
          content: 'You are a concise standalone voice tutor readiness probe. Reply with exactly: voice tutor ready',
        },
        {
          role: 'user',
          content: 'readiness check',
        },
      ], {
        // Thinking-model headroom: hidden reasoning precedes the answer, so a
        // 12-token cap returned empty content and failed the probe.
        maxTokens: 1024,
        temperature: 0,
        timeoutMs: 20000,
      });
      if (!reply) {
        return {
          status: 'offline',
          detail: 'GGUF runtime returned an empty chat completion.',
        };
      }
      return {
        status: 'online',
        detail: `Generated ${reply.length} character(s).`,
        metadata: { sample: reply.slice(0, 120) },
      };
    }));

    if (config.voxcpmEnabled) {
      probes.push(await runReadinessProbe('voxcpmModel', 'VoxCPM model loaded', async () => {
        const result = await probeVoxCpmHealth(1500);
        return {
          status: result.status,
          detail: result.detail,
          metadata: { available: result.available },
        };
      }));
    }

    if (config.voiceAsrEnabled) {
      probes.push(await runReadinessProbe('voiceAsr', 'Voice ASR available', async () => {
        const result = await voiceInputAsrBridge.getStatus({ refresh: true });
        return {
          status: result?.available === true ? 'online' : 'offline',
          detail: result?.available === true ? 'Voice ASR is ready.' : (result?.reason || 'Voice ASR is unavailable.'),
          metadata: {
            apiStyle: result?.apiStyle || null,
            liveMode: result?.liveMode || null,
          },
        };
      }));
    }

    const status = probes.some((probe) => probe.status === 'offline')
      ? 'offline'
      : probes.some((probe) => probe.status === 'degraded')
        ? 'degraded'
        : 'online';
    return {
      success: status === 'online',
      service: 'voice-tutor-standalone',
      source: 'active-readiness',
      status,
      checkedAt: new Date().toISOString(),
      durationMs: Date.now() - startedAt,
      cached: false,
      cacheTtlMs: 30000,
      probes,
    };
  }

  const standaloneReadinessCacheTtlMs = 30000;
  let standaloneReadinessCache = null;
  let standaloneReadinessInFlight = null;

  function decorateStandaloneReadinessPayload(payload, options = {}) {
    const cloned = cloneJsonValue(payload);
    cloned.cached = options.cached === true;
    cloned.inFlightShared = options.inFlightShared === true;
    cloned.cacheTtlMs = standaloneReadinessCacheTtlMs;
    if (standaloneReadinessCache?.cachedAt) {
      cloned.cachedAt = new Date(standaloneReadinessCache.cachedAt).toISOString();
      cloned.cacheAgeMs = Math.max(0, Date.now() - standaloneReadinessCache.cachedAt);
    }
    return cloned;
  }

  async function getStandaloneReadiness(options = {}) {
    const force = options.force === true;
    const now = Date.now();
    if (
      !force
      && standaloneReadinessCache
      && now - standaloneReadinessCache.cachedAt <= standaloneReadinessCacheTtlMs
    ) {
      return decorateStandaloneReadinessPayload(standaloneReadinessCache.payload, { cached: true });
    }
    if (standaloneReadinessInFlight) {
      const payload = await standaloneReadinessInFlight;
      return decorateStandaloneReadinessPayload(payload, { inFlightShared: true });
    }
    standaloneReadinessInFlight = runStandaloneReadinessProbes()
      .then((payload) => {
        standaloneReadinessCache = {
          payload,
          cachedAt: Date.now(),
        };
        return payload;
      })
      .finally(() => {
        standaloneReadinessInFlight = null;
      });
    const payload = await standaloneReadinessInFlight;
    return decorateStandaloneReadinessPayload(payload);
  }

  // ── CoachingSignal-powered coaching ──

  function resolveLessonState(session) {
    if (session.lessonState) {
      return LessonState.fromJSON(session.lessonState);
    }
    return null;
  }

  function persistLessonState(session, lessonState) {
    session.lessonState = lessonState.toJSON();
  }

  /**
   * Post-process a raw coach reply through the card-authoring channel.
   *
   * Strips any trailing ```card-ops``` block (so it never reaches TTS), validates
   * the directive, applies surviving ops to the session's practice card, and
   * returns the visible text plus the payload fields the surface consumes.
   *
   * Crash-proof: ANY error (parse, validate, apply) is swallowed and the function
   * behaves as if the reply carried no ops — the visible text falls back to the
   * original reply so the coach bubble is never lost.
   */
  function processCoachReplyCardOps(session, rawReply, {
    targetPreset,
    allowMeasurementDerivedOps = true,
  } = {}) {
    const fallback = {
      say: String(rawReply || '').trim(),
      activeCard: null,
      cardOpsApplied: 0,
      replayDirective: null,
      cardOpsSuppressed: null,
    };
    try {
      const sessionId = session?.id;
      if (!sessionId) {
        return { ...fallback, activeCard: practiceCards.getActiveCard(sessionId) };
      }
      const preset = targetPreset
        || session?.voiceState?.targetPreset
        || 'cute-feminine';

      const { say, ops } = extractCardOps(rawReply);
      const visible = say || fallback.say;

      if (!ops) {
        return {
          say: visible,
          activeCard: practiceCards.getActiveCard(sessionId),
          cardOpsApplied: 0,
          replayDirective: null,
          cardOpsSuppressed: null,
        };
      }

      if (!allowMeasurementDerivedOps) {
        return {
          say: visible,
          activeCard: practiceCards.getActiveCard(sessionId),
          cardOpsApplied: 0,
          replayDirective: null,
          cardOpsSuppressed: 'measurement_unusable',
        };
      }

      const validated = validateCardOps(ops);
      let applied = 0;
      let focusContext;
      if (validated.focusUpdate) {
        focusContext = validated.focusUpdate.direction
          || validated.focusUpdate.axis
          || '';
      }

      if (validated.ops.length > 0) {
        const result = practiceCards.applyCardOps(sessionId, validated.ops, {
          targetPreset: preset,
          focus: focusContext,
        });
        applied = result.applied;
      }

      // A focus_update with no create/swap still re-statements the active card's
      // focus (re-emphasis of the same phrase under a new axis is a UI concern;
      // here we record the focus on the active card so the surface can re-render).
      if (validated.focusUpdate && practiceCards.getActiveCard(sessionId)) {
        const current = practiceCards.getActiveCard(sessionId);
        const nextFocus = { ...current.focus, ...validated.focusUpdate };
        practiceCards.setActiveCard(sessionId, { ...current, focus: nextFocus });
      }

      return {
        say: visible,
        activeCard: practiceCards.getActiveCard(sessionId),
        cardOpsApplied: applied,
        replayDirective: validated.replay || null,
        cardOpsSuppressed: null,
      };
    } catch (error) {
      logger?.warn?.(`[Voice] card-ops post-processing failed: ${error?.message || error}`);
      return fallback;
    }
  }

  /**
   * 2026-07-26 phase C — apply an isolation-loop verdict to the live session.
   *
   * The transition itself was decided purely (coaching/section-loop.js); this is the
   * only place its three consequences happen, so the buffered and streaming coach
   * paths cannot drift on any of them:
   *
   *   1. THE CARD. `isolate` stashes the whole-sentence card and puts the 1-3 word
   *      fragment on the strip; `restore` puts the sentence back exactly as it was.
   *      This runs AFTER the model's own card-ops have been applied, deliberately:
   *      the loop's card decision is the app's, and a model that tried to swap the
   *      phrase on an entry turn must not be able to clobber the fragment it was
   *      just told to drill.
   *   2. THE STATE. sectionLoop + sectionLoopLastTakeKey are written through
   *      updateSessionVoiceState so they are normalized and persisted like every
   *      other voice-state field.
   *   3. THE WITNESS. One structured line per transition, in the existing style.
   *
   * Returns the active card after the swap (or null), so the caller can put the
   * truthful card in the session payload. Never throws — a telemetry or card failure
   * must never break a coach turn.
   */
  function applySectionLoopOutcome(session, loopResult, { targetPreset = 'cute-feminine' } = {}) {
    if (!session || !loopResult || typeof loopResult !== 'object') return null;
    const sessionId = session.id;
    // An ISOLATE whose card swap did not happen must not open a loop. Otherwise the
    // coach spends three turns drilling a fragment the learner cannot see, and the
    // pedagogy ("isolate the fragment ONTO the practice card") is silently only half
    // performed. Fail-closed: no fragment on screen, no isolation.
    let isolated = false;
    try {
      if (loopResult.cardAction === 'isolate'
        && loopResult.sectionLoop
        && typeof practiceCards.stashActiveCard === 'function') {
        const spec = buildFragmentCardSpec(loopResult.sectionLoop, { targetPreset });
        if (spec) {
          practiceCards.stashActiveCard(sessionId, createPracticeCard(spec));
          isolated = practiceCards.getActiveCard(sessionId)?.phrase === spec.phrase;
        }
      } else if (loopResult.cardAction === 'restore'
        && typeof practiceCards.restoreStashedCard === 'function') {
        // The stashed sentence is preferred; the loop's own recorded phrase (still on
        // the PRE-write voice state here) is the fallback for the case where the stash
        // was lost — a fresh process, a cleared store — so the learner is never left
        // staring at a fragment with no way back to the line.
        const phrase = session.voiceState?.sectionLoop?.phrase || '';
        // source 'tutor', NOT 'fallback': the frontend auto-speaks a card whose
        // source is 'fallback' (frontend/src/voice/lesson/controller.ts), so a
        // stash-loss exit would make the app read the whole sentence aloud
        // unprompted — a spoken surprise caused by an internal recovery path.
        practiceCards.restoreStashedCard(sessionId, phrase
          ? { phrase, difficulty: 'easy', source: 'tutor', targetPreset }
          : null);
      }
    } catch (error) {
      logger?.warn?.(`[Voice] section-loop card swap failed: ${error?.message || error}`);
    }

    // However the isolation ended, rearm the takeover detector for the next one.
    // (`restore` already clears it inside the store; this covers the exits that do
    // NOT restore — card takeover itself, where the newer card is left alone.)
    if (!loopResult.sectionLoop && typeof practiceCards.clearCardTakeover === 'function') {
      try { practiceCards.clearCardTakeover(sessionId); } catch { /* best-effort */ }
    }

    const isolateFailed = loopResult.cardAction === 'isolate' && !isolated;
    try {
      session.voiceState = voiceStateRuntime.updateSessionVoiceState(session, {
        sectionLoop: isolateFailed ? null : (loopResult.sectionLoop || null),
        sectionLoopLastTakeKey: loopResult.lastTakeKey || null,
      });
    } catch (error) {
      logger?.warn?.(`[Voice] section-loop state write failed: ${error?.message || error}`);
    }

    // One structured line per TRANSITION. A hold turn (the learner spoke to the
    // coach mid-isolation) changes nothing and deliberately logs nothing, so the
    // journal stays a record of decisions rather than of turns.
    const witness = loopResult.witness;
    if (isolateFailed) {
      logger?.log?.({
        event: 'coach_section_loop',
        state: 'entry_abandoned',
        attempts: 0,
        max_attempts: witness?.maxAttempts ?? null,
        axis: witness?.axis ?? null,
        fragment_tokens: null,
        measurement_usable: null,
        cue_id: null,
        reason: 'fragment_card_not_authored',
      });
      pushRuntimeWitness('warn', 'coach-section-loop', 'Isolation was abandoned: the fragment card could not be authored.', {
        outcome: 'entry_abandoned',
        axis: witness?.axis ?? null,
      });
    } else if (witness && loopResult.transition) {
      logger?.log?.({
        event: 'coach_section_loop',
        state: witness.state,
        attempts: witness.attempts ?? 0,
        // Read off the WITNESS, not off the surviving loop: on every exit the loop
        // is already null, and the cap it was working against is exactly what a
        // reader of an `exited_cap` line needs to see.
        max_attempts: witness.maxAttempts ?? null,
        axis: witness.axis ?? null,
        fragment_tokens: witness.fragment
          ? String(witness.fragment).split(/\s+/).filter(Boolean).length
          : null,
        measurement_usable: witness.usable,
        cue_id: witness.cueId ?? null,
        reason: witness.reason ?? null,
      });
      pushRuntimeWitness('info', 'coach-section-loop', 'Sentence-teardown isolation loop changed state.', {
        outcome: witness.state,
        attempts: witness.attempts ?? 0,
        axis: witness.axis ?? null,
        measurement_usable: witness.usable,
        cue_id: witness.cueId ?? null,
      });
    }

    try {
      return practiceCards.getActiveCard(sessionId) || null;
    } catch {
      return null;
    }
  }

  /**
   * Post-process a raw coach reply through the MEMORY-writing channel (v4).
   *
   * Strips ONLY a trailing ```remember-ops``` block (so it never reaches TTS),
   * validates the remember directive, applies the surviving ops to the learner's
   * profile, and returns the block-stripped visible text plus memoryOpsApplied.
   *
   * COMPOSES WITH card-ops: this runs FIRST and excises only the remember-ops
   * block, leaving any trailing card-ops block intact for processCoachReplyCardOps
   * downstream (extractMemoryOps preserves a sibling block at the tail).
   *
   * Crash-proof: ANY error (parse, validate, apply) is swallowed and the function
   * behaves as if the reply carried no remember block — the visible text falls
   * back to the original reply so the coach bubble is never lost.
   */
  /**
   * Wave 2A — DETERMINISTIC, LLM-FREE memory capture from the learner's OWN
   * utterance. Runs on EVERY coach turn, independent of the model, so a stated
   * coaching preference is captured even when the GGUF is offline (buildFallbackReply
   * emits no remember-ops block — the gap this closes). Emits the closed-list ops
   * from coaching/memory-extract and routes them through the SAME applyMemoryOps the
   * model channel uses; idempotent (the service dedupes coachPreferences by
   * lowercased text). Crash-proof: any failure is swallowed so the turn is unaffected.
   */
  function captureDeterministicLearnerMemory(studentId, transcript) {
    try {
      const sid = studentId || config.defaultStudentId;
      if (!sid) return 0;
      const ops = extractDeterministicMemoryOps(transcript);
      if (!ops.length) return 0;
      return applyMemoryOps(learnerContextService, sid, ops);
    } catch (error) {
      logger?.warn?.(`[Voice] deterministic memory capture failed: ${error?.message || error}`);
      return 0;
    }
  }

  function processCoachReplyMemoryOps(session, rawReply, utterance = '') {
    const fallback = {
      say: String(rawReply || '').trim(),
      memoryOpsApplied: 0,
    };
    try {
      const studentId = session?.studentId || config.defaultStudentId;
      const { say, ops } = extractMemoryOps(rawReply);
      const visible = say || fallback.say;
      if (!ops) {
        return { say: visible, memoryOpsApplied: 0 };
      }
      const validated = validateMemoryOps(ops);
      let applied = 0;
      if (validated.ops.length > 0) {
        // v6 FAITHFULNESS: verify free-text remembers against the learner's recent
        // words (this turn + the last few user turns) so an invented fact is dropped.
        const recentUser = (session?.voiceState?.coachThread || [])
          .filter((m) => m && m.role === 'user')
          .slice(-3)
          .map((m) => (m && (m.text || m.content)) || '')
          .join(' ');
        applied = applyMemoryOps(learnerContextService, studentId, validated.ops, {
          utterance: `${utterance} ${recentUser}`,
        });
      }
      return { say: visible, memoryOpsApplied: applied };
    } catch (error) {
      logger?.warn?.(`[Voice] memory-ops post-processing failed: ${error?.message || error}`);
      return fallback;
    }
  }

  async function ensureLessonPlan(session) {
    const lessonState = resolveLessonState(session);
    if (lessonState && lessonState.status !== 'idle') return lessonState;

    const voiceState = voiceStateRuntime.normalizeVoiceState(session.voiceState);
    const studentId = session.studentId || config.defaultStudentId;
    const learnerContext = await learnerContextService.getVoiceStudentModelSnapshot(studentId).catch(() => null);

    // B-SESS: the session's shape constrains what the planner may plan (quiet ->
    // hum/soft-onset only; silent -> listening/planning only; eyesFree ->
    // spoken-first). Never any time/minutes language.
    const sessionScope = normalizeSessionScope(session.sessionScope);
    const plan = await planLesson(voiceState, learnerContext, async (messages, opts) => {
      return callVoiceTutorModel(messages, opts);
    }, sessionScope);

    const newLessonState = new LessonState();
    newLessonState.applyPlan(plan);
    persistLessonState(session, newLessonState);
    logger?.log?.({
      event: 'lesson_scope',
      tier: sessionScope.tier,
      eyesFree: sessionScope.eyesFree,
    });
    return newLessonState;
  }

  function detectPracticeMode(question) {
    return /(?:chat|talk|conversation|off topic|normal)/i.test(question)
      ? 'conversation_practice'
      : 'active_drill';
  }

  // Eval turn counter per session
  const evalTurnCounters = new Map();
  // Per-turn telemetry store: turnId -> TurnTelemetry (allows the GET endpoint
  // and the frontend POST updates to share one record per turn).
  const turnTelemetryStore = new Map();
  const turnTelemetryCorrelationStore = new Map();
  const turnTelemetryTimestamps = new Map();
  const TELEMETRY_TTL_MS = 60 * 60 * 1000; // 1 hour
  const TELEMETRY_MAX_SIZE = 5000;

  function evictExpiredTelemetry() {
    const now = Date.now();
    for (const [turnId, timestamp] of turnTelemetryTimestamps) {
      if (now - timestamp > TELEMETRY_TTL_MS) {
        turnTelemetryCorrelationStore.delete(deriveTelemetryCorrelationId(turnId));
        turnTelemetryStore.delete(turnId);
        turnTelemetryTimestamps.delete(turnId);
      }
    }
    if (turnTelemetryStore.size > TELEMETRY_MAX_SIZE) {
      const entries = Array.from(turnTelemetryTimestamps.entries())
        .sort((a, b) => a[1] - b[1]);
      const toRemove = entries.slice(0, entries.length - TELEMETRY_MAX_SIZE);
      for (const [turnId] of toRemove) {
        turnTelemetryCorrelationStore.delete(deriveTelemetryCorrelationId(turnId));
        turnTelemetryStore.delete(turnId);
        turnTelemetryTimestamps.delete(turnId);
      }
    }
  }
  setInterval(() => {
    evictExpiredTelemetry();
    // B-SESS: piggyback the stale-session cut-short sweep on the existing
    // 5-minute maintenance tick (cheapest existing periodic hook; internal only).
    sweepStaleCutShortSessions();
  }, 5 * 60 * 1000).unref();
  // Per-session history: sessionId -> Array<TurnTelemetry> (we materialize to
  // JSON on read so the latest state is always reflected, even when
  // storeTurnTelemetry is called before the caller finishes updating fields).
  const sessionTelemetryHistory = new Map();
  const SESSION_TELEMETRY_HISTORY_LIMIT = 200;

  function storeTurnTelemetry(turnId, telemetry) {
    if (!turnId || !telemetry) return;
    turnTelemetryStore.set(turnId, telemetry);
    const correlationId = deriveTelemetryCorrelationId(turnId);
    if (correlationId) turnTelemetryCorrelationStore.set(correlationId, telemetry);
    turnTelemetryTimestamps.set(turnId, Date.now());
    evictExpiredTelemetry();
    const sessionId = telemetry.sessionId || null;
    if (sessionId) {
      const list = sessionTelemetryHistory.get(sessionId) || [];
      // Replace any prior entry for the same turnId so updates don't double-count.
      const existingIdx = list.findIndex((entry) => entry?.turnId === turnId);
      if (existingIdx >= 0) {
        list[existingIdx] = telemetry;
      } else {
        list.push(telemetry);
        while (list.length > SESSION_TELEMETRY_HISTORY_LIMIT) {
          list.shift();
        }
      }
      sessionTelemetryHistory.set(sessionId, list);
    }
  }

  function getTurnTelemetry(turnId) {
    return turnTelemetryStore.get(turnId) || turnTelemetryCorrelationStore.get(turnId) || null;
  }

  function logTurnTelemetry(telemetry, extra = {}) {
    if (!telemetry) return;
    const summary = telemetry.getSummary();
    logger?.log?.({
      event: 'turn_telemetry',
      llm_ms: summary.latency.llm_ms,
      llm_ttft_ms: summary.latency.llm_ttft_ms,
      tts_request_ms: summary.latency.tts_request_ms,
      tts_first_byte_ms: summary.latency.tts_first_byte_ms,
      tts_total_ms: summary.latency.tts_total_ms,
      time_to_first_audio_ms: summary.latency.time_to_first_audio_ms,
      total_turn_ms: summary.latency.total_turn_ms,
      fallback_reason: summary.fallback_reason,
      ...extra,
    });
  }

  // 2026-07-18 truth+safety witnesses: one structured line per coach turn when a
  // gate DECIDED something (two-tier strain fire/suppress, profile-capped
  // thresholds, praise suppression, adapt-by-misses). Quiet on clean turns so
  // the log stays readable. Mirrors the logTurnTelemetry object-line style.
  function logCoachDecisionWitness(telemetry, signal, { audioProvided = false } = {}) {
    const witness = signal?.decisionWitness;
    if (!witness) return;
    const strain = witness.safety?.strain || null;
    const breathy = witness.safety?.breathy || null;
    const praiseGuard = witness.intent?.praiseGuard || null;
    const misses = Number(witness.consecutiveMisses) || 0;
    const metricContract = witness.metricContract || null;
    const metricFailures = Array.isArray(metricContract?.failures)
      ? metricContract.failures.slice(0, 12)
      : [];
    const legacyMetricFields = Array.isArray(metricContract?.legacyMetricFields)
      ? metricContract.legacyMetricFields.slice(0, 12)
      : [];
    const targetIdentityFailures = Array.isArray(metricContract?.targetIdentityFailures)
      ? metricContract.targetIdentityFailures.slice(0, 8)
      : [];
    const audioSuppressed = Boolean(audioProvided && signal?.takeQuality?.usable === false);
    // 2026-07-26 (Defect 3): one line, only when the stale-take gate actually
    // fired. A healthy turn — take finalized inside this turn window, or no
    // window to test against — emits nothing here.
    const takeFreshness = witness.intent?.takeFreshness || null;
    if (takeFreshness?.gated === true) {
      logger?.log?.({
        event: 'coach_take_freshness',
        outcome: 'stale_take_evidence_ignored',
        reason: takeFreshness.reason,
        intent: witness.intent?.resolved ?? null,
      });
      pushRuntimeWitness('warn', 'coach-take-freshness', 'Stale take evidence was ignored for this coach turn.', {
        outcome: 'stale_take_evidence_ignored',
        reason: takeFreshness.reason,
        intent: witness.intent?.resolved ?? null,
      });
    }
    if (targetIdentityFailures.length > 0) {
      logger?.log?.({
        event: 'coach_target_identity',
        failures: targetIdentityFailures,
        target_source: normalizeVoiceTargetSourceCategory(metricContract?.targetSource),
        target_profile_present: Boolean(metricContract?.targetProfileId),
        longitudinal_history: 'suppressed',
      });
      pushRuntimeWitness('warn', 'coach-target-identity', 'Longitudinal target comparison was suppressed.', {
        outcome: 'suppressed',
        failures: targetIdentityFailures,
        target_source: normalizeVoiceTargetSourceCategory(metricContract?.targetSource),
        target_profile_present: Boolean(metricContract?.targetProfileId),
      });
    }
    if (metricFailures.length || legacyMetricFields.length || audioSuppressed) {
      logger?.log?.({
        event: 'coach_metric_contract',
        failures: metricFailures,
        measurement_available: metricContract?.measurementAvailable ?? null,
        measurement_rejection_reasons: metricContract?.measurementRejectionReasons || [],
        analysis_version: metricContract?.analysisVersion ?? null,
        sample_count: metricContract?.sampleCount ?? null,
        voiced_frame_pct: metricContract?.voicedFramePct ?? null,
        confident_frame_pct: metricContract?.confidentFramePct ?? null,
        score_confidence: metricContract?.scoreConfidence ?? null,
        capture_reliability: metricContract?.captureReliability ?? null,
        snr_db: metricContract?.snrDb ?? null,
        clipping_pct: metricContract?.clippingPct ?? null,
        pitch_valid_frame_count: metricContract?.pitchValidFrameCount ?? null,
        target_contract_present: metricContract?.targetContractPresent ?? false,
        target_preset: metricContract?.targetPreset ?? null,
        target_source: normalizeVoiceTargetSourceCategory(metricContract?.targetSource),
        target_profile_present: Boolean(metricContract?.targetProfileId),
        target_direction: metricContract?.targetDirection ?? null,
        target_bands: metricContract?.targetBands || null,
        uncertain_axis_count: metricContract?.uncertainAxisCount ?? null,
        legacy_metric_fields: legacyMetricFields,
        hnr_valid_frame_count: metricContract?.hnrValidFrameCount ?? null,
        hnr_voiced_coverage_pct: metricContract?.hnrVoicedCoveragePct ?? null,
        audio_suppressed: audioSuppressed,
      });
      pushRuntimeWitness('warn', 'coach-metric-contract', 'Voice metric contract required a guarded fallback.', {
        outcome: 'guarded',
        failures: metricFailures,
        legacy_metric_fields: legacyMetricFields,
        measurement_available: metricContract?.measurementAvailable ?? null,
        target_contract_present: metricContract?.targetContractPresent ?? false,
        target_source: normalizeVoiceTargetSourceCategory(metricContract?.targetSource),
        target_direction: metricContract?.targetDirection ?? null,
        target_profile_present: Boolean(metricContract?.targetProfileId),
        uncertain_axis_count: metricContract?.uncertainAxisCount ?? null,
        audio_suppressed: audioSuppressed,
      });
    }
    // 2026-07-26 phase B (sentence teardown): the per-section localization
    // witness. `takeSections` is present on the decision witness ONLY when the
    // scorer actually ran (fresh take AND card tokens), so a takeless turn adds
    // nothing here and emits no line it would not have emitted before.
    const takeSections = witness.takeSections || null;
    // 2026-07-28: the capture-latch context (state + reasons + derived capture
    // reliability). A latched turn is by definition not clean, so it is always
    // noteworthy — the next capture_only latch must be diagnosable from the
    // journal instead of invisible behind a null praise_guard.
    const safetyState = typeof witness.safetyState === 'string' ? witness.safetyState : null;
    const safetyReasons = Array.isArray(witness.safetyReasons) ? witness.safetyReasons.slice(0, 8) : [];
    const captureReliability = typeof witness.captureReliability === 'string'
      ? witness.captureReliability
      : null;
    // 2026-07-26 phase C: present ONLY on a turn where the isolation loop actually
    // moved, so a session that never tears a sentence apart logs zero extra fields
    // and the line's shape is byte-identical to before.
    const sectionLoop = witness.sectionLoop || null;
    const noteworthy = Boolean(
      (strain && strain.tier)
      || (breathy && breathy.tier)
      || (praiseGuard && praiseGuard.startsWith('suppressed'))
      || misses >= 2
      || (strain && strain.source === 'profile-capped')
      || (breathy && breathy.source === 'profile-capped')
      || safetyState === 'capture_only'
      || metricFailures.length
      || legacyMetricFields.length
      || targetIdentityFailures.length
      // A confidently-named weak fragment is exactly the event this witness
      // exists to record. Without this clause an otherwise-clean take with one
      // bad word would localize blame and log nothing, which is the failure
      // mode that made this instrumentation necessary in the first place.
      || takeSections?.worstConfident === true
      // Every isolation transition is noteworthy by construction: entering, retrying
      // and every exit are the decisions this witness exists to record.
      || Boolean(sectionLoop)
    );
    if (!noteworthy) return;
    logger?.log?.({
      event: 'coach_gates',
      threshold_source: strain?.source || breathy?.source || 'contract',
      strain_risk: strain?.risk ?? null,
      strain_warn: strain?.warn ?? null,
      strain_stop: strain?.stop ?? null,
      strain_tier: strain?.tier ?? null,
      take_kind: strain?.takeKind ?? null,
      take_kind_source: witness.takeKind?.source ?? null,
      strain_interpretation: strain?.interpretation ?? null,
      breathy_risk: breathy?.risk ?? null,
      breathy_warn: breathy?.warn ?? null,
      breathy_tier: breathy?.tier ?? null,
      guardian_strikes: strain?.strikes ?? 0,
      strikes_required: strain?.strikesRequired ?? null,
      praise_guard: praiseGuard,
      intent: witness.intent?.resolved ?? null,
      safety_state: safetyState,
      safety_reasons: safetyReasons,
      capture_reliability: captureReliability,
      consecutive_misses: misses,
      metric_failures: metricFailures,
      // Phase B worst-section fields, spread in only when sections were computed
      // so the line's shape is byte-identical to before on every other turn.
      ...(takeSections ? {
        worst_section_tokens: takeSections.worstTokenStart == null
          ? null
          : `${takeSections.worstTokenStart}-${takeSections.worstTokenEnd}`,
        worst_section_axis: takeSections.worstAxis ?? null,
        worst_section_confident: takeSections.worstConfident === true,
        worst_section_count: takeSections.sectionCount ?? null,
        worst_section_alignment: takeSections.alignment ?? null,
      } : {}),
      // Phase C: the isolation loop's state on this turn. Same spread-only-when-real
      // discipline as the phase-B fields above.
      ...(sectionLoop ? {
        section_loop: {
          state: sectionLoop.state,
          attempts: sectionLoop.attempts ?? 0,
        },
      } : {}),
    });
  }

  // Sanitizer vocab witness: logged only when the banned-vocabulary guard
  // actually replaced something in the visible coach line.
  function logSanitizerWitness(telemetry, sanitizerWitness) {
    if (sanitizerWitness?.captureRepairCause) {
      logger?.log?.({
        event: 'sanitizer_capture_repair',
        cause: sanitizerWitness.captureRepairCause,
      });
      pushRuntimeWitness('warn', 'sanitizer-capture-repair', 'Model capture explanation was replaced with measured-cause guidance.', {
        outcome: 'replaced',
        cause: sanitizerWitness.captureRepairCause,
      });
    }
    if (sanitizerWitness?.coreLoopRepairCause) {
      logger?.log?.({
        event: 'sanitizer_core_loop_repair',
        cause: sanitizerWitness.coreLoopRepairCause,
      });
      pushRuntimeWitness('warn', 'sanitizer-core-loop-repair', 'Renderer padding was replaced with an application-derived voice cue.', {
        outcome: 'replaced',
        cause: sanitizerWitness.coreLoopRepairCause,
      });
    }
    const hits = sanitizerWitness?.vocabHits;
    if (Array.isArray(hits) && hits.length > 0) {
      logger?.log?.({
        event: 'sanitizer_vocab',
        hits: hits.map((h) => `${h.match}->${h.replacement}`).slice(0, 12),
      });
    }
    const pressureHits = sanitizerWitness?.repPressureHits;
    if (Array.isArray(pressureHits) && pressureHits.length > 0) {
      const rules = [...new Set(pressureHits.map((hit) => String(hit || '')).filter(Boolean))].slice(0, 8);
      logger?.log?.({
        event: 'sanitizer_rep_pressure',
        replacement_count: pressureHits.length,
        rules,
      });
      pushRuntimeWitness('warn', 'sanitizer-rep-pressure', 'Model reply pressure language was replaced.', {
        outcome: 'replaced',
        replacement_count: pressureHits.length,
        rules,
      });
    }
    const sessionControlHits = sanitizerWitness?.sessionControlHits;
    if (Array.isArray(sessionControlHits) && sessionControlHits.length > 0) {
      pushRuntimeWitness('warn', 'sanitizer-session-control', 'Model session-control or messaging language was replaced.', {
        outcome: 'replaced',
        replacement_count: sessionControlHits.length,
      });
      logger?.log?.({
        event: 'sanitizer_session_control',
        replacement_count: sessionControlHits.length,
      });
    }
  }

  function createTurnId() {
    if (typeof crypto.randomUUID === 'function') {
      return `turn-${crypto.randomUUID()}`;
    }
    return `turn-${Date.now().toString(36)}-${Math.random().toString(16).slice(2)}`;
  }

  function recordEvalTurn(session, question, result, durationMs) {
    if (!config.evalPath) return;
    const sessionId = session.id;
    const turnIndex = evalTurnCounters.get(sessionId) || 0;
    evalTurnCounters.set(sessionId, turnIndex + 1);

    const record = createTurnRecord({
      sessionId,
      studentId: session.studentId || config.defaultStudentId,
      turnIndex,
      turnId: result?.turnId || null,
      signal: result.signal,
      rendererMessages: result.messages,
      rawReply: result.rawReply,
      sanitizedReply: result.sanitizedReply,
      userMessage: question,
      practiceMode: result.signal?.mode || detectPracticeMode(question),
      targetPreset: result.signal?.styleTarget,
      promptTokens: result.promptTokens,
      durationMs,
      modelUsed: config.voiceTutorGgufModel,
      telemetry: result?.telemetry || null,
    }, {
      captureText: captureEvalText,
      isolatedEvaluation,
    });

    try {
      appendTurnRecord(config.evalPath, record);
    } catch {
      // Best-effort eval recording — don't fail coaching for this
    }
  }

  async function generateRealtimeCoachReply(
    session,
    question,
    audioBase64,
    audioFormat,
    listeningTurn = null,
  ) {
    const start = Date.now();
    const voiceState = resolveListeningTurnVoiceState(session, listeningTurn);
    const practiceMode = detectPracticeMode(question);
    const lessonState = resolveLessonState(session);
    const studentId = session.studentId || config.defaultStudentId;
    // Wave 2A: deterministic, LLM-free preference capture from the learner's
    // utterance, BEFORE the snapshot load so a just-stated preference shapes THIS
    // turn's memo. Always-on (works even when the model is offline).
    captureDeterministicLearnerMemory(studentId, question);
    const learnerContext = await learnerContextService.getVoiceStudentModelSnapshot(studentId).catch(() => null);

    // Per-turn observability. The frontend may already have marked
    // speech_end_at (and may post updates later for first_audio_at and
    // playback_done_at) — we use a fresh TurnTelemetry per turn.
    const telemetry = new TurnTelemetry({
      turnId: createTurnId(),
      sessionId: session.id,
    });

    // VoiceTrainer acoustic analysis: the live voice state already carries
    // the latest take summary from /voice/take; we treat its presence as
    // "voice_trainer_done" and stamp it. If the frontend posted a fresher
    // timestamp earlier it will overwrite this via the POST endpoint.
    if (voiceState.lastSummary) {
      telemetry.mark('voice_trainer_done_at', { source: 'gateway' });
    }

    const result = await coachingTurn({
      voiceState,
      learnerContext,
      lessonState: lessonState ? {
        currentKnowledgePoint: lessonState.getCurrentPoint(),
        lessonBoard: { title: lessonState.lessonTitle },
      } : null,
      userMessage: question,
      practiceMode,
      // Flow wave (review fix): the MAIN app's coach path must carry the
      // session scope and a real take-kind source. The selected drill id
      // (voiceState.lessonId, e.g. 'cute-vocalise-siren') is the live kind
      // signal when no artifact repContext exists yet.
      sessionScope: session.sessionScope || null,
      repContext: resolveCoachRepContext(voiceState),
      targetPreset: voiceState.targetPreset || 'cute-feminine',
      // Phase B: the line the learner was actually asked to say. Without it the
      // section scorer has nothing to slice the timeline by and stays inert.
      cardTokens: practiceCards.getActiveCard?.(session.id)?.tokens || null,
      // Phase C: the isolation loop's state + the phrase to reassemble to. The
      // phrase is read from the STASH while an isolation is running, because the
      // active card is then the fragment, not the sentence.
      sectionLoop: voiceState.sectionLoop || null,
      sectionLoopLastTakeKey: voiceState.sectionLoopLastTakeKey || null,
      cardPhrase: voiceState.sectionLoop?.phrase
        || practiceCards.getActiveCard?.(session.id)?.phrase
        || '',
      // Does the isolation loop still own the practice strip? False only when a
      // NON-loop card actually replaced the loop's fragment (a model create/advance
      // op, or a route authoring a card) — the store records that moment explicitly
      // rather than us inferring it from the active card's source, which would also
      // read false whenever a loop and its card are merely out of step.
      stripOwned: !practiceCards.hasCardTakeover?.(session.id),

      conversationHistory: [
        ...(voiceState.coachThread || []).slice(-6),
        // 2026-07-28 Phase 0 shadow fix: composed texts never enter the coach
        // thread in shadow mode (the LLM serves), so without this window the
        // rotation pools would always pick pool[0] and the shadow stream would
        // show a constant template_id — the one thing shadow exists to check.
        ...(Array.isArray(session.directReplyShadowThread) ? session.directReplyShadowThread : [])
          .slice(-3)
          .map((text) => ({ role: 'assistant', content: text })),
      ],
      callModel: async (messages, opts) => {
        const modelResult = await callVoiceTutorModel(messages, opts);
        return modelResult;
      },
      audioBase64: audioBase64 || undefined,
      audioFormat: audioFormat || 'wav',
      telemetry,
      // 2026-07-28 Phase 0 deterministic-first rendering (see coaching/index.js):
      // 'off' by default, so the legacy path is byte-identical.
      directReplyMode: config.voiceDirectReplyMode,
      streamingCallbacks: {
        onFirstToken: () => {
          telemetry.mark('llm_first_token_at', { source: 'gateway' });
        },
      },
    });

    // 2026-07-28 Phase 0 SHADOW witness: the composer's would-be reply, logged
    // side-by-side while the LLM still serves. Null whenever the composer was
    // not asked or produced nothing (and always null when the flag is 'off').
    if (result.directReplyShadow) {
      // Rolling shadow window (bounded): feeds the composer's recency
      // exclusion next turn so the shadow stream exercises template rotation.
      session.directReplyShadowThread = [
        ...(Array.isArray(session.directReplyShadowThread) ? session.directReplyShadowThread : []),
        result.directReplyShadow.text,
      ].slice(-3);
      logger?.log?.({
        event: 'coach_direct_reply_shadow',
        ...result.directReplyShadow,
      });
    }

    // Lesson layer: strip the trailing ops blocks from the RAW reply, apply the
    // directives, then sanitize the visible line. Order matters for COMPOSITION:
    // memory-ops strips its ```remember-ops``` block first (preserving any trailing
    // card-ops block), then card-ops strips its now-trailing block. So a reply
    // carrying BOTH blocks (either order at the tail) is fully stripped + applied.
    // (result.sanitizedReply was sanitized from the raw reply WITH the blocks; we
    // re-sanitize the block-stripped `say` so the fenced JSON never reaches TTS.)
    const memoryOps = processCoachReplyMemoryOps(session, result.rawReply, question);
    const cardOps = processCoachReplyCardOps(session, memoryOps.say, {
      targetPreset: voiceState.targetPreset,
      allowMeasurementDerivedOps: result.signal?.takeQuality?.usable !== false,
    });
    if (cardOps.cardOpsSuppressed) {
      pushRuntimeWitness('warn', 'coach-ops', 'Rejected measurement-derived card operations.', {
        outcome: 'suppressed',
        reason: cardOps.cardOpsSuppressed,
        path: 'buffered',
      });
    }
    // 2026-07-26 phase C: the loop's card swap runs AFTER the model's card-ops so
    // the app's isolation decision wins over anything the model proposed, and the
    // returned card is what actually ends up on the strip.
    const sectionLoopCard = applySectionLoopOutcome(session, result.sectionLoop, {
      targetPreset: voiceState.targetPreset,
    });
    const sanitizerWitness = {};
    const reply = sanitizeCoachReply(cardOps.say, result.signal, { witness: sanitizerWitness });
    telemetry.mark('sanitizer_done_at', { source: 'gateway' });
    // 2026-07-29 L1: the reply text is final here — start TTS upstream NOW so
    // the phone's later speech request lands in the VoxCPM segment cache.
    presynthesizeCoachReply(session, reply, {
      speakingRate: result.signal?.personalization?.preferencePolicy?.speechRate,
      reason: 'coach_reply_buffered',
    });
    // 2026-07-26 field repair: same stamp as the streaming path, at the same
    // point in the turn. A prescription that only landed on one of the two
    // coach paths would leave the other one's learners in the split-brain
    // state this fix exists to close.
    stampEngineRecommendedTakeKind(session, result.signal);
    // 2026-07-18 witnesses: gate decisions + vocab replacements + fallback flag.
    logCoachDecisionWitness(telemetry, result.signal, { audioProvided: Boolean(audioBase64) });
    logSanitizerWitness(telemetry, sanitizerWitness);
    if (result.fallbackReply === true) {
      logger?.log?.({
        event: 'fallback_reply',
        reason: result.fallbackReason || telemetry.getFallback() || 'unknown',
        path: 'buffered',
      });
    }
    // v4 tutor-memory: tally this turn's focus axis for the session's dominant-
    // focus (written into the sessions ring at session end).
    recordSessionFocus(session.id, result.signal);
    const nextThread = appendVoiceCoachThreadMessage(
      {
        ...voiceState,
        coachThread: appendVoiceCoachThreadMessage(voiceState, 'user', question, 'runtime-question'),
      },
      'coach',
      reply,
      'runtime-answer',
    );
    const coachGeneratedAt = Date.now();
    session.voiceState = voiceStateRuntime.updateSessionVoiceState(session, {
      lastCoachMessage: reply,
      lastCoachGeneratedAt: coachGeneratedAt,
      coachThread: nextThread,
    });
    // 2026-07-30 cue carry-forward: the reply is final, so record WHAT this turn
    // gave before the checkpoint persists the state. Same stamp, same point in
    // the turn, on both coach paths.
    stampLastCueGiven(session, result.signal);
    checkpointCoachSession(session, {
      state: 'active',
      lastActivityAt: coachGeneratedAt,
    }, 'coach-generated');

    recordEvalTurn(session, question, { ...result, telemetry, turnId: telemetry.turnId }, Date.now() - start);
    storeTurnTelemetry(telemetry.turnId, telemetry);
    logTurnTelemetry(telemetry);

    const cloneDecision = await resolveCloneDecision(session.voiceState?.referenceClipId || null);
    return buildSessionPayload(session, {
      message: reply,
      coachMessage: reply,
      coachingSignal: result.signal,
      // Eval-only (env-gated): expose the RAW pre-strip model reply + the signal so the
      // harness can score write-restraint, block faithfulness, degenerate output, and
      // conversation-surface safety on what the MODEL actually produced (the visible
      // `message` is already block-stripped + sanitized, which hides those signals).
      ...(exposeRawEvalPayload
        ? { rawReply: result.rawReply, evalSignal: result.signal }
        : {}),
      // Phase C: the isolation swap is the last word on what the strip shows.
      activeCard: sectionLoopCard || cardOps.activeCard,
      cardOpsApplied: cardOps.cardOpsApplied,
      cardOpsSuppressed: cardOps.cardOpsSuppressed,
      memoryOpsApplied: memoryOps.memoryOpsApplied,
      replayDirective: cardOps.replayDirective,
      turnId: telemetry.turnId,
      telemetry: telemetry.getSummary(),
      // Payload honesty (2026-07-18): true when the coach line is a deterministic
      // fallback (model offline/empty), never presented as live coaching.
      fallbackReply: result.fallbackReply === true,
      // voiceCloned = a reference is loaded AND it passes the clone gate (what the
      // TTS proxy will actually do). voiceCloneable mirrors the gate; voiceCloneNote
      // is the plain-English reason shown when a clip can't be cloned.
      voiceCloned: cloneDecision.hasReference && cloneDecision.cloneable,
      voiceCloneable: cloneDecision.cloneable,
      voiceCloneNote: cloneDecision.note,
    }, { studentModel: learnerContext });
  }

  async function generateRealtimeCoachReplyStreaming(
    session,
    question,
    res,
    audioBase64,
    audioFormat,
    listeningTurn = null,
  ) {
    const voiceState = resolveListeningTurnVoiceState(session, listeningTurn);
    const practiceMode = detectPracticeMode(question);
    const lessonState = resolveLessonState(session);
    const studentId = session.studentId || config.defaultStudentId;
    // Wave 2A: deterministic, LLM-free preference capture (always-on, incl. offline).
    captureDeterministicLearnerMemory(studentId, question);
    const learnerContext = await learnerContextService.getVoiceStudentModelSnapshot(studentId).catch(() => null);

    const telemetry = new TurnTelemetry({
      turnId: createTurnId(),
      sessionId: session.id,
    });

    if (voiceState.lastSummary) {
      telemetry.mark('voice_trainer_done_at', { source: 'gateway' });
    }

    // Build the signal deterministically first
    const { buildSignal, pickBaseline } = require('./coaching/signal-builder');
    // Shared baseline picker so the streaming coach prompt gets "VsBaseline:" deltas —
    // this live SSE path had dropped baseline; coaching/index.js uses the same helper.
    const streamBaseline = pickBaseline(learnerContext);
    const signal = buildSignal({
      voiceState,
      learnerContext,
      lessonState: lessonState ? {
        currentKnowledgePoint: lessonState.getCurrentPoint(),
        lessonBoard: { title: lessonState.lessonTitle },
      } : null,
      userMessage: question,
      practiceMode,
      targetPreset: voiceState.targetPreset || 'cute-feminine',
      baseline: streamBaseline,
      // Flow wave: tier/eyes-free context + the take's kind source ride the signal.
      sessionScope: session.sessionScope || null,
      repContext: resolveCoachRepContext(voiceState),
      // Phase B: same card tokens as the buffered path, so the two coach paths
      // cannot drift on whether sections are localized.
      cardTokens: practiceCards.getActiveCard?.(session.id)?.tokens || null,
    });

    // 2026-07-26 phase C: the SAME transition table the buffered path uses, called
    // at the same point in the turn (after the signal, before the prompt). This is
    // why the decision lives in coaching/section-loop.js rather than inline in
    // coachingTurn — the SSE path never calls coachingTurn, and a loop that only
    // ran on one of the two coach paths would isolate a fragment the other path
    // could never close.
    const sectionLoopResult = resolveSectionLoopTurn({
      sectionLoop: voiceState.sectionLoop || null,
      lastTakeKey: voiceState.sectionLoopLastTakeKey || null,
      signal,
      takeKey: resolveTakeKey(voiceState),
      // The TAKE's transcript, NOT signal.userUtterance — same binding as the
      // buffered path in coaching/index.js.
      takeTranscript: resolveTakeTranscript(voiceState),
      phrase: voiceState.sectionLoop?.phrase
        || practiceCards.getActiveCard?.(session.id)?.phrase
        || '',
      // Same ownership signal as the buffered path — see its note.
      stripOwned: !practiceCards.hasCardTakeover?.(session.id),
    });
    if (sectionLoopResult.signalPatch) {
      signal.sectionLoop = sectionLoopResult.signalPatch;
    }
    if (sectionLoopResult.witness && signal.decisionWitness) {
      signal.decisionWitness.sectionLoop = sectionLoopResult.witness;
    }

    telemetry.mark('coaching_signal_done_at');
    // 2026-07-26 field repair: when the ENGINE prescribes a vocalise, the
    // session's practice state follows it for the next take. Stamped from the
    // signal's own structured recommendation, never from the model's words.
    stampEngineRecommendedTakeKind(session, signal);
    // 2026-07-18 witness: gate decisions (two-tier strain, praise guard, misses).
    logCoachDecisionWitness(telemetry, signal, { audioProvided: Boolean(audioBase64) });

    // Build renderer messages from the signal (with optional audio)
    const rendererOptions = audioBase64 ? { audioBase64, audioFormat: audioFormat || 'wav' } : {};
    const messages = buildRendererMessages(signal, (voiceState.coachThread || []).slice(-6), rendererOptions);

    res.writeHead(200, {
      'Content-Type': 'text/event-stream',
      'Cache-Control': 'no-cache',
      Connection: 'keep-alive',
      'X-Accel-Buffering': 'no',
      'X-Turn-Id': telemetry.turnId,
    });

    let fullReply = '';
    let firstTokenMarked = false;
    // Payload honesty (2026-07-18): tracks whether the final coach line is a
    // deterministic fallback rather than the model's own words.
    let usedFallbackReply = false;
    // 2026-07-26 phase C — LATENCY LAW on the streaming path. A retry cue or the
    // warm cap exit is already written, so the stream is skipped entirely and the
    // done-event carries the engine line. Not a fallback: `usedFallbackReply` stays
    // false because nothing failed.
    //
    // 2026-07-28 Phase 0 deterministic-first rendering (SHADOW): same wiring as
    // the buffered path (coaching/index.js) — 'off' is byte-identical, 'shadow'
    // logs coach_direct_reply_shadow and still streams the model, 'on' serves
    // the composer line like a deterministicReply.
    const directReplyWitness = {};
    const engineReply = sectionLoopResult.deterministicReply
      || (config.voiceDirectReplyMode !== 'off'
        ? buildDirectReply(signal, {
          conversationHistory: [
            ...(voiceState.coachThread || []).slice(-6),
            // Same rolling shadow window as the buffered route — without it
            // the pools always pick pool[0] and the shadow stream shows a
            // constant template_id.
            ...(Array.isArray(session.directReplyShadowThread) ? session.directReplyShadowThread : [])
              .slice(-3)
              .map((text) => ({ role: 'assistant', content: text })),
          ],
          witness: directReplyWitness,
        })
        : null);
    const composerProduced = Boolean(engineReply) && !sectionLoopResult.deterministicReply
      && Boolean(directReplyWitness.templateId);
    const directReplyServed = composerProduced && config.voiceDirectReplyMode === 'on';
    if (composerProduced && config.voiceDirectReplyMode === 'shadow') {
      session.directReplyShadowThread = [
        ...(Array.isArray(session.directReplyShadowThread) ? session.directReplyShadowThread : []),
        engineReply,
      ].slice(-3);
      logger?.log?.({
        event: 'coach_direct_reply_shadow',
        composer_id: directReplyWitness.composerId,
        intent: directReplyWitness.intent,
        template_id: directReplyWitness.templateId,
        text: engineReply,
        practice_line_present: Boolean(signal.practiceLine),
        would_have_served: true,
      });
    }
    if (sectionLoopResult.deterministicReply || directReplyServed) {
      fullReply = engineReply;
      res.write(`data: ${JSON.stringify({
        progress: 'generating',
        turnId: telemetry.turnId,
      })}\n\n`);
      telemetry.mark('llm_request_at');
      telemetry.mark('llm_done_at');
    } else {
    telemetry.mark('llm_request_at');
    try {
      // Match the buffered realtime renderer's hard tail bound. The live tutor is
      // contracted to two sentences / 45 spoken words plus small optional ops.
      for await (const chunk of streamVoiceTutorModel(messages, {
        maxTokens: 256,
        // 0.20 = quality-optimal band; direction-safety now via sanitizeCoachReply Step 6.5 + the DIRECTION CONSTRAINT (see coaching/index.js).
        temperature: 0.2,
      })) {
        if (!firstTokenMarked) {
          telemetry.mark('llm_first_token_at', { source: 'gateway' });
          firstTokenMarked = true;
          // Never stream raw model text. The model may still be in the middle
          // of an unsafe sentence or trailing ops block; only the fully
          // sanitized done payload is learner-facing. This categorical event
          // keeps the transport alive without exposing content.
          res.write(`data: ${JSON.stringify({
            progress: 'generating',
            turnId: telemetry.turnId,
          })}\n\n`);
        }
        fullReply += chunk;
      }
    } catch (error) {
      fullReply = buildFallbackReply(signal);
      usedFallbackReply = true;
      telemetry.setFallback('stream_error', { source: 'gateway' });
    }
    telemetry.mark('llm_done_at');

    // Empty content (thinking model spent the whole budget on hidden reasoning)
    // is NOT an error, so the catch above never fires — guard it explicitly.
    if (!fullReply.trim()) {
      fullReply = buildFallbackReply(signal)
        || 'Let’s keep it easy — take it whenever you’re ready, and I’ll listen.';
      usedFallbackReply = true;
      telemetry.setFallback('empty_content');
    }
    }

    // Lesson layer: strip the trailing ops blocks from the RAW streamed text,
    // apply the directives, and sanitize the block-stripped visible line. Same
    // COMPOSITION as the non-stream path: memory-ops strips ```remember-ops``` first
    // (preserving a trailing card-ops block), then card-ops strips its block — so
    // both blocks (either order at the tail) are fully handled. Raw chunks are
    // deliberately buffered above; the only learner-facing coach text is the
    // sanitized `coachMessage` in the done-event payload below.
    const memoryOps = processCoachReplyMemoryOps(session, fullReply, question);
    const cardOps = processCoachReplyCardOps(session, memoryOps.say, {
      targetPreset: voiceState.targetPreset,
      allowMeasurementDerivedOps: signal?.takeQuality?.usable !== false,
    });
    if (cardOps.cardOpsSuppressed) {
      pushRuntimeWitness('warn', 'coach-ops', 'Rejected measurement-derived card operations.', {
        outcome: 'suppressed',
        reason: cardOps.cardOpsSuppressed,
        path: 'streaming',
      });
    }
    // Phase C: same ordering as the buffered path — the loop's card decision runs
    // after the model's card-ops and wins.
    const sectionLoopCard = applySectionLoopOutcome(session, sectionLoopResult, {
      targetPreset: voiceState.targetPreset,
    });
    const sanitizerWitness = {};
    const reply = sanitizeCoachReply(cardOps.say, signal, { witness: sanitizerWitness });
    logSanitizerWitness(telemetry, sanitizerWitness);
    // 2026-07-29 L1: same pre-synthesis as the buffered path — the reply text
    // is final at sanitize time on both coach routes.
    presynthesizeCoachReply(session, reply, {
      speakingRate: signal?.personalization?.preferencePolicy?.speechRate,
      reason: 'coach_reply_streaming',
    });
    if (usedFallbackReply) {
      logger?.log?.({
        event: 'fallback_reply',
        reason: telemetry.getFallback() || 'unknown',
        path: 'streaming',
      });
    }
    // v4 tutor-memory: tally this turn's focus axis for the session's dominant-
    // focus (written into the sessions ring at session end).
    recordSessionFocus(session.id, signal);
    telemetry.mark('sanitizer_done_at');
    const nextThread = appendVoiceCoachThreadMessage(
      {
        ...voiceState,
        coachThread: appendVoiceCoachThreadMessage(voiceState, 'user', question, 'runtime-question'),
      },
      'coach',
      reply,
      'runtime-answer',
    );
    const coachGeneratedAt = Date.now();
    session.voiceState = voiceStateRuntime.updateSessionVoiceState(session, {
      lastCoachMessage: reply,
      lastCoachGeneratedAt: coachGeneratedAt,
      coachThread: nextThread,
    });
    // 2026-07-30 cue carry-forward: same stamp as the buffered path, at the same
    // point in the turn — a record that only landed on one of the two coach
    // paths would name the cue for half of the app's learners and not the other.
    stampLastCueGiven(session, signal);
    checkpointCoachSession(session, {
      state: 'active',
      lastActivityAt: coachGeneratedAt,
    }, 'coach-generated');

    const cloneDecision = await resolveCloneDecision(session.voiceState?.referenceClipId || null);
    const sessionPayload = await buildSessionPayload(session, {
      message: reply,
      coachMessage: reply,
      coachingSignal: signal,
      // Phase C: the isolation swap is the last word on what the strip shows.
      activeCard: sectionLoopCard || cardOps.activeCard,
      cardOpsApplied: cardOps.cardOpsApplied,
      cardOpsSuppressed: cardOps.cardOpsSuppressed,
      memoryOpsApplied: memoryOps.memoryOpsApplied,
      replayDirective: cardOps.replayDirective,
      turnId: telemetry.turnId,
      // Payload honesty (2026-07-18): true when the streamed coach line is a
      // deterministic fallback (stream error / empty model content).
      fallbackReply: usedFallbackReply,
      voiceCloned: cloneDecision.hasReference && cloneDecision.cloneable,
      voiceCloneable: cloneDecision.cloneable,
      voiceCloneNote: cloneDecision.note,
    }, { studentModel: learnerContext });

    // Eval recording for streaming turns
    recordEvalTurn(session, question, {
      signal,
      messages,
      rawReply: fullReply,
      sanitizedReply: reply,
      promptTokens: 0, // Not tracked for streaming
      telemetry,
      turnId: telemetry.turnId,
    }, 0);
    storeTurnTelemetry(telemetry.turnId, telemetry);
    logTurnTelemetry(telemetry);

    res.write(`data: ${JSON.stringify({ done: true, session: sessionPayload, turnId: telemetry.turnId })}\n\n`);
    res.end();
  }

  const voiceSessionRouteHandlers = {
    async getVoiceHealth() {
      const services = {};
      try {
        services.voiceTrainer = {
          status: 'online',
          payload: await callVoiceTrainer('/health', { timeoutMs: 5000 }),
        };
      } catch (error) {
        services.voiceTrainer = {
          status: 'offline',
          error: error.message,
        };
      }

      try {
        const payload = await fetchJson(`${config.voiceTutorGgufBaseUrl}/models`, {
          fetchImpl,
          apiKey: config.voiceTutorGgufApiKey,
          timeoutMs: 5000,
        });
        const modelIds = Array.isArray(payload?.data)
          ? payload.data.map((model) => normalizeText(model?.id, 300)).filter(Boolean)
          : [];
        const targetModelPresent = modelIds.length === 0 || modelIds.includes(config.voiceTutorGgufModel);
        services.voiceTutorGguf = {
          status: targetModelPresent ? 'online' : 'degraded',
          payload,
          targetModelPresent,
        };
      } catch (error) {
        services.voiceTutorGguf = {
          status: 'offline',
          error: error.message,
        };
      }

      services.voxcpm = await probeVoxCpmHealth(1500);
      try {
        const asrStatus = await voiceInputAsrBridge.getStatus({ refresh: true });
        services.voiceAsr = {
          status: !config.voiceAsrEnabled ? 'disabled' : (asrStatus?.available === true ? 'online' : 'offline'),
          ...asrStatus,
        };
      } catch (error) {
        services.voiceAsr = {
          status: config.voiceAsrEnabled ? 'offline' : 'disabled',
          enabled: config.voiceAsrEnabled,
          available: false,
          reason: error?.message || 'Voice ASR health check failed.',
        };
      }

      const memoryStorage = getMemoryStorageHealthSummary();
      services.learnerMemory = {
        ...memoryStorage.learner,
        status: memoryStorage.learner.writeBlocked ? 'offline' : 'online',
      };
      services.sessionMemory = {
        ...memoryStorage.sessions,
        status: memoryStorage.sessions.writeBlocked
          ? 'offline'
          : (memoryStorage.sessions.status === 'disabled' ? 'disabled' : 'online'),
      };
      // The phone has one listening surface backed by two internal evidence
      // lanes. Startup is usable when EITHER lane can hear a turn; the missing
      // lane remains visible as degraded in /voice/input/status. Requiring the
      // analyzer here made the disabled Start shell contradict that contract.
      const listeningAvailable = services.voiceTrainer.status === 'online'
        || services.voiceAsr.status === 'online';
      const online = listeningAvailable
        && services.voiceTutorGguf.status === 'online'
        && (!config.voxcpmEnabled || services.voxcpm.status === 'online')
        && memoryStorage.learner.writeBlocked !== true
        && memoryStorage.sessions.writeBlocked !== true;
      return {
        statusCode: online ? 200 : 503,
        payload: {
          service: 'voice-tutor-standalone',
          status: online ? 'online' : 'offline',
          trainerUrl: config.voiceTrainerUrl,
          voiceTutorGgufBaseUrl: config.voiceTutorGgufBaseUrl,
          voiceTutorGgufModel: config.voiceTutorGgufModel,
          memoryStorage,
          sessionStore: sessionStore?.getStoreInfo?.() || null,
          services,
        },
      };
    },
    async getStandaloneReadiness(options = {}) {
      const readiness = await getStandaloneReadiness(options);
      return {
        statusCode: readiness.status === 'online' ? 200 : 503,
        payload: readiness,
      };
    },
    async getVoiceSession(sessionId) {
      return {
        statusCode: 200,
        payload: await buildSessionPayload(requireSession(sessionId)),
      };
    },
    async getDeepTutorVoiceSession() {
      return {
        statusCode: 404,
        payload: { success: false, error: 'DeepTutor voice routes are disabled in standalone mode.' },
      };
    },
    async startDeepTutorVoiceSession() {
      return {
        statusCode: 404,
        payload: { success: false, error: 'DeepTutor voice routes are disabled in standalone mode.' },
      };
    },
  };

  // Active TTS streams for cancel propagation: streamId -> AbortController
  const activeTtsStreams = new Map();

  function abortTtsStreamsForSession(sessionId, reason = 'session-stopped') {
    const normalizedSessionId = normalizeSessionId(sessionId);
    if (!normalizedSessionId) return 0;
    let aborted = 0;
    for (const [streamId, controller] of activeTtsStreams.entries()) {
      if (controller?.transVoiceSessionId !== normalizedSessionId) continue;
      try {
        const error = new Error(reason);
        error.name = 'AbortError';
        controller.abort(error);
      } catch {
        // The stream's finally block is still responsible for cleanup.
      }
      activeTtsStreams.delete(streamId);
      aborted += 1;
    }
    return aborted;
  }

  // 2026-07-30 CALL-AND-RESPONSE GRAPH: the tutor's own travel.
  //
  // The graph shows the learner a shape to copy — the tutor's dot crossing the
  // pitch / mouth-shape field — and then her dot over the ghost of it. Her half
  // has always worked; the tutor's could not, because the app synthesizes his
  // speech and never listens to it.
  //
  // This is the listening, and it is deliberately parasitic on work that was
  // already happening. Pre-synthesis ALREADY fetches and drains the exact audio
  // the phone will be sent, purely to warm VoxCPM's cache, and already throws
  // those bytes away. Measuring them costs no extra synthesis, no extra GPU
  // time, and — because pre-synthesis is fire-and-forget at sanitize time — not
  // one millisecond on the reply path.
  //
  // The cache is keyed by the same (reference, rate, text) triple that
  // determines the audio, so a repeated phrase is a map lookup and every line
  // the session pre-warms is measured before the learner ever hears it.
  //
  // SERIAL BY DESIGN. The analyzer is shared with the learner's own takes, and
  // hers are the ones that must not queue. One tutor analysis at a time, with a
  // short deadline: a busy analyzer costs the graph a turn, never the lesson.
  const tutorMetricTracks = createTutorMetricTrackCache({
    maxEntries: config.tutorMetricTrackCacheEntries,
  });
  let tutorMetricTrackLane = Promise.resolve();
  let tutorMetricTrackInFlight = 0;

  function readTutorMetricTrack(key) {
    if (!config.tutorMetricTrackEnabled || !key) return null;
    return tutorMetricTracks.get(key);
  }

  /**
   * Measure one piece of already-synthesized tutor audio and cache the result.
   *
   * Never throws, never returns a rejected promise, never blocks a caller that
   * does not await it. Every failure path — analyzer down, audio unmeasurable,
   * metrics untrustworthy, request superseded — resolves to null, and null
   * means the graph has no tutor dot for that line. The tutor still speaks.
   */
  function scheduleTutorMetricTrack(pcmBuffer, {
    key,
    targetPreset = null,
    sampleRate = null,
    signal = null,
    reason = 'coach_reply',
  } = {}) {
    if (!config.tutorMetricTrackEnabled) return Promise.resolve(null);
    if (!key || !Buffer.isBuffer(pcmBuffer) || pcmBuffer.length < 2 || pcmBuffer.length % 2) {
      return Promise.resolve(null);
    }
    // Already measured. This is the cache doing its job: a pre-warmed template
    // or a repeated phrase costs nothing.
    if (tutorMetricTracks.has(key)) return Promise.resolve(tutorMetricTracks.get(key));

    const startedAt = Date.now();
    const run = async () => {
      if (signal?.aborted) return null;
      if (tutorMetricTracks.has(key)) return tutorMetricTracks.get(key);
      const timeoutMs = Number.isFinite(Number(config.tutorMetricTrackTimeoutMs))
        ? Math.max(1, Math.round(Number(config.tutorMetricTrackTimeoutMs)))
        : 4000;
      tutorMetricTrackInFlight += 1;
      try {
        const analysis = await callVoiceTrainer('/api/v1/voice/synthesis/analyze', {
          method: 'POST',
          timeoutMs,
          body: {
            pcm16Base64: pcmBuffer.toString('base64'),
            // VoxCPM streams raw PCM16 mono at its own rate; the analyzer
            // resamples with its OWN resampler so the tutor's reading lands in
            // the same measurement space as the learner's take.
            sampleRate: Number.isFinite(Number(sampleRate)) && Number(sampleRate) > 0
              ? Math.round(Number(sampleRate))
              : VOXCPM_STREAM_SAMPLE_RATE,
            targetPreset: normalizeText(targetPreset, 80) || 'cute-feminine',
          },
        });
        const track = buildTutorMetricTrack(analysis, {
          maxPoints: config.tutorMetricTrackMaxPoints,
        });
        if (track) {
          tutorMetricTracks.set(key, track);
        }
        logger?.log?.({
          event: 'tutor_metric_track',
          reason,
          outcome: track ? 'measured' : 'unusable',
          duration_ms: Math.max(0, Date.now() - startedAt),
          audio_bytes: pcmBuffer.length,
          points: track?.points?.length || 0,
          mean_pitch_hz: track?.meanPitchHz ?? null,
          resonance: track?.resonance ?? null,
        });
        return track;
      } catch (error) {
        // A missing shape is a normal outcome, not an incident: log it and
        // leave the turn alone.
        logger?.log?.({
          event: 'tutor_metric_track',
          reason,
          outcome: error?.name === 'AbortError' ? 'aborted' : 'error',
          duration_ms: Math.max(0, Date.now() - startedAt),
          audio_bytes: pcmBuffer.length,
          error: normalizeText(error?.message, 200) || 'unknown',
        });
        return null;
      } finally {
        tutorMetricTrackInFlight = Math.max(0, tutorMetricTrackInFlight - 1);
      }
    };

    // Queue behind any analysis already running, and never let one failure
    // poison the lane for the next line.
    const task = tutorMetricTrackLane.then(run, run);
    tutorMetricTrackLane = task.then(() => undefined, () => undefined);
    return task;
  }

  // 2026-07-29 L1 (TTS latency): PRE-SYNTHESIS at sanitize time. The reply text
  // is final when sanitizeCoachReply returns, but the phone only calls
  // /voice/speech/generate after receiving it — a ~0.7 MB payload round trip
  // over relayed Tailscale, then a cold per-segment synthesis. Fire the SAME
  // upstream /generate immediately (identical target_text, speakingRate and
  // reference_audio_path, so the service's per-segment cache keys match) and
  // DRAIN the stream so every segment lands in the VoxCPM cache before the
  // phone asks. The phone's later request then hits cache_hit (~0.1 s to
  // first byte instead of a full synthesis).
  //
  // TEXT IDENTITY (verified 2026-07-29): coach free-speech replies send no
  // emphasis, so the gateway's synthesisText === targetText === the reply
  // verbatim (frontend/src/voice/coach-speech.ts:613 sends message.content
  // unshaped). The speaking rate is the preferencePolicy's (0.76, or 0.65
  // under 'slower-pace' — same mapping the frontend applies via
  // VOICE_COACH_(SLOW_)SPEAKING_RATE). If either ever diverges, the pre-synth
  // harmlessly caches the wrong text: the phone's request misses and
  // synthesizes as before.
  //
  // Fire-and-forget (the coach reply response never waits on this) but
  // ABORT-AWARE: the controller rides activeTtsStreams, so End/session-stop
  // cancels it via abortTtsStreamsForSession, and a newer reply supersedes a
  // still-running older prime. A 429 can also mean low-priority template
  // warming owns VoxCPM's single worker. Real replies retry off the response
  // path; templates remain opportunistic and give up immediately.
  function presynthesizeCoachReply(session, text, { speakingRate = null, reason = 'coach_reply', supersede = true } = {}) {
    if (!config.voxcpmEnabled) return false;
    const sessionId = normalizeSessionId(session?.id);
    const referenceClipId = session?.voiceState?.referenceClipId || null;
    const targetText = normalizeText(text, 700);
    if (!sessionId || !referenceClipId || !targetText) return false;

    // Reply pre-synthesis supersedes a still-running older one (the phone will
    // speak the newest reply first); the template pre-warm passes
    // supersede:false so its segments coexist.
    if (supersede && session.presynthStreamId && activeTtsStreams.has(session.presynthStreamId)) {
      try {
        const stale = activeTtsStreams.get(session.presynthStreamId);
        const error = new Error('superseded by a newer pre-synthesis');
        error.name = 'AbortError';
        stale.abort(error);
      } catch {
        // The stale task's finally block still cleans up.
      }
      activeTtsStreams.delete(session.presynthStreamId);
    }

    const streamId = `tts-presynth-${Date.now()}-${Math.random().toString(16).slice(2, 8)}`;
    const controller = new AbortController();
    controller.transVoiceSessionId = sessionId;
    activeTtsStreams.set(streamId, controller);
    if (supersede) {
      session.presynthStreamId = streamId;
    }
    const startedAt = Date.now();
    const rate = Number.isFinite(Number(speakingRate))
      ? Number(speakingRate)
      : DEFAULT_TUTOR_SPEAKING_RATE;

    const task = (async () => {
      const cloneDecision = await resolveCloneDecision(referenceClipId);
      if (controller.signal.aborted || !cloneDecision.cloneable) {
        return { outcome: controller.signal.aborted ? 'aborted' : 'reference_unavailable', bytes: 0 };
      }
      const referenceAudioPath = await ensureReferenceAudio(referenceClipId);
      if (controller.signal.aborted || !referenceAudioPath) {
        return { outcome: controller.signal.aborted ? 'aborted' : 'reference_unavailable', bytes: 0 };
      }
      // Built from the SAME three inputs this request is about to send, so the
      // speech route can find this line's measured travel by rebuilding the key
      // from its own identical request. Resolved here because the reference
      // path is only known after the clone gate has run.
      const metricTrackKey = buildTutorMetricTrackKey({
        text: targetText,
        speakingRate: rate,
        referenceAudioPath,
      });
      const upstreamBody = {
        target_text: targetText,
        speakingRate: rate,
        reference_audio_path: referenceAudioPath,
      };
      const busyDelays = reason === 'template_prewarm'
        ? [0]
        : COACH_PRESYNTH_BUSY_DELAYS_MS;
      let response = null;
      for (let attempt = 0; attempt < busyDelays.length; attempt += 1) {
        await waitForAbortableDelay(busyDelays[attempt], controller.signal);
        if (controller.signal.aborted) return { outcome: 'aborted', bytes: 0 };
        response = await fetch(`${config.voxcpmUrl}/generate`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(upstreamBody),
          signal: controller.signal,
        });
        if (response.status !== 429 || attempt + 1 >= busyDelays.length) break;
        try { await response.body?.cancel?.(); } catch {}
        logger?.log?.({
          event: 'tts_presynth_admission',
          component: 'voice-tutor-standalone',
          seam: 'voxcpm-generate',
          line: 'presynthesizeCoachReply',
          class: 'partial-function',
          reason,
          outcome: 'busy_retry',
          attempt: attempt + 1,
        });
      }
      if (!response?.ok) {
        return {
          outcome: response?.status === 429 ? 'busy' : `http_${response?.status || 0}`,
          bytes: 0,
        };
      }
      // DRAIN the whole stream so every segment lands in the service cache.
      // Reader-based (works with both native fetch bodies and the test
      // harness's hand-rolled streams); arrayBuffer when available.
      //
      // 2026-07-30: the drained bytes are no longer discarded. They ARE the
      // tutor's speech for this line — the same audio the phone is about to be
      // sent — so keeping them lets the graph measure the tutor for free.
      let bytes = 0;
      const chunks = [];
      if (typeof response.arrayBuffer === 'function') {
        const buffered = await response.arrayBuffer();
        bytes = buffered.byteLength || 0;
        if (bytes) chunks.push(Buffer.from(buffered));
      } else if (response.body?.getReader) {
        const reader = response.body.getReader();
        for (;;) {
          const { done, value } = await reader.read();
          if (done) break;
          const chunkLength = value?.byteLength || value?.length || 0;
          bytes += chunkLength;
          if (chunkLength) chunks.push(Buffer.from(value));
        }
        reader.releaseLock?.();
      }
      if (chunks.length) {
        // The audio's own declared rate wins over the compiled-in fallback.
        const declaredRate = Number(response.headers?.get?.('X-Audio-Sample-Rate'));
        scheduleTutorMetricTrack(Buffer.concat(chunks), {
          key: metricTrackKey,
          targetPreset: session?.voiceState?.targetPreset || null,
          sampleRate: Number.isFinite(declaredRate) && declaredRate > 0
            ? declaredRate
            : VOXCPM_STREAM_SAMPLE_RATE,
          signal: controller.signal,
          reason,
        });
      }
      return { outcome: 'primed', bytes };
    })();

    task.then((result) => {
      logger?.log?.({
        event: 'tts_presynth',
        reason,
        outcome: result.outcome,
        duration_ms: Math.max(0, Date.now() - startedAt),
        drained_bytes: result.bytes,
        text_chars: targetText.length,
      });
    }).catch((error) => {
      if (error?.name !== 'AbortError') {
        logger?.log?.({
          event: 'tts_presynth',
          reason,
          outcome: 'error',
          duration_ms: Math.max(0, Date.now() - startedAt),
          error: normalizeText(error?.message, 200) || 'unknown',
        });
      }
    }).finally(() => {
      activeTtsStreams.delete(streamId);
      if (supersede && session.presynthStreamId === streamId) {
        session.presynthStreamId = null;
      }
    });
    return true;
  }

  function buildPersonalizationResetVoiceState(session) {
    const current = voiceStateRuntime.normalizeVoiceState(session?.voiceState);
    return voiceStateRuntime.normalizeVoiceState(voiceStateRuntime.buildDefaultVoiceState({
      status: 'idle',
      targetPreset: current.targetPreset,
      targetSource: current.targetSource,
      selectedCustomPresetId: current.selectedCustomPresetId,
      selectedCustomPresetName: current.selectedCustomPresetName,
      referenceClipId: current.referenceClipId,
      referenceClipName: current.referenceClipName,
      referenceAnalysis: current.referenceAnalysis,
      targetVoiceProfile: current.targetVoiceProfile,
      targetBinding: current.targetBinding || buildRuntimeTargetBinding(current),
      coachVoice: {
        ...(isRecord(current.coachVoice) ? current.coachVoice : {}),
        continuousEnabled: false,
      },
      voiceConditioning: isRecord(current.voiceConditioning)
        ? current.voiceConditioning
        : undefined,
    }));
  }

  async function clearRuntimeLearnerData(studentId, options = {}) {
    const normalizedStudentId = normalizeText(studentId, 160);
    if (!normalizedStudentId) {
      throw createHttpError(400, 'studentId is required and must be a string');
    }
    const deleteAll = options.deleteAll === true;
    const preflightStoreInfo = deleteAll ? sessionStore?.getStoreInfo?.() : null;
    if (
      preflightStoreInfo?.writeBlocked === true
      && preflightStoreInfo.writeBlockKind !== 'unrecoverable-corruption'
    ) {
      throw createHttpError(
        503,
        'Complete deletion cannot safely interpret the write-blocked session schema.',
      );
    }
    let deletedSessions = 0;
    let resetSessions = 0;
    let closedLiveInputs = 0;
    let cancelledSpeechStreams = 0;
    const affectedSessionIds = [];

    for (const [sessionId, session] of Array.from(sessions.entries())) {
      if ((session?.studentId || config.defaultStudentId) !== normalizedStudentId) continue;
      affectedSessionIds.push(sessionId);
      closedLiveInputs += stopLiveInputSession(
        session,
        deleteAll ? 'learner-data-deleted' : 'learner-memory-reset',
      );
      cancelledSpeechStreams += abortTtsStreamsForSession(
        sessionId,
        deleteAll ? 'learner-data-deleted' : 'learner-memory-reset',
      );
      clearPerSessionRuntimeState(sessionId);
      if (deleteAll) {
        sessions.delete(sessionId);
        deletedSessions += 1;
        continue;
      }
      session.voiceState = buildPersonalizationResetVoiceState(session);
      session.deeptutorVoiceState = normalizeDeepTutorVoiceState(null);
      session.lessonState = null;
      session.mainTask = null;
      session.notepad = createDefaultNotepadState();
      session.summary = null;
      session.ringLogged = null;
      session.updatedAt = Date.now();
      resetSessions += 1;
    }
    recentMilestoneCache.delete(normalizedStudentId);
    let sessionArtifacts = {
      success: true,
      disabled: !sessionStore,
      inspectedArtifacts: 0,
      rewrittenArtifacts: 0,
      removedUnreadableArtifacts: 0,
      removedRecords: 0,
      remainingTargetRecords: 0,
    };
    let writeRecovery = {
      recovered: false,
      blocked: false,
      disabled: !sessionStore,
      inspectedArtifacts: 0,
      remainingTargetRecords: 0,
    };
    if (deleteAll && sessionStore) {
      if (typeof sessionStore.scrubLearnerArtifacts !== 'function') {
        throw createHttpError(503, 'Complete session-generation deletion is unavailable.');
      }
      try {
        sessionArtifacts = sessionStore.scrubLearnerArtifacts(normalizedStudentId, {
          defaultStudentId: config.defaultStudentId,
        });
      } catch {
        throw createHttpError(503, 'Complete session-generation deletion could not be verified.');
      }
      if (sessionArtifacts?.success !== true || sessionArtifacts.remainingTargetRecords !== 0) {
        throw createHttpError(503, 'Complete session-generation deletion could not be verified.');
      }
      const storeInfo = sessionStore.getStoreInfo?.();
      if (storeInfo?.writeBlocked) {
        if (typeof sessionStore.recoverWritesAfterVerifiedLearnerScrub !== 'function') {
          throw createHttpError(503, 'The scrubbed session store could not be rebuilt safely.');
        }
        try {
          writeRecovery = sessionStore.recoverWritesAfterVerifiedLearnerScrub(
            normalizedStudentId,
            { defaultStudentId: config.defaultStudentId },
          );
        } catch {
          throw createHttpError(503, 'The scrubbed session store could not be rebuilt safely.');
        }
        if (writeRecovery?.blocked === true) {
          throw createHttpError(503, 'The scrubbed session store remains write-blocked.');
        }
      }
    }

    const learnerKey = crypto
      .createHash('sha256')
      .update(normalizedStudentId)
      .digest('hex');
    const evalStore = config.evalStorePath
      ? deleteSessionTurns(config.evalStorePath, {
        sessionIds: affectedSessionIds,
        learnerKeys: [learnerKey],
        // Legacy rows have no learner key and cannot be proved unrelated.
        removeUnattributed: true,
      })
      : {
        success: true,
        disabled: true,
        inspected: 0,
        removedRecords: 0,
        removedFile: false,
        remainingTargetRecords: 0,
      };
    if (evalStore?.success !== true || evalStore.remainingTargetRecords !== 0) {
      throw createHttpError(503, 'Learner evaluation records could not be deleted safely.');
    }

    // Artifact and eval-ledger deletion happen before any write that might be
    // blocked. `saveSessions` copies the current primary generation to `.bak`
    // before replacing it, so two required writes form the final boundary:
    // generation one cleans the primary and generation two replaces the backup
    // with that already-clean primary.
    const persistence = [];
    if (sessionStore) {
      persistence.push(persistSessionsSafely({ required: true }));
      persistence.push(persistSessionsSafely({ required: true }));
    }
    const receipt = {
      success: true,
      operation: deleteAll ? 'delete-all' : 'reset-personalization',
      deletedSessions,
      resetSessions,
      closedLiveInputs,
      cancelledSpeechStreams,
      persistencePasses: persistence.length,
      persistedGenerations: persistence.filter((result) => result?.saved === true).length,
      sessionArtifacts,
      writeRecovery,
      evalStore,
    };
    pushRuntimeWitness('info', 'learner-memory', 'Learner runtime memory operation completed.', {
      outcome: receipt.operation,
      deleted_sessions: deletedSessions,
      reset_sessions: resetSessions,
      closed_live_inputs: closedLiveInputs,
      cancelled_speech_streams: cancelledSpeechStreams,
    });
    return receipt;
  }

  // Voice cloning reference audio cache: clipId -> { path, downloadedAt }
  const referenceAudioPathCache = new Map();
  const REFERENCE_CACHE_TTL = 3600000; // 1 hour
  // TTS health-status cache. Closure variable on purpose: getVoiceSpeechStatus
  // is an object-literal method, so its own name is NOT bound inside its body —
  // a `getVoiceSpeechStatus._cache` self-reference there throws ReferenceError (500).
  let speechStatusCache = null;
  let acousticInputStatusCache = null;

  async function getAcousticInputAvailability(liveAttached) {
    if (!liveAttached) {
      return { available: false, reason: 'Live acoustic capture is not attached.' };
    }
    const now = Date.now();
    if (acousticInputStatusCache && now - acousticInputStatusCache.checkedAt < 3000) {
      return acousticInputStatusCache;
    }
    try {
      await callVoiceTrainer('/health', { timeoutMs: 500 });
      acousticInputStatusCache = { available: true, reason: null, checkedAt: now };
    } catch (error) {
      acousticInputStatusCache = {
        available: false,
        reason: normalizeText(error?.message, 160) || 'Voice analyzer is unavailable.',
        checkedAt: now,
      };
    }
    return acousticInputStatusCache;
  }

  async function ensureReferenceAudio(clipId) {
    if (!clipId || !config.voxcpmEnabled) return null;
    const cached = referenceAudioPathCache.get(clipId);
    if (cached && Date.now() - cached.downloadedAt < REFERENCE_CACHE_TTL) {
      return cached.path;
    }
    try {
      const refUrl = `${config.voiceTrainerUrl}/api/v1/voice/reference/${encodeURIComponent(clipId)}/audio`;
      const dlResp = await fetch(`${config.voxcpmUrl}/v1/reference-audio/download`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url: refUrl, clip_id: clipId }),
        signal: AbortSignal.timeout(10000),
      });
      if (!dlResp.ok) return null;
      const dlData = await dlResp.json();
      referenceAudioPathCache.set(clipId, { path: dlData.path, downloadedAt: Date.now() });
      return dlData.path;
    } catch (err) {
      logger?.log?.({
        event: 'tts_reference_audio_prepare',
        outcome: 'unavailable',
      });
      return null;
    }
  }

  // Reference-quality cache: clipId -> { quality, fetchedAt }. The DSP analyze
  // response carries a `quality` object (verdict + cloneable + summary); we fetch
  // it here so the cloning gate can decide WITHOUT recomputing any DSP.
  const referenceQualityCache = new Map();
  const REFERENCE_QUALITY_TTL = 3600000; // 1 hour
  // clipId -> Promise<boolean>. Session Start launches selected-voice feature
  // preparation without delaying the control response. The first real speech
  // request can await the same promise, preventing a collision with VoxCPM's
  // single GPU worker while keeping the learner-facing Start action immediate.
  const referencePrewarmPromises = new Map();
  let referencePrewarmLane = Promise.resolve();
  let referencePrewarmClosed = false;
  const REFERENCE_PREWARM_BUSY_DELAYS_MS = [0, 250, 500, 1000, 2000, 4000];

  async function getReferenceQuality(clipId) {
    if (!clipId) return null;
    const cached = referenceQualityCache.get(clipId);
    if (cached && Date.now() - cached.fetchedAt < REFERENCE_QUALITY_TTL) {
      return cached.quality;
    }
    try {
      const analysis = await callVoiceTrainer(
        `/api/v1/voice/reference/${encodeURIComponent(clipId)}`,
        { method: 'GET', timeoutMs: 8000 },
      );
      const quality = isRecord(analysis?.quality) ? analysis.quality : null;
      referenceQualityCache.set(clipId, { quality, fetchedAt: Date.now() });
      return quality;
    } catch (err) {
      logger?.log?.({
        event: 'tts_reference_quality_lookup',
        outcome: 'unavailable',
      });
      return null;
    }
  }

  // The single cloning-gate decision used by both the TTS proxy and session
  // payload. Missing quality evidence may still attempt reference preparation,
  // but the proxy below remains fail-closed: no resolved reference path means no
  // synthesis request and therefore no substituted voice.
  async function resolveCloneDecision(referenceClipId) {
    if (!referenceClipId) {
      return { hasReference: false, cloneable: false, note: null };
    }
    const quality = await getReferenceQuality(referenceClipId);
    if (!quality || typeof quality.cloneable !== 'boolean') {
      return { hasReference: true, cloneable: true, note: null };
    }
    return {
      hasReference: true,
      cloneable: quality.cloneable,
      note: normalizeText(quality.cloneNote, 240) || null,
    };
  }

  function prewarmSelectedReference(referenceClipId, session = null) {
    if (!config.voxcpmEnabled || !referenceClipId || referencePrewarmClosed) {
      return Promise.resolve(false);
    }
    const existing = referencePrewarmPromises.get(referenceClipId);
    if (existing) return existing;

    const startedAt = Date.now();
    const isCurrent = () => (
      !referencePrewarmClosed
      && (!session || (
        session.voiceState?.referenceClipId === referenceClipId
        && session.voiceState?.status !== 'ended'
      ))
    );
    let task;
    const run = async () => {
      if (!isCurrent()) return false;
      const cloneDecision = await resolveCloneDecision(referenceClipId);
      if (!isCurrent() || !cloneDecision.cloneable) return false;
      const referenceAudioPath = await ensureReferenceAudio(referenceClipId);
      if (!isCurrent() || !referenceAudioPath) return false;

      for (let attempt = 0; attempt < REFERENCE_PREWARM_BUSY_DELAYS_MS.length; attempt += 1) {
        const delayMs = REFERENCE_PREWARM_BUSY_DELAYS_MS[attempt];
        if (delayMs > 0) {
          await new Promise((resolve) => setTimeout(resolve, delayMs));
        }
        if (!isCurrent()) return false;
        const response = await fetch(`${config.voxcpmUrl}/v1/reference-audio/prime`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ reference_audio_path: referenceAudioPath }),
          signal: AbortSignal.timeout(Math.min(config.voxcpmTimeoutMs, 30000)),
        });
        if (response.status === 429 && attempt + 1 < REFERENCE_PREWARM_BUSY_DELAYS_MS.length) {
          logger?.log?.({
            event: 'tts_reference_prewarm',
            outcome: 'busy_retry',
            attempt: attempt + 1,
          });
          continue;
        }
        if (!response.ok) {
          logger?.log?.({
            event: 'tts_reference_prewarm',
            outcome: response.status === 429 ? 'busy_exhausted' : 'rejected',
            status: response.status,
            duration_ms: Math.max(0, Date.now() - startedAt),
          });
          return false;
        }
        const result = await response.json();
        logger?.log?.({
          event: 'tts_reference_prewarm',
          outcome: result?.prepared === true ? 'prepared' : 'rejected',
          cache_hit: result?.cache_hit === true,
          duration_ms: Math.max(0, Date.now() - startedAt),
        });
        return result?.prepared === true;
      }
      return false;
    };
    task = referencePrewarmLane.catch(() => false).then(run).catch(() => {
      logger?.log?.({
        event: 'tts_reference_prewarm',
        outcome: 'unavailable',
        duration_ms: Math.max(0, Date.now() - startedAt),
      });
      return false;
    }).finally(() => {
      if (referencePrewarmPromises.get(referenceClipId) === task) {
        referencePrewarmPromises.delete(referenceClipId);
      }
    });
    referencePrewarmPromises.set(referenceClipId, task);
    referencePrewarmLane = task.then(() => undefined, () => undefined);
    return task;
  }

  function closeReferencePrewarms() {
    referencePrewarmClosed = true;
    return referencePrewarmLane;
  }

  // 2026-07-29 L3 (TTS latency): pre-warm the INVARIANT template segments at
  // session start. Deterministic replies draw from small pools and VoxCPM's
  // segment cache keys are (reference-digest | segment-text), so invariant
  // sentences — drill bodies, RESET/BREATHER/WIN-next templates, the
  // section-loop cue table + warm cap exit — have stable keys and pay off
  // every time they are spoken. Interpolated sentences (lesson names, take
  // numbers, quoted practice lines) are uncacheable and skipped. Runs AFTER
  // the reference prewarm (the real first request outranks this), paced one
  // segment at a time through the same L1 path (supersede:false so the
  // segments coexist), abort-aware via the same stream registry, and capped
  // at PREWARM_TEMPLATE_CAP segments.
  const PREWARM_TEMPLATE_CAP = 48;

  function listPrewarmTemplateTexts() {
    const sectionCueTexts = Object.values(SECTION_CUES || {})
      .flat()
      .map((cue) => cue?.text)
      .filter((text) => typeof text === 'string' && text.trim());
    return [...new Set([
      ...listInvariantTemplateTexts(),
      ...listStarterDrillInstructions(),
      ...sectionCueTexts,
      SECTION_LOOP_CAP_EXIT,
    ].filter((text) => typeof text === 'string' && text.trim()))]
      .slice(0, PREWARM_TEMPLATE_CAP);
  }

  async function prewarmInvariantTemplates(session, speakingRate = DEFAULT_TUTOR_SPEAKING_RATE) {
    if (!config.ttsTemplatePrewarmEnabled) return 0;
    const texts = listPrewarmTemplateTexts();
    const paceMs = Number.isFinite(Number(config.ttsTemplatePrewarmPaceMs))
      ? Number(config.ttsTemplatePrewarmPaceMs)
      : 150;
    let primed = 0;
    const foregroundWaitMs = Math.max(25, paceMs || 25);
    for (const text of texts) {
      // Gateway close stops the loop — the pre-warm must never outlive its
      // runtime (an orphaned loop keeps hitting fetch for segments nobody
      // will ever play). A real reply owns session.presynthStreamId; low-priority
      // templates wait instead of reacquiring the single worker ahead of it.
      if (referencePrewarmClosed) break;
      if (normalizeSessionId(session?.id) == null || session?.voiceState?.status === 'ended') break;
      while (session.presynthStreamId && activeTtsStreams.has(session.presynthStreamId)) {
        if (referencePrewarmClosed || session?.voiceState?.status === 'ended') break;
        await new Promise((resolve) => setTimeout(resolve, foregroundWaitMs));
      }
      if (referencePrewarmClosed || session?.voiceState?.status === 'ended') break;
      const fired = presynthesizeCoachReply(session, text, {
        speakingRate,
        reason: 'template_prewarm',
        supersede: false,
      });
      if (!fired) break;
      primed += 1;
      // Low priority: yield between segments so a real coach/speech request
      // can win the single VoxCPM worker.
      if (paceMs > 0) {
        await new Promise((resolve) => setTimeout(resolve, paceMs));
      }
    }
    logger?.log?.({
      event: 'tts_template_prewarm',
      segments_enumerated: texts.length,
      segments_fired: primed,
    });
    return primed;
  }

  // The body lives in voice-target-identity as `coachingDirectionFromPreset`
  // (module scope, so top-level helpers here can reach it too); this stays as a
  // thin delegating wrapper because 12 call sites in this closure use the short
  // name. Importing it instead of re-deriving the preset->direction mapping
  // locally is deliberate: the local copy had already drifted from the shared
  // one once. Kept as a `function` declaration, NOT a `const` alias, so it stays
  // hoisted exactly as before — several call sites sit above this line.
  function targetDirectionFromPreset(targetPreset) {
    return coachingDirectionFromPreset(targetPreset);
  }

  function canonicalTakeTargetSource(value) {
    const source = normalizeVoiceTargetSourceCategory(value);
    return source === 'preset' ? 'built-in' : source;
  }

  function finiteTakeTargetValue(value) {
    if (value == null || value === '') return null;
    const numeric = Number(value);
    return Number.isFinite(numeric) ? numeric : null;
  }

  function referenceCalibrationStatus(referenceAnalysis, targetVoiceProfile) {
    const referenceVersion = normalizeText(referenceAnalysis?.analysisVersion, 120);
    const profileVersion = normalizeText(targetVoiceProfile?.analysisVersion, 120);
    if (!referenceVersion && !profileVersion) return 'both_missing';
    if (!referenceVersion) return 'reference_missing';
    if (!profileVersion) return 'profile_missing';
    return referenceVersion === profileVersion ? 'matched' : 'mismatch';
  }

  function assertReferenceCalibrationMatch(referenceAnalysis, targetVoiceProfile) {
    const referenceVersion = normalizeText(referenceAnalysis?.analysisVersion, 120);
    const calibrationStatus = referenceCalibrationStatus(referenceAnalysis, targetVoiceProfile);
    if (calibrationStatus.endsWith('missing')) {
      throw createHttpError(
        422,
        'Reference target calibration version is missing; re-analyze the retained audio.',
      );
    }
    if (calibrationStatus === 'mismatch') {
      throw createHttpError(
        409,
        'Reference analysis and target profile use different acoustic calibrations.',
      );
    }
    return referenceVersion;
  }

  function collectVoiceTakeProvenanceFailures({
    session,
    voiceSessionId,
    summary,
    attemptArtifact,
    clientAttemptId,
  }) {
    const failures = [];
    const voiceState = session?.voiceState || {};
    const expectedPreset = normalizeText(voiceState.targetPreset, 80);
    const expectedSource = canonicalTakeTargetSource(voiceState.targetSource);
    const expectedProfile = isRecord(voiceState.targetVoiceProfile)
      ? voiceState.targetVoiceProfile
      : {};
    const expectedProfileId = normalizeText(expectedProfile.profileId, 160) || null;
    const expectedReferenceClipId = normalizeText(voiceState.referenceClipId, 120) || null;
    const expectedDirection = normalizeText(expectedProfile.direction, 40)
      || targetDirectionFromPreset(expectedPreset);
    const expectedAnalysisVersion = isReferenceTargetSource(expectedSource)
      ? normalizeText(expectedProfile.analysisVersion, 120)
      : null;
    const expectedSloaneSessionId = normalizeText(session?.id, 120);
    const expectedVoiceSessionId = normalizeText(voiceSessionId, 120);

    const compareTarget = (label, target) => {
      if (!isRecord(target)) {
        failures.push(`missing_${label}_target`);
        return;
      }
      if (canonicalTakeTargetSource(target.source) !== expectedSource) {
        failures.push(`${label}_target_source_mismatch`);
      }
      if (normalizeText(target.targetPreset, 80) !== expectedPreset) {
        failures.push(`${label}_target_preset_mismatch`);
      }
      if ((normalizeText(target.targetProfileId, 160) || null) !== expectedProfileId) {
        failures.push(`${label}_target_profile_mismatch`);
      }
      if (normalizeText(target.direction, 40) !== expectedDirection) {
        failures.push(`${label}_target_direction_mismatch`);
      }

      if (expectedSource !== 'built-in') {
        for (const band of [
          'pitchFloorHz',
          'pitchCeilingHz',
          'resonanceFloor',
          'resonanceCeiling',
          'weightFloor',
          'weightCeiling',
        ]) {
          const expected = finiteTakeTargetValue(expectedProfile[band]);
          const actual = finiteTakeTargetValue(target[band]);
          if (expected == null || actual == null) {
            failures.push(`${label}_target_${band}_missing`);
          } else if (actual !== expected) {
            failures.push(`${label}_target_${band}_mismatch`);
          }
        }
      }
    };

    if (!isRecord(summary)) {
      failures.push('missing_summary');
    } else {
      if (normalizeText(summary.voiceSessionId, 120) !== expectedVoiceSessionId) {
        failures.push('summary_voice_session_mismatch');
      }
      if (normalizeText(summary.targetPreset, 80) !== expectedPreset) {
        failures.push('summary_target_preset_mismatch');
      }
      if (
        expectedAnalysisVersion
        && normalizeText(summary.analysisVersion, 120) !== expectedAnalysisVersion
      ) {
        failures.push('summary_analysis_version_mismatch');
      }
      compareTarget('summary', summary.target);
      const contract = resolveMetricContract(voiceState, summary);
      if (!contract.hasTargetContract) {
        failures.push('summary_target_contract_invalid');
      }
    }

    if (!isRecord(attemptArtifact)) {
      failures.push('missing_attempt_artifact');
    } else {
      if (!normalizeText(attemptArtifact.attemptArtifactId, 160)) {
        failures.push('missing_attempt_artifact_id');
      }
      if (normalizeText(attemptArtifact.voiceSessionId, 120) !== expectedVoiceSessionId) {
        failures.push('artifact_voice_session_mismatch');
      }
      if (normalizeText(attemptArtifact.sloaneSessionId, 120) !== expectedSloaneSessionId) {
        failures.push('artifact_sloane_session_mismatch');
      }
      if (normalizeText(attemptArtifact.targetPreset, 80) !== expectedPreset) {
        failures.push('artifact_target_preset_mismatch');
      }
      if (
        expectedAnalysisVersion
        && normalizeText(attemptArtifact.analysisVersion, 120) !== expectedAnalysisVersion
      ) {
        failures.push('artifact_target_analysis_version_mismatch');
      }
      if ((normalizeText(attemptArtifact.referenceClipId, 120) || null) !== expectedReferenceClipId) {
        failures.push('artifact_reference_clip_mismatch');
      }
      const expectedClientAttemptId = normalizeText(clientAttemptId, 160) || null;
      if (
        expectedClientAttemptId
        && (normalizeText(attemptArtifact.clientAttemptId, 160) || null) !== expectedClientAttemptId
      ) {
        failures.push('artifact_client_attempt_mismatch');
      }
      compareTarget('artifact', attemptArtifact.target);
      const summaryAnalysisVersion = normalizeText(summary?.analysisVersion, 120) || null;
      const artifactAnalysisVersion = normalizeText(attemptArtifact.analysisVersion, 120) || null;
      if (
        summaryAnalysisVersion
        && artifactAnalysisVersion
        && summaryAnalysisVersion !== artifactAnalysisVersion
      ) {
        failures.push('artifact_analysis_version_mismatch');
      }
    }

    return [...new Set(failures)];
  }

  async function assertVoiceTakeProvenance({
    session,
    voiceSessionId,
    summary,
    attemptArtifact,
    clientAttemptId,
    analyzerAlreadyEnded = false,
  }) {
    const failures = collectVoiceTakeProvenanceFailures({
      session,
      voiceSessionId,
      summary,
      attemptArtifact,
      clientAttemptId,
    });
    if (failures.length === 0) return;

    let quarantineAttempted = false;
    let quarantineAcknowledged = analyzerAlreadyEnded;
    if (!analyzerAlreadyEnded && voiceSessionId) {
      quarantineAttempted = true;
      try {
        const quarantine = await callVoiceTrainer(
          `/api/v1/voice/sessions/${encodeURIComponent(voiceSessionId)}/end`,
          { method: 'POST', body: { reason: 'take target provenance mismatch' } },
        );
        quarantineAcknowledged = quarantine?.status === 'ended';
      } catch {
        quarantineAcknowledged = false;
      }
    }

    session.voiceState = voiceStateRuntime.updateSessionVoiceState(session, {
      status: 'error',
      voiceSessionId: null,
      streamUrl: null,
      lastError: 'Voice analyzer take provenance did not match the active target.',
    });
    const witness = {
      outcome: 'rejected',
      failures,
      expected_target_source: canonicalTakeTargetSource(session.voiceState?.targetSource),
      expected_target_direction: targetDirectionFromPreset(session.voiceState?.targetPreset),
      expected_profile_present: Boolean(session.voiceState?.targetVoiceProfile),
      expected_reference_present: Boolean(session.voiceState?.referenceClipId),
      summary_present: isRecord(summary),
      artifact_present: isRecord(attemptArtifact),
      quarantine_attempted: quarantineAttempted,
      quarantine_acknowledged: quarantineAcknowledged,
    };
    logger?.log?.({ event: 'take_target_provenance', ...witness });
    pushRuntimeWitness(
      'error',
      'take-target-provenance',
      'Voice analyzer take provenance mismatch was rejected before coaching or learning.',
      witness,
    );
    throw createHttpError(502, 'Voice analyzer returned a take for a different target or session.');
  }

  function resolveSelectedCustomPreset(preset) {
    if (!isRecord(preset) || preset.archived === true) {
      throw createHttpError(404, 'Custom voice preset not found or archived.');
    }
    const targetVoiceProfile = isRecord(preset.targetVoiceProfile)
      ? preset.targetVoiceProfile
      : null;
    if (!targetVoiceProfile) {
      throw createHttpError(422, 'Custom voice preset has no validated target profile.');
    }
    const targetPreset = normalizeText(preset.basePreset || targetVoiceProfile.targetPreset, 80);
    const targetSource = preset.kind === 'reference' ? 'custom-reference' : 'custom-handmade';
    const referenceAnalysis = isRecord(preset.referenceAnalysis) ? preset.referenceAnalysis : null;
    const referenceClipId = normalizeText(preset.referenceClipId, 120) || null;
    if (preset.kind === 'reference' && !referenceAnalysis) {
      throw createHttpError(422, 'Saved reference target has no trustworthy reference analysis.');
    }
    if (preset.kind === 'reference' && isRejectedReferenceAnalysis(referenceAnalysis)) {
      throw createHttpError(422, 'Saved reference audio is not reliable enough to become a voice target.');
    }
    if (preset.kind === 'reference' && !hasTrustworthyReferenceMeasurement(referenceAnalysis)) {
      throw createHttpError(422, 'Saved reference target has no trustworthy voiced measurement.');
    }
    if (preset.kind === 'reference' && !referenceClipId) {
      throw createHttpError(422, 'Saved reference target has no reference clip.');
    }
    if (
      preset.kind === 'reference'
      && normalizeText(referenceAnalysis?.clipId, 120) !== referenceClipId
    ) {
      throw createHttpError(409, 'Saved reference analysis does not match its reference clip.');
    }
    if (
      preset.kind === 'reference'
      && normalizeText(targetVoiceProfile.clipId, 120) !== referenceClipId
    ) {
      throw createHttpError(409, 'Saved reference target profile does not match its reference clip.');
    }
    if (preset.kind === 'reference') {
      assertReferenceCalibrationMatch(referenceAnalysis, targetVoiceProfile);
    }
    const contract = resolveMetricContract({
      targetPreset,
      targetSource,
      targetVoiceProfile,
    }, {
      targetPreset,
      metrics: { advanced: { measurementAvailable: true } },
      target: {
        source: targetSource,
        targetProfileId: targetVoiceProfile.profileId,
        direction: targetDirectionFromPreset(targetPreset),
      },
    });
    if (!targetPreset || !contract.hasTargetContract) {
      throw createHttpError(422, `Custom voice preset target contract is invalid: ${[
        ...contract.targetValidationFailures,
        ...(contract.hasTargetContract ? [] : ['missing_target_contract']),
      ].join(', ')}`);
    }
    return {
      targetPreset,
      targetSource,
      targetVoiceProfile,
      selectedCustomPresetId: normalizeText(preset.id, 120),
      selectedCustomPresetName: normalizeText(preset.name, 120),
      referenceClipId,
      referenceClipName: normalizeText(preset.referenceClipName, 200) || null,
      referenceAnalysis,
      direction: contract.target.direction,
    };
  }

  async function recoverCoachSessionFromCheckpoint(studentId, checkpoint) {
    if (!checkpoint?.sessionId) return null;
    const expectedBinding = isRecord(checkpoint.targetBinding) ? checkpoint.targetBinding : {};
    const expectedPresetId = normalizeText(
      expectedBinding.presetId || checkpoint.preset?.id,
      160,
    );
    const expectedReferenceClipId = normalizeText(
      expectedBinding.referenceClipId || checkpoint.preset?.referenceClipId,
      160,
    );
    if (!expectedPresetId || !expectedReferenceClipId) {
      pushRuntimeWitness('error', 'coach-continuity', 'Checkpoint recovery was refused without an exact saved preset.', {
        outcome: 'checkpoint_target_incomplete',
        preset_present: Boolean(expectedPresetId),
        reference_present: Boolean(expectedReferenceClipId),
      });
      throw createHttpError(409, 'The continuing lesson cannot resume until its exact saved voice preset is available.');
    }

    let preset;
    try {
      preset = await callVoiceTrainer(`/api/v1/voice/presets/${encodeURIComponent(expectedPresetId)}`);
    } catch (error) {
      pushRuntimeWitness('error', 'coach-continuity', 'Checkpoint preset could not be fetched.', {
        outcome: 'checkpoint_preset_unavailable',
        preset_present: true,
      });
      throw createHttpError(503, 'The exact tutor voice for this continuing lesson is currently unavailable.');
    }
    const resolved = resolveSelectedCustomPreset(preset);
    if (
      resolved.selectedCustomPresetId !== expectedPresetId
      || resolved.referenceClipId !== expectedReferenceClipId
    ) {
      pushRuntimeWitness('error', 'coach-continuity', 'Checkpoint preset identity did not match the saved lesson.', {
        outcome: 'checkpoint_preset_mismatch',
        preset_match: resolved.selectedCustomPresetId === expectedPresetId,
        reference_match: resolved.referenceClipId === expectedReferenceClipId,
      });
      throw createHttpError(409, 'The saved tutor voice no longer matches this continuing lesson.');
    }

    const practiceText = normalizeText(checkpoint.practice?.text, 500);
    const pronunciation = normalizeText(checkpoint.practice?.pronunciation, 500);
    const activeLine = practiceText
      ? {
        id: normalizeText(checkpoint.practice?.lineId, 160) || createId('voice-line-recovered'),
        displayText: practiceText,
        performanceText: pronunciation || practiceText,
        intent: 'continuing spoken practice',
        difficulty: 'medium',
        targetPreset: resolved.targetPreset,
        teachingFocus: normalizeText(checkpoint.lesson?.focus, 120)
          ? [normalizeText(checkpoint.lesson.focus, 120)]
          : [],
        source: 'coach-checkpoint',
        referenceMode: 'reference-supported',
        cueSheet: {
          phrase: practiceText,
          cueLine: pronunciation || practiceText,
          styledCueLine: pronunciation || practiceText,
          tokens: [],
        },
        pinned: false,
      }
      : null;
    const prospectiveVoiceState = voiceStateRuntime.normalizeVoiceState(
      voiceStateRuntime.buildDefaultVoiceState({
        status: 'idle',
        targetPreset: resolved.targetPreset,
        targetSource: resolved.targetSource,
        targetVoiceProfile: resolved.targetVoiceProfile,
        selectedCustomPresetId: resolved.selectedCustomPresetId,
        selectedCustomPresetName: resolved.selectedCustomPresetName,
        referenceClipId: resolved.referenceClipId,
        referenceClipName: resolved.referenceClipName,
        referenceAnalysis: resolved.referenceAnalysis,
        activeLine,
      }),
    );
    const recoveredBinding = buildRuntimeTargetBinding(prospectiveVoiceState);
    if (
      !recoveredBinding
      || (
        normalizeText(expectedBinding.targetKey, 80)
        && recoveredBinding.targetKey !== normalizeText(expectedBinding.targetKey, 80)
      )
    ) {
      pushRuntimeWitness('error', 'coach-continuity', 'Checkpoint target fingerprint did not match the saved preset.', {
        outcome: 'checkpoint_target_mismatch',
        target_key_present: Boolean(expectedBinding.targetKey),
      });
      throw createHttpError(409, 'The saved tutor voice fingerprint changed, so the lesson was not resumed.');
    }
    bindLearnerVoiceTarget(
      { studentId },
      { ...prospectiveVoiceState, targetBinding: recoveredBinding },
      'checkpoint-recovered',
    );
    const session = createSession({
      sessionId: checkpoint.sessionId,
      studentId,
      persist: false,
      voiceState: {
        ...prospectiveVoiceState,
        targetBinding: recoveredBinding,
      },
      lessonState: {
        id: normalizeText(checkpoint.lesson?.lessonId, 160) || null,
        status: normalizeText(checkpoint.lesson?.status, 60) || 'practice',
        stage: normalizeText(checkpoint.lesson?.stage, 80) || 'core',
        focus: normalizeText(checkpoint.lesson?.focus, 120) || null,
        currentExerciseId: normalizeText(checkpoint.lesson?.exerciseId, 160) || null,
        currentExerciseIndex: Math.max(0, Math.round(Number(checkpoint.lesson?.exerciseIndex) || 0)),
      },
    });
    persistSessionsSafely();
    pushRuntimeWitness('info', 'coach-continuity', 'Checkpoint recovered the exact continuing lesson.', {
      outcome: 'checkpoint_session_recovered',
      preset_present: true,
      reference_present: true,
      practice_present: Boolean(activeLine),
    });
    return session;
  }

  async function retireAnalyzerSessionForTargetTransition(session, reason) {
    const voiceSessionId = normalizeText(session?.voiceState?.voiceSessionId, 200);
    if (!voiceSessionId) {
      return { attempted: false, acknowledged: true, outcome: 'none' };
    }
    try {
      const result = await callVoiceTrainer(`/api/v1/voice/sessions/${encodeURIComponent(voiceSessionId)}/end`, {
        method: 'POST',
        body: {
          reason,
          sloaneSessionId: session.id,
          referenceClipId: session.voiceState?.referenceClipId || null,
          clientAttemptId: null,
          repContext: null,
          selfReport: null,
        },
      });
      return {
        attempted: true,
        acknowledged: result?.status === 'ended',
        outcome: result?.status === 'ended' ? 'ended' : 'unexpected_status',
      };
    } catch (error) {
      return { attempted: true, acknowledged: false, outcome: 'end_failed', error: error.message };
    }
  }

  function targetTransitionResetPatch() {
    return {
      voiceSessionId: null,
      streamUrl: null,
      status: 'idle',
      endedAt: null,
      lessonId: null,
      phraseForecast: null,
      forecastPhrase: null,
      phraseComparison: null,
      lastTakeTimeline: null,
      lastSummary: null,
      lastAttemptArtifact: null,
      lastError: null,
    };
  }

  function logTargetTransition(fromState, toState, analyzer) {
    const expectedProfile = Boolean(toState.targetSource && toState.targetSource !== 'built-in');
    const actualProfile = Boolean(toState.targetVoiceProfile);
    const outcome = expectedProfile === actualProfile && analyzer.acknowledged
      ? 'applied'
      : analyzer.acknowledged ? 'state_mismatch' : 'analyzer_retire_unacknowledged';
    const witness = {
      outcome,
      from_source: normalizeVoiceTargetSourceCategory(fromState?.targetSource),
      to_source: normalizeVoiceTargetSourceCategory(toState.targetSource),
      expected_profile_present: expectedProfile,
      actual_profile_present: actualProfile,
      target_direction: targetDirectionFromPreset(toState.targetPreset),
      analyzer_transition_attempted: analyzer.attempted,
      analyzer_acknowledged: analyzer.acknowledged,
      analyzer_outcome: analyzer.outcome,
      rebind_required: true,
    };
    logger?.log?.({ event: 'target_transition', ...witness });
    pushRuntimeWitness(outcome === 'applied' ? 'info' : 'warn', 'target-transition', 'Voice target transition completed.', witness);
  }

  function logTargetTransitionFailure(fromState, toSource, outcome, analyzer = null, diagnostics = {}) {
    const witness = {
      outcome,
      from_source: normalizeVoiceTargetSourceCategory(fromState?.targetSource),
      to_source: normalizeVoiceTargetSourceCategory(toSource),
      expected_profile_present: toSource !== 'built-in',
      actual_profile_present: Boolean(fromState?.targetVoiceProfile),
      target_direction: targetDirectionFromPreset(fromState?.targetPreset),
      analyzer_transition_attempted: analyzer?.attempted === true,
      analyzer_acknowledged: analyzer?.acknowledged === true,
      analyzer_outcome: normalizeText(analyzer?.outcome, 40) || 'not_attempted',
      rebind_required: true,
      ...diagnostics,
    };
    logger?.log?.({ event: 'target_transition', ...witness });
    pushRuntimeWitness('error', 'target-transition', 'Voice target transition failed before state mutation.', witness);
  }

  function assertAnalyzerRetiredForTargetTransition(fromState, toSource, analyzer) {
    if (analyzer?.acknowledged === true) return;
    logTargetTransitionFailure(fromState, toSource, 'analyzer_retire_failed', analyzer);
    throw createHttpError(
      503,
      'The current voice analyzer session could not be retired, so the target was not changed.',
    );
  }

  // ── Calibration self-healing: gateway half (2026-07-26) ────────────────────
  //
  // When VoiceTrainer's VOICE_ANALYSIS_VERSION moves, the trainer re-analyzes a
  // stale reference in place at session start. That fixes the ANALYSIS but
  // strands the gateway: the fingerprint we persisted in
  // voiceState.targetVoiceProfile was derived under the OLD calibration, and
  // the trainer's _reference_profile_matches demands exact equality on
  // EXACT_REFERENCE_PROFILE_FIELDS, so the very next start is rejected with
  // reason=reference_profile_mismatch. The fingerprint law is deliberate and is
  // NOT relaxed here; instead the gateway re-derives the fingerprint for the
  // SAME clip and retries the start exactly once.
  //
  // Reason detection: the trainer surfaces these as a plain 400 whose FastAPI
  // `detail` is the raw ValueError text (routers/sessions.py start handler does
  // `HTTPException(status_code=400, detail=str(exc))`). The machine-readable
  // reason token exists ONLY in the trainer's own log line
  // (event=voice_session_start_rejected reason=...), never on the wire — so the
  // reason is recovered from the exact sentences the two rebindable paths
  // raise. fetchJson puts that text on error.message and the raw body on
  // error.payload.upstream.
  const CALIBRATION_REBIND_SIGNATURES = Object.freeze([
    Object.freeze({
      // audio_analysis.py build_target_voice_profile — stored analysis predates
      // the running calibration and the trainer could not self-heal it.
      reason: 'rejected_reference_analysis',
      pattern: /older or unknown acoustic calibration/i,
    }),
    Object.freeze({
      // streaming_analyzer.py _reject_session_start('reference_profile_mismatch')
      // — the stored analysis is current but our fingerprint is stale.
      reason: 'reference_profile_mismatch',
      pattern: /target profile does not match the stored reference analysis/i,
    }),
  ]);

  function calibrationRebindReason(error) {
    if (Number(error?.status) !== 400) return null;
    const upstreamDetail = error?.payload?.upstream?.detail;
    const detail = normalizeText(
      typeof upstreamDetail === 'string' && upstreamDetail ? upstreamDetail : error?.message,
      600,
    );
    if (!detail) return null;
    const signature = CALIBRATION_REBIND_SIGNATURES.find((entry) => entry.pattern.test(detail));
    return signature ? signature.reason : null;
  }

  /**
   * Re-derive the reference target fingerprint for the SAME clip and persist it
   * through the durable voice-state binding.
   *
   * Deliberately narrow, per the 2026-07-25 target-binding laws: it never
   * substitutes a different clip (every derived artifact must echo back the
   * clip id and preset it was asked for), it never changes the target preset,
   * and it fails SILENT — returning null — rather than binding something the
   * caller did not ask for. It is not a target TRANSITION: the clip, the preset
   * and the analyzer session are unchanged, so it deliberately does not retire
   * the analyzer, abort TTS, or run targetTransitionResetPatch(). Only the
   * calibration-bearing evidence is refreshed.
   *
   * The sibling derivation in updateVoiceSessionReference is intentionally not
   * shared: that path DERIVES the preset from the incoming analysis, whereas
   * this one must PRESERVE the preset already bound to the session.
   */
  async function refreshReferenceTargetBinding(
    session,
    { referenceClipId, targetPreset, targetSource, reason },
  ) {
    const witness = { outcome: 'refresh_failed', clip_id: referenceClipId, reason };
    const emit = (outcome, extra = {}) => {
      const data = { ...witness, ...extra, outcome };
      logger?.log?.({ event: 'target_rebinding', ...data });
      pushRuntimeWitness(
        outcome === 'refreshed' ? 'info' : 'warn',
        'target-rebinding',
        outcome === 'refreshed'
          ? 'Reference target fingerprint was refreshed for the bound clip.'
          : 'Reference target fingerprint could not be refreshed.',
        data,
      );
      return data;
    };

    try {
      const referenceAnalysis = await callVoiceTrainer(
        `/api/v1/voice/reference/${encodeURIComponent(referenceClipId)}`,
        { method: 'GET' },
      );
      if (
        !isRecord(referenceAnalysis)
        || normalizeText(referenceAnalysis.clipId, 120) !== referenceClipId
      ) {
        emit('refresh_failed', { failure: 'reference_clip_mismatch' });
        return null;
      }
      if (isRejectedReferenceAnalysis(referenceAnalysis)) {
        emit('refresh_failed', { failure: 'reference_rejected' });
        return null;
      }
      if (!hasTrustworthyReferenceMeasurement(referenceAnalysis)) {
        emit('refresh_failed', { failure: 'reference_untrustworthy' });
        return null;
      }

      const targetVoiceProfile = await callVoiceTrainer('/api/v1/voice/target/profile', {
        method: 'POST',
        body: { clipId: referenceClipId, targetPreset },
      });
      if (
        !isRecord(targetVoiceProfile)
        || normalizeText(targetVoiceProfile.clipId, 120) !== referenceClipId
        || normalizeText(targetVoiceProfile.targetPreset, 80) !== targetPreset
        || !normalizeText(targetVoiceProfile.profileId, 160)
      ) {
        emit('refresh_failed', { failure: 'derived_profile_mismatch' });
        return null;
      }

      // The refreshed pair must agree with each other, or the binding would be
      // internally inconsistent — the same fail-closed check the bind path runs.
      const analysisVersion = assertReferenceCalibrationMatch(referenceAnalysis, targetVoiceProfile);

      // Validate the contract under the source actually bound to this session
      // ('reference' vs 'custom-reference'), not a hardcoded one — otherwise the
      // contract being checked is not the contract being bound.
      const refreshedTargetSource = isReferenceTargetSource(targetSource)
        ? targetSource
        : 'reference';
      const refreshedContract = resolveMetricContract({
        targetPreset,
        targetSource: refreshedTargetSource,
        targetVoiceProfile,
      }, {
        targetPreset,
        metrics: { advanced: { measurementAvailable: true } },
        target: {
          source: refreshedTargetSource,
          targetProfileId: targetVoiceProfile.profileId,
          direction: targetDirectionFromPreset(targetPreset),
        },
      });
      if (!refreshedContract.hasTargetContract) {
        emit('refresh_failed', { failure: 'invalid_target_contract' });
        return null;
      }

      // The durable targetBinding fingerprints the six exact bands AND the
      // calibration version (voice-target-identity.js targetKey), so a
      // refreshed profile left beside a stale binding would fail
      // requireExactSessionTargetBinding on the very next tutor-speech turn —
      // trading the start loop for a can't-speak loop. Recompute it here so the
      // binding always travels WITH the fingerprint it describes.
      const previousVoiceState = voiceStateRuntime.normalizeVoiceState(session.voiceState);
      const nextVoiceState = voiceStateRuntime.normalizeVoiceState({
        ...previousVoiceState,
        targetPreset,
        targetVoiceProfile,
        referenceAnalysis,
        referenceClipId,
      });
      // Only sessions that already carry an exact binding get one recomputed —
      // compatibility sessions that never had one must not gain one here.
      // bindLearnerVoiceTarget throws when the refreshed state cannot produce an
      // exact identity or cannot be persisted; the outer catch turns that into
      // refresh_failed, so a broken rebind falls back to the original rejection
      // instead of binding something unverified.
      const hadExactBinding = Boolean(
        isRecord(previousVoiceState.targetBinding)
        || normalizeText(previousVoiceState.selectedCustomPresetId, 160),
      );
      const targetBinding = hadExactBinding
        ? bindLearnerVoiceTarget(session, nextVoiceState, 'calibration-rebound')
        : null;

      // Durable transaction: the refreshed fingerprint, the evidence it was
      // derived from, and the binding that fingerprints it are persisted
      // together, before the retry, so a crash can never leave a v3 profile
      // paired with a v2 analysis or a v2 binding.
      session.voiceState = voiceStateRuntime.updateSessionVoiceState(session, {
        targetVoiceProfile,
        referenceAnalysis,
        referenceClipId,
        targetPreset,
        ...(targetBinding ? { targetBinding } : {}),
      });
      emit('refreshed', { analysis_version: analysisVersion });
      return { referenceAnalysis, targetVoiceProfile, analysisVersion };
    } catch (error) {
      emit('refresh_failed', { failure: 'derivation_error', status: Number(error?.status) || null });
      return null;
    }
  }

  const voiceOperationRouteHandlers = {
    async startVoiceSession(body = {}, internal = {}) {
      // 2026-07-27 MTF-ONLY (round 5) — THE CREATE-SIDE WRITE GATE.
      //
      // This must run BEFORE getOrCreateSession. The round-4 gate covered only
      // updateVoiceSessionPreset, so START was still a write sink that could
      // persist an invalid row: getOrCreateSession -> createSession ->
      // persistSessionsSafely() writes the session to disk with the caller's
      // targetPreset, and only LATER does the analyzer round-trip
      // (/api/v1/voice/sessions/start) return 400. Measured: the request
      // answered 400 while the store kept `targetPreset: "masculine"`, and a
      // subsequent GET handed it back.
      //
      // BOTH create paths are covered because createSession takes the preset
      // from either `input.targetPreset` OR a whole `input.voiceState` object —
      // and buildDefaultVoiceState spreads `...overrides` with no enum check
      // (voice-session-state.js), so voiceState.targetPreset is a second door
      // into the same field.
      //
      // The authoritative copy of this check now also sits inside createSession
      // itself (the choke point every create path funnels through, including
      // POST /session/start and checkpoint recovery). This one is kept at the
      // route edge so a rejected start costs nothing and reads plainly here.
      //
      // Rejecting is the whole response. A masculinizing target is corrupt
      // input, not a legacy lane: it is never coerced to a live preset.
      assertLiveBuiltInTargetPreset(normalizeText(body.targetPreset, 80));
      if (isRecord(body.voiceState)) {
        assertLiveBuiltInTargetPreset(normalizeText(body.voiceState.targetPreset, 80));
      }
      const session = getOrCreateSession(body);
      const currentVoiceState = voiceStateRuntime.normalizeVoiceState(session.voiceState);
      const targetPreset = normalizeText(body.targetPreset, 80) || currentVoiceState.targetPreset || 'cute-feminine';
      const targetVoiceProfile = isRecord(body.targetVoiceProfile)
        ? body.targetVoiceProfile
        : (isRecord(currentVoiceState.targetVoiceProfile) ? currentVoiceState.targetVoiceProfile : null);
      const requestedTargetSource = normalizeText(body.targetSource, 40).toLowerCase();
      const targetSource = normalizeVoiceTargetSourceCategory(
        requestedTargetSource
          || currentVoiceState.targetSource
          || (targetVoiceProfile ? 'custom' : (currentVoiceState.referenceClipId ? 'reference' : 'built-in')),
      );
      if (targetSource === 'unknown') {
        pushRuntimeWitness('warn', 'target-transition', 'Invalid voice target source was rejected.', {
          outcome: 'invalid_target_source',
          target_source: 'unknown',
          analyzer_acknowledged: false,
        });
        throw createHttpError(422, 'Target source is invalid.');
      }
      const referenceClipId = normalizeText(body.referenceClipId, 120)
        || currentVoiceState.referenceClipId
        || null;
      if (targetSource === 'built-in' && targetVoiceProfile) {
        throw createHttpError(409, 'Built-in target cannot start with a stale custom voice profile.');
      }
      if (targetSource === 'built-in' && referenceClipId) {
        throw createHttpError(409, 'Built-in target cannot start with a stale reference clip.');
      }
      if (targetSource !== 'built-in' && !targetVoiceProfile) {
        throw createHttpError(422, 'Every non-built-in target requires a complete target voice profile.');
      }
      if (
        targetVoiceProfile
        && (!normalizeText(targetVoiceProfile.profileId, 160) || !normalizeText(targetVoiceProfile.targetPreset, 80))
      ) {
        throw createHttpError(422, 'Target profile identity is incomplete.');
      }
      if (isReferenceTargetSource(targetSource) && !referenceClipId) {
        throw createHttpError(422, 'Reference target requires a reference clip.');
      }
      if (
        isReferenceTargetSource(targetSource)
        && normalizeText(targetVoiceProfile?.clipId, 120) !== referenceClipId
      ) {
        throw createHttpError(409, 'Reference target profile does not match the selected reference clip.');
      }
      // Reference evidence is trusted only after a server-owned reference or
      // custom-preset transition has bound it to this app session. A caller
      // cannot manufacture six plausible bands plus a body-level analysis and
      // bypass the reference upload/profile derivation gates.
      const boundReferenceAnalysis = isRecord(currentVoiceState.referenceAnalysis)
        ? currentVoiceState.referenceAnalysis
        : null;
      if (isReferenceTargetSource(targetSource) && isRejectedReferenceAnalysis(boundReferenceAnalysis)) {
        throw createHttpError(422, 'Reference audio is not reliable enough to become a voice target.');
      }
      if (isReferenceTargetSource(targetSource) && !hasTrustworthyReferenceMeasurement(boundReferenceAnalysis)) {
        pushRuntimeWitness('warn', 'target-transition', 'Unverified reference target start was rejected.', {
          outcome: 'reference_evidence_missing',
          target_source: normalizeVoiceTargetSourceCategory(targetSource),
          reference_profile_present: Boolean(targetVoiceProfile),
          analyzer_acknowledged: false,
        });
        throw createHttpError(
          422,
          'Reference target must be verified and bound to this session before it can start.',
        );
      }
      if (
        isReferenceTargetSource(targetSource)
        && normalizeText(boundReferenceAnalysis?.clipId, 120) !== referenceClipId
      ) {
        pushRuntimeWitness('warn', 'target-transition', 'Reference target evidence binding mismatch was rejected.', {
          outcome: 'reference_evidence_mismatch',
          target_source: normalizeVoiceTargetSourceCategory(targetSource),
          reference_profile_present: Boolean(targetVoiceProfile),
          analyzer_acknowledged: false,
        });
        throw createHttpError(409, 'Reference target does not match the evidence bound to this session.');
      }
      const expectedReferenceAnalysisVersion = isReferenceTargetSource(targetSource)
        ? assertReferenceCalibrationMatch(boundReferenceAnalysis, targetVoiceProfile)
        : null;
      if (
        targetVoiceProfile
        && normalizeText(targetVoiceProfile.targetPreset, 80)
        && normalizeText(targetVoiceProfile.targetPreset, 80) !== targetPreset
      ) {
        throw createHttpError(409, 'Target profile base preset does not match the selected target preset.');
      }
      if (targetVoiceProfile) {
        const startContract = resolveMetricContract({
          targetPreset,
          targetSource,
          targetVoiceProfile,
        }, {
          targetPreset,
          metrics: { advanced: { measurementAvailable: true } },
          target: {
            source: targetSource,
            targetProfileId: targetVoiceProfile.profileId,
            direction: targetDirectionFromPreset(targetPreset),
          },
        });
        if (!startContract.hasTargetContract) {
          throw createHttpError(422, `Target profile contract is invalid: ${[
            ...startContract.targetValidationFailures,
            ...(startContract.hasTargetContract ? [] : ['missing_target_contract']),
          ].join(', ')}`);
        }
      }
      let result;
      // A calibration bump invalidates the persisted reference fingerprint, so
      // the first start after one is rejected by design. Re-derive the
      // fingerprint for the SAME clip and retry EXACTLY ONCE — a second failure
      // surfaces normally, so this can never become a retry loop.
      let activeTargetVoiceProfile = targetVoiceProfile;
      let activeExpectedAnalysisVersion = expectedReferenceAnalysisVersion;
      let rebindAttempted = false;
      for (;;) {
        try {
          result = await callVoiceTrainer('/api/v1/voice/sessions/start', {
            method: 'POST',
            body: {
              sloaneSessionId: session.id,
              targetPreset,
              lessonId: normalizeText(body.lessonId, 120) || currentVoiceState.lessonId || null,
              referenceClipId,
              // VoiceTrainer's start contract is flat. Keep the full profile for
              // compatible analyzers, but send the identity field it actually
              // persists and acknowledges as a top-level value.
              targetProfileId: normalizeText(activeTargetVoiceProfile?.profileId, 160) || null,
              targetVoiceProfile: activeTargetVoiceProfile,
              targetSource,
              memoryEnabled: true,
            },
          });
        } catch (error) {
          const rebindReason = rebindAttempted ? null : calibrationRebindReason(error);
          if (rebindReason && isReferenceTargetSource(targetSource) && referenceClipId) {
            rebindAttempted = true;
            const refreshed = await refreshReferenceTargetBinding(session, {
              referenceClipId,
              targetPreset,
              targetSource,
              reason: rebindReason,
            });
            if (refreshed) {
              activeTargetVoiceProfile = refreshed.targetVoiceProfile;
              activeExpectedAnalysisVersion = refreshed.analysisVersion;
              continue;
            }
          }
          const witness = {
            outcome: 'analyzer_start_rejected',
            target_source: normalizeVoiceTargetSourceCategory(targetSource),
            target_direction: targetDirectionFromPreset(targetPreset),
            expected_profile_present: Boolean(activeTargetVoiceProfile),
            analyzer_acknowledged: false,
            rebind_attempted: rebindAttempted,
          };
          logger?.log?.({ event: 'target_transition', ...witness });
          pushRuntimeWitness('error', 'target-transition', 'Voice analyzer rejected a target binding.', witness);
          throw error;
        }

        const analyzerAckFailures = [];
        if (!normalizeText(result?.voiceSessionId, 200)) {
          analyzerAckFailures.push('missing_voice_session_id');
        }
        const hasAcknowledgementField = (fieldName) => (
          isRecord(result) && Object.prototype.hasOwnProperty.call(result, fieldName)
        );
        const acknowledgedTargetPreset = normalizeText(result?.targetPreset, 80);
        const acknowledgedTargetSource = normalizeVoiceTargetSourceCategory(result?.targetSource);
        const acknowledgedReferenceClipId = normalizeText(result?.referenceClipId, 120) || null;
        const acknowledgedTargetProfileId = normalizeText(result?.targetProfileId, 160) || null;
        const acknowledgedAnalysisVersion = normalizeText(result?.analysisVersion, 120) || null;
        if (!hasAcknowledgementField('targetPreset') || !acknowledgedTargetPreset) {
          analyzerAckFailures.push('missing_target_preset');
        } else if (acknowledgedTargetPreset !== targetPreset) {
          analyzerAckFailures.push('target_preset_mismatch');
        }
        if (!hasAcknowledgementField('targetSource') || acknowledgedTargetSource === 'unknown') {
          analyzerAckFailures.push('missing_target_source');
        } else if (acknowledgedTargetSource !== targetSource) {
          analyzerAckFailures.push('target_source_mismatch');
        }
        if (referenceClipId && !acknowledgedReferenceClipId) {
          analyzerAckFailures.push('missing_reference_clip_id');
        } else if (acknowledgedReferenceClipId !== referenceClipId) {
          analyzerAckFailures.push('reference_clip_mismatch');
        }
        const expectedTargetProfileId = normalizeText(activeTargetVoiceProfile?.profileId, 160) || null;
        if (expectedTargetProfileId && !acknowledgedTargetProfileId) {
          analyzerAckFailures.push('missing_target_profile_id');
        } else if (acknowledgedTargetProfileId !== expectedTargetProfileId) {
          analyzerAckFailures.push('target_profile_mismatch');
        }
        // After a rebind the expected calibration is the REFRESHED one, not the
        // stale version this request was framed with.
        if (activeExpectedAnalysisVersion && !acknowledgedAnalysisVersion) {
          analyzerAckFailures.push('missing_analysis_version');
        } else if (
          activeExpectedAnalysisVersion
          && acknowledgedAnalysisVersion !== activeExpectedAnalysisVersion
        ) {
          analyzerAckFailures.push('analysis_version_mismatch');
        }
        if (analyzerAckFailures.length > 0) {
          let rollbackAcknowledged = false;
          const rejectedVoiceSessionId = normalizeText(result?.voiceSessionId, 200);
          if (rejectedVoiceSessionId) {
            try {
              const rollback = await callVoiceTrainer(
                `/api/v1/voice/sessions/${encodeURIComponent(rejectedVoiceSessionId)}/end`,
                { method: 'POST', body: { reason: 'target acknowledgement mismatch' } },
              );
              rollbackAcknowledged = rollback?.status === 'ended';
            } catch {
              rollbackAcknowledged = false;
            }
          }

          // Second shape of the same calibration trap. When a version bump
          // leaves the six exact bands unchanged, the trainer ACCEPTS the start
          // (our fingerprint still matches its re-analyzed reference) but
          // acknowledges the NEW calibration, while we still expect the old one
          // from our persisted reference analysis. That is our bookkeeping being
          // stale, not a target mismatch — so it earns the same single rebind
          // rather than looping forever on a 502. Every other acknowledgement
          // failure stays fail-closed.
          //
          // The retry is also gated on the analyzer session the trainer just
          // created being genuinely retired. If that rollback was not
          // acknowledged, retrying would strand a live analyzer session with
          // nothing recording it — so an unacknowledged rollback stays a
          // terminal 502, exactly as every acknowledgement failure was before
          // this retry path existed.
          const analyzerSessionRetired = !rejectedVoiceSessionId || rollbackAcknowledged;
          const staleCalibrationAckOnly = analyzerAckFailures.every(
            (failure) => failure === 'analysis_version_mismatch',
          );
          if (
            staleCalibrationAckOnly
            && analyzerSessionRetired
            && !rebindAttempted
            && isReferenceTargetSource(targetSource)
            && referenceClipId
          ) {
            rebindAttempted = true;
            const refreshed = await refreshReferenceTargetBinding(session, {
              referenceClipId,
              targetPreset,
              targetSource,
              reason: 'analysis_version_mismatch',
            });
            // Retry ONLY when the freshly derived calibration is the very one
            // the analyzer just acknowledged. That is what distinguishes "we
            // were the stale party" (retry converges) from "the analyzer
            // acknowledges an epoch its own reference store does not agree
            // with" (retry is pointless, and the request must stay fail-closed
            // exactly as before).
            if (refreshed && refreshed.analysisVersion === acknowledgedAnalysisVersion) {
              activeTargetVoiceProfile = refreshed.targetVoiceProfile;
              activeExpectedAnalysisVersion = refreshed.analysisVersion;
              continue;
            }
          }

          const witness = {
            outcome: 'analyzer_ack_mismatch',
            failures: analyzerAckFailures,
            target_source: normalizeVoiceTargetSourceCategory(targetSource),
            target_direction: targetDirectionFromPreset(targetPreset),
            rollback_attempted: Boolean(rejectedVoiceSessionId),
            rollback_acknowledged: rollbackAcknowledged,
          };
          logger?.log?.({ event: 'target_transition', ...witness });
          pushRuntimeWitness('error', 'target-transition', 'Voice analyzer target acknowledgement did not match the request.', witness);
          // Debugger (2026-07-21): surface the EXACT failure list in the HTTP error so a
          // contract-drift between gateway and VoiceTrainer is self-diagnosing from the
          // response alone — not just the opaque "did not acknowledge" string. The
          // acknowledged payload is included so the mismatch is visible without server logs.
          throw createHttpError(502, `Voice analyzer did not acknowledge the requested target exactly (failures: ${analyzerAckFailures.join(', ')}).`, {
            analyzerAckFailures,
            requested: { targetPreset, targetSource, referenceClipId: referenceClipId || null, targetProfileId: normalizeText(activeTargetVoiceProfile?.profileId, 160) || null },
            acknowledged: { targetPreset: acknowledgedTargetPreset, targetSource: acknowledgedTargetSource, referenceClipId: acknowledgedReferenceClipId, targetProfileId: acknowledgedTargetProfileId },
          });
        }
        break;
      }
      const startMayCommit = (() => {
        try {
          return typeof internal.shouldCommit !== 'function' || internal.shouldCommit() === true;
        } catch {
          return false;
        }
      })();
      if (!startMayCommit) {
        const abandonedVoiceSessionId = normalizeText(result?.voiceSessionId, 200);
        if (abandonedVoiceSessionId) {
          try {
            await callVoiceTrainer(
              `/api/v1/voice/sessions/${encodeURIComponent(abandonedVoiceSessionId)}/end`,
              { method: 'POST', body: { reason: 'voice input turn superseded' } },
            );
          } catch {
            // Local state still remains untouched. Remote cleanup is best effort
            // because the caller has already abandoned this turn.
          }
        }
        throw createHttpError(409, 'Voice input turn is no longer current.');
      }
      session.voiceState = voiceStateRuntime.updateSessionVoiceState(session, {
        status: result?.status || 'ready',
        targetPreset,
        voiceSessionId: result?.voiceSessionId || currentVoiceState.voiceSessionId || null,
        lessonId: result?.lessonId || currentVoiceState.lessonId || null,
        referenceClipId,
        targetVoiceProfile: activeTargetVoiceProfile,
        targetSource,
        streamUrl: result?.streamUrl || currentVoiceState.streamUrl || null,
        serviceStatus: 'online',
        sessionStartedAt: result?.createdAt || Date.now(),
        endedAt: null,
        lastError: null,
      });
      if (referenceClipId) {
        // L3 rides AFTER the reference prewarm so the real first request wins.
        void prewarmSelectedReference(referenceClipId, session)
          .then(() => prewarmInvariantTemplates(session))
          .catch(() => null);
      }
      pushRuntimeWitness('info', 'target-transition', 'Voice analyzer acknowledged a target binding.', {
        outcome: 'analyzer_bound',
        target_source: normalizeVoiceTargetSourceCategory(session.voiceState.targetSource),
        target_direction: targetDirectionFromPreset(session.voiceState.targetPreset),
        expected_profile_present: Boolean(activeTargetVoiceProfile),
        actual_profile_present: Boolean(session.voiceState.targetVoiceProfile),
        analyzer_acknowledged: Boolean(result?.voiceSessionId),
      });
      return buildSessionPayload(session, { voiceTrainer: result });
    },
    async updateVoiceSessionReference(body = {}) {
      const session = requireSession(body.sessionId);
      const previousVoiceState = voiceStateRuntime.normalizeVoiceState(session.voiceState);
      const referenceClipId = normalizeText(body.referenceClipId, 120) || null;
      if (!referenceClipId) {
        const analyzer = await retireAnalyzerSessionForTargetTransition(session, 'reference target removed');
        assertAnalyzerRetiredForTargetTransition(previousVoiceState, 'built-in', analyzer);
        session.voiceState = voiceStateRuntime.updateSessionVoiceState(session, {
          ...targetTransitionResetPatch(),
          targetSource: 'built-in',
          targetVoiceProfile: null,
          selectedCustomPresetId: null,
          selectedCustomPresetName: null,
          referenceClipId: null,
          referenceClipName: null,
          referenceAnalysis: null,
        });
        abortTtsStreamsForSession(session.id, 'selected-tutor-voice-changed');
        logTargetTransition(previousVoiceState, session.voiceState, analyzer);
        return buildSessionPayload(session);
      }

      let referenceAnalysis;
      let targetVoiceProfile;
      let targetPreset;
      try {
        referenceAnalysis = await callVoiceTrainer(
          `/api/v1/voice/reference/${encodeURIComponent(referenceClipId)}`,
          { method: 'GET' },
        );
        if (!isRecord(referenceAnalysis) || normalizeText(referenceAnalysis.clipId, 120) !== referenceClipId) {
          throw createHttpError(409, 'Reference analysis does not match the selected reference clip.');
        }
        if (isRejectedReferenceAnalysis(referenceAnalysis)) {
          throw createHttpError(422, 'Reference audio is not reliable enough to become a voice target.');
        }
        targetPreset = normalizeText(referenceAnalysis.targetPreset, 80)
          || previousVoiceState.targetPreset
          || 'cute-feminine';
        targetVoiceProfile = await callVoiceTrainer('/api/v1/voice/target/profile', {
          method: 'POST',
          body: { clipId: referenceClipId, targetPreset },
        });
        if (
          !isRecord(targetVoiceProfile)
          || normalizeText(targetVoiceProfile.clipId, 120) !== referenceClipId
          || normalizeText(targetVoiceProfile.targetPreset, 80) !== targetPreset
        ) {
          throw createHttpError(409, 'Derived target profile does not match the selected reference.');
        }
        assertReferenceCalibrationMatch(referenceAnalysis, targetVoiceProfile);
        const referenceContract = resolveMetricContract({
          targetPreset,
          targetSource: 'reference',
          targetVoiceProfile,
        }, {
          targetPreset,
          metrics: { advanced: { measurementAvailable: true } },
          target: {
            source: 'reference',
            targetProfileId: targetVoiceProfile.profileId,
            direction: targetDirectionFromPreset(targetPreset),
          },
        });
        if (!normalizeText(targetVoiceProfile.profileId, 160) || !referenceContract.hasTargetContract) {
          throw createHttpError(422, `Reference target contract is invalid: ${[
            ...referenceContract.targetValidationFailures,
            ...(referenceContract.hasTargetContract ? [] : ['missing_target_contract']),
          ].join(', ')}`);
        }
      } catch (error) {
        logTargetTransitionFailure(previousVoiceState, 'reference', 'profile_derivation_failed', null, {
          reference_calibration_status: referenceCalibrationStatus(referenceAnalysis, targetVoiceProfile),
        });
        throw error;
      }

      const analyzer = await retireAnalyzerSessionForTargetTransition(session, 'reference target selected');
      assertAnalyzerRetiredForTargetTransition(previousVoiceState, 'reference', analyzer);
      session.voiceState = voiceStateRuntime.updateSessionVoiceState(session, {
        ...targetTransitionResetPatch(),
        targetPreset,
        targetSource: 'reference',
        targetVoiceProfile,
        selectedCustomPresetId: null,
        selectedCustomPresetName: null,
        referenceClipId,
        referenceClipName: normalizeText(referenceAnalysis.filename || body.referenceClipName, 200) || null,
        referenceAnalysis,
      });
      abortTtsStreamsForSession(session.id, 'selected-tutor-voice-changed');
      logTargetTransition(previousVoiceState, session.voiceState, analyzer);
      return buildSessionPayload(session);
    },
    async updateVoiceSessionPreset(body = {}) {
      const session = requireSession(body.sessionId);
      const targetPreset = normalizeText(body.targetPreset, 80) || 'cute-feminine';
      // 2026-07-27 MTF-ONLY — THE UPDATE-SIDE WRITE GATE.
      //
      // This handler used to store ANY string verbatim, with no enum check and
      // no analyzer round-trip. That is how an invalid row got into the session
      // store in the first place: the round-4 reviewer drove this path and made
      // a session's stored preset "masculine". Every read-side guard downstream
      // (drills, cockpit, cue sheet) is then arguing about a row that should
      // never have existed, and this write makes no analyzer call at all.
      //
      // So the enum is enforced HERE, at the write, against the live registry
      // itself (voice-cue-sheet PRESET_PROFILES — imported, not re-listed, via
      // the shared assertLiveBuiltInTargetPreset). Rejecting is the whole
      // response: a masculinizing target is corrupt input, not a legacy lane,
      // so it is never coerced to a live preset. This runs BEFORE any side
      // effect (analyzer retirement, TTS abort, state write), so a rejected
      // write leaves the session exactly as it was.
      //
      // Scope note (CORRECTED 2026-07-27, round 5). An earlier revision of this
      // comment said the analyzer's gate "gates session START only" and implied
      // START was therefore covered. It was NOT: startVoiceSession persisted the
      // row via getOrCreateSession -> createSession -> persistSessionsSafely
      // BEFORE the analyzer round-trip could reject it, so the request 400'd and
      // the bad row survived. START now carries its own copy of this gate, ahead
      // of getOrCreateSession — see startVoiceSession above. The two gateway
      // write sinks for a built-in targetPreset are exactly those two handlers.
      //
      // This handler is the BUILT-IN target path (it sets targetSource
      // 'built-in' and clears selectedCustomPresetId). Custom and reference
      // targets have their own handlers — selectVoiceTargetPreset and
      // updateVoiceSessionReference — so restricting this one to the built-in
      // enum turns nothing legitimate away.
      assertLiveBuiltInTargetPreset(targetPreset);
      const previousVoiceState = voiceStateRuntime.normalizeVoiceState(session.voiceState);
      const analyzer = await retireAnalyzerSessionForTargetTransition(session, 'built-in target selected');
      assertAnalyzerRetiredForTargetTransition(previousVoiceState, 'built-in', analyzer);
      session.voiceState = voiceStateRuntime.updateSessionVoiceState(session, {
        ...targetTransitionResetPatch(),
        targetPreset,
        targetSource: 'built-in',
        targetVoiceProfile: null,
        selectedCustomPresetId: null,
        selectedCustomPresetName: null,
        referenceClipId: null,
        referenceClipName: null,
        referenceAnalysis: null,
      });
      abortTtsStreamsForSession(session.id, 'selected-tutor-voice-changed');
      logTargetTransition(previousVoiceState, session.voiceState, analyzer);
      return buildSessionPayload(session);
    },
    async listCustomVoiceTargetPresets(query = {}) {
      return callVoiceTrainer(`/api/v1/voice/presets${query.includeArchived ? '?includeArchived=true' : ''}`)
        .catch(() => ({ presets: [] }));
    },
    async saveCurrentVoiceTargetPreset(body = {}) {
      return callVoiceTrainer('/api/v1/voice/presets/reference/save', { method: 'POST', body });
    },
    async saveHandmadeVoiceTargetPreset(body = {}) {
      return callVoiceTrainer('/api/v1/voice/presets/handmade/save', { method: 'POST', body });
    },
    async selectVoiceTargetPreset(body = {}) {
      const session = normalizeSessionId(body.sessionId) ? requireSession(body.sessionId) : null;
      if (session) {
        const presetId = normalizeText(body.presetId, 120);
        if (!presetId) {
          throw createHttpError(400, 'presetId is required.');
        }
        let preset;
        try {
          preset = await callVoiceTrainer(`/api/v1/voice/presets/${encodeURIComponent(presetId)}`);
        } catch (error) {
          pushRuntimeWitness('warn', 'target-transition', 'Custom target resolution failed.', {
            outcome: 'preset_fetch_failed',
            requested_profile_present: true,
          });
          throw error;
        }
        let resolved;
        try {
          resolved = resolveSelectedCustomPreset(preset);
        } catch (error) {
          pushRuntimeWitness('warn', 'target-transition', 'Custom target contract was rejected.', {
            outcome: 'preset_contract_rejected',
            preset_kind: preset?.kind === 'reference' ? 'reference' : 'handmade',
            reference_quality_rejected: isRejectedReferenceAnalysis(preset?.referenceAnalysis),
            reference_evidence_missing: preset?.kind === 'reference'
              && !hasTrustworthyReferenceMeasurement(preset?.referenceAnalysis),
            reference_calibration_status: preset?.kind === 'reference'
              ? referenceCalibrationStatus(preset?.referenceAnalysis, preset?.targetVoiceProfile)
              : 'not_applicable',
          });
          throw error;
        }
        const previousVoiceState = voiceStateRuntime.normalizeVoiceState(session.voiceState);
        const analyzer = await retireAnalyzerSessionForTargetTransition(session, 'custom target selected');
        assertAnalyzerRetiredForTargetTransition(previousVoiceState, resolved.targetSource, analyzer);
        const nextVoiceState = voiceStateRuntime.normalizeVoiceState({
          ...session.voiceState,
          ...targetTransitionResetPatch(),
          targetPreset: resolved.targetPreset,
          targetSource: resolved.targetSource,
          targetVoiceProfile: resolved.targetVoiceProfile,
          selectedCustomPresetId: resolved.selectedCustomPresetId,
          selectedCustomPresetName: resolved.selectedCustomPresetName,
          referenceClipId: resolved.referenceClipId,
          referenceClipName: resolved.referenceClipName,
          referenceAnalysis: resolved.referenceAnalysis,
        });
        const targetBinding = bindLearnerVoiceTarget(session, nextVoiceState, 'preset-selected');
        session.voiceState = voiceStateRuntime.updateSessionVoiceState(session, {
          ...nextVoiceState,
          targetBinding,
        });
        abortTtsStreamsForSession(session.id, 'selected-tutor-voice-changed');
        logTargetTransition(previousVoiceState, session.voiceState, analyzer);
        checkpointCoachSession(session, { lastActivityAt: Date.now() }, 'preset-selected');
        return buildSessionPayload(session, { preset });
      }
      return { success: true, presetId: normalizeText(body.presetId, 120) || null };
    },
    async duplicateVoiceTargetPreset(body = {}) {
      return callVoiceTrainer(`/api/v1/voice/presets/${encodeURIComponent(body.presetId || '')}/duplicate`, { method: 'POST', body });
    },
    async archiveVoiceTargetPreset(body = {}) {
      return callVoiceTrainer(`/api/v1/voice/presets/${encodeURIComponent(body.presetId || '')}/archive`, { method: 'POST', body });
    },
    async restoreVoiceTargetPreset(body = {}) {
      return callVoiceTrainer(`/api/v1/voice/presets/${encodeURIComponent(body.presetId || '')}/restore`, { method: 'POST', body });
    },
    async deleteVoiceTargetPreset(body = {}) {
      const query = Number.isFinite(Number(body.expectedUpdatedAt)) ? `?expectedUpdatedAt=${Math.round(Number(body.expectedUpdatedAt))}` : '';
      return callVoiceTrainer(`/api/v1/voice/presets/${encodeURIComponent(body.presetId || '')}${query}`, { method: 'DELETE' });
    },
    /**
     * SELF-PRACTICE MENU (2026-07-29). The two-mode split: the tutor owns every
     * rung with a word in it; this is the pure-sound list a learner opens when
     * they are not in the state to want to talk.
     *
     * DELIBERATELY UNLIKE getVoiceDrills BELOW IN TWO WAYS, and neither is an
     * oversight to be "fixed":
     *  1. NO PRESET FALLBACK. getVoiceDrills defaults an unknown preset to
     *     cute-feminine so the tutor is never left with nothing. This returns an
     *     empty menu instead — see the comment in lessons/self-practice.js. An
     *     empty screen is obviously broken and therefore recoverable; a quietly
     *     substituted target is not.
     *  2. NO SESSION IS REQUIRED. The session is read ONLY to recover the
     *     learner's target preset when the caller did not pass one. The mode has
     *     to be openable in two free minutes, so it must not need a live tutor.
     *
     * NOTE FOR CALLERS: `targetPreset` here is the learner's GOAL LANE
     * ('cute-feminine', …), not the id of the uploaded voice sample the tutor
     * speaks with. Passing the sample id yields an empty menu with no error.
     */
    async listSelfPracticeDrills(query = {}) {
      const session = normalizeSessionId(query.sessionId) ? sessions.get(normalizeSessionId(query.sessionId)) : null;
      const targetPreset = normalizeText(query.targetPreset, 80)
        || session?.voiceState?.targetPreset
        || '';
      // Strict opt-in: nothing but an explicit "true" unlocks full-voice work
      // (case and surrounding spaces are forgiven, so 'TRUE' and ' true ' also
      // count — a query string is typed by hand often enough). A missing or
      // garbled param stays quiet, so a confused caller can never be the reason
      // someone at a bus stop is handed a lip trill.
      const allowLoud = String(query.allowLoud || '').trim().toLowerCase() === 'true';
      const drills = listSelfPracticeDrillsForPreset({ presetKey: targetPreset, allowLoud });
      return { targetPreset: targetPreset || null, allowLoud, drills };
    },
    async getVoiceDrills(query = {}) {
      const session = normalizeSessionId(query.sessionId) ? sessions.get(normalizeSessionId(query.sessionId)) : null;
      const targetPreset = normalizeText(query.targetPreset, 80)
        || session?.voiceState?.targetPreset
        || 'cute-feminine';
      const drills = getVoiceDrillPack(targetPreset);
      const selectedLessonId = session?.voiceState?.lessonId || null;
      // 2026-07-26 (Defect 4). Two things had frozen this list into the same
      // three drills forever: it never passed the summary (so voice-drills gave
      // every 'starter' drill a +1.2 boost and returned one fixed permutation),
      // and it had no memory of what it had just prescribed.
      //
      // FRESHNESS RULE HERE — deliberately different from the coach's. The
      // coach's turn-window gate (Defect 3) exists so a stale take cannot make
      // CLAIMS about the learner's current voice. Drill selection makes no
      // claim; it answers "what is worth practising next", and an hour-old
      // measurement is still the best available evidence of that. So the
      // freshest summary is used REGARDLESS of turn-window freshness. Only a
      // completely absent summary falls back to the starter ordering.
      const recommendationSummary = session?.voiceState?.lastSummary
        || session?.voiceState?.lastAttemptArtifact?.summary
        || null;
      const recentDrillIds = Array.isArray(session?.voiceState?.recentDrillIds)
        ? session.voiceState.recentDrillIds
        : [];
      const recommendedIds = recommendVoiceDrillIds({
        targetPreset,
        selectedLessonId,
        summary: recommendationSummary,
        hasReference: Boolean(session?.voiceState?.referenceClipId),
        recentDrillIds,
      });
      if (session) {
        // Remember what was just prescribed so the NEXT call rotates.
        //
        // CADENCE: this is a GET the client calls freely — the frontend has
        // roughly a dozen refreshDrills/refreshVoiceDrills(true) call sites, so
        // the set can rotate several times within a single learner action
        // (take finalize, preset change, panel open, reconnect...), not once
        // per take. That is exactly why the penalty DOWN-RANKS rather than
        // excludes: the worst an extra refetch can do is nudge the ordering,
        // and a drill the learner's own metrics call for (+1.15 per tag match)
        // or one they selected themselves (+1.4) still outranks the largest
        // penalty (0.9) and comes straight back. Exclusion under this cadence
        // would have starved the pack.
        session.voiceState = voiceStateRuntime.updateSessionVoiceState(session, {
          recentDrillIds: [...recommendedIds, ...recentDrillIds]
            .filter((id, index, list) => list.indexOf(id) === index)
            .slice(0, RECENTLY_PRESCRIBED_MEMORY),
        });
      }
      return {
        success: true,
        targetPreset,
        drills,
        selectedLessonId,
        selectedDrill: selectedLessonId ? getVoiceDrillById(targetPreset, selectedLessonId) : null,
        recommendedIds,
      };
    },
    async selectVoiceDrill(body = {}) {
      const session = requireSession(body.sessionId);
      const targetPreset = session.voiceState?.targetPreset || 'cute-feminine';
      const drill = getVoiceDrillById(targetPreset, body.lessonId) || getVoiceDrillPack(targetPreset)[0] || null;
      // An explicit learner selection always supersedes an engine instruction,
      // including re-selecting the same drill to restart it.
      clearPendingTakeKind(session, 'drill_selected');
      session.voiceState = voiceStateRuntime.updateSessionVoiceState(session, {
        lessonId: drill?.id || null,
        activeLine: drill ? createStandaloneLine(session, drill, 'select') : null,
        practiceProgression: null,
        lastError: null,
      });
      checkpointCoachSession(session, { lastActivityAt: Date.now() }, 'practice-updated');
      return buildSessionPayload(session, { selectedDrill: drill });
    },
    async updateVoiceCockpitLine(body = {}) {
      const session = requireSession(body.sessionId);
      const targetPreset = session.voiceState?.targetPreset || 'cute-feminine';
      const action = normalizeText(body.action, 40) || 'ensure';
      // A prescription belongs to the exact line the tutor made it against.
      // Every explicit line navigation action replaces/reissues that line, so
      // it must retire the old one-shot even when the lesson id is unchanged.
      clearPendingTakeKind(session, 'line_changed');
      // 2026-07-19: `regenerate` draws from the voice-cockpit-lines catalog (the
      // per-preset seed pool) so regenerating actually varies the line; before
      // this it re-issued the same drill phrase under a new id. The drill pack
      // keeps owning ensure/next/easier/harder/pin — complementary sources, not
      // competing ones. Catalog empty/exhausted -> fall through to the drill path.
      if (action === 'regenerate') {
        const catalogLine = pickVoiceCockpitCatalogLine({
          targetPreset,
          currentLineId: session.voiceState?.activeLine?.id || '',
          excludeText: session.voiceState?.activeLine?.displayText || '',
        });
        if (catalogLine) {
          session.voiceState = voiceStateRuntime.updateSessionVoiceState(session, {
            activeLine: {
              ...catalogLine,
              referenceMode: session.voiceState?.referenceClipId ? 'reference-supported' : null,
              pinned: Boolean(session.voiceState?.activeLine?.pinned),
            },
            practiceProgression: null,
            lastError: null,
          });
          checkpointCoachSession(session, { lastActivityAt: Date.now() }, 'practice-updated');
          return buildSessionPayload(session);
        }
      }
      const drills = getVoiceDrillPack(targetPreset);
      const currentIndex = drills.findIndex((drill) => drill.id === session.voiceState?.lessonId);
      const drill = action === 'next'
        ? drills[(currentIndex + 1 + drills.length) % drills.length]
        : (currentIndex >= 0 ? drills[currentIndex] : drills[0]);
      session.voiceState = voiceStateRuntime.updateSessionVoiceState(session, {
        lessonId: drill?.id || session.voiceState?.lessonId || null,
        activeLine: createStandaloneLine(session, drill, action),
        practiceProgression: null,
        lastError: null,
      });
      checkpointCoachSession(session, { lastActivityAt: Date.now() }, 'practice-updated');
      return buildSessionPayload(session);
    },
    async getVoiceInputStatus() {
      const backend = await voiceInputAsrBridge.getStatus({ refresh: true });
      const transcriptionAvailable = backend.enabled === true && backend.available === true;
      const live = voiceInputLiveService?.getStatus?.() || {
        attached: false,
        activeConnections: 0,
        detector: voiceTurnDetector.getStatus(),
        fallbackCount: 0,
      };
      const acousticStatus = await getAcousticInputAvailability(live.attached === true);
      const acousticTurnAvailable = acousticStatus.available === true;
      const backendCaptureAvailable = transcriptionAvailable || acousticTurnAvailable;
      const unifiedListeningReady = transcriptionAvailable && acousticTurnAvailable;
      const liveCaptureAvailable = backendCaptureAvailable && live.attached === true;
      return {
        success: true,
        status: unifiedListeningReady
          ? 'ready'
          : (backendCaptureAvailable ? 'degraded' : (backend.enabled ? 'unavailable' : 'disabled')),
        listening: {
          canStart: backendCaptureAvailable,
          status: unifiedListeningReady
            ? 'ready'
            : (backendCaptureAvailable ? 'degraded' : 'unavailable'),
          semanticAvailable: transcriptionAvailable,
          acousticAvailable: acousticTurnAvailable,
          reason: unifiedListeningReady
            ? null
            : (!transcriptionAvailable && acousticTurnAvailable
              ? 'Words may need an immediate spoken retry until semantic listening recovers.'
              : (transcriptionAvailable && !acousticTurnAvailable
                ? 'Voice-quality feedback is temporarily unavailable.'
                : (acousticStatus.reason || backend.reason || 'Listening services are unavailable.'))),
        },
        providers: {
          browser: { enabled: true, available: true },
          backend: {
            ...backend,
            available: backendCaptureAvailable,
            transcriptionAvailable,
            acousticTurnAvailable,
            acousticReason: acousticStatus.reason,
            live,
            capabilities: {
              normalizedTurnContract: true,
              liveCapture: liveCaptureAvailable,
              recordedCapture: transcriptionAvailable
                || config.voiceCoachTakeDecodeEnabled !== false,
              automaticTurnBoundary: backendCaptureAvailable,
              finalTranscript: transcriptionAvailable,
              interimTranscript: false,
              vad: backendCaptureAvailable,
              bargeInCancel: false,
            },
          },
        },
      };
    },
    async updateVoiceInputRuntime(body = {}) {
      const session = requireSession(body.sessionId);
      const voiceInputRuntime = {
        ...(session.voiceState?.voiceInputRuntime || {}),
        status: normalizeText(body.event, 40) || 'idle',
        lastOutcome: normalizeText(body.event, 40) || 'idle',
        requestedProvider: body.requestedProvider === 'backend' ? 'backend' : 'browser',
        effectiveProvider: body.effectiveProvider || null,
        captureProvider: body.captureProvider || null,
        transcriptSource: body.transcriptSource || null,
        lastTranscript: normalizeText(body.transcript, 1000) || null,
        lastTranscriptConfidence: Number.isFinite(Number(body.confidence)) ? Number(body.confidence) : null,
        lastEventAt: Number.isFinite(Number(body.eventAt)) ? Math.round(Number(body.eventAt)) : Date.now(),
        lastError: normalizeText(body.error, 200) || null,
      };
      session.voiceState = voiceStateRuntime.updateSessionVoiceState(session, { voiceInputRuntime });
      return buildSessionMutationPayload(
        session,
        { voiceInputRuntime },
        { voiceInputRuntime },
      );
    },
    async submitVoiceInputTurn(body = {}, internal = {}) {
      const session = requireSession(body.sessionId);
      const requestedProvider = body.requestedProvider === 'backend' ? 'backend' : 'browser';
      const captureProvider = body.captureProvider === 'backend' ? 'backend' : 'browser';
      let transcript = normalizeText(body.transcript, 1200);
      let confidence = Number.isFinite(Number(body.confidence)) ? Number(body.confidence) : null;
      let providerStyle = null;
      let transcriptSource = normalizeText(body.transcriptSource, 80);

      const isInternalTurnCurrent = () => {
        if (internal.signal?.aborted === true) return false;
        try {
          return typeof internal.shouldCommit !== 'function' || internal.shouldCommit() === true;
        } catch {
          return false;
        }
      };
      const ensureInternalTurnCurrent = () => {
        if (!isInternalTurnCurrent()) {
          throw createHttpError(409, 'Voice input turn is no longer current.');
        }
      };
      ensureInternalTurnCurrent();

      // This turn's analyzer take, once settled. Declared at turn scope because
      // both the no-speech reply and the transcript reply report its side
      // channels.
      let coachTake = null;
      // Declared at turn scope for the same reason `coachTake` is: BOTH replies
      // report it. A spoken turn has a trigger too — 'transcript', carrying the
      // analyzer's verdict on HOW those words were voiced — and a field reader
      // must be able to see it from the payload, not only from the log.
      let turnTrigger = null;
      let turnEvidence = null;

      if (!transcript && captureProvider === 'backend') {
        const mimeType = normalizeMimeType(body.mimeType || `audio/${normalizeText(body.audioFormat, 12) || 'webm'}`);
        if (!mimeType) {
          throw createHttpError(400, 'Unsupported recorded audio type.');
        }
        const audioBuffer = Buffer.isBuffer(internal.audioBuffer)
          ? internal.audioBuffer
          : decodeBase64Audio(body.audioBase64);
        if (!audioBuffer.length) {
          throw createHttpError(400, 'Recorded audio is empty.');
        }
        // ── The analyzer take leg (2026-07-26). Dispatched BEFORE the ASR is
        //    awaited so the two run concurrently: the DSP take and the
        //    transcription read the same segment and neither waits on the
        //    other. `beginCoachTakeAnalysis` never rejects and never runs past
        //    its own deadline, so this can add no failure mode and no more than
        //    that deadline to the turn.
        //
        //    Double-submission guard (source scope): only the live coach input
        //    path supplies `internal.pcmBuffer`. The solo practice transport
        //    streams straight into the trainer's WebSocket from the browser and
        //    finalizes through /voice/take — it never reaches this function, so
        //    it can never be double-counted here. Its `takeActive` flag lives in
        //    frontend/src/voice/practice-transport.ts and is not visible to the
        //    backend at all (there is no armed-practice flag on voiceState
        //    either). The race-free guard is therefore the trainer's own
        //    single-stream slot, which answers 409 while the practice socket
        //    owns the session; that surfaces here as a fail-open take error.
        //
        //    2026-07-27: the leg is only additive if it can RUN. The live coach
        //    client binds no analyzer session (POST /session/start does not),
        //    so without this the dispatch below returned null on every turn and
        //    the DSP was never consulted about any sound the learner made.
        //    Fail-open: a bind that fails leaves this exactly as it was.
        //
        //    Only when a take is PLAUSIBLE — binding otherwise would create a
        //    real analyzer session on the trainer that nothing can ever use, and
        //    make the route wear this leg's latency for nothing. "Plausible", not
        //    "certain": the check below is the synchronous decode PLAN, so a
        //    format nothing here can read never binds, while a decodable payload
        //    whose decode then fails at runtime does bind. That residual case is
        //    bounded — `voiceSessionId` is cached on the session and the next
        //    turn reuses it — but it is a real one, so the guard is not claimed
        //    to be exact.
        //
        //    2026-07-27 (SECOND wordless gap). That condition used to read
        //    "`internal.pcmBuffer` is a Buffer", which only the live STREAMING
        //    path supplies. `POST /voice/input/turn` (voice-runtime-entrypoints.js:320)
        //    calls this handler as `submitVoiceInputTurn(req.body || {})` — no
        //    `internal` at all — so the RECORDED path dispatched ZERO takes.
        //    MEASURED against the working tree (4f98044 plus the unstaged take
        //    -witness work — the `no_pcm_segment` witness named here does NOT
        //    exist at 4f98044 itself, where that guard is a silent `return null`),
        //    driving this handler with a real 2s voiced ogg/opus payload:
        //    take requests 0, witness reason 'no_pcm_segment', trigger
        //    'unresolved' under the current evidence contract (the historical
        //    resolver incorrectly called that absence 'silent').
        //    `voiced_evidence` was therefore STRUCTURALLY UNREACHABLE on the
        //    recorded branch: words and voicing were peers in the resolver but
        //    only one of them was ever gathered.
        //
        //    So the condition is now "a take is possible", which the recorded
        //    path can satisfy by DECODING its browser audio. The plan is
        //    resolved synchronously first (no ffmpeg, or a mime nothing here can
        //    read, means no bind — the old waste-avoidance still holds), and the
        //    decode itself is dispatched alongside the ASR.
        //
        //    Double-submission is unaffected: the recorded path already ran the
        //    ASR over this exact buffer, and /voice/take remains the only other
        //    take dispatcher. The trainer's per-session single-stream slot and
        //    `coachTakeInFlight` are still the race guards.
        //
        //    And CONCURRENTLY with the ASR, not in front of it. Awaiting the
        //    bind first put its whole deadline on the critical path of every
        //    turn; overlapped, a healthy bind is free and a slow one is hidden
        //    under transcription the turn was going to pay for anyway. The
        //    decode joins the same shadow: worst case decode (2s) + take (2.5s)
        //    still sits inside the ASR's own 10s budget.
        const streamPcmBuffer = Buffer.isBuffer(internal.pcmBuffer) ? internal.pcmBuffer : null;
        // Recorded audio only. A streamed turn already HAS its PCM and must not
        // pay a decode — this keeps the streaming branch byte-identical.
        const recordedDecodePlan = (!streamPcmBuffer && config.voiceCoachTakeDecodeEnabled !== false)
          ? resolveRecordedTakeDecodePlan(mimeType, { ffmpegPath: config.voiceCoachTakeFfmpegPath || null })
          : null;
        if (recordedDecodePlan && !recordedDecodePlan.decodable) {
          // DEGRADE TO TODAY, out loud. This turn has no take, so its acoustic
          // evidence is 'unresolved' unless the ASR found words — and the
          // witness NAMES the format so a
          // field reader can tell "we cannot read webm here" apart from "the
          // learner made no sound", which is the confusion this whole repair is about.
          pushRuntimeWitness('warn', 'coach-take', 'Recorded take cannot be decoded for the analyzer; this turn has no take evidence.', {
            outcome: 'recorded_take_decode_unavailable',
            reason: recordedDecodePlan.reason,
            audio_type: recordedDecodePlan.mimeType || mimeType,
          });
          logger?.log?.({
            event: 'coach_take_decode',
            outcome: 'unavailable',
            reason: recordedDecodePlan.reason,
            audio_type: recordedDecodePlan.mimeType || mimeType,
            ms: 0,
          });
        }
        const pendingDecode = recordedDecodePlan?.decodable === true
          ? decodeRecordedAudioToPcm16({
            audioBuffer,
            mimeType,
            ffmpegPath: config.voiceCoachTakeFfmpegPath || null,
            timeoutMs: Number.isFinite(Number(config.voiceCoachTakeDecodeTimeoutMs))
              ? Math.max(1, Math.round(Number(config.voiceCoachTakeDecodeTimeoutMs)))
              : 2000,
          })
          : null;
        const pendingBind = (streamPcmBuffer || pendingDecode)
          ? ensureCoachAnalyzerSession(session, { shouldCommit: isInternalTurnCurrent })
          : null;
        // Settle-shaped so a rejecting ASR cannot become an UNHANDLED rejection
        // while we are awaiting the bind. The throw is re-raised below, at the
        // point the original code threw it, so the caller's semantics are
        // unchanged.
        let latestAsrSettlement = null;
        const pendingAsr = voiceInputAsrBridge.transcribeAudio({
          audioBuffer,
          filename: normalizeText(body.filename, 160) || `voice-input.${normalizeText(body.audioFormat, 12) || 'webm'}`,
          mimeType,
          language: normalizeText(body.language, 20) || config.voiceAsrLanguage,
          signal: internal.signal,
        }).then(
          (value) => ({ ok: true, value }),
          (error) => ({ ok: false, error }),
        ).then((settlement) => {
          latestAsrSettlement = settlement;
          return settlement;
        });
        if (pendingBind) await pendingBind;
        ensureInternalTurnCurrent();
        // The segment this turn's take will read: the streamed PCM when there is
        // one, otherwise whatever the decode produced. `decodeRecordedAudioToPcm16`
        // always resolves and never rejects, so awaiting it here can add no
        // failure mode — a failed decode simply yields null and
        // `beginCoachTakeAnalysis` witnesses 'no_pcm_segment' exactly as before.
        let takePcmBuffer = streamPcmBuffer;
        if (pendingDecode) {
          const decoded = await pendingDecode;
          logger?.log?.({
            event: 'coach_take_decode',
            outcome: decoded.ok === true ? 'decoded' : 'failed',
            reason: decoded.ok === true ? null : decoded.reason,
            via: decoded.via || null,
            audio_type: decoded.mimeType || mimeType,
            bytes_in: decoded.bytesIn ?? audioBuffer.length,
            bytes_out: decoded.bytesOut ?? 0,
            ms: decoded.ms,
          });
          if (decoded.ok === true) {
            takePcmBuffer = decoded.pcm;
          } else {
            pushRuntimeWitness('warn', 'coach-take', 'Recorded take audio could not be decoded; this turn has no take evidence.', {
              outcome: 'recorded_take_decode_failed',
              reason: decoded.reason,
              audio_type: decoded.mimeType || mimeType,
              ms: decoded.ms,
            });
          }
          ensureInternalTurnCurrent();
        }
        const expectedTakeKind = resolveCoachTakeKind(session).kind;
        const pendingCoachTake = beginCoachTakeAnalysis(session, takePcmBuffer);
        const takeOutcome = pendingCoachTake ? await pendingCoachTake : null;
        const graceSettlement = latestAsrSettlement == null
          ? await settleWithin(
            pendingAsr,
            resolveAsrMergeGraceMs(takeOutcome, expectedTakeKind),
          )
          : null;
        const asrBypassed = latestAsrSettlement == null
          && graceSettlement == null;
        const settledAsr = latestAsrSettlement
          || graceSettlement
          || (asrBypassed
            ? {
              ok: false,
              bypassed: true,
              error: new Error('ASR bypassed after the bounded semantic merge window.'),
            }
            : null);
        // Currency is checked BEFORE the take is landed, never after. A turn
        // whose `shouldCommit` has gone false was superseded or abandoned — the
        // learner stopped, or spoke again over it — and it must commit NOTHING,
        // exactly as it committed nothing before this leg existed.
        //
        // This is not tidiness. A discarded turn never reaches `lastProcessedAt`
        // below, so the NEXT turn's freshness window still anchors on an older
        // turn — which means a take landed here would pass
        // resolveTakeEvidenceFreshness as `in_turn_window` on a turn it does not
        // belong to. That is precisely the stale-take substitution the gate
        // exists to prevent. Landing also writes learner-context, a checkpoint,
        // and the guardian side channels, none of which a discarded turn earns.
        if (takeOutcome && !isInternalTurnCurrent()) {
          logCoachTakeWitness({
            outcome: 'skipped',
            ms: takeOutcome.ms,
            takeKind: takeOutcome.takeKind,
            takeKindSource: takeOutcome.takeKindSource,
            hasMetrics: false,
            reason: 'turn_superseded',
          });
        }
        ensureInternalTurnCurrent();
        consumeCommittedPendingTakeKind(session, takeOutcome);
        coachTake = settleCoachTakeAnalysis(session, takeOutcome);
        const result = settledAsr.ok === true
          ? settledAsr.value
          : {
            success: false,
            noSpeech: true,
            transcript: '',
            error: settledAsr.error?.message || 'Voice ASR transcription failed.',
            transcriptSource: 'backend-asr',
          };
        // A transcript that normalizes to NOTHING (whitespace, control chars)
        // is a wordless turn, not a client contract error. Routing it through
        // the no-speech branch keeps the 5f5541f recoverability semantics and
        // avoids the inverted state a plain 400 here would leave: the take has
        // ALREADY landed above, so failing the turn afterward would strand
        // fresh take evidence on a turn that never advanced the input window.
        const asrTranscript = normalizeText(result?.transcript, 1200);
        // ── THE TURN TRIGGER (2026-07-27) ─────────────────────────────────
        // Named ONCE, here, from both evidence sources at their peer. The ASR
        // no longer decides whether a turn happened; it contributes words, the
        // analyzer contributes phonation, and this line reads both. The witness
        // is what makes the decision auditable from the field log alone — the
        // exact thing that was missing while two repairs were attempted blind.
        turnTrigger = resolveVoiceTurnTrigger({
          transcript: result?.noSpeech === true ? '' : asrTranscript,
          transcriptConfidence: result?.confidence,
          takeOutcome: coachTake,
          expectedTakeKind,
        });
        turnEvidence = buildVoiceTurnEvidence({
          asrSettled: settledAsr,
          asrResult: result,
          turnTrigger,
          takeOutcome: coachTake,
          expectedTakeKind,
        });
        logger?.log?.({
          event: 'voice_turn_trigger',
          trigger: turnTrigger.trigger,
          take_outcome: coachTake?.outcome || 'none',
          voiced_evidence: turnTrigger.voicedEvidence === true,
          asr_no_speech: result?.noSpeech === true,
        });
        if (turnTrigger.trigger !== VOICE_TURN_TRIGGERS.TRANSCRIPT) {
          const resolvedExpectedTakeKind = coachTake?.takeKind || expectedTakeKind;
          // Positive analyzer evidence is an accepted voice-quality turn even
          // when ASR misses the words. Only silent or unresolved phrase turns
          // ask for another sentence.
          const acceptedMeasuredTurn = turnTrigger.trigger === VOICE_TURN_TRIGGERS.VOICED_EVIDENCE;
          const wordlessPracticeKind = isWordlessPracticeKind(resolvedExpectedTakeKind);
          const lexicalRetry = !acceptedMeasuredTurn && !wordlessPracticeKind;
          // 2026-07-26: a WORDLESS practice turn is not a failed turn. When the
          // active drill is a vocalise (hum/SOVT/siren/sustained), the learner
          // is SUPPOSED to make sound with no words in it, and the ASR is
          // supposed to find no speech. This branch returns before any coach
          // turn is built, so without this the learner heard nothing back and
          // the loop just said "record again".
          //
          // Deterministic and code-owned: no LLM call, no fabricated scoring —
          // one acknowledgment line and a one-shot flag the frontend surfaces.
          //
          // 2026-07-26 (analyzer take leg): the ASR found no words, but the
          // analyzer may have found plenty. When THIS turn's take landed with
          // metrics, the acknowledgment says so — heard AND read — instead of
          // the weaker heard-only line. When it timed out or failed, the
          // original lines stand unchanged.
          const progressionTransition = wordlessPracticeKind
            ? applyPracticeProgressionTurn(
              session,
              coachTake?.takeKind,
              turnEvidence,
              coachTake,
            )
            : null;
          const acknowledgement = lexicalRetry
            ? {
              takeKind: resolvedExpectedTakeKind || 'phrase',
              drillId: session.voiceState?.lessonId || null,
              analyzed: coachTake?.hasMetrics === true,
              ackBasis: 'semantic_retry',
              line: resolveLexicalRetryLine(session, turnEvidence),
            }
            : resolveWordlessPracticeAcknowledgement(
              session,
              coachTake,
              turnTrigger,
            );
          const responseAction = progressionTransition?.coachLine
            ? {
              ...(acknowledgement || {}),
              takeKind: acknowledgement?.takeKind || coachTake?.takeKind || null,
              drillId: acknowledgement?.drillId || session.voiceState?.lessonId || null,
              analyzed: coachTake?.hasMetrics === true,
              ackBasis: acknowledgement?.ackBasis || turnTrigger.trigger,
              line: progressionTransition.coachLine,
            }
            : acknowledgement;
          if (responseAction) {
            pushRuntimeWitness('info', 'voice-input', lexicalRetry
              ? 'Lexical evidence was unavailable; sentence retry requested.'
              : 'Wordless vocalise practice acknowledged.', {
              outcome: lexicalRetry ? 'semantic_retry' : 'wordless_practice_ack',
              take_kind: responseAction.takeKind,
              drill_id: responseAction.drillId,
              analyzed: responseAction.analyzed === true,
              // WHY this fired: 'drill_kind' = the session's own drill state
              // said vocalise; 'voiced_evidence' = the state said otherwise and
              // the analyzer's voiced frames overrode it. A field session that
              // shows only 'voiced_evidence' is telling you the drill state is
              // not following the tutor's spoken prescription.
              ack_basis: responseAction.ackBasis,
              // WHAT MADE THIS A TURN. 'voiced_evidence' means the analyzer —
              // not the drill state, and never the engine's prescription —
              // confirmed a sound the ASR had no words for. That is the case
              // the word path used to eat.
              turn_trigger: turnTrigger.trigger,
            });
          }
          return buildSessionPayload(session, {
            // The take-finalize side channels for this turn's take (guardian
            // level, strainWatch, any guardian line). They already mutated the
            // session, so they must also be reported — the same fields the solo
            // take path returns.
            ...(coachTake?.extras || {}),
            inputTurn: {
              outcome: 'no-speech',
              requestedProvider,
              captureProvider,
              transcript: null,
              confidence: null,
              providerStyle: normalizeText(result.providerStyle, 80) || null,
              transcriptSource: normalizeText(result.transcriptSource, 80) || 'backend-asr',
              isFinal: body.isFinal !== false,
              capturedAt: Number.isFinite(Number(body.capturedAt))
                ? Math.round(Number(body.capturedAt))
                : Date.now(),
              // The named trigger for this turn, on the wire. `outcome` stays
              // 'no-speech' because that is the live client's contract for "the
              // ASR produced no words" and it re-arms on it — but 'no-speech'
              // was never the same statement as "nothing happened", and this
              // field is what finally separates the two for anyone reading a
              // payload: 'voiced_evidence' = the analyzer heard the learner,
              // 'unresolved' = evidence was insufficient, and 'silent' = the
              // analyzer corroborated no signal at its loudness floor.
              turnTrigger: turnTrigger.trigger,
              voicedEvidence: turnTrigger.voicedEvidence === true,
              evidence: turnEvidence,
              responseCommitted: true,
              // Present ONLY on a wordless-practice turn; absent otherwise, so
              // the existing no-speech behavior for phrase drills is untouched.
              // `coachLine` is this codebase's existing name for a warm line
              // destined for the coach thread (VoiceRealSentenceOutcomeResponse);
              // the live client reads it off the capture-ready envelope.
              ...(responseAction
                ? {
                  ...(lexicalRetry
                    ? { semanticRetry: true }
                    : { wordlessPractice: true }),
                  takeKind: responseAction.takeKind,
                  coachLine: responseAction.line,
                  // Whether the line the learner hears rests on a real reading
                  // from THIS take, or only on having heard the sound.
                  takeAnalyzed: responseAction.analyzed === true,
                  ...(progressionTransition
                    ? {
                      practiceProgression: {
                        transition: progressionTransition.transition,
                        phase: progressionTransition.progression?.phase || 'complete',
                        expectedUnit: progressionTransition.progression?.expectedUnit || null,
                        lexicalAccuracy: progressionTransition.lexicalAccuracy,
                      },
                    }
                    : {}),
                }
                : {}),
            },
          });
        }
        if (!result?.success) {
          pushRuntimeWitness('warn', 'voice-input', 'Recorded speech transcription failed.', {
            outcome: 'asr_transcription_failed',
            provider_style: config.voiceAsrApiStyle,
            audio_type: mimeType,
          });
          throw createHttpError(502, result?.error || 'Voice ASR transcription failed.', {
            providers: { backend: await voiceInputAsrBridge.getStatus({ refresh: false }) },
          });
        }
        transcript = asrTranscript;
        confidence = Number.isFinite(Number(result.confidence)) ? Number(result.confidence) : confidence;
        providerStyle = normalizeText(result.providerStyle, 80) || null;
        transcriptSource = normalizeText(result.transcriptSource, 80) || 'backend-asr';
        applyPracticeProgressionTurn(
          session,
          coachTake?.takeKind,
          turnEvidence,
          coachTake,
          transcript,
        );
      }
      // THE MALFORMED-CALLER GATE, and nothing else (2026-07-27).
      //
      // This 400 is deliberately NOT routed through `resolveVoiceTurnTrigger`,
      // and the reason is reachability rather than preference. MEASURED against
      // this handler at HEAD 4f98044, all three ways in:
      //
      //   captureProvider 'backend' + audio, WORDLESS  -> never arrives here. The
      //     block above owns it end to end and returns the 200 no-speech payload
      //     with `turnTrigger`. A genuinely silent analyzed take reports
      //     'silent'; absent or insufficient evidence reports 'unresolved'.
      //   captureProvider 'backend', NO audioBase64    -> never arrives here either;
      //     `decodeBase64Audio` (voice-input-asr.js) already threw 400
      //     "audioBase64 is required for backend voice input turns" upstream. The
      //     'backend' arm of the message below is therefore UNREACHABLE, kept only
      //     so the two providers stay symmetrical if that upstream guard moves.
      //   captureProvider 'browser', no transcript     -> the one live path here.
      //     A browser-transcript turn supplies NO audio at all, so there is nothing
      //     for the analyzer to hear and no take to consult: a trigger decision
      //     would be 'unresolved' by construction, on zero evidence. Answering that
      //     with a coach turn would launder a client bug into a practice turn.
      //
      // A wordless-but-voiced take cannot reach this line. A caller that sent
      // neither words nor audio is the only thing that can.
      if (!transcript) {
        throw createHttpError(400, captureProvider === 'backend'
          ? 'transcript or audioBase64 is required for backend voice input turns'
          : 'transcript is required for browser voice input turns');
      }
      ensureInternalTurnCurrent();
      const capturedAt = Number.isFinite(Number(body.capturedAt)) ? Math.round(Number(body.capturedAt)) : Date.now();
      session.voiceState = voiceStateRuntime.updateSessionVoiceState(session, {
        voiceInputRuntime: {
          ...(session.voiceState?.voiceInputRuntime || {}),
          status: 'idle',
          lastOutcome: 'completed',
          requestedProvider,
          effectiveProvider: captureProvider,
          captureProvider,
          providerStyle,
          transcriptSource: transcriptSource || (captureProvider === 'backend' ? 'backend-asr' : 'browser-speech-recognition'),
          lastTranscript: transcript,
          lastTranscriptConfidence: confidence,
          successfulTurns: Number(session.voiceState?.voiceInputRuntime?.successfulTurns || 0) + 1,
          capturedAt,
          // 2026-07-26 (Defect 3): the turn window for the NEXT coach turn opens
          // at the PREVIOUS input turn, not this one — the take for this turn is
          // finalized around the same instant as this ASR, in either order, so
          // anchoring on `lastProcessedAt` would reject a genuinely fresh take.
          previousInputTurnAt: Number.isFinite(
            Number(session.voiceState?.voiceInputRuntime?.lastProcessedAt),
          )
            ? Number(session.voiceState.voiceInputRuntime.lastProcessedAt)
            : null,
          lastProcessedAt: Date.now(),
        },
      });
      checkpointCoachSession(session, {
        state: 'active',
        lastSpokeAt: capturedAt,
        lastLearnerSpokeAt: capturedAt,
        lastActivityAt: Date.now(),
      }, 'learner-spoke');
      const listeningTurnId = turnTrigger
        ? registerListeningTurn(session, {
          transcript,
          confidence,
          evidence: turnEvidence,
          takeKind: coachTake?.takeKind,
          capturedAt,
        })
        : null;
      return buildSessionPayload(session, {
        // As in the no-speech branch: the take's side channels already mutated
        // the session, so the reply reports them rather than hiding them.
        ...(coachTake?.extras || {}),
        inputTurn: {
          requestedProvider,
          captureProvider,
          transcript,
          confidence,
          providerStyle,
          transcriptSource: transcriptSource || (captureProvider === 'backend' ? 'backend-asr' : 'browser-speech-recognition'),
          isFinal: body.isFinal !== false,
          capturedAt,
          ...(listeningTurnId ? { listeningTurnId } : {}),
          // Absent on a browser-supplied transcript, where no analyzer take ran
          // and there is therefore nothing honest to say about voicing.
          ...(turnTrigger
            ? {
              turnTrigger: turnTrigger.trigger,
              voicedEvidence: turnTrigger.voicedEvidence === true,
              evidence: turnEvidence,
              responseCommitted: true,
            }
            : {}),
        },
      });
    },
    async getVoiceSpeechStatus() {
      if (!config.voxcpmEnabled) {
        return {
          success: true,
          providers: {
            browser: { enabled: true, available: true },
            voxcpm: { enabled: false, available: false, reason: 'VoxCPM is not enabled. Set VOXCPM_ENABLED=true to enable.' },
          },
        };
      }
      const HEALTH_CACHE_TTL_MS = 5000;
      if (speechStatusCache && Date.now() - speechStatusCache.ts < HEALTH_CACHE_TTL_MS) {
        return speechStatusCache.result;
      }
      try {
        const controller = new AbortController();
        const timeout = setTimeout(() => controller.abort(), 300);
        const resp = await fetch(`${config.voxcpmUrl}/health`, { signal: controller.signal });
        clearTimeout(timeout);
        if (resp.ok) {
          const info = await resp.json();
          const result = {
            success: true,
            providers: {
              browser: { enabled: true, available: true },
              voxcpm: {
                enabled: true,
                available: info.ok === true && info.model_loaded === true,
                baseUrl: config.voxcpmUrl,
                model: config.voxcpmModel,
                cloning: { supported: true },
                lastError: null,
                lastCheckedAt: Date.now(),
                info,
                infoError: null,
              },
            },
          };
          speechStatusCache = { ts: Date.now(), result };
          return result;
        }
        const result = {
          success: true,
          providers: {
            browser: { enabled: true, available: true },
            voxcpm: { enabled: true, available: false, lastError: `TTS health check returned ${resp.status}`, lastCheckedAt: Date.now() },
          },
        };
        speechStatusCache = { ts: Date.now(), result };
        return result;
      } catch (err) {
        const result = {
          success: true,
          providers: {
            browser: { enabled: true, available: true },
            voxcpm: { enabled: true, available: false, lastError: err.message || 'TTS service unreachable', lastCheckedAt: Date.now() },
          },
        };
        speechStatusCache = { ts: Date.now(), result };
        return result;
      }
    },
    async updateVoiceSpeechConditioning(body = {}) {
      const session = requireSession(body.sessionId);
      session.voiceState = voiceStateRuntime.updateSessionVoiceState(session, {
        voiceConditioning: {
          ...(session.voiceState?.voiceConditioning || {}),
          ...(isRecord(body.conditioning) ? body.conditioning : body),
          updatedAt: Date.now(),
        },
      });
      return buildSessionPayload(session);
    },
    async prepareVoiceSpeechConditioningLatents(body = {}) {
      const session = requireSession(body.sessionId);
      return buildSessionPayload(session, {
        prepared: false,
        provider: 'browser',
        reason: 'Standalone Voice Tutor has no server-side TTS latents enabled.',
      });
    },
    async proxyVoiceSpeechGenerate(req, res, body = {}) {
      if (!config.voxcpmEnabled) {
        res.status(501).json({
          success: false,
          provider: 'browser',
          error: 'VoxCPM is not enabled. Set VOXCPM_ENABLED=true to enable server-side speech.',
        });
        return;
      }

      const targetText = normalizeText(body.targetText || body.text, 700);
      if (!targetText) {
        res.status(400).json({ success: false, provider: 'voxcpm', error: 'targetText is required.' });
        return;
      }

      // Word-emphasis channel. VoxCPM has no prosody API and its vendored text
      // normalizer deletes <tags> and speaks asterisks literally, so punctuation
      // is the ONLY emphasis signal that reaches the acoustic model: shape the
      // stressed word into its own short comma-delimited clause. Same words,
      // same order — commas are the only thing added, and the 700-char cap is
      // re-checked AFTER shaping (an over-cap shaping falls back to the
      // original rather than dropping a word). `targetText` itself is left
      // untouched so every other use of it stays the learner-visible line.
      // `emphasisOccurrence` (which whole-word occurrence of the word IN THIS
      // TEXT) is the authoritative selector, because the caller does not always
      // speak the bare practice phrase. `emphasisTokenIndex` is kept for
      // traceability and as a legacy selector for callers whose targetText IS
      // the phrase. Both must be real numbers — Number(null) is 0, which would
      // silently become "the first token".
      const emphasisWord = normalizeText(body.emphasisWord, 80);
      const asRequestIndex = (value) => (
        typeof value === 'number' && Number.isInteger(value) && value >= 0 ? value : null
      );
      const emphasisOccurrence = asRequestIndex(body.emphasisOccurrence);
      const emphasisTokenIndex = asRequestIndex(body.emphasisTokenIndex);
      // Card-token index: witness metadata only, never a selector. It lives in a
      // different coordinate system from `emphasisTokenIndex` (which counts
      // whitespace tokens of THIS text), so it must not share that name.
      const emphasisCardTokenIndex = asRequestIndex(body.emphasisCardTokenIndex);
      let synthesisText = targetText;
      if (emphasisWord) {
        const emphasisShaping = shapeEmphasisClause({
          text: targetText,
          emphasisWord,
          occurrence: emphasisOccurrence,
          tokenIndex: emphasisTokenIndex,
          maxLength: MAX_EMPHASIS_SHAPED_LENGTH,
        });
        synthesisText = emphasisShaping.text;
        logger?.log?.({
          event: 'tts_emphasis',
          requested: emphasisWord,
          matched: emphasisShaping.matched,
          shaped: emphasisShaping.shaped,
          reason: emphasisShaping.reason,
          // Which occurrence was ACTUALLY stressed, and how it was chosen — the
          // witness must never claim to have honoured a selector it discarded.
          selector: emphasisShaping.selector,
          occurrence_requested: emphasisOccurrence,
          occurrence_used: emphasisShaping.occurrenceUsed,
          occurrence_count: emphasisShaping.occurrenceCount,
          token_index_requested: emphasisTokenIndex,
          card_token_index: emphasisCardTokenIndex,
          text_length: synthesisText.length,
        });
      }

      const sessionId = normalizeSessionId(body.sessionId);
      const session = sessionId ? sessions.get(sessionId) : null;
      let referenceClipId = null;
      const sessionVoiceState = session?.voiceState || null;
      if (
        session
        && (
          normalizeText(sessionVoiceState?.selectedCustomPresetId, 160)
          || isRecord(sessionVoiceState?.targetBinding)
        )
      ) {
        const targetBinding = requireExactSessionTargetBinding(session);
        referenceClipId = targetBinding.referenceClipId || null;
      } else if (session) {
        // Compatibility-only raw reference sessions predate named presets.
        // The Coach surface never enters this branch: it requires a selected
        // named uploaded preset before Start.
        referenceClipId = normalizeText(sessionVoiceState?.referenceClipId, 160) || null;
      }
      const speechTargetFingerprint = session
        ? buildSessionSpeechTargetFingerprint(session)
        : null;
      const streamId = `tts-${Date.now()}-${Math.random().toString(16).slice(2, 8)}`;
      const turnId = normalizeText(body.turnId, 200) || null;
      const turnTelemetry = turnId ? getTurnTelemetry(turnId) : null;
      const controller = new AbortController();
      controller.transVoiceSessionId = sessionId;
      activeTtsStreams.set(streamId, controller);

      const createAbortReason = (name, message) => {
        const error = new Error(message);
        error.name = name;
        return error;
      };
      const assertRequestActive = () => {
        if (controller.signal.aborted) {
          throw controller.signal.reason || createAbortReason('AbortError', 'TTS request aborted');
        }
        if (session) {
          let currentFingerprint = null;
          try {
            currentFingerprint = sessions.get(sessionId) === session
              ? buildSessionSpeechTargetFingerprint(session)
              : null;
          } catch {
            currentFingerprint = null;
          }
          if (currentFingerprint !== speechTargetFingerprint) {
            const error = createAbortReason('AbortError', 'Selected tutor voice changed');
            if (!controller.signal.aborted) controller.abort(error);
            throw error;
          }
        }
        if (res.destroyed && !res.writableEnded) {
          const error = createAbortReason('AbortError', 'TTS downstream client disconnected');
          controller.abort(error);
          throw error;
        }
      };
      const waitForActiveRequest = async (operation) => {
        assertRequestActive();
        const phasePromise = Promise.resolve().then(operation);
        let onAbort;
        let phaseTimeout;
        const abortPromise = new Promise((_, reject) => {
          onAbort = () => reject(
            controller.signal.reason || createAbortReason('AbortError', 'TTS request aborted'),
          );
          controller.signal.addEventListener('abort', onAbort, { once: true });
        });
        const timeoutPromise = new Promise((_, reject) => {
          phaseTimeout = setTimeout(() => {
            const error = createAbortReason('TimeoutError', 'TTS request phase timed out');
            if (!controller.signal.aborted) {
              controller.abort(error);
            }
            reject(error);
          }, config.voxcpmTimeoutMs);
        });
        try {
          // Each external phase gets a fresh inactivity budget. Reference
          // preparation must not consume the time needed to deliver the tutor's
          // later audio, and every received PCM chunk resets the body-read budget.
          const value = await Promise.race([phasePromise, abortPromise, timeoutPromise]);
          assertRequestActive();
          return value;
        } finally {
          clearTimeout(phaseTimeout);
          controller.signal.removeEventListener('abort', onAbort);
        }
      };
      const waitForRetryDelay = (delayMs) => new Promise((resolve, reject) => {
        assertRequestActive();
        let timer;
        const onAbort = () => {
          clearTimeout(timer);
          reject(controller.signal.reason || createAbortReason('AbortError', 'TTS request aborted'));
        };
        timer = setTimeout(() => {
          controller.signal.removeEventListener('abort', onAbort);
          resolve();
        }, delayMs);
        controller.signal.addEventListener('abort', onAbort, { once: true });
      });
      const fetchGenerationWhenWorkerAvailable = async (upstreamBody) => {
        let busyAttempt = 0;
        while (true) {
          assertRequestActive();
          const response = await fetch(`${config.voxcpmUrl}/generate`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(upstreamBody),
            signal: controller.signal,
          });
          if (response.status !== 429) return response;

          // A cancelled synthesis can keep VoxCPM's single model worker occupied
          // briefly because an in-flight GPU call cannot be interrupted safely.
          // Keep this request alive within its existing phase budget instead of
          // turning that expected overlap into an immediate learner-visible 502.
          try { await response.body?.cancel?.(); } catch {}
          busyAttempt += 1;
          logger?.log?.({
            event: 'tts_generation_admission',
            outcome: 'busy_retry',
            attempt: busyAttempt,
          });
          const delayMs = Math.min(2000, 100 * (2 ** Math.min(busyAttempt - 1, 5)));
          await waitForRetryDelay(delayMs);
        }
      };
      const onClientDisconnect = () => {
        if (res.writableEnded) return;
        if (!controller.signal.aborted) {
          controller.abort(createAbortReason('AbortError', 'TTS downstream client disconnected'));
        }
      };
      res.once('close', onClientDisconnect);
      try {
        if (turnTelemetry) {
          turnTelemetry.mark('tts_request_at', { source: 'gateway' });
        }

        // Cloning gate: only push the reference into VoxCPM when the DSP quality
        // assessment marks the clip cloneable. These helpers have their own signals,
        // so race them against this request's lifecycle and re-check after each await.
        let referenceAudioPath = null;
        if (referenceClipId) {
          const activePrewarm = referencePrewarmPromises.get(referenceClipId);
          if (activePrewarm) {
            await waitForActiveRequest(() => activePrewarm);
            assertRequestActive();
          }
          const cloneDecision = await waitForActiveRequest(
            () => resolveCloneDecision(referenceClipId),
          );
          assertRequestActive();
          if (cloneDecision.cloneable) {
            referenceAudioPath = await waitForActiveRequest(
              () => ensureReferenceAudio(referenceClipId),
            );
            assertRequestActive();
          }
          if (!referenceAudioPath) {
            if (turnTelemetry) {
              turnTelemetry.setFallback('tts_reference_unavailable', { source: 'gateway' });
              logTurnTelemetry(turnTelemetry, { stage: 'tts_reference_unavailable' });
            }
            res.setHeader('Cache-Control', 'no-store');
            res.setHeader('X-Voice-Speech-Provider', 'voxcpm');
            res.setHeader('X-Reference-Resolved', 'false');
            res.setHeader('X-Voice-Cloned', 'false');
            res.status(409).json({
              success: false,
              provider: 'voxcpm',
              error: 'Selected tutor voice is unavailable.',
            });
            return;
          }
        }

        const speakingRate = normalizeTutorSpeakingRate(body.speakingRate);
        const upstreamBody = {
          // Emphasis-shaped when the caller named a word, byte-identical to
          // targetText otherwise. Never SSML, never markdown.
          target_text: synthesisText,
          speakingRate,
        };
        if (referenceAudioPath) {
          upstreamBody.reference_audio_path = referenceAudioPath;
        }

        const upstream = await waitForActiveRequest(
          () => fetchGenerationWhenWorkerAvailable(upstreamBody),
        );

        if (!upstream.ok) {
          if (turnTelemetry) {
            turnTelemetry.setFallback('tts_http_error', { source: 'gateway' });
            logTurnTelemetry(turnTelemetry, { stage: 'tts_proxy' });
          }
          if (!res.headersSent) {
            res.status(502).json({
              success: false,
              provider: 'voxcpm',
              error: `TTS service returned status ${upstream.status}`,
            });
          }
          return;
        }

        const upstreamGenerationMode = normalizeText(
          upstream.headers.get('X-TTS-Generation-Mode'),
          40,
        ).toLowerCase();
        const upstreamReferenceAudioRole = normalizeText(
          upstream.headers.get('X-Reference-Audio-Role'),
          40,
        ).toLowerCase();
        const upstreamAppliedRate = Number(upstream.headers.get('X-Speaking-Rate-Applied'));
        const expectedGenerationMode = referenceAudioPath
          ? 'cloned-synthesis'
          : 'profile-synthesis';
        const expectedReferenceAudioRole = referenceAudioPath
          ? 'conditioning-only'
          : 'none';

        // The selected recording may condition the cloned voice, but it must
        // never be sent downstream as tutor speech. Fail closed unless the TTS
        // service proves that this response is newly synthesized target text.
        if (
          upstreamGenerationMode !== expectedGenerationMode
          || upstreamReferenceAudioRole !== expectedReferenceAudioRole
          || !Number.isFinite(upstreamAppliedRate)
          || Math.abs(upstreamAppliedRate - speakingRate) > 0.005
        ) {
          try { await upstream.body?.cancel?.(); } catch {}
          if (turnTelemetry) {
            turnTelemetry.setFallback('tts_http_error', { source: 'gateway' });
            logTurnTelemetry(turnTelemetry, { stage: 'tts_synthesis_evidence_rejected' });
          }
          res.status(502).json({
            success: false,
            provider: 'voxcpm',
            error: 'Tutor speech synthesis could not be verified.',
          });
          return;
        }

        if (turnTelemetry) {
          turnTelemetry
            .setMetadata('tts_provider', 'voxcpm')
            .setMetadata('tts_generation_mode', upstreamGenerationMode)
            .setMetadata('tts_reference_audio_role', upstreamReferenceAudioRole)
            .setMetadata('tts_speaking_rate', upstreamAppliedRate);
        }
        pushRuntimeWitness('info', 'tts-synthesis', 'Tutor speech synthesis verified.', {
          outcome: 'verified',
          provider: 'voxcpm',
          generation_mode: upstreamGenerationMode,
          reference_audio_role: upstreamReferenceAudioRole,
          speaking_rate: upstreamAppliedRate,
        });

        const contentType = upstream.headers.get('content-type') || 'audio/wav';

        res.setHeader('Content-Type', contentType);
        res.setHeader('Cache-Control', 'no-store');
        res.setHeader('X-Voice-Speech-Provider', 'voxcpm');
        // Honesty contract: any successful response for a selected reference is
        // necessarily cloned because unresolved references returned above.
        if (referenceClipId) {
          res.setHeader('X-Reference-Resolved', referenceAudioPath ? 'true' : 'false');
        }
        res.setHeader('X-Voice-Speech-Stream-Id', streamId);
        // Always report cloning status explicitly: 'true' only when a reference
        // was both present AND passed the clone gate (referenceAudioPath set);
        // 'false' otherwise (no reference, or gated out as un-cloneable).
        res.setHeader('X-Voice-Cloned', referenceAudioPath ? 'true' : 'false');
        if (turnId) {
          res.setHeader('X-Turn-Id', turnId);
        }

        const contentLength = upstream.headers.get('content-length');
        if (contentLength) {
          res.setHeader('Content-Length', contentLength);
        }

        for (const headerName of VOXCPM_AUDIO_RESPONSE_HEADERS) {
          const headerValue = upstream.headers.get(headerName);
          if (typeof headerValue === 'string') {
            res.setHeader(headerName, headerValue);
          }
        }

        // 2026-07-30 call-and-response graph: THE PUBLISH SEAM.
        //
        // This response is the one that already accompanies a spoken line — it
        // carries the audio itself — so the tutor's measured travel rides with
        // the sound it describes, arriving exactly when the dot should start
        // moving. A header, because the body is raw audio bytes; and the
        // frontend already reads six headers off this very response.
        //
        // A pure LOOKUP. It never waits for an analysis and never triggers one:
        // by construction the measurement already happened on the pre-synthesis
        // of this same text, rate and reference, or it did not happen at all. A
        // miss (cold line the pre-synthesis has not finished, analyzer down,
        // audio unmeasurable) sets no header, and the graph draws no tutor dot
        // for that turn. Nothing about the speech is delayed either way.
        const tutorTrack = readTutorMetricTrack(buildTutorMetricTrackKey({
          text: synthesisText,
          speakingRate,
          referenceAudioPath,
        }));
        if (tutorTrack) {
          const encodedTrack = encodeTutorMetricTrackHeader(tutorTrack);
          if (encodedTrack) {
            res.setHeader(TUTOR_METRIC_TRACK_HEADER, encodedTrack);
          }
        }

        if (upstream.body) {
          const reader = upstream.body.getReader();
          let firstByteMarked = false;
          try {
            while (true) {
              const { done, value } = await waitForActiveRequest(() => reader.read());
              if (done) break;
              if (!firstByteMarked && turnTelemetry) {
                turnTelemetry.mark('tts_first_byte_at', { source: 'gateway' });
                firstByteMarked = true;
              }
              res.write(value);
            }
          } finally {
            reader.releaseLock();
          }
          if (!res.writableEnded && !res.destroyed) {
            res.end();
          }
          if (turnTelemetry) {
            turnTelemetry.mark('tts_done_at', { source: 'gateway' });
            logTurnTelemetry(turnTelemetry, { stage: 'tts_stream_complete' });
          }
        } else {
          const buffer = Buffer.from(await waitForActiveRequest(() => upstream.arrayBuffer()));
          if (turnTelemetry) {
            turnTelemetry.mark('tts_first_byte_at', { source: 'gateway' });
          }
          if (!res.writableEnded && !res.destroyed) {
            res.end(buffer);
          }
          if (turnTelemetry) {
            turnTelemetry.mark('tts_done_at', { source: 'gateway' });
            logTurnTelemetry(turnTelemetry, { stage: 'tts_buffered_complete' });
          }
        }
      } catch (err) {
        const abortReason = controller.signal.aborted ? controller.signal.reason : null;
        const isTimeout = abortReason?.name === 'TimeoutError';
        const isAbort = Boolean(abortReason) || err?.name === 'AbortError';
        if (turnTelemetry) {
          if (isTimeout) {
            turnTelemetry.setFallback('tts_timeout', { source: 'gateway' });
          } else if (isAbort) {
            turnTelemetry.setFallback('tts_cancelled', { source: 'gateway' });
          } else if (res.headersSent) {
            turnTelemetry.setFallback('tts_stream_error', { source: 'gateway' });
          } else {
            turnTelemetry.setFallback('tts_network_error', { source: 'gateway' });
          }
          logTurnTelemetry(turnTelemetry, {
            stage: isTimeout
              ? (res.headersSent ? 'tts_stream_timeout' : 'tts_proxy_timeout')
              : (isAbort ? 'tts_cancelled' : (res.headersSent ? 'tts_stream_error' : 'tts_proxy_error')),
          });
        }

        pushRuntimeWitness('error', 'tts-synthesis', 'Tutor speech stream interrupted.', {
          outcome: 'failed',
          failure_reason: isTimeout
            ? 'timeout'
            : (isAbort ? 'cancelled' : (res.headersSent ? 'stream-error' : 'network-error')),
          response_started: Boolean(res.headersSent),
        });

        if (isTimeout) {
          if (!res.headersSent && !res.destroyed) {
            res.status(504).json({ success: false, provider: 'voxcpm', error: 'TTS request timed out' });
          } else if (!res.writableEnded && !res.destroyed) {
            // A normal EOF would make partial tutor speech indistinguishable
            // from a complete utterance. Tear down the body so fetch readers
            // reject and the frontend cannot acknowledge `/voice/speech/played`.
            res.destroy();
          }
        } else if (isAbort) {
          if (!res.headersSent && !res.destroyed) {
            res.status(499).json({ success: false, provider: 'voxcpm', error: 'TTS request cancelled' });
          } else if (!res.writableEnded && !res.destroyed) {
            res.destroy();
          }
        } else if (!res.headersSent) {
          res.status(502).json({
            success: false,
            provider: 'voxcpm',
            error: 'TTS service unavailable',
          });
        } else if (!res.writableEnded && !res.destroyed) {
          res.destroy();
        }
      } finally {
        res.removeListener('close', onClientDisconnect);
        activeTtsStreams.delete(streamId);
      }
    },
    activeTtsStreams,
    recordVoiceSpeechPlayback(body = {}) {
      const session = requireSession(body.sessionId);
      if (!session.voiceState?.referenceClipId || body.provider !== 'voxcpm') {
        throw createHttpError(409, 'A resolved preset-bound tutor voice is required.');
      }
      const coachSpokeAt = Date.now();
      session.voiceState = voiceStateRuntime.updateSessionVoiceState(session, {
        lastCoachSpokenAt: coachSpokeAt,
      });
      checkpointCoachSession(session, {
        state: 'active',
        lastCoachSpokeAt: coachSpokeAt,
        lastActivityAt: coachSpokeAt,
      }, 'coach-spoke');
      return {
        success: true,
        recorded: true,
        coachSpokeAt,
      };
    },
    cancelVoiceSpeech(body = {}) {
      const streamId = normalizeText(body.streamId, 100);
      const controller = streamId ? activeTtsStreams.get(streamId) : null;
      const cancelled = Boolean(controller);
      if (controller) {
        controller.abort();
        activeTtsStreams.delete(streamId);
      }
      return {
        success: true,
        sessionId: normalizeSessionId(body.sessionId) || null,
        streamId: streamId || null,
        cancelled,
        provider: config.voxcpmEnabled ? 'voxcpm' : 'browser',
      };
    },
    async updateVoiceCockpitState(body = {}) {
      const session = requireSession(body.sessionId);
      const voiceStatePatch = {
        ...(isRecord(body.coachVoice) ? { coachVoice: body.coachVoice } : {}),
        ...(isRecord(body.voiceInputRuntime) ? { voiceInputRuntime: body.voiceInputRuntime } : {}),
        ...(isRecord(body.advancedPanel) ? { advancedPanel: body.advancedPanel } : {}),
      };
      session.voiceState = voiceStateRuntime.updateSessionVoiceState(session, {
        coachVoice: isRecord(body.coachVoice) ? body.coachVoice : session.voiceState?.coachVoice,
        voiceInputRuntime: isRecord(body.voiceInputRuntime) ? body.voiceInputRuntime : session.voiceState?.voiceInputRuntime,
        advancedPanel: isRecord(body.advancedPanel) ? body.advancedPanel : session.voiceState?.advancedPanel,
      });
      return buildSessionMutationPayload(session, {}, voiceStatePatch);
    },
    async projectVoicePhraseForecast(body = {}) {
      const session = requireSession(body.sessionId);
      const phrase = normalizeText(body.phrase, 500);
      if (!phrase) {
        throw createHttpError(400, 'phrase is required');
      }
      const targetProfile = session.voiceState?.targetVoiceProfile || body.targetVoiceProfile;
      if (!targetProfile) {
        session.voiceState = voiceStateRuntime.updateSessionVoiceState(session, {
          forecastPhrase: phrase,
          phraseForecast: null,
          lastError: 'Load or derive a target voice profile before phrase forecasting.',
        });
        return buildSessionPayload(session, { phraseForecast: null });
      }
      const forecast = await callVoiceTrainer('/api/v1/voice/target/forecast', {
        method: 'POST',
        body: { phrase, targetProfile },
      });
      session.voiceState = voiceStateRuntime.updateSessionVoiceState(session, {
        forecastPhrase: phrase,
        phraseForecast: forecast,
        lastError: null,
      });
      return buildSessionPayload(session, { phraseForecast: forecast });
    },
    async saveVoicePhraseComparison(body = {}) {
      const session = requireSession(body.sessionId);
      session.voiceState = voiceStateRuntime.updateSessionVoiceState(session, {
        phraseComparison: isRecord(body.phraseComparison) ? body.phraseComparison : null,
        lastTakeTimeline: Array.isArray(body.lastTakeTimeline) ? body.lastTakeTimeline : session.voiceState?.lastTakeTimeline || null,
      });
      return buildSessionPayload(session);
    },
    async startAsyncVoiceCoachTask(body = {}) {
      const session = requireSession(body.sessionId);
      const taskId = normalizeText(body.taskId, 160) || createId('voice-coach-task');
      tasks.set(taskId, {
        status: 'running',
        result: null,
        error: null,
        sessionId: session.id,
        startedAt: Date.now(),
      });
      void generateRealtimeCoachReply(session, 'Give me one concise post-take coaching note for the latest voice attempt.')
        .then((payload) => {
          tasks.set(taskId, {
            status: 'done',
            result: payload.coachMessage || payload.message || session.voiceState?.lastCoachMessage || '',
            error: null,
            sessionId: session.id,
            completedAt: Date.now(),
          });
        })
        .catch((error) => {
          tasks.set(taskId, {
            status: 'error',
            result: null,
            error: error.message,
            sessionId: session.id,
            completedAt: Date.now(),
          });
        });
      return { taskId, status: 'running' };
    },
    async processVoiceCoachRuntime(body = {}) {
      const session = requireSession(body.sessionId);
      const listeningTurnId = normalizeText(body.listeningTurnId, 200);
      if (listeningTurnId) {
        return processListeningTurnCoach(session, listeningTurnId, (listeningTurn) => (
          generateRealtimeCoachReply(
            session,
            listeningTurn.transcript,
            null,
            'wav',
            listeningTurn,
          )
        ));
      }
      const question = normalizeText(body.message, 1600);
      if (!question) {
        throw createHttpError(400, 'A coach question is required');
      }
      const audioBase64 = typeof body.audioBase64 === 'string' ? body.audioBase64 : null;
      const audioFormat = typeof body.audioFormat === 'string' ? body.audioFormat : 'wav';
      return generateRealtimeCoachReply(
        session,
        question,
        audioBase64,
        audioFormat,
        null,
      );
    },
    async processLegacyVoiceCoachMessage(body = {}) {
      return this.processVoiceCoachRuntime(body);
    },
    async finalizeVoiceTake(body = {}) {
      const session = requireSession(body.sessionId);
      const voiceSessionId = session.voiceState?.voiceSessionId;
      if (!voiceSessionId) {
        throw createHttpError(400, 'No active VoiceTrainer session is available.');
      }
      const result = await callVoiceTrainer(`/api/v1/voice/sessions/${encodeURIComponent(voiceSessionId)}/take`, {
        method: 'POST',
        body: {
          reason: body.reason || 'voice take end',
          sloaneSessionId: session.id,
          referenceClipId: session.voiceState?.referenceClipId || null,
          clientAttemptId: body.clientAttemptId || null,
          repContext: body.repContext,
          selfReport: body.selfReport,
        },
      });
      const summary = result?.summary || result?.attemptArtifact?.summary || null;
      const attemptArtifact = result?.attemptArtifact || null;
      await assertVoiceTakeProvenance({
        session,
        voiceSessionId,
        summary,
        attemptArtifact,
        clientAttemptId: body.clientAttemptId,
      });
      const repContext = result?.attemptArtifact?.repContext || body.repContext || null;
      const takeExtras = landFinalizedTake(session, {
        summary,
        attemptArtifact,
        status: result?.status,
        streamUrl: result?.streamUrl,
        repContext,
        checkpointReason: 'practice-take-finalized',
      });

      return buildSessionPayload(session, {
        summary,
        attemptArtifact,
        ...takeExtras,
      });
    },
    async disarmVoiceSession(body = {}) {
      const session = requireSession(body.sessionId);
      session.voiceState = voiceStateRuntime.updateSessionVoiceState(session, {
        status: 'idle',
        serviceStatus: 'online',
        lastError: null,
      });
      return buildSessionPayload(session);
    },
    async endVoiceSession(body = {}) {
      const session = requireSession(body.sessionId);
      const voiceSessionId = session.voiceState?.voiceSessionId;
      let result = null;
      if (voiceSessionId) {
        result = await callVoiceTrainer(`/api/v1/voice/sessions/${encodeURIComponent(voiceSessionId)}/end`, {
          method: 'POST',
          body: {
            reason: body.reason || 'voice session end',
            sloaneSessionId: session.id,
            referenceClipId: session.voiceState?.referenceClipId || null,
            clientAttemptId: body.clientAttemptId || null,
            repContext: body.repContext,
            selfReport: body.selfReport,
          },
        }).catch((error) => ({ error: error.message }));
      }
      const summary = result?.summary || result?.attemptArtifact?.summary || session.voiceState?.lastSummary || null;
      if (result?.summary || result?.attemptArtifact) {
        await assertVoiceTakeProvenance({
          session,
          voiceSessionId,
          summary: result?.summary || result?.attemptArtifact?.summary || null,
          attemptArtifact: result?.attemptArtifact || null,
          clientAttemptId: body.clientAttemptId,
          analyzerAlreadyEnded: result?.status === 'ended',
        });
      }
      const endedAt = result?.endedAt || Date.now();
      session.voiceState = voiceStateRuntime.updateSessionVoiceState(session, {
        status: 'ended',
        endedAt,
        lastSummary: summary,
        lastAttemptArtifact: result?.attemptArtifact || session.voiceState?.lastAttemptArtifact || null,
        // Session end can also deliver a final take; stamp it the same way, and
        // leave any earlier stamp alone when it does not.
        lastTakeFinalizedAt: result?.attemptArtifact
          ? Date.now()
          : (session.voiceState?.lastTakeFinalizedAt ?? null),
        lastError: result?.error || null,
      });
      // v4 tutor-memory (gap 2): write the per-session log entry into the sessions
      // ring + set lastSessionAt, so a returning session knows TIME has passed.
      // Best-effort: never throws out of session end. B-SESS: a clean close is
      // endReason 'completed' — it upgrades any earlier cut-short entry (pause
      // beacon / sweep) for this session instead of double-writing.
      writeSessionRingEntry(session, endedAt, { endReason: 'completed' });
      return buildSessionPayload(session, {
        summary,
        voiceTrainer: result,
      });
    },
    // ── B-SESS pause beacon ─────────────────────────────────────────────────
    // POST /voice/session/:sessionId/paused — sent by the shell on pagehide via
    // navigator.sendBeacon (no custom headers; trusted-local guard admission).
    // If the session exists and is not ended, the sessions-ring entry is written
    // NOW as 'cut-short' so the continuity chain is correct even if the learner
    // never returns. The session itself is left fully resumable — nothing is
    // stopped or torn down, and updatedAt is deliberately NOT touched. A later
    // clean close upgrades the same ring entry to 'completed' (service dedupe by
    // sessionId); a repeated beacon with no intervening activity is skipped.
    pauseVoiceSessionBeacon(sessionId) {
      const normalizedSessionId = normalizeSessionId(sessionId);
      const session = normalizedSessionId ? sessions.get(normalizedSessionId) : null;
      if (!session) {
        // Beacons are fire-and-forget from closing pages — a stale/unknown id is
        // not an error worth a 4xx.
        return {
          success: true,
          source: 'voice-standalone',
          sessionId: normalizedSessionId || null,
          recorded: false,
          reason: 'not-found',
        };
      }
      const voiceState = session.voiceState || {};
      const active = voiceState.status !== 'ended';
      const guardian = strainGuardians.get(String(session.id || ''));
      const watch = guardian && typeof guardian.strainWatch === 'function' ? guardian.strainWatch() : null;
      const hadActivity = Boolean(
        (watch && Number(watch.takeCount) > 0)
        || (Array.isArray(voiceState.coachThread) && voiceState.coachThread.length > 0)
        || voiceState.lastSummary,
      );
      let recorded = false;
      if (active) {
        recorded = writeSessionRingEntry(session, Date.now(), { endReason: 'cut-short' }) === true;
        checkpointCoachSession(session, {
          state: 'stopped',
          stoppedAt: Date.now(),
          lastActivityAt: Number(session.updatedAt) || Date.now(),
        }, 'page-hidden');
      }
      logger?.log?.({ event: 'session_paused_beacon', hadActivity });
      return {
        success: true,
        source: 'voice-standalone',
        sessionId: session.id,
        recorded,
        hadActivity,
      };
    },
    // ── B-SESS session scope ────────────────────────────────────────────────
    // PATCH-style POST /voice/session/:sessionId/scope — partial update of
    // { tier: 'full'|'quiet'|'silent', eyesFree: boolean }. Invalid values are a
    // 400; the updated sessionScope is echoed on the returned session payload.
    async updateVoiceSessionScope(sessionId, body = {}) {
      const session = requireSession(sessionId);
      const input = isRecord(body) ? body : {};
      const next = normalizeSessionScope(session.sessionScope);
      if (Object.prototype.hasOwnProperty.call(input, 'tier')) {
        if (!SESSION_SCOPE_TIERS.includes(input.tier)) {
          throw createHttpError(400, `tier must be one of: ${SESSION_SCOPE_TIERS.join(', ')}`);
        }
        next.tier = input.tier;
      }
      if (Object.prototype.hasOwnProperty.call(input, 'eyesFree')) {
        if (typeof input.eyesFree !== 'boolean') {
          throw createHttpError(400, 'eyesFree must be a boolean');
        }
        next.eyesFree = input.eyesFree;
      }
      session.sessionScope = next;
      // A scope change is real session activity: touch + persist via the payload
      // builder, which also echoes sessionScope in the extras.
      return buildSessionPayload(session);
    },
    async processDeepTutorVoiceMessage() {
      throw createHttpError(404, 'DeepTutor voice routes are disabled in standalone mode.');
    },
    async processDeepTutorVoiceBriefAction() {
      throw createHttpError(404, 'DeepTutor voice routes are disabled in standalone mode.');
    },
    async processDeepTutorVoiceAdvance() {
      throw createHttpError(404, 'DeepTutor voice routes are disabled in standalone mode.');
    },
    async processDeepTutorVoiceTakeCoaching() {
      throw createHttpError(404, 'DeepTutor voice routes are disabled in standalone mode.');
    },
  };

  const appCompatibilityRouteHandlers = {
    async startSession(body = {}) {
      const requestedAgentId = normalizeText(body.agentId, 80) || 'voice';
      const studentId = normalizeText(body.studentId, 160) || config.defaultStudentId;
      const requestedSessionId = normalizeText(body.sessionId, 160) || null;
      const priorCheckpoint = readCoachCheckpoint(studentId, { requiredReadable: true });
      let checkpointSession = body.forceNewSession !== true
        && priorCheckpoint?.sessionId
        && sessions.get(priorCheckpoint.sessionId)?.studentId === studentId
        && sessions.get(priorCheckpoint.sessionId)?.voiceState?.status !== 'ended'
        ? sessions.get(priorCheckpoint.sessionId)
        : null;
      const requestedSession = requestedSessionId && sessions.get(requestedSessionId)?.studentId === studentId
        ? sessions.get(requestedSessionId)
        : null;
      if (
        !requestedSession
        && !checkpointSession
        && body.forceNewSession !== true
        && priorCheckpoint?.sessionId
      ) {
        checkpointSession = await recoverCoachSessionFromCheckpoint(studentId, priorCheckpoint);
      }
      // The phone's persisted session is an explicit continuity claim and owns
      // its selected voice identity. A newer default-student checkpoint may
      // come from another browser or an automated probe; it must only be used
      // when the caller has no valid existing session of its own.
      let createdSession = false;
      let session = requestedSession || checkpointSession;
      if (!session) {
        session = createSession({
          sessionId: requestedSessionId,
          studentId,
          targetPreset: normalizeText(body.targetPreset, 80) || 'cute-feminine',
          // Start has a single required commit below. Do not perform an earlier
          // best-effort write that could make a failed Start look durable.
          persist: false,
        });
        createdSession = true;
      }
      const resumed = Boolean(checkpointSession || requestedSession);
      if (resumed) {
        // An explicit phone session is also an explicit target claim. Rebind
        // the learner profile to that exact session target before any live
        // input can begin; a stale profile pointing at another preset must not
        // split checkpoint, runtime, and tutor-TTS identity.
        const reboundTargetBinding = bindLearnerVoiceTarget(
          session,
          session.voiceState,
          'session-resumed',
        );
        session.voiceState = voiceStateRuntime.updateSessionVoiceState(session, {
          targetBinding: reboundTargetBinding,
        });
      }
      if (session.voiceState?.status === 'ended') {
        session.voiceState = voiceStateRuntime.updateSessionVoiceState(session, {
          status: 'idle',
          endedAt: null,
        });
      }
      let sessionMutationPersisted = false;
      try {
        if (body.prepareLiveInput === true && body.activate === false) {
          beginLiveInputPreparation(session, body.liveInputLeaseId);
        } else if (body.activate !== false) {
          if (typeof body.continuousEnabled === 'boolean') {
            session.voiceState = voiceStateRuntime.updateSessionVoiceState(session, {
              coachVoice: {
                ...(session.voiceState?.coachVoice || {}),
                continuousEnabled: body.continuousEnabled,
              },
            });
          }
          activateLiveInputSession(session, body.liveInputLeaseId);
        }

        // The mutation must be durably accepted before the checkpoint may say
        // "active" and before Start can return success to the phone.
        touchSession(session, { required: true });
        sessionMutationPersisted = true;

        if (body.activate !== false) {
          const nowValue = Date.now();
          checkpointCoachSession(session, {
            state: 'active',
            stoppedAt: null,
            lastRestartedAt: resumed ? nowValue : null,
            restartCount: resumed
              ? Math.max(0, Number(priorCheckpoint?.restartCount) || 0) + 1
              : Math.max(0, Number(priorCheckpoint?.restartCount) || 0),
            lastActivityAt: nowValue,
          }, 'learner-started', { required: true });
        }
      } catch (error) {
        stopLiveInputSession(session, 'session-start-rollback');
        session.voiceState = voiceStateRuntime.updateSessionVoiceState(session, {
          status: 'idle',
          endedAt: null,
        });
        if (createdSession) {
          sessions.delete(session.id);
        }
        if (sessionMutationPersisted) {
          // The first compensating write cleans the primary; the second makes
          // the backup generation clean too.
          persistSessionsSafely({ required: true });
          persistSessionsSafely({ required: true });
        }
        checkpointCoachSession(session, {
          state: 'stopped',
          stoppedAt: Date.now(),
          lastActivityAt: Date.now(),
        }, 'learner-start-rolled-back');
        throw error;
      }
      // Starting the microphone must not queue an unrelated model-generated
      // lesson plan ahead of the learner's first spoken turn. Planning remains
      // available through the explicit lesson endpoint.
      return buildSessionMutationPayload(session, {
        agentId: requestedAgentId,
        name: 'Voice Tutor',
        agentName: requestedAgentId === 'voice' ? 'Voice Tutor' : requestedAgentId,
        model: config.voiceTutorGgufModel,
        studentId: session.studentId || config.defaultStudentId,
      }, session.voiceState, { persist: false });
    },
    async stopSession(sessionId) {
      const session = sessions.get(normalizeSessionId(sessionId));
      let recorded = false;
      let cancelledSpeechStreams = 0;
      if (session) {
        const closedLiveInputs = stopLiveInputSession(session, 'learner-stopped');
        cancelledSpeechStreams = abortTtsStreamsForSession(session.id, 'learner-stopped');
        const stoppedAt = Date.now();
        session.updatedAt = stoppedAt;
        session.voiceState = voiceStateRuntime.updateSessionVoiceState(session, {
          status: 'idle',
          endedAt: null,
        });
        // End is an explicit, learner-owned pause in one continuing lesson.
        // It updates the return-gap clock without marking the lesson completed.
        recorded = writeSessionRingEntry(session, stoppedAt, {
          endReason: 'learner-stopped',
          persist: false,
        });
        // Verbatim working context is useful only while the turn/session is
        // live. The compact checkpoint above is the durable continuity record.
        purgeWorkingConversationState(session);
        let persistenceError = null;
        try {
          persistSessionsSafely({ required: true });
        } catch (error) {
          persistenceError = error;
        }
        let checkpointError = null;
        try {
          checkpointCoachSession(session, {
            state: 'stopped',
            stoppedAt,
            lastActivityAt: stoppedAt,
          }, 'learner-stopped', { required: true });
        } catch (error) {
          checkpointError = error;
        }
        if (persistenceError) throw persistenceError;
        if (checkpointError) throw checkpointError;
        pushRuntimeWitness('info', 'voice-input-live', 'Learner End invalidated live input.', {
          outcome: 'session-stopped',
          closed_connections: closedLiveInputs,
          cancelled_speech_streams: cancelledSpeechStreams,
          continuity_recorded: recorded,
        });
      }
      return {
        success: true,
        status: 'stopped',
        archived: false,
        sessionId: normalizeSessionId(sessionId) || null,
        continuityRecorded: recorded,
        cancelledSpeechStreams,
      };
    },
    freezeSession(sessionId) {
      return {
        success: true,
        status: 'frozen',
        archived: false,
        sessionId: normalizeSessionId(sessionId) || null,
      };
    },
    listFrozenSessions() {
      return {
        success: true,
        sessions: [],
        frozenSessions: [],
        source: 'voice-standalone',
      };
    },
    listModels() {
      return {
        success: true,
        models: [createStandaloneRuntimeModelEntry(config)],
        source: 'voice-standalone',
      };
    },
    listCompatibilityPresets() {
      return {
        success: true,
        presets: [],
        models: [createStandaloneRuntimeModelEntry(config)],
        note: 'Voice Tutor standalone has no general SLOANE compatibility presets.',
      };
    },
    getModelRuntimeStatus() {
      return {
        success: true,
        status: 'standalone',
        providers: {
          voiceTutorGguf: {
            status: 'configured',
            baseUrl: config.voiceTutorGgufBaseUrl,
            model: config.voiceTutorGgufModel,
          },
        },
      };
    },
    listAgents() {
      return {
        success: true,
        agents: [],
        source: 'voice-standalone',
      };
    },
    getAgentPreferences(agentId) {
      return {
        success: true,
        agentId: normalizeText(agentId, 80) || 'voice',
        model: null,
        reasoningEffort: null,
        knowledgeSelection: [],
      };
    },
    updateAgentPreferences(agentId, body = {}) {
      return {
        success: true,
        agentId: normalizeText(agentId, 80) || 'voice',
        model: normalizeText(body.model, 200) || null,
        reasoningEffort: normalizeText(body.reasoningEffort, 40) || null,
        knowledgeSelection: Array.isArray(body.knowledgeSelection) ? body.knowledgeSelection : [],
      };
    },
    getAgentKnowledgeAccess(agentId) {
      return {
        success: true,
        agentId: normalizeText(agentId, 80) || 'voice',
        knowledgeAccess: [],
        datasets: [],
        source: 'voice-standalone',
      };
    },
    getKnowledgeGrouped() {
      return {
        success: true,
        groups: [],
        datasets: [],
        source: 'voice-standalone',
      };
    },
    getKnowledgeProcessingStatus() {
      return {
        success: true,
        status: 'standalone',
        jobs: [],
        source: 'voice-standalone',
      };
    },
    getKnowledgeMcpStatus() {
      return {
        success: true,
        jobs: [],
        source: 'voice-standalone',
      };
    },
    listKnowledgeVideoJobs() {
      return [];
    },
    listKnowledgeUrlJobs() {
      return {
        success: true,
        jobs: [],
        source: 'voice-standalone',
      };
    },
    getStageState() {
      return {
        success: true,
        state: null,
        canvas: null,
        source: 'voice-standalone',
      };
    },
    getImageStudioCapabilities() {
      return {
        success: true,
        enabled: false,
        capabilities: [],
        source: 'voice-standalone',
      };
    },
    getSessionNotepad(sessionId) {
      const session = requireSession(sessionId);
      const notepad = ensureSessionNotepad(session);
      return {
        success: true,
        sessionId: session.id,
        ...notepad,
        currentTask: session.mainTask || notepad.mainTask || null,
        isBeingEdited: notepad.isBeingEdited || false,
        notepadPolicy: session.notepadPolicy || null,
      };
    },
    updateSessionNotepad(sessionId, body = {}) {
      const session = requireSession(sessionId);
      const content = typeof body.content === 'string' ? body.content : '';
      if (typeof body.mainTask === 'string' && body.mainTask.trim()) {
        session.mainTask = body.mainTask.trim();
      }
      const final = applyNotepadContent(session, content, { compact: false });
      touchSession(session);
      return {
        success: true,
        sessionId: session.id,
        ...session.notepad,
        itemsCount: session.notepad.items.length,
        currentTask: session.mainTask || session.notepad.mainTask || null,
        truncated: final.truncated,
      };
    },
    appendSessionTodo(sessionId, body = {}) {
      const session = requireSession(sessionId);
      const item = normalizeText(body.item, 500);
      if (!item) {
        throw createHttpError(400, 'Invalid item');
      }
      appendNotepadEntry(session, item, normalizeText(body.category, 40) || 'task', {
        compact: true,
        currentTask: session.mainTask || '',
      });
      touchSession(session);
      return {
        success: true,
        sessionId: session.id,
        ...session.notepad,
        currentTask: session.mainTask || session.notepad.mainTask || null,
        totalItems: session.notepad.items.length,
      };
    },
    getTurnTelemetry(turnId) {
      const id = normalizeText(turnId, 200);
      if (!id) {
        throw createHttpError(400, 'turnId is required');
      }
      const telemetry = getTurnTelemetry(id);
      if (!telemetry) {
        return { success: false, error: 'Telemetry not found for that correlation.' };
      }
      return {
        success: true,
        correlationId: telemetry.getSummary().correlationId,
        telemetry: telemetry.getSummary(),
      };
    },
    updateTurnTelemetry(turnId, body = {}) {
      const id = normalizeText(turnId, 200);
      if (!id) {
        throw createHttpError(400, 'turnId is required');
      }
      let telemetry = getTurnTelemetry(id);
      if (!telemetry) {
        // Allow the frontend to create a sparse telemetry record for a turn
        // we have not yet observed (e.g. if speech_end_at was marked before
        // the coaching turn started). Use the same schema and shape.
        telemetry = new TurnTelemetry({
          turnId: id,
        });
        storeTurnTelemetry(id, telemetry);
      }
      const updates = isRecord(body.timestamps) ? body.timestamps : {};
      for (const [key, value] of Object.entries(updates)) {
        if (value == null) continue;
        telemetry.record(key, value, { source: 'frontend' });
      }
      if (Object.prototype.hasOwnProperty.call(body, 'fallback_reason')) {
        const incomingFallback = typeof body.fallback_reason === 'string'
          ? body.fallback_reason.trim().toLowerCase()
          : null;
        // A sparse frontend success report carries `null`. It must never erase
        // a more authoritative timeout/stream failure already observed by the
        // gateway for the same turn.
        if (
          !telemetry.getFallback()
          && TURN_TELEMETRY_FALLBACK_REASONS.includes(incomingFallback)
        ) {
          telemetry.setFallback(incomingFallback, { source: 'frontend' });
        }
      }
      return {
        success: true,
        correlationId: telemetry.getSummary().correlationId,
        telemetry: telemetry.getSummary(),
      };
    },
  };

  const standaloneSessionRouteHandlers = {
    listSessions(query = {}) {
      return listStandaloneSessions(query);
    },
    exportSession(sessionId) {
      return exportStandaloneSession(sessionId);
    },
    deleteSession(sessionId) {
      return deleteStandaloneSession(sessionId);
    },
    pruneSessions() {
      return pruneStandaloneSessions();
    },
  };

  if (!voiceInputLiveService) {
    voiceInputLiveService = createVoiceInputLiveService({
      detector: voiceTurnDetector,
      getSession: (sessionId) => sessions.get(sessionId) || null,
      getSessionGeneration: (session) => Number(session?.coachLiveInputGeneration) || 0,
      canOpenSession: (session, context = {}) => (
        (session?.coachLiveInputState === 'starting' || session?.coachLiveInputState === 'active')
        && liveInputLeaseMatches(session, context.liveInputLeaseId)
      ),
      isSessionActive: (session, context = {}) => (
        session?.coachLiveInputState === 'active'
        && Number(session?.coachLiveInputGeneration) === Number(context.generation)
        && liveInputLeaseMatches(session, context.liveInputLeaseId)
      ),
      submitTurn: (body, internal) => voiceOperationRouteHandlers.submitVoiceInputTurn(body, internal),
      policy: {
        candidateSilenceMs: config.voiceLiveCandidateSilenceMs,
        fallbackSilenceMs: config.voiceLiveFallbackSilenceMs,
        semanticThreshold: config.voiceLiveSemanticThreshold,
        maxAudioBytes: config.voiceLiveMaxAudioBytes,
      },
      onWitness: pushRuntimeWitness,
    });
  }

  return {
    appCompatibilityRouteHandlers,
    callVoiceTrainer,
    callVoiceTutorModel,
    config,
    consumeListeningTurn,
    get debugBus() { return debugBus; },
    set debugBus(value) { debugBus = value; },
    ensureLessonPlan,
    generateRealtimeCoachReplyStreaming,
    getTurnTelemetry,
    getSessionTelemetryHistory: (sessionId) => {
      const list = sessionTelemetryHistory.get(sessionId) || [];
      return list.map((entry) => {
        if (entry && typeof entry.getSummary === 'function') {
          return entry.toJSON();
        }
        return entry;
      });
    },
    learnerContextService,
    learnerContextRouteHandlers: createLearnerContextRouteHandlers({
      learnerContextService,
      clearRuntimeLearnerData,
    }),
    persistLessonState,
    practiceCards,
    processCoachReplyCardOps,
    processCoachReplyMemoryOps,
    // B-SESS: exposed so the pin route (registered outside this closure) can
    // stamp it, and so tests/ops can drive the internal sweep directly.
    recentMilestoneCache,
    resolveLessonState,
    // 2026-07-26 field repair: the engine's one-shot take-kind prescription.
    // Exposed for the same reason recentMilestoneCache is — its LIFECYCLE
    // (stamp -> read -> spend -> expire) is internal machinery with no route of
    // its own, and the alternative to driving it directly is a brittle
    // full-coach-turn fixture that proves less. The wiring of the two stamp
    // sites is proven separately, through the real coach paths.
    stampEngineRecommendedTakeKind,
    // 2026-07-30 cue carry-forward: exposed for the same reason as its
    // take-kind neighbour above — the stamp/clear rule is unit-testable on its
    // own, while the two call sites are proven through the real coach paths.
    stampLastCueGiven,
    resolveCoachTakeKind,
    // 2026-07-27 field repair: the coach-turn request witness, exposed because
    // the route that needs it is registered outside this closure and the logger
    // + debug bus live inside it. See its definition for the incident.
    logCoachTurnRequest,
    // 2026-07-27: the witness emitter itself, exposed so the JOURNAL MAPPING
    // below it (which decides what an operator actually sees after a failure)
    // is kill-testable rather than only reachable through a WebSocket upgrade.
    pushRuntimeWitness,
    sessions,
    sessionStore,
    standaloneSessionRouteHandlers,
    sweepStaleCutShortSessions,
    tasks,
    turnTelemetryStore,
    voiceOperationRouteHandlers,
    closeReferencePrewarms,
    voiceInputAsrBridge,
    voiceInputLiveService,
    voiceTurnDetector,
    voiceSessionRouteHandlers,
    voiceStateRuntime,
  };
}

function registerStandaloneSupportRoutes(app, runtime, options = {}) {
  const sensitiveRouteGuard = options.sensitiveRouteGuard || createSensitiveRouteGuard({
    adminToken: options.adminToken ?? appConfig.ADMIN_TOKEN,
    routeLabel: 'Voice standalone route',
  });
  function sendRouteError(res, error) {
    const status = error.status || error.statusCode || 500;
    res.status(status).json(error.payload || {
      success: false,
      error: error.message || String(error),
    });
  }

  function registerJson(method, route, handler) {
    app[method](route, sensitiveRouteGuard, async (req, res) => {
      try {
        res.json(await handler(req));
      } catch (error) {
        sendRouteError(res, error);
      }
    });
  }

  app.get('/health', async (_req, res) => {
    const result = await runtime.voiceSessionRouteHandlers.getVoiceHealth();
    res.status(result.statusCode).json(result.payload);
  });

  app.get('/voice/standalone/readiness', sensitiveRouteGuard, async (_req, res) => {
    const force = ['1', 'true', 'yes'].includes(String(_req.query?.force || '').toLowerCase());
    const result = await runtime.voiceSessionRouteHandlers.getStandaloneReadiness({ force });
    res.status(result.statusCode).json(result.payload);
  });

  registerJson('post', '/session/start', (req) => (
    runtime.appCompatibilityRouteHandlers.startSession(req.body || {})
  ));

  registerJson('post', '/session/:sessionId/stop', (req) => (
    runtime.appCompatibilityRouteHandlers.stopSession(req.params.sessionId)
  ));

  registerJson('post', '/session/:sessionId/freeze', (req) => (
    runtime.appCompatibilityRouteHandlers.freezeSession(req.params.sessionId)
  ));

  registerJson('get', '/sessions/frozen', () => (
    runtime.appCompatibilityRouteHandlers.listFrozenSessions()
  ));

  registerJson('get', '/models', () => runtime.appCompatibilityRouteHandlers.listModels());
  registerJson('get', '/models/runtime-status', () => (
    runtime.appCompatibilityRouteHandlers.getModelRuntimeStatus()
  ));
  registerJson('get', '/compatibility-presets', () => (
    runtime.appCompatibilityRouteHandlers.listCompatibilityPresets()
  ));

  registerJson('get', '/agents/list', () => runtime.appCompatibilityRouteHandlers.listAgents());
  registerJson('get', '/agents/:id/preferences', (req) => (
    runtime.appCompatibilityRouteHandlers.getAgentPreferences(req.params.id)
  ));
  registerJson('put', '/agents/:id/preferences', (req) => (
    runtime.appCompatibilityRouteHandlers.updateAgentPreferences(req.params.id, req.body || {})
  ));
  registerJson('get', '/agents/:id/knowledge-access', (req) => (
    runtime.appCompatibilityRouteHandlers.getAgentKnowledgeAccess(req.params.id)
  ));

  registerJson('get', '/knowledge/grouped', () => (
    runtime.appCompatibilityRouteHandlers.getKnowledgeGrouped()
  ));
  registerJson('get', '/knowledge/processing-status', () => (
    runtime.appCompatibilityRouteHandlers.getKnowledgeProcessingStatus()
  ));
  registerJson('post', '/knowledge/processing-status/trigger', () => (
    runtime.appCompatibilityRouteHandlers.getKnowledgeProcessingStatus()
  ));
  registerJson('get', '/knowledge/mcp-status', () => (
    runtime.appCompatibilityRouteHandlers.getKnowledgeMcpStatus()
  ));
  registerJson('get', '/knowledge/video-jobs', () => (
    runtime.appCompatibilityRouteHandlers.listKnowledgeVideoJobs()
  ));
  registerJson('get', '/knowledge/url-jobs', () => (
    runtime.appCompatibilityRouteHandlers.listKnowledgeUrlJobs()
  ));
  registerJson('get', '/stage/state', () => runtime.appCompatibilityRouteHandlers.getStageState());
  registerJson('get', '/image-studio/capabilities', () => (
    runtime.appCompatibilityRouteHandlers.getImageStudioCapabilities()
  ));

  registerJson('get', '/session/:sessionId/notepad', (req) => (
    runtime.appCompatibilityRouteHandlers.getSessionNotepad(req.params.sessionId)
  ));
  registerJson('put', '/session/:sessionId/notepad', (req) => (
    runtime.appCompatibilityRouteHandlers.updateSessionNotepad(req.params.sessionId, req.body || {})
  ));
  registerJson('post', '/session/:sessionId/todo', (req) => (
    runtime.appCompatibilityRouteHandlers.appendSessionTodo(req.params.sessionId, req.body || {})
  ));

  registerJson('get', '/voice/standalone/sessions', (req) => (
    runtime.standaloneSessionRouteHandlers.listSessions(req.query || {})
  ));
  registerJson('get', '/voice/standalone/sessions/:sessionId/export', (req) => (
    runtime.standaloneSessionRouteHandlers.exportSession(req.params.sessionId)
  ));
  registerJson('post', '/voice/standalone/sessions/prune', () => (
    runtime.standaloneSessionRouteHandlers.pruneSessions()
  ));
  registerJson('delete', '/voice/standalone/sessions/:sessionId', (req) => (
    runtime.standaloneSessionRouteHandlers.deleteSession(req.params.sessionId)
  ));

  // Per-turn observability endpoints
  registerJson('get', '/voice/turns/:turnId/telemetry', (req) => (
    runtime.appCompatibilityRouteHandlers.getTurnTelemetry(req.params.turnId)
  ));
  registerJson('post', '/voice/turns/:turnId/telemetry', (req) => (
    runtime.appCompatibilityRouteHandlers.updateTurnTelemetry(req.params.turnId, req.body || {})
  ));
  registerJson('get', '/voice/sessions/:sessionId/telemetry', (req) => {
    const sessionId = normalizeText(req.params.sessionId, 160);
    if (!sessionId) {
      return { success: false, error: 'sessionId is required' };
    }
    const history = runtime.getSessionTelemetryHistory(sessionId);
    return { success: true, sessionId, count: history.length, telemetry: history };
  });

  // Streaming coach endpoint — SSE
  // 2026-07-27 field repair (the silent coach turn). This route is the SERVER
  // end of the only crossing that turns a finished transcript into a spoken
  // reply, and it used to be entirely unwitnessed: every rejection here — a
  // missing session, a bad body, or a throw inside the coach turn — answered
  // the client and logged NOTHING. A live turn ended at `asr-completed` and the
  // journal simply stopped, with no way to tell whether the client had even
  // asked. `coach_turn_request` now names both ends of that question: one
  // compact line when the request ARRIVES, and one when it fails. The emitter
  // itself lives on the runtime, which owns the logger and the debug bus.
  const logCoachTurnRequest = typeof runtime.logCoachTurnRequest === 'function'
    ? runtime.logCoachTurnRequest
    : () => {};
  app.post('/voice/coach/stream', sensitiveRouteGuard, async (req, res) => {
    const startedAt = Date.now();
    try {
      const body = req.body || {};
      const sessionId = typeof body.sessionId === 'string' ? body.sessionId.trim() : '';
      if (!sessionId) {
        logCoachTurnRequest('rejected', { reason: 'missing_session_id', class: 'contract-drift' });
        res.status(400).json({ success: false, error: 'sessionId is required' });
        return;
      }
      const session = runtime.sessions.get(sessionId);
      if (!session) {
        logCoachTurnRequest('rejected', { reason: 'session_not_found', class: 'wrong-path' });
        res.status(404).json({ success: false, error: `Session not found: ${sessionId}` });
        return;
      }
      const listeningTurn = runtime.consumeListeningTurn(session, body.listeningTurnId);
      const question = listeningTurn?.transcript
        || (typeof body.message === 'string' ? body.message.trim() : '');
      if (!question) {
        logCoachTurnRequest('rejected', { reason: 'missing_message', class: 'contract-drift' });
        res.status(400).json({ success: false, error: 'message is required' });
        return;
      }
      const audioBase64 = typeof body.audioBase64 === 'string' ? body.audioBase64 : null;
      const audioFormat = typeof body.audioFormat === 'string' ? body.audioFormat : 'wav';
      // The ARRIVAL line. Content-free (no transcript, no ids beyond a length),
      // and the one fact the 2026-07-27 hunt could not establish from any log:
      // did the client ask for a reply at all?
      logCoachTurnRequest('accepted', {
        message_chars: question.length,
        audio_provided: Boolean(audioBase64),
      });
      await runtime.generateRealtimeCoachReplyStreaming(
        session,
        question,
        res,
        audioBase64,
        audioFormat,
        listeningTurn,
      );
    } catch (error) {
      logCoachTurnRequest('failed', {
        reason: 'coach_turn_threw',
        class: error?.name === 'TypeError' || error?.name === 'ReferenceError'
          ? 'dead-function'
          : 'partial-function',
        error_name: String(error?.name || 'Error').slice(0, 60),
        // Bounded so a model reply or learner utterance can never ride out on
        // an error string.
        error_message: String(error?.message || 'unknown error').slice(0, 200),
        response_started: res.headersSent === true,
        ms: Math.max(0, Date.now() - startedAt),
      });
      if (!res.headersSent) {
        res.status(500).json({ success: false, error: error.message });
      } else {
        res.end();
      }
    }
  });

  // Lesson management endpoints
  registerJson('get', '/voice/lesson/current', (req) => {
    const sessionId = typeof req.query?.sessionId === 'string' ? req.query.sessionId.trim() : '';
    const session = runtime.sessions.get(sessionId);
    if (!session) return { success: false, error: 'Session not found' };
    const lessonState = runtime.resolveLessonState(session);
    return {
      success: true,
      lesson: lessonState ? lessonState.toJSON() : null,
    };
  });

  registerJson('post', '/voice/lesson/plan', async (req) => {
    const body = req.body || {};
    const sessionId = typeof body.sessionId === 'string' ? body.sessionId.trim() : '';
    const session = runtime.sessions.get(sessionId);
    if (!session) return { success: false, error: 'Session not found' };
    session.lessonState = null; // Force replan
    const lessonState = await runtime.ensureLessonPlan(session);
    return {
      success: true,
      lesson: lessonState.toJSON(),
    };
  });

  registerJson('post', '/voice/lesson/advance', (req) => {
    const body = req.body || {};
    const sessionId = typeof body.sessionId === 'string' ? body.sessionId.trim() : '';
    const session = runtime.sessions.get(sessionId);
    if (!session) return { success: false, error: 'Session not found' };
    const lessonState = runtime.resolveLessonState(session);
    if (!lessonState) return { success: false, error: 'No active lesson' };
    const hasMore = lessonState.advance();
    runtime.persistLessonState(session, lessonState);
    return {
      success: true,
      hasMore,
      lesson: lessonState.toJSON(),
    };
  });

  registerJson('post', '/voice/lesson/attempt', (req) => {
    const body = req.body || {};
    const sessionId = typeof body.sessionId === 'string' ? body.sessionId.trim() : '';
    const session = runtime.sessions.get(sessionId);
    if (!session) return { success: false, error: 'Session not found' };
    const lessonState = runtime.resolveLessonState(session);
    if (!lessonState) return { success: false, error: 'No active lesson' };
    lessonState.recordAttempt(body.success === true);
    runtime.persistLessonState(session, lessonState);
    return {
      success: true,
      lesson: lessonState.toJSON(),
    };
  });

  // ── B-SESS flow-session routes (same guard as every sibling session route:
  //    sensitiveRouteGuard's trusted-local path — sendBeacon carries no custom
  //    headers, so admission is by loopback/tailscale address, token otherwise).
  // Pause beacon: fired on pagehide; writes the ring entry NOW as cut-short.
  // The session stays resumable; a later clean close upgrades the entry.
  registerJson('post', '/voice/session/:sessionId/paused', (req) => (
    runtime.voiceOperationRouteHandlers.pauseVoiceSessionBeacon(req.params.sessionId)
  ));
  // PATCH-style scope update: { tier?: 'full'|'quiet'|'silent', eyesFree?: boolean }.
  registerJson('post', '/voice/session/:sessionId/scope', (req) => (
    runtime.voiceOperationRouteHandlers.updateVoiceSessionScope(req.params.sessionId, req.body || {})
  ));

  // Practice card endpoints (the lesson "strip of words"). The active card is
  // primarily authored via the coach card_ops channel; these routes read it,
  // advance the deterministic fallback, and provide a manual/testing authoring entry.
  registerJson('get', '/voice/card', (req) => {
    const sessionId = typeof req.query?.sessionId === 'string' ? req.query.sessionId.trim() : '';
    const session = runtime.sessions.get(sessionId);
    if (!session) return { success: false, error: 'Session not found' };
    return {
      success: true,
      card: runtime.practiceCards.getActiveCard(sessionId),
    };
  });

  registerJson('post', '/voice/card/advance', (req) => {
    const body = req.body || {};
    const sessionId = typeof body.sessionId === 'string' ? body.sessionId.trim() : '';
    const session = runtime.sessions.get(sessionId);
    if (!session) return { success: false, error: 'Session not found' };
    const targetPreset = session.voiceState?.targetPreset || 'cute-feminine';
    const focus = typeof body.focus === 'string' ? body.focus : null;
    const topics = Array.isArray(body.topics) ? body.topics : null;
    const card = runtime.practiceCards.nextFallbackCard(sessionId, { targetPreset, focus, topics });
    return { success: true, card };
  });

  registerJson('post', '/voice/card/author', (req) => {
    const body = req.body || {};
    const sessionId = typeof body.sessionId === 'string' ? body.sessionId.trim() : '';
    const session = runtime.sessions.get(sessionId);
    if (!session) return { success: false, error: 'Session not found' };
    const targetPreset = session.voiceState?.targetPreset || 'cute-feminine';
    // Validate the manual card_ops payload through the same gate as the coach channel.
    const validated = validateCardOps({ card_ops: body.card_ops, focus_update: body.focus_update, replay: body.replay });
    let applied = 0;
    if (validated.ops.length > 0) {
      const result = runtime.practiceCards.applyCardOps(sessionId, validated.ops, {
        targetPreset,
        focus: validated.focusUpdate ? (validated.focusUpdate.direction || validated.focusUpdate.axis) : undefined,
      });
      applied = result.applied;
    }
    if (validated.focusUpdate && runtime.practiceCards.getActiveCard(sessionId)) {
      const current = runtime.practiceCards.getActiveCard(sessionId);
      runtime.practiceCards.setActiveCard(sessionId, { ...current, focus: { ...current.focus, ...validated.focusUpdate } });
    }
    return {
      success: true,
      card: runtime.practiceCards.getActiveCard(sessionId),
      cardOpsApplied: applied,
      replayDirective: validated.replay || null,
      errors: validated.errors,
    };
  });

  // ── V1.5 one-real-sentence routes (next to the practice-card routes) ───────
  //
  // The sentence the person will actually say today. An OFFER, never an
  // obligation. studentId is resolved from the body/query, else from the named
  // session, else the default learner. No negative records are ever written.

  // Resolve the studentId for a real-sentence request (mirrors how the rest of
  // the runtime resolves it: explicit id wins, else the session's, else default).
  function resolveRealSentenceStudentId({ studentId, sessionId } = {}) {
    const explicit = normalizeText(studentId, 160);
    if (explicit) return explicit;
    const sid = normalizeText(sessionId, 160);
    if (sid) {
      const session = runtime.sessions.get(sid);
      if (session?.studentId) return session.studentId;
    }
    return runtime.config.defaultStudentId;
  }

  // GET /voice/real-sentence?studentId= -> { today, pendingDebrief, suggestions[3] }
  registerJson('get', '/voice/real-sentence', async (req) => {
    const studentId = resolveRealSentenceStudentId({
      studentId: req.query?.studentId,
      sessionId: req.query?.sessionId,
    });
    const state = runtime.learnerContextService.getRealSentenceState(studentId);
    // Suggestions are deterministic: built from the learner profile + everyday
    // templates, never repeating the last 10 picked. Read the profile snapshot
    // for the name/topics/hobbies.
    let profile = {};
    try {
      const snapshot = await runtime.learnerContextService.getVoiceStudentModelSnapshot(studentId);
      profile = snapshot?.profile || {};
    } catch {
      profile = {};
    }
    return {
      success: true,
      studentId,
      today: state.today,
      pendingDebrief: state.pendingDebrief,
      suggestions: buildSuggestions(profile, state.realSentences),
    };
  });

  // POST /voice/real-sentence/pick { studentId, sessionId?, text } -> { entry, card }
  registerJson('post', '/voice/real-sentence/pick', (req) => {
    const body = req.body || {};
    const studentId = resolveRealSentenceStudentId({ studentId: body.studentId, sessionId: body.sessionId });
    const text = normalizeText(body.text, REAL_SENTENCE_MAX_LEN);
    if (!text) {
      return { success: false, error: 'A sentence (text) is required.' };
    }
    // Create the persisted entry (status 'picked', stamped today).
    const entry = createRealSentenceEntry(text);
    runtime.learnerContextService.addRealSentence(studentId, entry);

    // Create a PracticeCard (kind:'real_sentence') and set it active for the
    // session when a sessionId is supplied. Focus = the current session focus.
    let card = null;
    const sessionId = normalizeText(body.sessionId, 160);
    if (sessionId) {
      const session = runtime.sessions.get(sessionId);
      if (session) {
        const targetPreset = session.voiceState?.targetPreset || 'cute-feminine';
        const sessionFocus = session.voiceState?.activeLine?.focus
          || session.voiceState?.focus
          || null;
        card = runtime.practiceCards.createCard(sessionId, {
          phrase: text,
          kind: 'real_sentence',
          focus: sessionFocus,
          difficulty: 'easy',
          source: 'tutor',
          targetPreset,
        });
      }
    }
    return { success: true, studentId, entry, card };
  });

  // POST /voice/real-sentence/outcome { studentId, id, outcome, note? }
  //   -> sets status 'debriefed' + outcome. said-well appends a whatWorked entry;
  //      said-rough / not-said write NO negative record (warm coach line only).
  registerJson('post', '/voice/real-sentence/outcome', (req) => {
    const body = req.body || {};
    const studentId = resolveRealSentenceStudentId({ studentId: body.studentId, sessionId: body.sessionId });
    const id = normalizeText(body.id, 80);
    const outcome = REAL_SENTENCE_OUTCOMES.includes(body.outcome) ? body.outcome : null;
    if (!id) return { success: false, error: 'A real-sentence id is required.' };
    if (!outcome) {
      return { success: false, error: `outcome must be one of ${REAL_SENTENCE_OUTCOMES.join(', ')}.` };
    }
    const note = normalizeText(body.note, 240);
    // Read the entry text (for the coach line + whatWorked) before updating.
    const before = runtime.learnerContextService.getRealSentenceState(studentId);
    const entry = (before.realSentences || []).find((e) => e && e.id === id) || null;
    const text = entry?.text || '';

    // Set status debriefed + outcome (+ optional note). No negative record.
    runtime.learnerContextService.updateRealSentence(studentId, id, {
      status: 'debriefed',
      outcome,
      ...(note ? { note } : {}),
    });

    // said-well -> append a whatWorked win AND log an identity-moment. said-rough /
    // not-said -> NO record anywhere (warm coach line only).
    if (outcome === 'said-well') {
      try {
        runtime.learnerContextService.updateLearnerProfile(studentId, {
          whatWorked: [whatWorkedEntryForOutcome(text)],
        });
      } catch {
        // fail-soft: the win-append must never fail the outcome
      }
      // v4 tutor-memory (gap 5): a carried real sentence is the realest data the
      // product has — also log it as a milestone moment (keeps the whatWorked
      // append above). Best-effort + fail-soft.
      try {
        if (text && typeof runtime.learnerContextService.addMoment === 'function') {
          runtime.learnerContextService.addMoment(studentId, {
            kind: 'milestone',
            text: `carried: ${text}`,
          });
        }
      } catch {
        // fail-soft: the moment-append must never fail the outcome
      }
    }

    return {
      success: true,
      studentId,
      id,
      outcome,
      coachLine: outcomeCoachLine(outcome, text),
    };
  });

  // Eval endpoints
  registerJson('get', '/voice/eval/session/:sessionId', (req) => {
    const sessionId = req.params.sessionId;
    if (!runtime.config.evalPath) return { success: false, error: 'Eval not configured' };
    const turns = readSessionTurns(runtime.config.evalPath, sessionId);
    return { success: true, sessionId, turnCount: turns.length, turns };
  });

  registerJson('get', '/voice/eval/session/:sessionId/analytics', (req) => {
    const sessionId = req.params.sessionId;
    if (!runtime.config.evalPath) return { success: false, error: 'Eval not configured' };
    const turns = readSessionTurns(runtime.config.evalPath, sessionId);
    const analytics = computeSessionAnalytics(turns);
    return { success: true, sessionId, analytics };
  });

  registerJson('post', '/voice/eval/session/:sessionId/export-golden', (req) => {
    const sessionId = req.params.sessionId;
    if (!runtime.config.evalPath) return { success: false, error: 'Eval not configured' };
    const turns = readSessionTurns(runtime.config.evalPath, sessionId);
    const fixtures = turns.map((turn, i) => turnToGoldenFixture(turn, `Session ${sessionId} turn ${i}`));
    return { success: true, sessionId, fixtureCount: fixtures.length, fixtures };
  });

  app.get('/knowledge/voice/status', sensitiveRouteGuard, (_req, res) => {
    res.json({
      success: true,
      surface: 'voice',
      status: 'standalone',
      state: 'ready',
      note: 'Standalone Voice Tutor does not require the general SLOANE knowledge compiler.',
    });
  });

  app.get('/task/:taskId/status', sensitiveRouteGuard, (req, res) => {
    const task = runtime.tasks.get(req.params.taskId);
    if (!task) {
      res.status(404).json({ status: 'missing', error: 'Task not found' });
      return;
    }
    res.json(task);
  });

  app.all('/voice/reference/analyze', sensitiveRouteGuard, (req, res) => {
    proxyHttpRequest(req, res, `${runtime.config.voiceTrainerUrl}/api/v1/voice/reference/analyze`, {
      headers: runtime.config.voiceTrainerAuthToken
        ? { authorization: `Bearer ${runtime.config.voiceTrainerAuthToken}` }
        : {},
    });
  });

  app.all('/voice/reference/:clipId', sensitiveRouteGuard, (req, res) => {
    proxyHttpRequest(req, res, `${runtime.config.voiceTrainerUrl}/api/v1/voice/reference/${encodeURIComponent(req.params.clipId)}`, {
      headers: runtime.config.voiceTrainerAuthToken
        ? { authorization: `Bearer ${runtime.config.voiceTrainerAuthToken}` }
        : {},
    });
  });

  app.all('/voice/reference/:clipId/audio', sensitiveRouteGuard, (req, res) => {
    proxyHttpRequest(req, res, resolveReferenceAudioUrl(runtime.config.voiceTrainerUrl, req.params.clipId), {
      headers: runtime.config.voiceTrainerAuthToken
        ? { authorization: `Bearer ${runtime.config.voiceTrainerAuthToken}` }
        : {},
    });
  });

  // Attempt-audio replay proxy — mirrors the reference-audio proxy above. Streams
  // the retained per-attempt WAV from the DSP service for "listen back together".
  app.all('/voice/attempt/:attemptId/audio', sensitiveRouteGuard, (req, res) => {
    proxyHttpRequest(req, res, resolveAttemptAudioUrl(runtime.config.voiceTrainerUrl, req.params.attemptId), {
      headers: runtime.config.voiceTrainerAuthToken
        ? { authorization: `Bearer ${runtime.config.voiceTrainerAuthToken}` }
        : {},
    });
  });

  // ── V1.5 time-lapse mirror: milestone proxies (mirror the attempt-audio proxy).
  //   POST   /voice/attempt/:attemptId/pin   -> promote a retained take to a milestone
  //   GET    /voice/milestones                -> list (oldest first)
  //   GET    /voice/milestone/:id/audio       -> the milestone WAV
  //   DELETE /voice/milestone/:id             -> unpin
  function voiceTrainerProxyHeaders() {
    return runtime.config.voiceTrainerAuthToken
      ? { authorization: `Bearer ${runtime.config.voiceTrainerAuthToken}` }
      : {};
  }

  // Pin is a POST with a JSON body ({ studentId, label? }). express.json() has
  // already consumed the stream, so we forward via callVoiceTrainer (which
  // re-serializes the body) rather than the raw stream proxy used for bodyless
  // GET/DELETE routes. Also stamps the recent-milestone cache for the suggestion
  // gate.
  registerJson('post', '/voice/attempt/:attemptId/pin', async (req) => {
    const body = req.body || {};
    const studentId = normalizeText(body.studentId, 160);
    if (studentId) {
      // B-SESS fix: recentMilestoneCache is a runtime-closure Map — referencing
      // it bare here (a sibling top-level function) was a ReferenceError -> 500
      // whenever a pin carried a studentId. Go through the runtime handle.
      runtime.recentMilestoneCache?.set(studentId, { lastPinnedAt: Date.now() });
    }
    const result = await runtime.callVoiceTrainer(
      `/api/v1/voice/attempts/${encodeURIComponent(req.params.attemptId)}/pin`,
      {
        method: 'POST',
        body: {
          studentId: studentId || runtime.config.defaultStudentId,
          label: normalizeText(body.label, 120) || null,
        },
      },
    );
    return { success: true, ...(isRecord(result) ? result : { result }) };
  });

  app.all('/voice/milestones', sensitiveRouteGuard, (req, res) => {
    const search = req.originalUrl.includes('?') ? `?${req.originalUrl.split('?')[1]}` : '';
    proxyHttpRequest(req, res, `${resolveMilestonesUrl(runtime.config.voiceTrainerUrl)}${search}`, {
      headers: voiceTrainerProxyHeaders(),
    });
  });

  app.all('/voice/milestone/:id/audio', sensitiveRouteGuard, (req, res) => {
    proxyHttpRequest(req, res, resolveMilestoneAudioUrl(runtime.config.voiceTrainerUrl, req.params.id), {
      headers: voiceTrainerProxyHeaders(),
    });
  });

  app.all('/voice/milestone/:id', sensitiveRouteGuard, (req, res) => {
    proxyHttpRequest(req, res, resolveMilestoneUrl(runtime.config.voiceTrainerUrl, req.params.id), {
      headers: voiceTrainerProxyHeaders(),
    });
  });

  app.all('/voice-trainer/*', sensitiveRouteGuard, (req, res) => {
    const originalUrl = req.originalUrl || req.url || '';
    const upstreamPath = originalUrl.replace(/^\/voice-trainer/, '') || '/';
    proxyHttpRequest(req, res, `${runtime.config.voiceTrainerUrl}${upstreamPath}`, {
      headers: runtime.config.voiceTrainerAuthToken
        ? { authorization: `Bearer ${runtime.config.voiceTrainerAuthToken}` }
        : {},
    });
  });
}

function resolveVoiceTrainerWebSocketUrl(runtime, requestUrl) {
  const base = new URL(runtime.config.voiceTrainerUrl);
  const protocol = base.protocol === 'https:' ? 'wss:' : 'ws:';
  const upstreamPath = String(requestUrl || '').replace(/^\/voice-trainer/, '') || '/';
  const basePath = base.pathname.replace(/\/$/, '');
  return `${protocol}//${base.host}${basePath}${upstreamPath}`;
}

function authorizeVoiceTrainerUpgrade(req, sensitiveRouteGuard) {
  let allowed = false;
  let statusCode = 403;
  let payload = { success: false, code: 'SENSITIVE_ROUTE_ACCESS_DENIED', error: 'Voice standalone route access denied.' };
  const response = {
    status(code) { statusCode = code; return this; },
    json(value) { payload = value; return this; },
  };
  sensitiveRouteGuard(req, response, () => { allowed = true; statusCode = 200; payload = null; });
  return { allowed, statusCode, payload };
}

function createVoiceTrainerUpgradeHandler(runtime, options = {}) {
  const logger = options.logger || console;
  const sensitiveRouteGuard = options.sensitiveRouteGuard;
  const authorizeUpgrade = options.authorizeUpgrade
    || ((req) => authorizeVoiceTrainerUpgrade(req, sensitiveRouteGuard));
  const webSocketServer = options.webSocketServer;
  const WebSocketCtor = options.WebSocketCtor || WebSocket;
  return function voiceTrainerUpgradeHandler(req, socket, head) {
    const requestUrl = String(req.url || '');
    if (!requestUrl.startsWith('/voice-trainer/')) {
      return;
    }
    const authorization = authorizeUpgrade(req);
    if (!authorization.allowed) {
      if (!socket.destroyed) {
        socket.write?.('HTTP/1.1 403 Forbidden\r\nConnection: close\r\nContent-Length: 0\r\n\r\n');
        socket.destroy();
      }
      return;
    }
    webSocketServer.handleUpgrade(req, socket, head, (client) => {
      const upstream = new WebSocketCtor(resolveVoiceTrainerWebSocketUrl(runtime, requestUrl), {
        headers: runtime.config.voiceTrainerAuthToken
          ? { authorization: `Bearer ${runtime.config.voiceTrainerAuthToken}` }
          : undefined,
      });
      let upstreamOpen = false;
      const pendingClientMessages = [];

      function closeBoth(code = 1011, reason = 'VoiceTrainer websocket proxy closed.') {
        try {
          if (client.readyState === WebSocketCtor.OPEN || client.readyState === WebSocketCtor.CONNECTING) {
            client.close(code, reason);
          }
        } catch { /* cleanup: client ws.close */ }
        try {
          if (upstream.readyState === WebSocketCtor.OPEN || upstream.readyState === WebSocketCtor.CONNECTING) {
            upstream.close(code, reason);
          }
        } catch { /* cleanup: upstream ws.close */ }
      }

      client.on('message', (data, isBinary) => {
        if (upstreamOpen && upstream.readyState === WebSocketCtor.OPEN) {
          upstream.send(data, { binary: isBinary });
          return;
        }
        pendingClientMessages.push({ data, isBinary });
      });
      client.on('close', () => closeBoth(1000, 'Client closed.'));
      client.on('error', () => closeBoth(1011, 'Client websocket error.'));

      upstream.on('open', () => {
        upstreamOpen = true;
        while (pendingClientMessages.length > 0 && upstream.readyState === WebSocketCtor.OPEN) {
          const message = pendingClientMessages.shift();
          upstream.send(message.data, { binary: message.isBinary });
        }
      });
      upstream.on('message', (data, isBinary) => {
        if (client.readyState === WebSocketCtor.OPEN) {
          client.send(data, { binary: isBinary });
        }
      });
      upstream.on('close', (code, reason) => closeBoth(code, reason));
      upstream.on('error', (error) => {
        logger.warn?.('[VoiceStandalone] VoiceTrainer websocket proxy failed.');
        // Route into the debug bus so it shows in the on-page overlay. This is the
        // recurring 403 / connection-refused symptom that previously had no surfacing.
        try {
          runtime.debugBus?.push('warn', 'ws-proxy', 'VoiceTrainer websocket proxy failed.', {
            outcome: 'upstream-error',
          });
        } catch { /* telemetry must never break the proxy */ }
        closeBoth(1011, 'VoiceTrainer websocket proxy failed.');
      });
    });
  };
}

function attachVoiceTrainerWebSocketProxy(server, runtime, options = {}) {
  const WebSocketServerCtor = options.WebSocketServerCtor || WebSocket.Server;
  const wss = new WebSocketServerCtor({ noServer: true });
  const handler = createVoiceTrainerUpgradeHandler(runtime, {
    logger: options.logger,
    sensitiveRouteGuard: options.sensitiveRouteGuard,
    authorizeUpgrade: options.authorizeUpgrade,
    webSocketServer: wss,
    WebSocketCtor: options.WebSocketCtor || WebSocket,
  });
  server.on('upgrade', handler);

  return wss;
}

function createVoiceStandaloneApp({
  appFactory = () => express(),
  attachVoiceTrainerWebSocketProxyImpl = attachVoiceTrainerWebSocketProxy,
  createDebugBusImpl = createDebugBus,
  createPersistentWitnessSinkImpl = createPersistentWitnessSink,
  requestLoggingMiddlewareImpl = requestLoggingMiddleware,
  registerVoiceRuntimeEntrypointsImpl = registerVoiceRuntimeEntrypoints,
  registerStandaloneSupportRoutesImpl = registerStandaloneSupportRoutes,
  attachDebugRoutesImpl = attachDebugRoutes,
  ...options
} = {}) {
  const runtime = options.runtime || createVoiceStandaloneRuntime(options);
  const app = appFactory();
  const sensitiveRouteGuard = options.sensitiveRouteGuard || createSensitiveRouteGuard({
    adminToken: options.adminToken ?? appConfig.ADMIN_TOKEN,
    routeLabel: 'Voice standalone route',
  });
  const authorizeUpgrade = (req) => authorizeVoiceTrainerUpgrade(req, sensitiveRouteGuard);

  // Debug/observation bus — created FIRST so every request (including errors during later
  // middleware/route setup) is logged. In-memory ring buffer; resets on restart by design.
  const debugSink = options.debugSink
    || (options.enablePersistentTelemetry === true ? createPersistentWitnessSinkImpl({
      logger: options.logger || console,
      logPath: options.debugLogPath,
      statusPath: options.debugStatusPath,
    }) : null);
  const debugBus = createDebugBusImpl({ logger: options.logger || console, sink: debugSink });
  runtime.debugBus = debugBus; // expose so WS-proxy + coaching can push events too

  if (runtime.config.corsEnabled) {
    app.use(cors({ exposedHeaders: VOICE_SPEECH_BROWSER_EXPOSED_RESPONSE_HEADERS }));
  }
  // Request logging MUST come before body parsers so even requests that fail JSON parsing
  // are captured with a reqId + status + timing.
  app.use(requestLoggingMiddlewareImpl(debugBus));
  app.use((req, _res, next) => {
    req.rawBodyStartAt = Date.now();
    next();
  });
  app.use(express.json({
    limit: runtime.config.requestJsonLimit,
    type: ['application/json', 'application/*+json'],
  }));
  app.use(express.urlencoded({ extended: true, limit: runtime.config.requestJsonLimit }));

  registerVoiceRuntimeEntrypointsImpl(app, {
    enableDeepTutorVoiceRoutes: runtime.config.enableDeepTutorVoiceRoutes,
    learnerContextRouteHandlers: runtime.learnerContextRouteHandlers,
    sendRouteError(res, error) {
      const status = error.status || error.statusCode || 500;
      res.status(status).json(error.payload || createVoiceBackendErrorPayload(null, error.message, {
        success: false,
      }));
    },
    voiceOperationRouteHandlers: runtime.voiceOperationRouteHandlers,
    voiceRouteMiddlewares: sensitiveRouteGuard,
    voiceSessionRouteHandlers: runtime.voiceSessionRouteHandlers,
  });
  registerStandaloneSupportRoutesImpl(app, runtime, { sensitiveRouteGuard });

  // Debug/observation routes — used by the on-page debug overlay (boot harness in the
  // HTML shell) to ingest client events and poll the merged client+server event stream.
  app.use('/voice/debug', sensitiveRouteGuard);
  attachDebugRoutesImpl(app, debugBus, {
    healthProbe: async () => {
      try {
        const r = await runtime.voiceSessionRouteHandlers.getVoiceHealth();
        return {
          gatewayHealth: {
            status: r.payload?.status || 'unknown',
            statusCode: r.statusCode,
          },
          memoryStorage: r.payload?.memoryStorage || null,
        };
      } catch { return { gatewayHealth: { status: 'unavailable' } }; }
    },
  });
  debugBus.push('info', 'system', 'Voice Tutor debug bus online (request logging + /voice/debug/* routes attached)', {
    voiceTrainerConfigured: Boolean(runtime.config.voiceTrainerUrl),
    ggufConfigured: Boolean(runtime.config.voiceTutorGgufBaseUrl),
  });

  return {
    app,
    runtime,
    debugBus,
    start(overrides = {}) {
      const host = overrides.host || runtime.config.host;
      const port = overrides.port ?? runtime.config.port;
      // Warm the optional semantic endpoint detector while the gateway starts so
      // the user's first thoughtful pause is not spent paying Python/model boot.
      Promise.resolve(runtime.voiceTurnDetector?.start?.()).catch(() => {
        // Conservative silence endpointing remains available if warm-up fails.
      });
      const server = app.listen(port, host, () => {
        const logger = overrides.logger || console;
        logger.log(`[VoiceStandalone] listening on http://${host}:${port}`);
        logger.log(`[VoiceStandalone] VoiceTrainer: ${runtime.config.voiceTrainerUrl}`);
        logger.log(`[VoiceStandalone] GGUF: ${runtime.config.voiceTutorGgufBaseUrl} (${runtime.config.voiceTutorGgufModel})`);
      });
      server.once?.('close', () => {
        debugBus.close?.();
        runtime.voiceInputLiveService?.close?.();
        void runtime.closeReferencePrewarms?.();
      });
      const logger = overrides.logger || console;
      attachVoiceTrainerWebSocketProxyImpl(server, runtime, {
        logger,
        sensitiveRouteGuard,
        authorizeUpgrade,
        WebSocketServerCtor: overrides.WebSocketServerCtor,
        WebSocketCtor: overrides.WebSocketCtor,
      });
      runtime.voiceInputLiveService?.attach?.(server, { authorizeUpgrade });
      return server;
    },
  };
}

module.exports = {
  createVoiceStandaloneApp,
  createVoiceStandaloneRuntime,
  authorizeVoiceTrainerUpgrade,
  createVoiceTrainerUpgradeHandler,
  attachVoiceTrainerWebSocketProxy,
  fetchJson,
  proxyHttpRequest,
  createVoiceStandaloneSessionStore,
  registerStandaloneSupportRoutes,
  resolveVoiceTrainerWebSocketUrl,
  // Code-owned SPOKEN copy that bypasses sanitizeCoachReply (returned directly
  // on wordless turns) — exported so the content product-law scan covers it.
  WORDLESS_PRACTICE_LINES,
  WORDLESS_ANALYZED_LINES,
  VOICED_PRACTICE_LINES,
  voicedPracticeLineWithSentence,
  // The first-class turn trigger (2026-07-27). Exported so the "a turn fires on
  // a transcript OR on confirmed phonation" rule is testable on its own, rather
  // than only observable through a whole live turn.
  VOICE_TURN_TRIGGERS,
  resolveVoiceTurnTrigger,
  // Exported for the same reason as resolveVoiceTurnTrigger: the owner's
  // 2026-07-27 ruling turns on a three-way distinction (measured / faint but
  // real / positively silent) that the live-turn harness cannot express — it
  // stubs the analyzer offline, so "the analyzer ran and found zero voicing"
  // is unreachable through it. Pure function, no state.
  resolveWordlessPracticeAcknowledgement,
};
