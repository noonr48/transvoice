# VoxCPM model configuration
VOXCPM_MODEL_ID=openbmb/VoxCPM2       # HuggingFace repo id pulled on first run
VOXCPM_DEVICE=cuda:0                  # cuda:0 here == GPU index 1 (start.sh sets CUDA_VISIBLE_DEVICES=1)
VOXCPM_LOAD_DENOISER=false            # Load the optional audio denoiser block (extra VRAM)
VOXCPM_OPTIMIZE=true                  # Enable torch.compile / fused kernels if available

# Server binding
TTS_HOST=127.0.0.1                     # Loopback only — the gateway proxies external traffic
TTS_PORT=8020                          # Must match VOXCPM_URL in the transvoice-app .env

# Voice and synthesis defaults
TTS_DEFAULT_VOICE_PROFILE=coach_v1     # Profile id from voice_profiles.py used when none is requested
TTS_CFG_VALUE=2.0                      # Classifier-free guidance strength (1.0 = off, higher = more on-voice)
TTS_INFERENCE_TIMESTEPS=8              # Denoising steps per segment (more = slower, marginal quality)
TTS_NORMALIZE=true                     # Loudness-normalise the generated PCM before returning
TTS_FORMAT=pcm_s16le                   # Wire format for the streaming endpoint
TTS_SAMPLE_RATE=48000                  # Output sample rate in Hz; must match the gateway's expected rate

# Text segmentation limits
TTS_MAX_TEXT_CHARS=700                 # Hard cap on request length (matches VoxCPM bridge contract)
TTS_MAX_SEGMENT_CHARS=220              # Split inputs longer than this into multiple segments
TTS_MIN_SEGMENT_CHARS=40               # Avoid emitting tiny trailing fragments

# Cache settings
TTS_CACHE_DIR=./runtime-cache          # Where PCM chunks are memoised on disk
TTS_CACHE_MAX_ENTRIES=500              # LRU cap; oldest entries are evicted first

# Concurrency (1 = sequential synthesis, prevents GPU contention)
TTS_SEMAPHORE_CONCURRENCY=1            # In-flight synth requests; keep at 1 for a single-GPU box
