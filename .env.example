# TransVoice Standalone — Local Development Configuration
# Copy to .env and adjust as needed.

# Gateway bind target
VOICE_STANDALONE_HOST=127.0.0.1
VOICE_STANDALONE_PORT=3021

# Local dependencies
VOICE_TRAINER_URL=http://127.0.0.1:8002
VOICE_TUTOR_GGUF_BASE_URL=http://127.0.0.1:8019/v1
VOICE_TUTOR_GGUF_MODEL=voice-tutor-gemma4-r128-clean-s070-iq4nl-attnq8-last10-gguf

# TTS / VoxCPM (consumed by backend/voice-standalone-config.js + backend/config.js).
# Disabled by default; set VOXCPM_ENABLED=true to route tutor TTS through VoxCPM.
VOXCPM_ENABLED=false
VOXCPM_URL=http://127.0.0.1:8020
VOXCPM_MODEL=openbmb/VoxCPM2
VOXCPM_TIMEOUT_MS=30000

# Buffered speech-to-text for the spoken Coach input path. The phone sends
# recorded audio to this same-origin gateway; only the gateway calls ASR.
VOICE_ASR_ENABLED=false
VOICE_ASR_URL=http://127.0.0.1:8765
VOICE_ASR_API_STYLE=simple
VOICE_ASR_LANGUAGE=en
VOICE_ASR_TIMEOUT_MS=10000
VOICE_ASR_LIVE_MODE=buffered

# Live Coach input streams 16 kHz PCM to the gateway. Smart Turn is an
# advisory speech-completion model; uncertainty or failure waits for the
# conservative silence boundary instead of cutting the learner off.
SMART_TURN_ENABLED=true
# SMART_TURN_PYTHON_PATH=/home/USER/.local/share/sloane/transvoice/smart-turn/venv/bin/python
# SMART_TURN_MODEL_PATH=/home/USER/.local/share/sloane/transvoice/smart-turn/models/smart-turn-v3.2-cpu.onnx
SMART_TURN_TIMEOUT_MS=500
# Endpoint timing is a code-locked accessibility contract: 1800 ms neural
# candidate, 4500 ms conservative/recorded fallback. It is not an env knob.
VOICE_LIVE_SEMANTIC_THRESHOLD=0.65
VOICE_LIVE_MAX_AUDIO_BYTES=4194304

# Durable state (defaults to ~/.local/state/sloane/voice-standalone/)
# VOICE_STANDALONE_STATE_ROOT=/home/USER/.local/state/sloane/voice-standalone

# Session retention
VOICE_STANDALONE_SESSION_MAX_SESSIONS=250
VOICE_STANDALONE_SESSION_RETENTION_DAYS=0

# Privacy-bounded runtime evaluation is opt-in and categorical. Text-bearing
# evaluation is available only to the isolated evaluator, never via live env.
VOICE_STANDALONE_EVAL_ENABLED=false
# VOICE_STANDALONE_EVAL_PATH=/home/USER/.local/state/sloane/voice-standalone/coaching-eval.jsonl

# CORS (keep enabled for split frontend/backend dev)
VOICE_STANDALONE_CORS_ENABLED=true

# Optional: VoiceTrainer auth token
# VOICE_TRAINER_AUTH_TOKEN=

# Optional: GGUF model API key
# VOICE_TUTOR_GGUF_API_KEY=
