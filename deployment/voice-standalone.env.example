# Standalone gateway bind target behind a local reverse proxy.
VOICE_STANDALONE_HOST=127.0.0.1
VOICE_STANDALONE_PORT=3021

# Local dependencies. Keep these private; expose only the reverse proxy.
VOICE_TRAINER_URL=http://127.0.0.1:8002
VOICE_TUTOR_GGUF_BASE_URL=http://127.0.0.1:8019/v1
VOICE_TUTOR_GGUF_MODEL=voice-tutor-gemma4-r128-clean-s070-iq4nl-attnq8-last10-gguf

# Spoken Coach input. Keep this service private to the gateway host or tailnet.
VOICE_ASR_ENABLED=true
VOICE_ASR_URL=http://127.0.0.1:8765
VOICE_ASR_API_STYLE=simple
VOICE_ASR_LANGUAGE=en
VOICE_ASR_TIMEOUT_MS=10000
VOICE_ASR_LIVE_MODE=buffered

# Adaptive spoken-turn completion. Run scripts/setup-smart-turn.sh once on the
# gateway host. No semantic decision can cut inside the protected 1800 ms
# pause; unavailable or incomplete decisions wait for the 4500 ms fallback.
SMART_TURN_ENABLED=true
SMART_TURN_PYTHON_PATH=/home/USER/.local/share/sloane/transvoice/smart-turn/venv/bin/python
SMART_TURN_MODEL_PATH=/home/USER/.local/share/sloane/transvoice/smart-turn/models/smart-turn-v3.2-cpu.onnx
SMART_TURN_TIMEOUT_MS=500
# Endpoint timing is code-locked at 1800/4500 ms and cannot be overridden by
# deployment environment or persisted frontend state.
VOICE_LIVE_SEMANTIC_THRESHOLD=0.65
VOICE_LIVE_MAX_AUDIO_BYTES=4194304

# Durable standalone state.
VOICE_STANDALONE_STATE_ROOT=/var/lib/sloane/voice-standalone
VOICE_STANDALONE_SESSION_STORE_PATH=/var/lib/sloane/voice-standalone/sessions.json
VOICE_STANDALONE_SESSION_MAX_SESSIONS=250
VOICE_STANDALONE_SESSION_RETENTION_DAYS=0

# Keep production turn evaluation off unless categorical diagnostics are
# explicitly required. Raw text capture is isolated-evaluator-only.
VOICE_STANDALONE_EVAL_ENABLED=false
# VOICE_STANDALONE_EVAL_PATH=/var/lib/sloane/voice-standalone/coaching-eval.jsonl

# Leave CORS enabled for split frontend/backend development.
# Same-origin HTTPS deployment can set this to false after validation.
VOICE_STANDALONE_CORS_ENABLED=true
